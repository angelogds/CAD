<% layout('layout') %>

<style>
  .assistant-shell{max-width:1180px;margin:0 auto}
  .assistant-hero{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:16px}
  .assistant-title{margin:0;font-size:28px;color:#163828}.assistant-subtitle{margin:6px 0 0;color:#667085}
  .assistant-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr);gap:16px}
  .assistant-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;box-shadow:0 8px 28px rgba(15,23,42,.06);overflow:hidden}
  .assistant-tabs{display:flex;gap:4px;padding:8px;background:#f5f7f6;border-bottom:1px solid #e5e7eb}
  .assistant-tab{border:0;background:transparent;border-radius:12px;padding:10px 16px;font-weight:700;color:#667085;cursor:pointer}
  .assistant-tab.active{background:#fff;color:#137a46;box-shadow:0 1px 4px rgba(15,23,42,.08)}
  .assistant-panel{display:none;padding:18px}.assistant-panel.active{display:block}
  .assistant-muted{color:#667085;font-size:13px}.assistant-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .assistant-input{width:100%;min-height:132px;border:1px solid #d0d5dd;border-radius:14px;padding:14px;resize:vertical;font:inherit;box-sizing:border-box}
  .assistant-btn{border:1px solid #128447;background:#128447;color:#fff;border-radius:12px;padding:11px 16px;font-weight:800;cursor:pointer}
  .assistant-btn.secondary{background:#fff;color:#128447}.assistant-btn:disabled{opacity:.55;cursor:not-allowed}
  .assistant-history{height:520px;overflow:auto;padding:14px;background:#f8faf9}
  .assistant-msg{padding:11px 13px;border-radius:14px;margin-bottom:10px;white-space:pre-wrap;line-height:1.45;border:1px solid #e5e7eb;background:#fff}
  .assistant-msg.user{background:#effaf3;border-color:#cdeed9;margin-left:38px}.assistant-msg.ai{margin-right:38px}
  .voice-center{text-align:center;padding:12px 4px 20px}.voice-orb{width:124px;height:124px;border-radius:50%;border:0;background:#128447;color:#fff;font-size:42px;cursor:pointer;box-shadow:0 12px 30px rgba(18,132,71,.25);transition:.2s}.voice-orb.active{transform:scale(1.04);box-shadow:0 0 0 12px rgba(18,132,71,.12),0 14px 32px rgba(18,132,71,.28)}
  .voice-status{font-weight:800;color:#163828;margin-top:14px}.voice-transcript{min-height:160px;max-height:300px;overflow:auto;text-align:left;background:#f8faf9;border:1px solid #e5e7eb;border-radius:14px;padding:14px;margin-top:16px;white-space:pre-wrap}
  .assistant-side{padding:18px}.side-chip{display:inline-block;background:#edf7f1;color:#137a46;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:800;margin:0 6px 6px 0}
  .safety-box{margin-top:14px;padding:12px;border-radius:14px;background:#fff8e8;border:1px solid #f6d88f;color:#805b10;font-size:13px}
  @media(max-width:900px){.assistant-grid{grid-template-columns:1fr}.assistant-history{height:380px}.assistant-hero{flex-direction:column}.voice-orb{width:108px;height:108px}}
</style>

<div class="assistant-shell">
  <div class="assistant-hero">
    <div>
      <h1 class="assistant-title">Assistente Industrial</h1>
      <p class="assistant-subtitle">Manutenção, PCM, equipamentos e operação com texto e voz em tempo real.</p>
    </div>
    <a href="<%= backHref || '/dashboard' %>" class="btn btn-ghost">Voltar</a>
  </div>

  <% if (!aiEnabled) { %>
    <div class="assistant-card" style="padding:14px;margin-bottom:12px;color:#b45309;">IA desativada por configuração (AI_ENABLED=false).</div>
  <% } else if (!aiConfigured) { %>
    <div class="assistant-card" style="padding:14px;margin-bottom:12px;color:#b45309;">IA ainda não configurada no servidor (OPENAI_API_KEY ausente).</div>
  <% } %>

  <div class="assistant-grid">
    <div class="assistant-card">
      <div class="assistant-tabs">
        <button class="assistant-tab active" data-tab="text">Conversa</button>
        <button class="assistant-tab" data-tab="voice">Voz</button>
      </div>

      <section class="assistant-panel active" id="panel-text">
        <label class="assistant-muted" for="aiContexto">Contexto</label>
        <select id="aiContexto" style="width:100%;margin:6px 0 10px;border:1px solid #d0d5dd;border-radius:12px;padding:10px;">
          <option value="geral">Geral</option><option value="os">OS</option><option value="equipamento">Equipamento</option><option value="preventiva">Preventiva</option><option value="academia">Academia</option>
        </select>
        <textarea id="aiPergunta" class="assistant-input" placeholder="Ex.: quais são as prioridades de manutenção para hoje?"></textarea>
        <div class="assistant-row" style="margin-top:10px;">
          <button class="assistant-btn" id="aiEnviar" type="button">Enviar</button>
          <button class="assistant-btn secondary" id="aiLimpar" type="button">Limpar histórico</button>
        </div>
        <div id="aiStatus" class="assistant-muted" style="margin-top:9px;"></div>
      </section>

      <section class="assistant-panel" id="panel-voice">
        <div class="voice-center">
          <button id="voiceToggle" class="voice-orb" type="button" aria-label="Iniciar conversa por voz">🎙️</button>
          <div id="voiceStatus" class="voice-status">Pronto para conversar</div>
          <div class="assistant-muted" style="margin-top:5px;">Toque no microfone, permita o acesso e fale normalmente. Toque novamente para encerrar.</div>
          <div id="voiceTranscript" class="voice-transcript">A transcrição da conversa aparecerá aqui.</div>
        </div>
        <audio id="voiceRemoteAudio" autoplay></audio>
      </section>
    </div>

    <aside class="assistant-card">
      <div class="assistant-side">
        <h3 style="margin-top:0;color:#163828;">Assistente conectado ao sistema</h3>
        <span class="side-chip">OS</span><span class="side-chip">Equipamentos</span><span class="side-chip">Histórico</span><span class="side-chip">Estoque</span><span class="side-chip">Voz Realtime</span>
        <p class="assistant-muted">Consultas operacionais usam ferramentas do backend e respeitam o perfil do usuário logado.</p>
        <div class="safety-box">Abertura de OS por voz é preparada primeiro. A gravação só acontece depois de confirmação explícita.</div>
      </div>
      <div class="assistant-history" id="aiHistory"></div>
    </aside>
  </div>
</div>

<script src="/js/ai-chat.js"></script>
<script src="/js/ai-realtime.js"></script>
