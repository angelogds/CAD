<% layout('layout') %>
<%- include('partials/internal-styles') %>
<%
  const weekdays = ['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];
  const formatDate = (value) => value ? new Date(`${value}T12:00:00`).toLocaleDateString('pt-BR') : '-';
  const byDay = new Map();
  (programacao.dias || []).forEach((day) => byDay.set(day, []));
  (programacao.itens || []).forEach((item) => { if (byDay.has(item.data_programada)) byDay.get(item.data_programada).push(item); });
  const previous = new Date(`${programacao.semana_inicio}T12:00:00`); previous.setDate(previous.getDate()-7);
  const next = new Date(`${programacao.semana_inicio}T12:00:00`); next.setDate(next.getDate()+7);
%>
<div class="pcm-op-page">
  <header class="pcm-op-head"><div><span class="pcm-op-eyebrow">Planejamento de curto prazo</span><h1>Programação semanal</h1><p>Agenda real da equipe e fila de OS ainda sem programação, reunidas em uma única tela.</p></div><div class="pcm-op-head-actions"><% if (!canManagePcm) { %><span class="pcm-readonly">Modo consulta</span><% } %><a class="pcm-op-btn" href="/pcm">Voltar à visão geral</a></div></header>
  <div class="pcm-shell">
    <%- include('partials/internal-nav', { activePcmSection: (typeof activePcmSection !== 'undefined' ? activePcmSection : '') }) %>
    <main class="pcm-content pcm-op-content">
      <section class="pcm-op-actions"><div><strong>Semana de <%= formatDate(programacao.semana_inicio) %> a <%= formatDate(programacao.semana_fim) %></strong><span><%= (programacao.itens || []).length %> OS programada(s)</span></div><div class="pcm-op-actions-buttons"><a class="pcm-op-btn" href="/pcm/programacao-semanal?semana_inicio=<%= previous.toISOString().slice(0,10) %>">Semana anterior</a><a class="pcm-op-btn" href="/pcm/programacao-semanal">Semana atual</a><a class="pcm-op-btn" href="/pcm/programacao-semanal?semana_inicio=<%= next.toISOString().slice(0,10) %>">Próxima semana</a></div></section>

      <section class="pcm-stat-grid"><div class="pcm-stat"><span>Programadas</span><strong><%= resumo.total %></strong><small>na semana</small></div><div class="pcm-stat info"><span>Horas previstas</span><strong><%= Number(resumo.horas||0).toLocaleString('pt-BR') %></strong><small>carga programada</small></div><div class="pcm-stat warn"><span>Sem responsável</span><strong><%= resumo.sem_responsavel %></strong><small>definir executor</small></div><div class="pcm-stat danger"><span>Fila pendente</span><strong><%= resumo.pendentes %></strong><small>OS sem programação</small></div></section>

      <section class="pcm-op-panel">
        <div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Calendário</span><h2>Agenda da equipe</h2><p>Cada cartão representa uma programação persistida no banco.</p></div></div>
        <div class="pcm-week-grid">
          <% (programacao.dias || []).forEach(function(day,index){ %>
            <div class="pcm-week-day"><header><strong><%= weekdays[index] %></strong><span><%= formatDate(day) %></span></header><div class="pcm-week-items">
              <% if (!(byDay.get(day) || []).length) { %><div class="pcm-week-empty">Sem programação</div><% } %>
              <% (byDay.get(day) || []).forEach(function(item){ %><a class="pcm-week-item" href="/os/<%= item.os_id %>"><span><b>OS #<%= item.os_id %></b><i class="pcm-op-badge priority-<%= String(item.prioridade||'MEDIA').toLowerCase() %>"><%= item.prioridade %></i></span><strong><%= item.equipamento %></strong><small><%= item.responsavel %> · <%= Number(item.horas_estimadas||0).toLocaleString('pt-BR') %> h</small></a><% }) %>
            </div></div>
          <% }) %>
        </div>
      </section>

      <section class="pcm-op-panel">
        <div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Fila sem programação</span><h2>OS que ainda precisam entrar na agenda</h2><p>Escolha data, responsável e duração. Reprogramar a mesma OS substitui a programação anterior.</p></div></div>
        <div class="pcm-op-table-wrap"><table class="pcm-op-table pcm-schedule-table"><thead><tr><th>OS / Equipamento</th><th>Prioridade</th><th>Status</th><th>Data</th><th>Responsável</th><th>Horas</th><th>Ação</th></tr></thead><tbody>
          <% if (!atividadesSemProgramacao.length) { %><tr><td colspan="7" class="pcm-op-empty">Todo o backlog exibido já está programado nesta semana.</td></tr><% } %>
          <% atividadesSemProgramacao.forEach(function(item){ %><tr><td><strong>OS #<%= item.id %></strong><span><%= item.equipamento %> · <%= item.tipo %></span></td><td><span class="pcm-op-badge priority-<%= String(item.prioridade||'MEDIA').toLowerCase() %>"><%= item.prioridade %></span></td><td><span class="pcm-op-badge status"><%= item.status %></span></td><td colspan="4"><% if (canManagePcm) { %><form class="pcm-schedule-form" method="POST" action="/pcm/programacao-semanal/<%= item.id %>/programar" data-pcm-loading><input type="hidden" name="semana_inicio" value="<%= programacao.semana_inicio %>"><input name="data_programada" type="date" min="<%= programacao.semana_inicio %>" max="<%= programacao.semana_fim %>" required><select name="responsavel_user_id"><option value="">Não atribuído</option><% (programacao.mecanicos || []).forEach(function(person){ %><option value="<%= person.id %>"><%= person.name %></option><% }) %></select><input name="horas_estimadas" type="number" min="0.5" max="72" step="0.5" value="2" required><button class="pcm-op-btn pcm-op-btn-small" type="submit">Programar</button></form><% } else { %><span class="pcm-readonly">Consulta</span><% } %></td></tr><% }) %>
        </tbody></table></div>
      </section>
    </main>
  </div>
</div>
<style>
.pcm-week-grid{display:grid;grid-template-columns:repeat(7,minmax(165px,1fr));gap:8px;overflow:auto}.pcm-week-day{min-height:230px;border:1px solid #dfe8e3;border-radius:13px;background:#f8fbf9;overflow:hidden}.pcm-week-day>header{display:flex;justify-content:space-between;gap:8px;padding:10px;background:#eef7f1;border-bottom:1px solid #dfe8e3}.pcm-week-day>header span{color:#68778a;font-size:11px}.pcm-week-items{display:grid;gap:7px;padding:8px}.pcm-week-empty{color:#869286;font-size:11px;text-align:center;padding:34px 4px}.pcm-week-item{display:grid;gap:5px;border:1px solid #cfdfd5;border-left:3px solid #159947;border-radius:9px;background:#fff;padding:8px;text-decoration:none;color:#122033}.pcm-week-item>span{display:flex;justify-content:space-between;gap:5px}.pcm-week-item small{color:#68778a}.pcm-week-item:hover{border-color:#159947}.pcm-schedule-form{display:grid;grid-template-columns:145px minmax(150px,1fr) 78px auto;gap:7px}.pcm-schedule-form input,.pcm-schedule-form select{min-height:35px;border:1px solid #cfdbd5;border-radius:8px;background:#fff;padding:0 8px;font:inherit;font-size:12px}@media(max-width:900px){.pcm-week-grid{grid-template-columns:repeat(7,190px)}.pcm-schedule-form{grid-template-columns:1fr 1fr}.pcm-schedule-form button{width:100%}}
</style>
<script src="/js/pcm-operational.js" defer></script>
