<link rel="stylesheet" href="/css/pcm-operational.css">
<style>
  .pcm-module-page{display:grid;gap:16px}.pcm-module-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:22px;border:1px solid #dce8e0;border-radius:18px;background:linear-gradient(135deg,#fff,#f1faf4)}
  .pcm-module-head h1{margin:4px 0;color:#10233e;font-size:clamp(25px,3vw,38px);line-height:1.05}.pcm-module-head p{margin:0;color:#68778a}.pcm-module-actions,.pcm-inline-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}.pcm-section-label{color:#11813d;font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .pcm-shell{display:grid;grid-template-columns:220px minmax(0,1fr);gap:14px;align-items:start}.pcm-module-content{display:grid;gap:14px;min-width:0}.pcm-card{border:1px solid #dce8e0;border-radius:16px;background:#fff;padding:16px;box-shadow:0 10px 28px rgba(19,73,42,.055)}.pcm-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px}.pcm-card h2{margin:2px 0 0;color:#14243a;font-size:19px}.pcm-card p{margin:4px 0 0;color:#708092}
  .pcm-stat-grid{display:grid;grid-template-columns:repeat(4,minmax(140px,1fr));gap:10px}.pcm-stat{position:relative;overflow:hidden;border:1px solid #dce8e0;border-radius:14px;background:#fff;padding:14px}.pcm-stat:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:#159947}.pcm-stat.warn:before{background:#e5a50a}.pcm-stat.danger:before{background:#dc4b4b}.pcm-stat.info:before{background:#2788ca}.pcm-stat span{display:block;color:#66768a;font-size:11px;font-weight:850;text-transform:uppercase}.pcm-stat strong{display:block;margin-top:6px;color:#10233e;font-size:27px}.pcm-stat small{color:#839084}
  .pcm-filter,.pcm-form{display:grid;gap:10px}.pcm-filter{grid-template-columns:repeat(4,minmax(150px,1fr)) auto;align-items:end}.pcm-form-grid{display:grid;grid-template-columns:repeat(4,minmax(145px,1fr));gap:10px}.pcm-field{display:grid;gap:5px;color:#526174;font-size:12px;font-weight:750}.pcm-input{width:100%;min-height:42px;border:1px solid #cad9d0;border-radius:10px;background:#fff;padding:9px 11px;color:#17263b;font:inherit;outline:0}.pcm-input:focus{border-color:#159947;box-shadow:0 0 0 3px rgba(21,153,71,.11)}textarea.pcm-input{min-height:88px;resize:vertical}.pcm-span-2{grid-column:span 2}.pcm-span-3{grid-column:span 3}.pcm-span-4{grid-column:1/-1}
  .pcm-button{min-height:40px;border:1px solid #c9d8d0;border-radius:10px;background:#fff;color:#126d35;padding:9px 13px;font:inherit;font-weight:850;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px}.pcm-button:hover{border-color:#159947;background:#f2faf5}.pcm-button.primary{background:#149545;border-color:#149545;color:#fff}.pcm-button.danger{color:#a83434;border-color:#efc5c5}.pcm-button.small{min-height:33px;padding:6px 10px;font-size:12px}
  .pcm-table-wrap{width:100%;overflow:auto;border:1px solid #e0e9e3;border-radius:12px}.pcm-table{width:100%;min-width:760px;border-collapse:collapse}.pcm-table th,.pcm-table td{padding:11px 12px;border-bottom:1px solid #e8eee9;text-align:left;vertical-align:top}.pcm-table th{background:#f6faf7;color:#647387;font-size:11px;text-transform:uppercase}.pcm-table td{color:#25354b;font-size:13px}.pcm-table tr:last-child td{border-bottom:0}.pcm-table td small{display:block;margin-top:3px;color:#7b8897}.pcm-empty-row{text-align:center!important;color:#7e8c82!important;padding:28px!important}
  .pcm-badge{display:inline-flex;align-items:center;border-radius:999px;background:#edf6f0;color:#16743a;padding:4px 8px;font-size:10px;font-weight:900;text-transform:uppercase}.pcm-badge.warn{background:#fff4d9;color:#9c6900}.pcm-badge.danger{background:#fee9e8;color:#b33b37}.pcm-badge.info{background:#e6f3fb;color:#176b9d}.pcm-readonly{display:inline-flex;border:1px solid #bddbc8;border-radius:999px;background:#eef8f1;color:#176f38;padding:7px 10px;font-size:12px;font-weight:850}.pcm-note{border:1px solid #dbe6df;border-left:4px solid #159947;border-radius:10px;background:#f7fbf8;padding:11px;color:#536473;font-size:13px}.pcm-note.warn{border-left-color:#e3a008;background:#fffaf0}.pcm-empty-state{text-align:center;border:1px dashed #cbd9d0;border-radius:12px;padding:24px;color:#758378}.pcm-split{display:grid;grid-template-columns:1fr 1fr;gap:14px}.pcm-list{margin:8px 0 0;padding-left:18px;color:#526174}.pcm-list li+li{margin-top:6px}details.pcm-card>summary{cursor:pointer;color:#126f37;font-weight:900;list-style:none}details.pcm-card>summary::-webkit-details-marker{display:none}details.pcm-card[open]>summary{margin-bottom:14px}
  @media(max-width:1200px){.pcm-stat-grid{grid-template-columns:repeat(2,1fr)}.pcm-form-grid{grid-template-columns:repeat(2,1fr)}.pcm-span-3,.pcm-span-4{grid-column:1/-1}.pcm-filter{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:850px){.pcm-module-head{display:grid}.pcm-module-actions{justify-content:flex-start}.pcm-shell{grid-template-columns:1fr}.pcm-split{grid-template-columns:1fr}}
  @media(max-width:560px){.pcm-stat-grid,.pcm-form-grid,.pcm-filter{grid-template-columns:1fr}.pcm-span-2,.pcm-span-3,.pcm-span-4{grid-column:auto}.pcm-button{width:100%}}
</style>
