<% layout('layout') %>
<%- include('partials/internal-styles') %>
<% const d=relatorio||{cards:{},graficos:{},tabelas:{ordens:[]}}; const qp=new URLSearchParams(d.filtros||{}).toString(); %>
<div class="pcm-module-page">
  <header class="pcm-module-head"><div><span class="pcm-section-label">Análise e exportação</span><h1>Relatórios e indicadores</h1><p>Visões analíticas do histórico real, prontas para consulta, PDF e planilha.</p></div><div class="pcm-module-actions"><a class="pcm-button" href="/pcm/relatorios-avancados/pdf?<%= qp %>">Baixar PDF</a><a class="pcm-button" href="/pcm/relatorios-avancados/excel?<%= qp %>">Baixar Excel</a></div></header>
  <div class="pcm-shell"><%- include('partials/internal-nav', { activePcmSection }) %><main class="pcm-module-content">
    <section class="pcm-card"><form class="pcm-filter" method="GET" action="/pcm/relatorios-avancados"><label class="pcm-field">Data inicial<input class="pcm-input" type="date" name="data_inicial" value="<%= d.filtros.data_inicial||'' %>"></label><label class="pcm-field">Data final<input class="pcm-input" type="date" name="data_final" value="<%= d.filtros.data_final||'' %>"></label><label class="pcm-field">Setor<select class="pcm-input" name="setor"><option value="">Todos</option><% opcoes.setores.forEach(function(s){ %><option value="<%= s.setor %>" <%= d.filtros.setor===s.setor?'selected':'' %>><%= s.setor %></option><% }) %></select></label><label class="pcm-field">Equipamento<select class="pcm-input" name="equipamento_id"><option value="">Todos</option><% opcoes.equipamentos.forEach(function(e){ %><option value="<%= e.id %>" <%= String(d.filtros.equipamento_id)===String(e.id)?'selected':'' %>><%= e.nome %></option><% }) %></select></label><button class="pcm-button primary">Atualizar análise</button></form></section>
    <section class="pcm-stat-grid"><div class="pcm-stat"><span>OS no período</span><strong><%= d.cards.total_os||0 %></strong><small>registros filtrados</small></div><div class="pcm-stat danger"><span>Corretivas</span><strong><%= d.cards.corretivas||0 %></strong><small><%= d.cards.percentual_corretiva||0 %>% do total</small></div><div class="pcm-stat info"><span>Preventivas</span><strong><%= d.cards.preventivas||0 %></strong><small><%= d.cards.percentual_preventiva||0 %>% do total</small></div><div class="pcm-stat warn"><span>Atrasadas</span><strong><%= d.cards.os_atrasadas||0 %></strong><small>fora do SLA interno</small></div></section>
    <section class="pcm-split"><article class="pcm-card"><span class="pcm-section-label">Tendência</span><h2>Ordens por mês</h2><div style="height:280px"><canvas id="relatorioMes"></canvas></div></article><article class="pcm-card"><span class="pcm-section-label">Composição</span><h2>Tipos de manutenção</h2><div style="height:280px"><canvas id="relatorioTipos"></canvas></div></article></section>
    <section class="pcm-card"><div class="pcm-card-head"><div><span class="pcm-section-label">Ranking de confiabilidade</span><h2>Equipamentos com maior incidência de falhas</h2></div></div><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>Posição</th><th>Equipamento</th><th>Setor</th><th>Falhas</th><th>Críticas</th><th>Média entre falhas</th><th>Última ocorrência</th></tr></thead><tbody><% const ranking=d.graficos.falhas_equipamento||[]; if(!ranking.length){ %><tr><td colspan="7" class="pcm-empty-row">Sem falhas corretivas no período.</td></tr><% } %><% ranking.forEach(function(item,i){ %><tr><td><%= i+1 %></td><td><strong><%= item.nome %></strong></td><td><%= item.setor||'-' %></td><td><%= item.falhas||0 %></td><td><%= item.falhas_criticas||0 %></td><td><%= item.media_dias_entre_falhas ?? 'Dados insuficientes' %></td><td><%= item.ultima_ocorrencia ? String(item.ultima_ocorrencia).slice(0,10) : '-' %></td></tr><% }) %></tbody></table></div></section>
  </main></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>(function(){if(typeof Chart==='undefined')return;const g=<%- JSON.stringify(d.graficos||{}) %>;const base={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#526174'}}},scales:{x:{ticks:{color:'#66768a'},grid:{color:'rgba(82,98,115,.1)'}},y:{beginAtZero:true,ticks:{color:'#66768a'},grid:{color:'rgba(82,98,115,.1)'}}}};const mes=g.os_mes||[];new Chart(document.getElementById('relatorioMes'),{type:'line',data:{labels:mes.map(x=>x.mes),datasets:[{label:'OS',data:mes.map(x=>x.total),borderColor:'#159947',backgroundColor:'rgba(21,153,71,.15)',fill:true,tension:.32}]},options:base});const tipos=g.tipos_manutencao||[];new Chart(document.getElementById('relatorioTipos'),{type:'doughnut',data:{labels:tipos.map(x=>x.tipo),datasets:[{data:tipos.map(x=>x.total),backgroundColor:['#159947','#2788ca','#e5a50a','#dc4b4b','#7d8b82']}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:'#526174'}}}}})})();</script>
