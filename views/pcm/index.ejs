<% layout('layout') %>
<%- include('partials/internal-styles') %>
<link rel="stylesheet" href="/css/pcm-operational.css">

<%
  const p = painel || { filtros: {}, cards: {}, fila: [], riscos: [], planos: [], alertas: [], distribuicao_status: [], preventivas: {}, analise_ia: null };
  const c = p.cards || {};
  const money = (value) => Number(value || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const date = (value) => value ? new Date(value).toLocaleDateString('pt-BR') : 'Sem data';
  const dateTime = (value) => value ? new Date(value).toLocaleString('pt-BR') : '-';
  const maxStatus = Math.max(1, ...(p.distribuicao_status || []).map((item) => Number(item.total || 0)));
  const ai = p.analise_ia || null;
%>

<div class="pcm-op-page">
  <header class="pcm-op-head">
    <div><span class="pcm-op-eyebrow">PCM operacional</span><h1>Planejamento e Controle da Manutenção</h1><p>Fila de trabalho, confiabilidade, preventivas, custos e decisões em uma única visão.</p></div>
    <div class="pcm-op-head-actions"><a class="pcm-op-btn" href="/pcm/dashboard-gerencial">Painel gerencial</a><a class="pcm-op-btn" href="/pcm/programacao-semanal">Programação semanal</a></div>
  </header>

  <div class="pcm-shell">
    <%- include('partials/internal-nav', { activePcmSection: (typeof activePcmSection !== 'undefined' ? activePcmSection : '') }) %>
    <main class="pcm-content pcm-op-content">
      <form class="pcm-op-filter" method="GET" action="/pcm" aria-label="Filtros do painel PCM">
        <label>Período<select name="periodo_dias"><% [7,30,90,180,365].forEach(function(days){ %><option value="<%= days %>" <%= Number(p.filtros.periodo_dias)===days ? 'selected' : '' %>><%= days===365 ? 'Últimos 12 meses' : `Últimos ${days} dias` %></option><% }) %></select></label>
        <label>Setor<select name="setor"><option value="">Todos os setores</option><% (opcoes?.setores || []).forEach(function(item){ %><option value="<%= item.setor %>" <%= p.filtros.setor===item.setor ? 'selected' : '' %>><%= item.setor %></option><% }) %></select></label>
        <label>Prioridade da fila<select name="prioridade"><option value="">Todas</option><% ['CRITICA','ALTA','MEDIA','BAIXA'].forEach(function(priority){ %><option value="<%= priority %>" <%= p.filtros.prioridade===priority ? 'selected' : '' %>><%= priority %></option><% }) %></select></label>
        <label>SLA interno<select name="sla_dias"><% [3,5,7,10,15,30].forEach(function(days){ %><option value="<%= days %>" <%= Number(p.filtros.sla_dias)===days ? 'selected' : '' %>><%= days %> dias</option><% }) %></select></label>
        <button class="pcm-op-btn pcm-op-btn-primary" type="submit">Aplicar filtros</button><a class="pcm-op-btn" href="/pcm">Limpar</a>
      </form>

      <% if (p.erro) { %><div class="pcm-op-notice pcm-op-notice-error"><%= p.erro %></div><% } %>

      <section class="pcm-op-actions" aria-label="Ações do PCM">
        <div><strong>Ciclo operacional</strong><span>Atualização sob comando, sem alterar dados ao apenas abrir a página.</span></div>
        <div class="pcm-op-actions-buttons">
          <form method="POST" action="/pcm/atualizar-indicadores" data-pcm-loading><input type="hidden" name="periodo_dias" value="<%= p.filtros.periodo_dias %>"><input type="hidden" name="setor" value="<%= p.filtros.setor || '' %>"><input type="hidden" name="prioridade" value="<%= p.filtros.prioridade || '' %>"><input type="hidden" name="sla_dias" value="<%= p.filtros.sla_dias %>"><button class="pcm-op-btn" type="submit">Atualizar indicadores</button></form>
          <form method="POST" action="/pcm/executar-automacao" data-pcm-confirm="Executar agora as regras automáticas de preventivas e risco?" data-pcm-loading><input type="hidden" name="periodo_dias" value="<%= p.filtros.periodo_dias %>"><input type="hidden" name="setor" value="<%= p.filtros.setor || '' %>"><input type="hidden" name="prioridade" value="<%= p.filtros.prioridade || '' %>"><input type="hidden" name="sla_dias" value="<%= p.filtros.sla_dias %>"><button class="pcm-op-btn" type="submit">Executar automação</button></form>
          <form method="POST" action="/pcm/analisar-ia" data-pcm-loading><input type="hidden" name="periodo_dias" value="<%= p.filtros.periodo_dias %>"><input type="hidden" name="setor" value="<%= p.filtros.setor || '' %>"><input type="hidden" name="prioridade" value="<%= p.filtros.prioridade || '' %>"><input type="hidden" name="sla_dias" value="<%= p.filtros.sla_dias %>"><button class="pcm-op-btn pcm-op-btn-ai" type="submit">Gerar análise com IA</button></form>
        </div>
      </section>

      <section class="pcm-op-kpis" aria-label="Indicadores principais">
        <a class="pcm-op-kpi tone-green" href="/pcm/backlog"><span>Backlog ativo</span><strong><%= c.backlog || 0 %></strong><small><%= c.abertas || 0 %> abertas · <%= c.andamento || 0 %> em andamento · <%= c.pausadas || 0 %> pausadas</small></a>
        <a class="pcm-op-kpi <%= Number(c.acima_sla||0)>0 ? 'tone-red' : 'tone-green' %>" href="/pcm/backlog?dias_atraso=<%= p.filtros.sla_dias %>"><span>Acima do SLA interno</span><strong><%= c.acima_sla || 0 %></strong><small>Mais de <%= p.filtros.sla_dias %> dias em aberto</small></a>
        <a class="pcm-op-kpi <%= Number(c.preventivas_vencidas||0)>0 ? 'tone-orange' : 'tone-blue' %>" href="/pcm/planejamento"><span>Preventivas</span><strong><%= c.preventivas_proximas || 0 %></strong><small>Próximas em 7 dias · <%= c.preventivas_vencidas || 0 %> vencidas</small></a>
        <a class="pcm-op-kpi tone-blue" href="/compras"><span>Dependências de materiais</span><strong><%= c.solicitacoes_pendentes || 0 %></strong><small><%= c.aguardando_material || 0 %> aguardando recebimento</small></a>
        <a class="pcm-op-kpi <%= Number(c.riscos_altos||0)>0 ? 'tone-red' : 'tone-green' %>" href="/pcm/criticidade"><span>Equipamentos em risco alto</span><strong><%= c.riscos_altos || 0 %></strong><small>Score por falhas, reincidência e preventivas</small></a>
        <div class="pcm-op-kpi tone-green"><span>Materiais recebidos</span><strong class="money"><%= money(c.custo_materiais_recebidos) %></strong><small><%= money(c.custo_materiais_comprometidos) %> comprometidos no período</small></div>
      </section>

      <section class="pcm-op-panel pcm-op-queue">
        <div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Prioridade de execução</span><h2>Fila de trabalho do PCM</h2><p>Somente OS ativas, ordenadas por prioridade, bloqueio e tempo em aberto.</p></div><a class="pcm-op-btn" href="/os">Ver todas as OS</a></div>
        <div class="pcm-op-table-wrap"><table class="pcm-op-table"><thead><tr><th>OS / Equipamento</th><th>Tipo</th><th>Prioridade</th><th>Status</th><th>Tempo em aberto</th><th>Responsável</th><th>Dependência</th><th>Ação</th></tr></thead><tbody>
          <% if (!(p.fila || []).length) { %><tr><td colspan="8" class="pcm-op-empty">Nenhuma OS ativa para os filtros selecionados.</td></tr><% } %>
          <% (p.fila || []).forEach(function(item){ %><tr class="<%= item.acima_sla ? 'is-overdue' : '' %>"><td><strong>OS #<%= item.id %></strong><span><%= item.equipamento %> · <%= item.setor %></span></td><td><span class="pcm-op-badge neutral"><%= item.tipo %></span></td><td><span class="pcm-op-badge priority-<%= String(item.prioridade||'MEDIA').toLowerCase() %>"><%= item.prioridade %></span></td><td><span class="pcm-op-badge status"><%= item.status %></span></td><td><strong><%= item.dias_aberta || 0 %> dia(s)</strong><span><%= item.acima_sla ? 'Acima do SLA' : 'Dentro do SLA' %></span></td><td><%= item.responsavel %></td><td><% if (item.possui_solicitacao) { %><span class="pcm-op-badge warning"><%= item.status_solicitacao || 'Solicitação ativa' %></span><% } else { %><span class="pcm-op-muted">Sem solicitação ativa</span><% } %></td><td><a class="pcm-op-btn pcm-op-btn-small" href="/os/<%= item.id %>">Abrir OS</a></td></tr><% }) %>
        </tbody></table></div>
      </section>

      <section class="pcm-op-grid pcm-op-grid-main">
        <article class="pcm-op-panel"><div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Confiabilidade</span><h2>Indicadores do período</h2></div><a class="pcm-op-link" href="/pcm/relatorios-avancados">Abrir relatório</a></div><div class="pcm-op-metrics"><div><span>MTBF</span><strong><%= c.mtbf_dias == null ? 'Dados insuficientes' : `${c.mtbf_dias} dias` %></strong><small><%= c.mtbf_amostras || 0 %> intervalo(s) válido(s)</small></div><div><span>MTTR</span><strong><%= c.mttr_horas == null ? 'Dados insuficientes' : `${c.mttr_horas} h` %></strong><small>Datas reais de início e conclusão</small></div><div><span>Preventiva</span><strong><%= c.preventiva_pct || 0 %>%</strong><small>Corretiva: <%= c.corretiva_pct || 0 %>%</small></div><div><span>Custo registrado em OS</span><strong><%= money(c.custo_os) %></strong><small>Sem estimar valores ausentes</small></div></div><div class="pcm-op-ratio"><span style="width:<%= c.preventiva_pct || 0 %>%"></span></div><div class="pcm-op-ratio-label"><span>Preventiva <%= c.preventiva_pct || 0 %>%</span><span>Corretiva <%= c.corretiva_pct || 0 %>%</span></div></article>
        <article class="pcm-op-panel pcm-op-ai"><div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Copiloto do PCM</span><h2>Análise para decisão humana</h2></div><% if (ai) { %><span class="pcm-op-badge <%= ai.origem==='OPENAI' ? 'success' : 'warning' %>"><%= ai.origem==='OPENAI' ? 'OpenAI' : 'Análise local' %></span><% } %></div><% if (!ai) { %><div class="pcm-op-empty-state"><strong>Nenhuma análise gerada para estes filtros.</strong><span>Clique em “Gerar análise com IA”. Se a API estiver indisponível, o sistema entrega uma análise local baseada em regras.</span></div><% } else { %><p class="pcm-op-ai-summary"><%= ai.resumo %></p><div class="pcm-op-ai-list"><% (ai.prioridades || []).forEach(function(item){ %><div><span class="pcm-op-badge priority-<%= String(item.nivel||'MEDIA').toLowerCase() %>"><%= item.nivel %></span><strong><%= item.titulo %></strong><p><%= item.motivo %></p><small>Ação sugerida: <%= item.acao %></small></div><% }) %></div><small class="pcm-op-muted">Gerada em <%= dateTime(ai.created_at) %>. Recomendações não executam alterações automaticamente.</small><% } %></article>
      </section>

      <section class="pcm-op-grid pcm-op-grid-three">
        <article class="pcm-op-panel"><div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Distribuição</span><h2>Status das OS</h2></div></div><div class="pcm-op-bars"><% if (!(p.distribuicao_status || []).length) { %><div class="pcm-op-empty">Sem OS no período.</div><% } %><% (p.distribuicao_status || []).forEach(function(item){ %><div><span><%= item.status %></span><div><i style="width:<%= Math.max(3, Number(item.total||0)*100/maxStatus) %>%"></i></div><strong><%= item.total %></strong></div><% }) %></div></article>
        <article class="pcm-op-panel"><div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Ativos</span><h2>Maior risco operacional</h2></div><a class="pcm-op-link" href="/pcm/criticidade">Ver criticidade</a></div><div class="pcm-op-risk-list"><% if (!(p.riscos || []).length) { %><div class="pcm-op-empty">Atualize os indicadores para calcular os scores.</div><% } %><% (p.riscos || []).slice(0,6).forEach(function(item){ %><a href="/equipamentos/<%= item.equipamento_id %>"><span><strong><%= item.equipamento %></strong><small><%= item.setor || 'Setor não informado' %> · <%= item.falhas_180d || 0 %> falhas/180d</small></span><b><%= item.score_risco %></b></a><% }) %></div></article>
        <article class="pcm-op-panel"><div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Plano mestre</span><h2>Próximas atividades</h2></div><a class="pcm-op-link" href="/pcm/planejamento">Abrir planejamento</a></div><div class="pcm-op-plan-list"><% if (!(p.planos || []).length) { %><div class="pcm-op-empty">Nenhum plano mestre ativo.</div><% } %><% (p.planos || []).slice(0,6).forEach(function(item){ %><div><span class="pcm-op-plan-date <%= String(item.situacao||'').toLowerCase() %>"><%= date(item.proxima_data_prevista) %></span><span><strong><%= item.equipamento %></strong><small><%= item.atividade_descricao %></small></span></div><% }) %></div></article>
      </section>

      <section class="pcm-op-panel"><div class="pcm-op-panel-head"><div><span class="pcm-op-section-label">Exceções</span><h2>Alertas operacionais não lidos</h2><p>Alertas gerados por regras rastreáveis; não são classificados como resultado da IA.</p></div><a class="pcm-op-btn" href="/pcm/backlog">Tratar no backlog</a></div><div class="pcm-op-alert-list"><% if (!(p.alertas || []).length) { %><div class="pcm-op-empty-state compact"><strong>Nenhum alerta operacional pendente.</strong><span>O painel permanece monitorando as regras cadastradas.</span></div><% } %><% (p.alertas || []).forEach(function(item){ %><div><span class="pcm-op-badge priority-<%= String(item.severidade||'MEDIA').toLowerCase() %>"><%= item.severidade %></span><span><strong><%= item.tipo %></strong><small><%= item.mensagem %></small></span><time><%= dateTime(item.created_at) %></time><% if (item.entidade_tipo==='OS' && item.entidade_id) { %><a class="pcm-op-btn pcm-op-btn-small" href="/os/<%= item.entidade_id %>">Abrir OS</a><% } %></div><% }) %></div></section>
      <footer class="pcm-op-footer">Dados calculados diretamente dos registros do sistema · Atualizado em <%= dateTime(p.atualizado_em) %></footer>
    </main>
  </div>
</div>
<script src="/js/pcm-operational.js" defer></script>
