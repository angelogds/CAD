<% layout('layout') %><%- include('partials/internal-styles') %>
<div class="page-head"><div><h1>Configurar dashboard</h1><p class="muted">Preferências individuais do Dashboard Gerencial da Manutenção.</p></div></div>
<div class="pcm-shell"><%- include('partials/internal-nav', { activePcmSection: 'dashboard-gerencial' }) %><div class="pcm-content"><form class="card" method="POST" action="/pcm/dashboard-gerencial/configurar"><div class="grid-3"><label>Período padrão<select class="input" name="periodo_padrao"><% ['mes_atual','mes_anterior','ultimos_3_meses','ultimos_6_meses','ultimos_12_meses'].forEach(function(p){ %><option value="<%= p %>" <%= prefs.periodo_padrao===p?'selected':'' %>><%= p %></option><% }) %></select></label><label>Falhas no período<input class="input" type="number" name="falhas_periodo" value="<%= prefs.limites.falhas_periodo || 3 %>"></label><label>Horas acumuladas de parada<input class="input" type="number" name="horas_parada" value="<%= prefs.limites.horas_parada || 24 %>"></label></div><h3>Cards</h3><div class="grid-4"><% cardsDisponiveis.forEach(function(c){ %><label><input type="checkbox" name="cards" value="<%= c %>" <%= prefs.cards.includes(c)?'checked':'' %>> <%= c %></label><% }) %></div><h3>Gráficos</h3><div class="grid-3"><% graficosDisponiveis.forEach(function(g){ %><label><input type="checkbox" name="graficos" value="<%= g %>" <%= prefs.graficos.includes(g)?'checked':'' %>> <%= g %></label><% }) %></div><div class="pcm-actions" style="margin-top:14px"><button class="btn" type="submit">Salvar preferências</button><a class="btn btn-outline" href="/pcm/dashboard-gerencial">Voltar</a></div></form><form method="POST" action="/pcm/dashboard-gerencial/configurar/restaurar" style="margin-top:10px"><button class="btn btn-outline" type="submit">Restaurar configuração padrão</button></form></div></div>
