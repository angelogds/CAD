<% layout('layout') %>
<%- include('partials/internal-styles') %>
<link rel="stylesheet" href="/css/pcm-lubrificacao-v7.css?v=20260928-2">
<div class="pcm-module-page">
  <header class="pcm-module-head">
    <div>
      <span class="pcm-section-label">Administração e logística</span>
      <h1>Plano de lubrificação</h1>
      <p>O PCM monta, valida e distribui o roteiro. Pontos automáticos entram como rascunho e só chegam ao mecânico depois da validação técnica.</p>
    </div>
    <div class="pcm-module-actions">
      <% if (canManagePcm) { %>
        <form method="POST" action="/pcm/lubrificacao/gerar-roteiro-base">
          <button class="pcm-button primary ui-btn ui-btn--primary" type="submit">Gerar / atualizar roteiro-base</button>
        </form>
      <% } %>
      <a class="pcm-button ui-btn ui-btn--outline" href="/pcm/lubrificacao/pdf?<%= new URLSearchParams(filtros).toString() %>">PDF do plano</a>
      <a class="pcm-button ui-btn ui-btn--outline" href="/pcm/planejamento">Plano mestre</a>
    </div>
  </header>

  <div class="pcm-shell">
    <%- include('partials/internal-nav', { activePcmSection }) %>
    <main class="pcm-module-content">
      <section class="pcm-stat-grid">
        <div class="pcm-stat"><span>Pontos ativos</span><strong><%= resumo.pontos %></strong><small>plano completo</small></div>
        <div class="pcm-stat warn"><span>Pendentes de validação</span><strong><%= resumo.pendentes_validacao %></strong><small>não aparecem ao mecânico</small></div>
        <div class="pcm-stat info"><span>Liberados</span><strong><%= resumo.liberados %></strong><small>prontos para distribuição</small></div>
        <div class="pcm-stat"><span>Cobertura</span><strong><%= resumo.cobertura %>%</strong><small>equipamentos com plano</small></div>
      </section>

      <section class="pcm-card">
        <div class="pcm-card-head">
          <div>
            <span class="pcm-section-label">Responsável semanal</span>
            <h2>Roteiro de lubrificação da semana</h2>
            <p>O mecânico selecionado assume o roteiro completo da semana. Moinhos e exaustores das caldeiras geram OS automática somente nos dias programados.</p>
          </div>
          <% if (semanaLubrificacao?.responsavel_nome) { %>
            <span class="pcm-badge"><%= semanaLubrificacao.responsavel_nome %></span>
          <% } else { %>
            <span class="pcm-badge danger">SEM RESPONSÁVEL</span>
          <% } %>
        </div>

        <div class="pcm-split">
          <form method="POST" action="/pcm/lubrificacao/semana/responsavel" class="pcm-form">
            <label class="pcm-field">Semana de referência
              <input class="pcm-input" type="date" name="semana_referencia" value="<%= semanaReferencia.inicio %>" required>
            </label>
            <label class="pcm-field">Mecânico responsável
              <select class="pcm-input" name="responsavel_user_id" required>
                <option value="">Selecione</option>
                <% mecanicos.forEach(function(m){ %>
                  <option value="<%= m.id %>" <%= String(semanaLubrificacao?.responsavel_user_id||'')===String(m.id)?'selected':'' %>><%= m.nome %></option>
                <% }) %>
              </select>
            </label>
            <button class="pcm-button primary ui-btn ui-btn--primary" type="submit">Definir responsável da semana</button>
          </form>

          <div class="pcm-form">
            <div class="pcm-note <%= resumoSemanaLubrificacao.sem_responsavel ? 'warn' : '' %>">
              <strong>Semana:</strong> <%= semanaReferencia.inicio %> a <%= semanaReferencia.fim %><br>
              <strong>Responsável:</strong> <%= resumoSemanaLubrificacao.responsavel_nome || 'Não definido' %><br>
              <strong>Execuções na semana:</strong> <%= resumoSemanaLubrificacao.executados_semana %><br>
              <strong>Atrasados:</strong> <%= resumoSemanaLubrificacao.atrasados %><br>
              <strong>OS automáticas hoje:</strong> <%= resumoSemanaLubrificacao.os_hoje %>
            </div>
            <% if (canManagePcm) { %>
              <form method="POST" action="/pcm/lubrificacao/semana/gerar-os-hoje">
                <input type="hidden" name="data_referencia" value="<%= semanaReferencia.referencia %>">
                <button class="pcm-button ui-btn ui-btn--outline" type="submit">Gerar / conferir OS de hoje</button>
              </form>
            <% } %>
          </div>
        </div>
      </section>

      <section class="pcm-card lub-monitor" data-lub-monitor data-url="/pcm/lubrificacao/acompanhamento?semana=<%= encodeURIComponent(semanaReferencia.inicio) %>">
        <div class="pcm-card-head">
          <div>
            <span class="pcm-section-label">Acompanhamento PCM</span>
            <h2>Andamento do roteiro de lubrificação</h2>
            <p>Visão do PCM baseada nas execuções que o mecânico fecha no roteiro. O setor exibido representa a <strong>última atividade registrada</strong>, não localização por GPS.</p>
          </div>
          <span class="pcm-badge <%= acompanhamentoLubrificacao.percentual>=100?'':'warn' %>" data-lub-status>
            <%= acompanhamentoLubrificacao.percentual>=100?'ROTEIRO CONCLUÍDO':(acompanhamentoLubrificacao.pontos_concluidos>0?'EM ANDAMENTO':'NÃO INICIADO') %>
          </span>
        </div>

        <div class="lub-overview">
          <div class="lub-progress-card">
            <div class="lub-progress-number"><strong data-lub-percent><%= acompanhamentoLubrificacao.percentual %>%</strong><span>pontos visitados na semana</span></div>
            <div class="lub-route-track" aria-label="Progresso do roteiro: <%= acompanhamentoLubrificacao.percentual %>%">
              <div class="lub-route-fill" data-lub-fill style="width:<%= acompanhamentoLubrificacao.percentual %>%"></div>
              <span class="lub-walker" data-lub-walker style="left:<%= Math.max(2,Math.min(98,acompanhamentoLubrificacao.percentual)) %>%" aria-hidden="true">🧑‍🔧</span>
            </div>
            <div class="lub-progress-meta">
              <span><strong data-lub-done><%= acompanhamentoLubrificacao.pontos_concluidos %></strong> concluídos</span>
              <span><strong data-lub-pending><%= acompanhamentoLubrificacao.pontos_pendentes %></strong> faltam</span>
              <span><strong data-lub-events><%= acompanhamentoLubrificacao.execucoes_semana %></strong> execuções registradas</span>
            </div>
          </div>

          <div class="lub-current-card">
            <span>Última atividade registrada</span>
            <strong data-lub-current-eq><%= acompanhamentoLubrificacao.ultima_atividade?.equipamento_nome || 'Roteiro ainda não iniciado' %></strong>
            <small data-lub-current-location>
              <% if (acompanhamentoLubrificacao.ultima_atividade) { %>
                <%= acompanhamentoLubrificacao.ultima_atividade.area_operacional_label %> • <%= acompanhamentoLubrificacao.ultima_atividade.setor || 'Setor não informado' %>
              <% } else { %>
                Aguardando primeira execução da semana
              <% } %>
            </small>
            <small data-lub-current-user><%= acompanhamentoLubrificacao.ultima_atividade?.executor_nome || acompanhamentoLubrificacao.responsavel_nome || 'Responsável não definido' %></small>
          </div>
        </div>

        <div class="lub-area-grid" data-lub-areas>
          <% acompanhamentoLubrificacao.areas.forEach(function(area){ %>
            <article class="lub-area-card">
              <span><%= area.label %></span>
              <strong><%= area.percentual %>%</strong>
              <div class="lub-mini-track"><i style="width:<%= area.percentual %>%"></i></div>
              <small><%= area.pontos_concluidos %>/<%= area.total_pontos %> pontos • <%= area.equipamentos %> equipamento(s)</small>
            </article>
          <% }) %>
          <% if (!acompanhamentoLubrificacao.areas.length) { %>
            <div class="pcm-empty-row">Ainda não há pontos ativos e validados para acompanhar.</div>
          <% } %>
        </div>

        <div class="pcm-table-wrap lub-equipment-scroll">
          <table class="pcm-table lub-progress-table">
            <thead><tr><th>Área / equipamento</th><th>Setor</th><th>Pontos</th><th>Andamento</th><th>Última execução</th></tr></thead>
            <tbody data-lub-equipment-body>
              <% acompanhamentoLubrificacao.equipamentos.forEach(function(item){ %>
                <tr class="lub-row-<%= item.status.toLowerCase() %>">
                  <td><strong><%= item.area_operacional_label %></strong><small><%= item.equipamento_nome %></small></td>
                  <td><%= item.setor || 'Não informado' %></td>
                  <td><%= item.pontos_concluidos %>/<%= item.total_pontos %></td>
                  <td><span class="lub-state <%= item.status.toLowerCase() %>"><%= item.status==='CONCLUIDO'?'Concluído':(item.status==='ANDAMENTO'?'Em andamento':'Pendente') %></span><small><%= item.percentual %>%</small></td>
                  <td><%= item.ultima_execucao || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="lub-monitor-foot">Atualização automática a cada 45 segundos. O painel não altera OS, plano ou execução.</div>
      </section>

      <section class="pcm-card">
        <div class="pcm-card-head">
          <div>
            <span class="pcm-section-label">Regra de segurança</span>
            <h2>Como o roteiro-base funciona</h2>
          </div>
        </div>
        <div class="pcm-note warn">
          O sistema identifica a família do equipamento e cria somente os <strong>pontos prováveis</strong>.
          Lubrificante, quantidade e frequência não são inventados: devem ser confirmados pelo PCM usando placa, manual,
          condição real do equipamento e padrão adotado pela manutenção. Só depois de validar e distribuir o ponto ele aparece em <strong>Roteiro de Lubrificação</strong> para o mecânico.
        </div>
      </section>

      <section class="pcm-card">
        <form method="GET" action="/pcm/lubrificacao" class="pcm-filter">
          <label class="pcm-field">Equipamento
            <select class="pcm-input" id="equipamento-filtro" name="equipamento_id">
              <option value="">Todos</option>
              <% equipamentos.forEach(function(eq){ %>
                <option value="<%= eq.id %>" data-setor="<%= eq.setor || '' %>" <%= String(filtros.equipamento_id)===String(eq.id)?'selected':'' %>><%= eq.nome %></option>
              <% }) %>
            </select>
          </label>
          <label class="pcm-field">Setor
            <input class="pcm-input" id="setor-filtro" name="setor" value="<%= filtros.setor %>" placeholder="Todos os setores">
          </label>
          <label class="pcm-field">Validação
            <select class="pcm-input" name="validacao">
              <option value="">Todos</option>
              <option value="PENDENTE" <%= filtros.validacao==='PENDENTE'?'selected':'' %>>Pendentes</option>
              <option value="VALIDADO" <%= filtros.validacao==='VALIDADO'?'selected':'' %>>Validados</option>
            </select>
          </label>
          <label class="pcm-field">Rota
            <select class="pcm-input" name="rota">
              <option value="">Todas</option>
              <% rotas.forEach(function(r){ %>
                <option value="<%= r.rota %>" <%= String(filtros.rota)===String(r.rota)?'selected':'' %>><%= r.rota %></option>
              <% }) %>
            </select>
          </label>
          <label class="pcm-field">Área operacional
            <select class="pcm-input" name="area">
              <option value="">Todas</option>
              <% areasLubrificacao.forEach(function(a){ %>
                <option value="<%= a.codigo %>" <%= String(filtros.area)===String(a.codigo)?'selected':'' %>><%= a.label %> (<%= a.equipamentos %>)</option>
              <% }) %>
            </select>
          </label>
          <label class="pcm-field">Situação do ponto
            <select class="pcm-input" name="ativos">
              <option value="1" <%= String(filtros.ativos)!=='0' && String(filtros.ativos).toUpperCase()!=='TODOS'?'selected':'' %>>Ativos</option>
              <option value="0" <%= String(filtros.ativos)==='0'?'selected':'' %>>Inativos</option>
              <option value="TODOS" <%= String(filtros.ativos).toUpperCase()==='TODOS'?'selected':'' %>>Todos</option>
            </select>
          </label>
          <button class="pcm-button primary ui-btn ui-btn--primary">Aplicar filtros</button>
          <a class="pcm-button ui-btn ui-btn--outline" href="/pcm/lubrificacao">Limpar</a>
        </form>
      </section>

      <% if (rotas.length) { %>
        <section class="pcm-card">
          <div class="pcm-card-head"><div><span class="pcm-section-label">Rotas planejadas</span><h2>Distribuição do roteiro</h2></div></div>
          <div class="pcm-stat-grid">
            <% rotas.forEach(function(r){ %>
              <a class="pcm-stat" href="/pcm/lubrificacao?rota=<%= encodeURIComponent(r.rota) %>">
                <span><%= r.rota %></span>
                <strong><%= r.pontos %></strong>
                <small><%= r.equipamentos %> equipamento(s) • <%= r.pendentes %> pendente(s)</small>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (canManagePcm && filtros.equipamento_id) { %>
        <section class="pcm-split">
          <details class="pcm-card">
            <summary>+ Cadastrar ponto manualmente</summary>
            <form method="POST" action="/pcm/lubrificacao/pontos" class="pcm-form">
              <input type="hidden" name="equipamento_id" value="<%= filtros.equipamento_id %>">
              <input class="pcm-input" name="ponto_lubrificacao" placeholder="Ponto de lubrificação" required>
              <input class="pcm-input" name="tipo_lubrificante_texto" placeholder="Lubrificante / especificação validada" required>
              <div class="pcm-split">
                <input class="pcm-input" type="number" step="0.01" min="0" name="quantidade" placeholder="Quantidade">
                <input class="pcm-input" name="unidade" placeholder="g, ml, L">
              </div>
              <select class="pcm-input" name="metodo_aplicacao">
                <option value="">Método de aplicação</option>
                <option>Engraxar</option><option>Verificar / completar nível</option><option>Troca de óleo</option><option>Pulverizar</option><option>Outro</option>
              </select>
              <select class="pcm-input" name="responsavel_user_id">
                <option value="">Não distribuir agora</option>
                <% mecanicos.forEach(function(m){ %><option value="<%= m.id %>"><%= m.nome %></option><% }) %>
              </select>
              <input class="pcm-input" name="rota_lubrificacao" placeholder="Rota" value="Rota manual - PCM">
              <input class="pcm-input" type="number" min="1" name="frequencia_dias" placeholder="Frequência em dias" required>
              <textarea class="pcm-input" name="instrucoes_execucao" rows="3" placeholder="Instrução operacional para o mecânico"></textarea>
              <input class="pcm-input" name="observacao" placeholder="Observações do PCM">
              <button class="pcm-button primary ui-btn ui-btn--primary">Salvar ponto validado</button>
            </form>
          </details>

          <article class="pcm-card">
            <span class="pcm-section-label">Assistente técnico opcional</span>
            <h2>Rascunho assistido</h2>
            <p>A sugestão é apenas apoio. Manual do fabricante, placa e condição real do equipamento prevalecem.</p>
            <form method="POST" action="/pcm/lubrificacao/sugerir-ia">
              <input type="hidden" name="equipamento_id" value="<%= filtros.equipamento_id %>">
              <button class="pcm-button ui-btn ui-btn--outline" type="submit">Gerar rascunho assistido</button>
            </form>
          </article>
        </section>
      <% } %>

      <% if (sugestaoIA && sugestaoIA.plano?.length) { %>
        <section class="pcm-card">
          <div class="pcm-card-head"><div><span class="pcm-section-label">Rascunho <%= sugestaoIA.origem === 'OPENAI' ? 'OpenAI' : 'local' %></span><h2><%= sugestaoIA.equipamento_nome %></h2><p><%= sugestaoIA.alerta || sugestaoIA.aviso || 'Revise todos os valores antes de cadastrar.' %></p></div></div>
          <ul class="pcm-list"><% sugestaoIA.plano.forEach(function(p){ %><li><strong><%= p.ponto_lubrificacao %></strong> — <%= p.tipo_lubrificante_texto %>; <%= p.quantidade %> <%= p.unidade %>; a cada <%= p.frequencia_dias %> dias.</li><% }) %></ul>
          <% if (canManagePcm) { %>
            <form method="POST" action="/pcm/lubrificacao/aplicar-sugestao-ia" class="pcm-form" style="margin-top:14px">
              <input type="hidden" name="equipamento_id" value="<%= sugestaoIA.equipamento_id || filtros.equipamento_id %>">
              <label class="pcm-note warn"><input type="checkbox" name="confirmacao_tecnica" value="1" required> Confirmo que conferi manual, pontos, produto, quantidade e frequência.</label>
              <button class="pcm-button primary ui-btn ui-btn--primary">Cadastrar pontos revisados</button>
            </form>
          <% } %>
        </section>
      <% } %>

      <section class="pcm-card">
        <div class="pcm-card-head">
          <div>
            <span class="pcm-section-label">Plano técnico</span>
            <h2>Equipamentos e pontos de lubrificação</h2>
            <p>Cada equipamento aparece uma única vez. Os mancais, redutores e demais pontos ficam agrupados dentro do próprio equipamento.</p>
          </div>
        </div>
        <div class="pcm-table-wrap">
          <table class="pcm-table lub-equipment-plan-table">
            <thead><tr><th>Equipamento / área</th><th>Pontos</th><th>Produto / frequência</th><th>Situação</th><th>Responsável</th><th>Administração</th></tr></thead>
            <tbody>
              <% if (!equipamentosLubrificacao.length) { %><tr><td colspan="6" class="pcm-empty-row">Nenhum equipamento encontrado.</td></tr><% } %>
              <% equipamentosLubrificacao.forEach(function(g){
                   const groupPending=Number(g.pendentes_validacao||0)>0;
                   const tone=groupPending?'warn':(g.situacao==='ATRASADO'?'danger':(g.situacao==='EM_BREVE'?'warn':''));
              %>
                <tr>
                  <td>
                    <strong><%= g.equipamento_nome %></strong>
                    <small><%= g.area_operacional_label || 'Área não classificada' %> • <%= g.setor || '-' %></small>
                    <% g.rotas.forEach(function(rota){ %><small><%= rota %></small><% }) %>
                  </td>
                  <td>
                    <div class="lub-compact-list">
                      <% g.pontos.forEach(function(p){ %>
                        <div class="lub-compact-point">
                          <strong><%= p.ponto_lubrificacao %></strong>
                          <small><%= p.metodo_aplicacao || 'Método a validar' %></small>
                        </div>
                      <% }) %>
                    </div>
                  </td>
                  <td>
                    <div class="lub-compact-list">
                      <% g.pontos.forEach(function(p){ %>
                        <div class="lub-compact-point">
                          <strong><%= p.tipo_lubrificante_texto || '-' %></strong>
                          <small><%= p.quantidade ?? '-' %> <%= p.unidade || '' %> • <%= p.frequencia_label %></small>
                        </div>
                      <% }) %>
                    </div>
                  </td>
                  <td>
                    <span class="pcm-badge <%= tone %>"><%= groupPending ? (g.pendentes_validacao+' PENDENTE(S) DE VALIDAÇÃO') : String(g.situacao).split('_').join(' ') %></span>
                    <small><%= g.total_pontos %> ponto(s) ativo(s)</small>
                  </td>
                  <td>
                    <% if (g.responsaveis.length) { %>
                      <% g.responsaveis.forEach(function(nome){ %><strong class="lub-responsavel-line"><%= nome %></strong><% }) %>
                    <% } else { %>
                      <strong>Não distribuído</strong>
                    <% } %>
                  </td>
                  <td>
                    <% if (canManagePcm) { %>
                      <details class="lub-equipment-manage">
                        <summary>Gerenciar <%= g.total_pontos %> ponto(s)</summary>
                        <div class="lub-equipment-manage-body">
                          <% g.pontos.forEach(function(p){ const validado=Number(p.validado_tecnicamente ?? 1)===1; %>
                            <article class="lub-point-admin">
                              <div class="lub-point-admin-head">
                                <strong><%= p.ponto_lubrificacao %></strong>
                                <span class="pcm-badge <%= validado?'':'warn' %>"><%= validado?'VALIDADO':'PENDENTE' %></span>
                              </div>
                              <% if (!validado) { %>
                                <form method="POST" action="/pcm/lubrificacao/<%= p.id %>/validar" class="pcm-form">
                                  <input type="hidden" name="equipamento_id" value="<%= p.equipamento_id %>">
                                  <input class="pcm-input" name="tipo_lubrificante_texto" value="<%= /A DEFINIR/i.test(p.tipo_lubrificante_texto||'') ? '' : (p.tipo_lubrificante_texto||'') %>" placeholder="Lubrificante / especificação" required>
                                  <div class="pcm-split">
                                    <input class="pcm-input" type="number" step="0.01" min="0" name="quantidade" value="<%= p.quantidade ?? '' %>" placeholder="Quantidade">
                                    <input class="pcm-input" name="unidade" value="<%= p.unidade || '' %>" placeholder="g, ml, L">
                                  </div>
                                  <select class="pcm-input" name="metodo_aplicacao" required>
                                    <option value="">Método</option>
                                    <% ['Engraxar','Verificar / completar nível','Troca de óleo','Pulverizar','Outro'].forEach(function(met){ %>
                                      <option <%= String(p.metodo_aplicacao||'')===met?'selected':'' %>><%= met %></option>
                                    <% }) %>
                                  </select>
                                  <div class="pcm-split">
                                    <input class="pcm-input" type="number" min="0" name="frequencia_dias" value="<%= p.frequencia_dias ?? '' %>" placeholder="Dias">
                                    <input class="pcm-input" type="number" min="0" name="frequencia_semanas" value="<%= p.frequencia_semanas ?? '' %>" placeholder="Semanas">
                                  </div>
                                  <div class="pcm-split">
                                    <input class="pcm-input" type="number" min="0" name="frequencia_meses" value="<%= p.frequencia_meses ?? '' %>" placeholder="Meses">
                                    <input class="pcm-input" type="number" min="0" name="frequencia_horas_operacao" value="<%= p.frequencia_horas_operacao ?? '' %>" placeholder="Horas operação">
                                  </div>
                                  <input class="pcm-input" name="rota_lubrificacao" value="<%= p.rota_lubrificacao || '' %>" placeholder="Rota">
                                  <select class="pcm-input" name="responsavel_user_id">
                                    <option value="">Distribuir depois</option>
                                    <% mecanicos.forEach(function(m){ %><option value="<%= m.id %>" <%= String(p.responsavel_user_id||'')===String(m.id)?'selected':'' %>><%= m.nome %></option><% }) %>
                                  </select>
                                  <textarea class="pcm-input" name="instrucoes_execucao" rows="3"><%= p.instrucoes_execucao || '' %></textarea>
                                  <select class="pcm-input" name="ativo"><option value="1">Ativo</option><option value="0">Inativo</option></select>
                                  <label class="pcm-note warn"><input type="checkbox" name="confirmacao_tecnica" value="1" required> Produto, quantidade, frequência e método foram conferidos tecnicamente.</label>
                                  <button class="pcm-button primary ui-btn ui-btn--primary" type="submit">Validar e liberar</button>
                                </form>
                              <% } else { %>
                                <form method="POST" action="/pcm/lubrificacao/<%= p.id %>/distribuir" class="pcm-form">
                                  <input type="hidden" name="equipamento_id" value="<%= p.equipamento_id %>">
                                  <select class="pcm-input" name="responsavel_user_id">
                                    <option value="">Não distribuído</option>
                                    <% mecanicos.forEach(function(m){ %><option value="<%= m.id %>" <%= String(p.responsavel_user_id||'')===String(m.id)?'selected':'' %>><%= m.nome %></option><% }) %>
                                  </select>
                                  <input class="pcm-input" name="metodo_aplicacao" value="<%= p.metodo_aplicacao || '' %>" placeholder="Método">
                                  <select class="pcm-input" name="ativo"><option value="1" <%= Number(p.ativo ?? 1)===1?'selected':'' %>>Ativo</option><option value="0" <%= Number(p.ativo ?? 1)===0?'selected':'' %>>Inativo</option></select>
                                  <button class="pcm-button ui-btn ui-btn--outline" type="submit">Salvar distribuição</button>
                                </form>
                              <% } %>
                            </article>
                          <% }) %>
                        </div>
                      </details>
                    <% } else { %><span class="pcm-readonly">Consulta</span><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <% if (motoresPendentes.length || equipamentosSemRoteiro.length) { %>
        <section class="pcm-split">
          <article class="pcm-card">
            <span class="pcm-section-label">Motores >= 20 CV</span>
            <h2>Pendentes de vínculo</h2>
            <p>O local de instalação não casou com segurança a um equipamento cadastrado. O PCM deve corrigir o vínculo/cadastro antes de liberar a relubrificação.</p>
            <div class="pcm-table-wrap">
              <table class="pcm-table">
                <thead><tr><th>Motor</th><th>Potência</th><th>Local cadastrado</th></tr></thead>
                <tbody>
                  <% if (!motoresPendentes.length) { %><tr><td colspan="3" class="pcm-empty-row">Nenhum motor >=20 CV pendente.</td></tr><% } %>
                  <% motoresPendentes.forEach(function(m){ %><tr><td><strong><%= m.codigo || ('#'+m.id) %></strong><small><%= m.descricao %></small></td><td><%= m.potencia_cv %> CV</td><td><%= m.local_instalacao || 'Não informado' %></td></tr><% }) %>
                </tbody>
              </table>
            </div>
          </article>

          <article class="pcm-card">
            <span class="pcm-section-label">Cobertura do cadastro</span>
            <h2>Equipamentos sem roteiro classificado</h2>
            <p>Ativos que ainda não possuem nenhum ponto de lubrificação. Podem não exigir lubrificação ou precisar de classificação manual.</p>
            <div class="pcm-table-wrap">
              <table class="pcm-table">
                <thead><tr><th>Equipamento</th><th>Setor</th><th>Tipo</th></tr></thead>
                <tbody>
                  <% if (!equipamentosSemRoteiro.length) { %><tr><td colspan="3" class="pcm-empty-row">Todos os ativos aplicáveis já possuem roteiro.</td></tr><% } %>
                  <% equipamentosSemRoteiro.forEach(function(e){ %><tr><td><strong><%= e.nome %></strong><small><%= e.codigo || e.tag || '-' %></small></td><td><%= e.setor || '-' %></td><td><%= e.tipo || 'Não classificado' %></td></tr><% }) %>
                </tbody>
              </table>
            </div>
          </article>
        </section>
      <% } %>
    </main>
  </div>
</div>
<script>
(function(){
  const e=document.getElementById('equipamento-filtro'),s=document.getElementById('setor-filtro');
  if(!e||!s)return;
  e.addEventListener('change',function(){const o=e.options[e.selectedIndex];if(o&&o.dataset.setor)s.value=o.dataset.setor;});
})();
</script>
<script src="/js/pcm-lubrificacao-v7.js?v=20260928-2" defer></script>
