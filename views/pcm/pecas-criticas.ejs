<% layout('layout') %>
<%- include('partials/internal-styles') %>
<div class="pcm-module-page">
  <header class="pcm-module-head"><div><span class="pcm-section-label">Disponibilidade de materiais</span><h1>Peças críticas em estoque</h1><p>Posição real das peças estratégicas vinculadas à lista técnica dos equipamentos.</p></div><div class="pcm-module-actions"><a class="pcm-button" href="/pcm/pecas-criticas/pdf?<%= new URLSearchParams(filtros).toString() %>">Baixar PDF</a><a class="pcm-button" href="/estoque">Abrir estoque</a></div></header>
  <div class="pcm-shell"><%- include('partials/internal-nav', { activePcmSection }) %><main class="pcm-module-content">
    <section class="pcm-stat-grid"><div class="pcm-stat"><span>Peças críticas</span><strong><%= resumo.total %></strong><small>no filtro</small></div><div class="pcm-stat danger"><span>Abaixo do mínimo</span><strong><%= resumo.abaixo_minimo %></strong><small>risco de indisponibilidade</small></div><div class="pcm-stat warn"><span>Estoque zerado</span><strong><%= resumo.zeradas %></strong><small>prioridade de suprimento</small></div><div class="pcm-stat info"><span>Sem vínculo</span><strong><%= resumo.sem_vinculo %></strong><small>corrigir cadastro técnico</small></div></section>
    <section class="pcm-card"><form class="pcm-filter" method="GET" action="/pcm/pecas-criticas"><label class="pcm-field">Categoria<input class="pcm-input" name="tipo" value="<%= filtros.tipo %>" placeholder="Rolamento, correia..."></label><label class="pcm-field">Código ou modelo<input class="pcm-input" name="busca" value="<%= filtros.busca %>"></label><label class="pcm-field"><span>Situação</span><span><input type="checkbox" name="abaixo_minimo" value="1" <%= filtros.abaixo_minimo?'checked':'' %>> Somente abaixo do mínimo</span></label><span></span><button class="pcm-button primary">Aplicar filtros</button></form></section>
    <section class="pcm-card"><div class="pcm-card-head"><div><span class="pcm-section-label">Cobertura do estoque</span><h2>Itens estratégicos</h2></div></div><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>Código</th><th>Descrição/modelo</th><th>Categoria</th><th>Atual</th><th>Mínimo</th><th>Cobertura</th><th>Ação</th></tr></thead><tbody><% if (!pecas.length) { %><tr><td colspan="7" class="pcm-empty-row">Nenhuma peça crítica encontrada.</td></tr><% } %><% pecas.forEach(function(p){ const atual=Number(p.estoque_atual||0), minimo=Number(p.estoque_minimo||0), baixa=atual<minimo; %><tr><td><%= p.codigo_interno || '-' %></td><td><strong><%= p.descricao_tecnica || p.modelo_comercial || '-' %></strong><small><%= p.qtd_equipamentos || 1 %> aplicação(ões)</small></td><td><%= p.categoria || '-' %></td><td><strong><%= atual %></strong></td><td><%= minimo %></td><td><span class="pcm-badge <%= baixa?'danger':'' %>"><%= baixa?'Repor':'Coberto' %></span></td><td><div class="pcm-inline-actions"><a class="pcm-button small" href="/estoque">Estoque</a><a class="pcm-button small" href="/pcm/engenharia?busca=<%= encodeURIComponent(p.codigo_interno || p.modelo_comercial || '') %>">Aplicações</a></div></td></tr><% }) %></tbody></table></div></section>
  </main></div>
</div>
