<% layout('layout') %>
<%- include('partials/internal-styles') %>
<div class="pcm-module-page">
  <header class="pcm-module-head"><div><span class="pcm-section-label">Cadastro técnico</span><h1>Engenharia e criticidade</h1><p>Ficha do equipamento, lista técnica, vínculo ao estoque e matriz de criticidade no mesmo lugar.</p></div><div class="pcm-module-actions"><% if (!canManagePcm) { %><span class="pcm-readonly">Modo consulta</span><% } %><a class="pcm-button" href="/pcm/pecas-criticas">Peças críticas</a></div></header>
  <div class="pcm-shell"><%- include('partials/internal-nav', { activePcmSection }) %><main class="pcm-module-content">
    <section class="pcm-stat-grid"><div class="pcm-stat"><span>Componentes</span><strong><%= resumo.componentes %></strong><small>no filtro</small></div><div class="pcm-stat danger"><span>Peças críticas</span><strong><%= resumo.criticos %></strong><small>itens estratégicos</small></div><div class="pcm-stat info"><span>Vinculados ao estoque</span><strong><%= resumo.vinculados_estoque %></strong><small>rastreáveis</small></div><div class="pcm-stat warn"><span>Índice de criticidade</span><strong><%= resumo.indice_criticidade ?? '-' %></strong><small><%= criticidadeAtual?.nivel_criticidade || 'não avaliado' %></small></div></section>
    <section class="pcm-card"><form class="pcm-filter" method="GET" action="/pcm/engenharia"><label class="pcm-field">Equipamento<select class="pcm-input" name="equipamento_id"><option value="">Selecione</option><% equipamentos.forEach(function(eq){ %><option value="<%= eq.id %>" <%= String(filtros.equipamento_id)===String(eq.id)?'selected':'' %>><%= eq.nome %></option><% }) %></select></label><label class="pcm-field">Categoria<input class="pcm-input" name="categoria" value="<%= filtros.categoria %>" placeholder="Rolamento, correia..."></label><label class="pcm-field">Código ou modelo<input class="pcm-input" name="busca" value="<%= filtros.busca %>"></label><span></span><button class="pcm-button primary" type="submit">Carregar engenharia</button></form></section>
    <section class="pcm-split"><article class="pcm-card"><span class="pcm-section-label">Equipamento</span><h2><%= equipamentoSelecionado?.nome || 'Selecione um equipamento' %></h2><ul class="pcm-list"><li>Tag: <strong><%= equipamentoSelecionado?.tag || equipamentoSelecionado?.codigo || '-' %></strong></li><li>Setor: <strong><%= equipamentoSelecionado?.setor || '-' %></strong></li><li>Criticidade cadastral: <strong><%= equipamentoSelecionado?.criticidade || 'N/D' %></strong></li><li>Componentes listados: <strong><%= resumo.componentes %></strong></li></ul></article><article class="pcm-card" id="criticidade"><span class="pcm-section-label">Matriz de criticidade</span><h2>Avaliação 1 a 5</h2><% if (filtros.equipamento_id && canManagePcm) { %><form method="POST" action="/pcm/engenharia/criticidade" class="pcm-form-grid"><input type="hidden" name="equipamento_id" value="<%= filtros.equipamento_id %>"><% [['impacto_producao','Produção'],['impacto_seguranca','Segurança'],['impacto_ambiental','Ambiental'],['custo_parada','Custo']].forEach(function(i){ %><label class="pcm-field"><%= i[1] %><input class="pcm-input" type="number" min="1" max="5" name="<%= i[0] %>" value="<%= criticidadeAtual?.[i[0]] || 3 %>"></label><% }) %><div class="pcm-span-4 pcm-inline-actions"><button class="pcm-button primary">Calcular e salvar</button></div></form><% } else { %><p><%= filtros.equipamento_id ? 'Perfil sem permissão para alterar a matriz.' : 'Selecione um equipamento para avaliar.' %></p><% } %></article></section>
    <% if (canManagePcm && filtros.equipamento_id) { %><details class="pcm-card"><summary>+ Adicionar componente à lista técnica</summary><form method="POST" action="/pcm/engenharia/componentes" class="pcm-form-grid"><input type="hidden" name="equipamento_id" value="<%= filtros.equipamento_id %>"><label class="pcm-field">Categoria<input class="pcm-input" name="categoria"></label><label class="pcm-field">Modelo/componente<input class="pcm-input" name="modelo_comercial" required></label><label class="pcm-field">Código interno<input class="pcm-input" name="codigo_interno"></label><label class="pcm-field">ID no estoque<input class="pcm-input" type="number" name="estoque_item_id"></label><label class="pcm-field pcm-span-2">Descrição técnica<input class="pcm-input" name="descricao_tecnica"></label><label class="pcm-field">Aplicação/posição<input class="pcm-input" name="aplicacao_posicao"></label><label class="pcm-field"><span>Classificação</span><span><input type="checkbox" name="peca_critica" value="1"> Peça crítica</span></label><div class="pcm-span-4 pcm-inline-actions"><button class="pcm-button primary">Adicionar componente</button></div></form></details><% } %>
    <section class="pcm-card"><div class="pcm-card-head"><div><span class="pcm-section-label">BOM</span><h2>Lista técnica do equipamento</h2></div></div><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>Categoria</th><th>Componente</th><th>Código</th><th>Aplicação</th><th>Estoque</th><th>Crítica</th></tr></thead><tbody><% if (!bom.length) { %><tr><td colspan="6" class="pcm-empty-row">Nenhum componente encontrado.</td></tr><% } %><% bom.forEach(function(item){ %><tr><td><%= item.categoria || '-' %></td><td><strong><%= item.modelo_comercial || '-' %></strong><small><%= item.descricao_tecnica || '' %></small></td><td><%= item.codigo_interno || '-' %></td><td><%= item.aplicacao_posicao || '-' %></td><td><%= item.estoque_item_id || 'Sem vínculo' %></td><td><span class="pcm-badge <%= item.peca_critica?'danger':'' %>"><%= item.peca_critica ? 'Crítica' : 'Normal' %></span></td></tr><% }) %></tbody></table></div></section>
  </main></div>
</div>
