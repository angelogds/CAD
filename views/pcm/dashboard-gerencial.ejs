<% layout('layout') %>
<%
const d = dashboard || { filtros:{}, cards:{}, graficos:{}, tabelas:{ordens:[]}, equipamentos_atencao:[], opcoesExtras:{} };
const extras = d.opcoesExtras || { mecanicos:[], status:[], tipos:[], criticidades:[], solicitantes:[] };
const userName = user?.name || user?.email || 'Usuário';
const userRole = user?.role || '-';
const qp = new URLSearchParams(d.filtros || {}).toString();
function selected(a,b){ return String(a || '') === String(b || '') ? 'selected' : ''; }
const years = Array.from({length: 7}, (_,i)=> String(new Date().getFullYear() - i));
const meses = [['','Todos'],['1','Janeiro'],['2','Fevereiro'],['3','Março'],['4','Abril'],['5','Maio'],['6','Junho'],['7','Julho'],['8','Agosto'],['9','Setembro'],['10','Outubro'],['11','Novembro'],['12','Dezembro']];
%>
<link rel="stylesheet" href="/css/pcm-dashboard.css">
<div class="pcm-dashboard-page">
  <div class="pcm-loading"><div class="pcm-spinner" aria-label="Carregando"></div></div>
  <section class="pcm-hero">
    <div>
      <span class="pcm-eyebrow">Campo do Gado • PCM</span>
      <h1>PAINEL GERENCIAL PCM</h1>
      <!-- Dashboard Gerencial da Manutenção | Configurar dashboard | Excel | Ranking operacional dos mecânicos | Ranking dos solicitantes -->
      <p>Indicadores de Planejamento e Controle da Manutenção, criticidade e confiabilidade dos equipamentos.</p>
      <div id="periodoResumo" class="pcm-period-chip" style="display:inline-flex;margin-top:10px">Período analisado: <%= d.filtros.data_inicial || '-' %> a <%= d.filtros.data_final || '-' %></div>
    </div>
    <div class="pcm-hero-actions">
      <span class="pcm-user-chip"><%= userName %> • <%= userRole %></span>
      <span class="pcm-user-chip"><%= new Date().toLocaleDateString('pt-BR') %></span>
      <button class="pcm-btn pcm-btn-primary" id="btnAtualizar" type="button">Atualizar dados</button>
      <button class="pcm-btn" id="btnPdf" type="button">Gerar PDF</button>
      <button class="pcm-btn" id="btnFull" type="button">Tela cheia</button>
      <a class="pcm-btn pcm-btn-ghost" href="/pcm/dashboard-gerencial/configurar">Configurar dashboard</a><a class="pcm-btn pcm-btn-ghost" href="/pcm/dashboard-gerencial/excel?<%= qp %>">Excel</a>
    </div>
  </section>

  <button class="pcm-btn pcm-mobile-filter" id="btnMobileFilters" type="button">Filtros</button>
  <% if (d.filtros.aviso) { %><div class="pcm-alert-box"><%= d.filtros.aviso %></div><% } %>
  <% if (d.erros && d.erros.length) { %><div class="pcm-alert-box"><strong>Atenção:</strong> <%= d.erros.join(' | ') %></div><% } %>

  <div class="pcm-layout">
    <aside class="pcm-filters" aria-label="Filtros do painel">
      <h2 class="pcm-filter-title">Filtros</h2>
      <form id="pcmFilters" method="GET" action="/pcm/dashboard-gerencial">
        <div class="pcm-filter-grid">
          <label>Período rápido<select class="pcm-input" name="periodo"><% [['mes_atual','Mês atual'],['mes_anterior','Mês anterior'],['ultimos_3_meses','Últimos 3 meses'],['ultimos_6_meses','Últimos 6 meses'],['ultimos_12_meses','Últimos 12 meses'],['personalizado','Personalizado']].forEach(function(o){ %><option value="<%= o[0] %>" <%= selected(d.filtros.shortcut,o[0]) %>><%= o[1] %></option><% }) %></select></label>
          <label>Ano<select class="pcm-input" name="ano"><option value="">Todos</option><% years.forEach(function(y){ %><option value="<%= y %>" <%= selected(d.filtros.ano,y) %>><%= y %></option><% }) %></select></label>
          <label>Mês<select class="pcm-input" name="mes"><% meses.forEach(function(m){ %><option value="<%= m[0] %>" <%= selected(d.filtros.mes,m[0]) %>><%= m[1] %></option><% }) %></select></label>
          <label>Data inicial<input class="pcm-input" type="date" name="data_inicial" value="<%= d.filtros.data_inicial || '' %>"></label>
          <label>Data final<input class="pcm-input" type="date" name="data_final" value="<%= d.filtros.data_final || '' %>"></label>
          <label>Setor<select class="pcm-input" name="setor"><option value="">Todos</option><% opcoes.setores.forEach(function(s){ %><option value="<%= s.setor %>" <%= selected(d.filtros.setor,s.setor) %>><%= s.setor %></option><% }) %></select></label>
          <label>Equipamento<select class="pcm-input" name="equipamento_id"><option value="">Todos</option><% opcoes.equipamentos.forEach(function(e){ %><option value="<%= e.id %>" data-setor="<%= e.setor || '' %>" <%= selected(d.filtros.equipamento_id,e.id) %>><%= e.nome %></option><% }) %></select></label>
          <label>Tipo de manutenção<select class="pcm-input" name="tipo_manutencao"><option value="">Todos</option><% extras.tipos.forEach(function(t){ %><option value="<%= t %>" <%= selected(d.filtros.tipo_manutencao,t) %>><%= t %></option><% }) %></select></label>
          <label>Criticidade<select class="pcm-input" name="criticidade"><option value="">Todas</option><% extras.criticidades.forEach(function(c){ %><option value="<%= c %>" <%= selected(d.filtros.criticidade,c) %>><%= c %></option><% }) %></select></label>
          <label>Situação da OS<select class="pcm-input" name="status"><option value="">Todas</option><% extras.status.forEach(function(st){ %><option value="<%= st %>" <%= selected(d.filtros.status,st) %>><%= st %></option><% }) %></select></label>
          <label>Responsável<select class="pcm-input" name="mecanico_id"><option value="">Todos</option><% extras.mecanicos.forEach(function(m){ %><option value="<%= m.id %>" <%= selected(d.filtros.mecanico_id,m.id) %>><%= m.nome %></option><% }) %></select></label>
          <label>Solicitante<select class="pcm-input" name="solicitante_id"><option value="">Todos</option><% (extras.solicitantes||[]).forEach(function(s){ %><option value="<%= s.id %>" <%= selected(d.filtros.solicitante_id,s.id) %>><%= s.nome %></option><% }) %></select></label>
          <label>Equipamento ativo/inativo<select class="pcm-input" name="ativo"><option value="">Todos</option><option value="1" <%= selected(d.filtros.ativo,'1') %>>Ativo</option><option value="0" <%= selected(d.filtros.ativo,'0') %>>Inativo</option></select></label>
        </div>
        <div class="pcm-filter-actions"><button class="pcm-btn pcm-btn-primary" type="submit">Aplicar filtros</button><button class="pcm-btn" id="btnLimpar" type="button">Limpar filtros</button></div>
      </form>
      <div class="pcm-updated"><span class="pcm-dot"></span><span>Dados atualizados em<br><strong id="lastUpdate"><%= new Date().toLocaleString('pt-BR') %></strong></span></div>
    </aside>

    <main>
      <div class="pcm-print-report"><strong>Campo do Gado – Indústria de Reciclagem Animal LTDA</strong><br>Manutenção Industrial – PCM • Painel Gerencial de Manutenção • Elaboração: Ângelo Gomes da Silva — Encarregado de Manutenção</div>
      <section class="pcm-kpis">
        <% [['total_os','','Total de OS no período','Ordens conforme filtros','blue'],['corretivas','','OS corretivas','Falhas/quebras não canceladas','red'],['preventivas','','OS preventivas','Indicador positivo',''],['os_abertas','','OS abertas','Ainda não iniciadas','amber'],['os_andamento','','OS em andamento','Serviços em execução','blue'],['os_atrasadas','⚠️','OS críticas/atrasadas','Urgência operacional','red'],['os_concluidas','','OS finalizadas','Concluídas no período',''],['cumprimento_programacao','','Cumprimento da Programação','Programados concluídos / programados',''],['percentual_manutencao_planejada','','% Manutenção Planejada','Planejados / total de serviços','blue'],['backlog_manutencao','','Backlog da manutenção','OS e demandas pendentes','amber']].forEach(function(c){ %>
          <a class="pcm-kpi <%= c[4] %>" href="#ordens" data-card="<%= c[0] %>" data-suffix="<%= c[0].includes('tempo') ? ' h' : '' %>"><div class="pcm-kpi-icon"><%= c[1] %></div><div class="pcm-kpi-title"><%= c[2] %></div><div class="pcm-kpi-value"><%= d.cards[c[0]] ?? 'Dados insuficientes' %><%= c[0].includes('tempo') && d.cards[c[0]] !== null ? ' h' : '' %></div><div class="pcm-kpi-desc"><%= c[3] %> • abrir lista filtrada</div></a>
        <% }) %>
      </section>


      <section class="pcm-panel" id="planejamento"><h2>Planejamento e Programação</h2><div class="pcm-mini-grid"><span>Serviços planejados: <strong><%= d.cards.servicos_planejados || 0 %></strong></span><span>Não planejados: <strong><%= d.cards.servicos_nao_planejados || 0 %></strong></span><span>Programados: <strong><%= d.cards.servicos_programados || 0 %></strong></span><span>Executados: <strong><%= d.cards.servicos_executados || 0 %></strong></span><span>Serviços pendentes: <strong><%= d.cards.servicos_pendentes || 0 %></strong></span><span>Preventivas programadas x executadas: <strong><%= d.cards.preventivas_programadas || 0 %> x <%= d.cards.preventivas_concluidas || 0 %></strong></span></div></section>
      <section class="pcm-panel" id="demandas"><h2>Demandas</h2><div class="pcm-mini-grid"><span>Total: <strong><%= d.cards.demandas_total || 0 %></strong></span><span>Abertas: <strong><%= d.cards.demandas_abertas || 0 %></strong></span><span>Programadas: <strong><%= d.cards.demandas_programadas || 0 %></strong></span><span>Em andamento: <strong><%= d.cards.demandas_andamento || 0 %></strong></span><span>Atrasadas: <strong><%= d.cards.demandas_atrasadas || 0 %></strong></span><span>Concluídas: <strong><%= d.cards.demandas_concluidas || 0 %></strong></span><span>Convertidas em OS: <strong><%= d.cards.demandas_convertidas_os || 0 %></strong></span><span>Prazo médio: <strong><%= d.cards.prazo_medio_demandas || 'Dados insuficientes' %> h</strong></span></div><p class="pcm-panel-sub">Status exibidos conforme cadastro real do banco, sem criação de situações paralelas.</p></section>
      <section class="pcm-panel" id="criticidade"><h2>Criticidade</h2><div class="pcm-mini-grid"><span>Alta criticidade: <strong><%= d.criticidade?.alta_criticidade || 0 %></strong></span><span>Críticos com OS aberta: <strong><%= d.criticidade?.criticos_os_aberta || 0 %></strong></span><span>Preventiva vencida: <strong><%= d.criticidade?.criticos_preventiva_vencida || 0 %></strong></span><span>Críticos parados: <strong><%= d.criticidade?.criticos_parados || 0 %></strong></span><span>Sem preventiva: <strong><%= d.criticidade?.criticos_sem_preventiva || 0 %></strong></span><span>Demanda pendente: <strong><%= d.criticidade?.criticos_demanda_pendente || 0 %></strong></span></div></section>
      <section class="pcm-panel" id="confiabilidade"><h2>Confiabilidade</h2><div class="pcm-mini-grid"><span>MTBF: <strong><%= d.confiabilidade?.mtbf ?? 'Dados insuficientes para cálculo' %></strong></span><span>MTTR: <strong><%= d.confiabilidade?.mttr ?? 'Dados insuficientes para cálculo' %></strong></span><span>Disponibilidade: <strong><%= d.confiabilidade?.disponibilidade ?? 'Dados insuficientes para cálculo' %></strong></span><span>Campos necessários: <strong><%= (d.confiabilidade?.campos_necessarios || []).join(', ') %></strong></span></div></section>

      <section class="pcm-grid">
        <article class="pcm-panel pcm-panel-wide"><h2>Top 5 equipamentos com maior frequência de falhas</h2><p class="pcm-panel-sub">Somente OS corretivas; preventivas e canceladas não entram no ranking.</p><div class="pcm-chart"><canvas id="chartTopFalhas"></canvas><div class="pcm-empty">Não foram encontrados dados para os filtros selecionados.</div></div></article>
        <article class="pcm-panel"><h2>Distribuição das intervenções de manutenção</h2><p class="pcm-panel-sub">Corretivas, preventivas, inspeções e demais tipos reais.</p><div class="pcm-chart pcm-chart-sm"><canvas id="chartCorPrev"></canvas><div class="pcm-empty">Sem intervenções no período.</div></div></article>
        <article class="pcm-panel"><h2>Ordens de Serviço por Mês</h2><p class="pcm-panel-sub">Evolução mensal dentro do período filtrado.</p><div class="pcm-chart"><canvas id="chartOsMes"></canvas><div class="pcm-empty">Sem OS no período.</div></div></article>
        <article class="pcm-panel"><h2>Serviços por Mecânico</h2><p class="pcm-panel-sub">Top 6 responsáveis com execução registrada.</p><div class="pcm-chart"><canvas id="chartMecanico"></canvas><div class="pcm-empty">Sem registros confiáveis de mecânico.</div></div></article>
        <article class="pcm-panel"><h2>Falhas por Setor</h2><p class="pcm-panel-sub">Ranking dos setores por falhas corretivas.</p><div class="pcm-chart"><canvas id="chartFalhasSetor"></canvas><div class="pcm-empty">Sem falhas por setor.</div></div></article>
        <article class="pcm-panel pcm-panel-wide"><h2>Intervalo e evolução das ocorrências</h2><p class="pcm-panel-sub">Usa média de dias entre falhas quando há histórico suficiente, sem assumir horas reais de funcionamento.</p><div class="pcm-chart"><canvas id="chartEvolucao"></canvas><div class="pcm-empty">Sem histórico suficiente.</div></div></article>
        <article class="pcm-panel"><h2>Preventivas por Situação</h2><p class="pcm-panel-sub">Concluídas, pendentes e vencidas.</p><div class="pcm-chart pcm-chart-sm"><canvas id="chartPreventivas"></canvas><div class="pcm-empty">Sem preventivas.</div></div></article>
        <article class="pcm-panel"><h2>Situação das Ordens de Serviço</h2><p class="pcm-panel-sub">Painel rápido por status real.</p><div class="pcm-chart pcm-chart-sm"><canvas id="chartStatus"></canvas><div class="pcm-empty">Sem OS.</div></div></article>
        <article class="pcm-panel pcm-panel-wide"><h2>Ranking de equipamentos com maior incidência de falhas</h2><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>Posição</th><th>Equipamento</th><th>Setor</th><th>Total de falhas</th><th>Falhas críticas</th><th>Reincidências</th><th>Média dias entre falhas</th><th>Última ocorrência</th><th>Situação atual</th><th>Ação</th></tr></thead><tbody id="rankingFalhas"></tbody></table></div><a class="pcm-btn" href="/pcm/falhas" style="margin-top:10px">Ver ranking completo</a></article>
        <article class="pcm-panel"><h2>Equipamentos que exigem atenção</h2><p class="pcm-panel-sub">Reforma e parada programada</p><p class="pcm-panel-sub">Sugestões automáticas não são decisão técnica definitiva.</p><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>Nome</th><th>Setor</th><th>Criticidade</th><th>Motivo</th><th>Falhas</th><th>Última</th><th>Situação</th><th>Responsável</th></tr></thead><tbody id="equipAtencao"></tbody></table></div></article>
        <article class="pcm-panel pcm-panel-wide" id="ordens"><h2>Relação das OS filtradas</h2><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>OS</th><th>Abertura</th><th>Tipo</th><th>Status</th><th>Equipamento</th><th>Setor</th><th>Solicitante</th></tr></thead><tbody><% if(!d.tabelas.ordens.length){ %><tr><td colspan="7">Não foram encontrados dados para os filtros selecionados.</td></tr><% } %><% d.tabelas.ordens.slice(0,80).forEach(function(o){ %><tr><td><a href="/os/<%= o.id %>">#<%= o.id %></a></td><td><%= o.opened_at || '-' %></td><td><%= o.tipo || '-' %></td><td><%= o.status || '-' %></td><td><%= o.equipamento || '-' %></td><td><%= o.setor||'-' %></td><td><%= o.solicitante||'-' %></td></tr><% }) %></tbody></table></div></article>
      </section>
    </main>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>window.PCM_DASHBOARD_INITIAL=<%- JSON.stringify(d) %>;</script>
<script src="/js/pcm-dashboard.js" defer></script>
