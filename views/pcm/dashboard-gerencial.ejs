<% layout('layout') %>
<%- include('partials/internal-styles') %>
<%
  const d=dashboard||{filtros:{},cards:{},graficos:{},tabelas:{ordens:[]},equipamentos_atencao:[],opcoesExtras:{}};
  const extras=d.opcoesExtras||{tipos:[],status:[],criticidades:[]};
  const qp=new URLSearchParams(d.filtros||{}).toString();
  function selected(a,b){return String(a||'')===String(b||'')?'selected':''}
%>
<link rel="stylesheet" href="/css/pcm-dashboard.css">
<div class="pcm-directors-page">
  <div class="pcm-loading"><div class="pcm-spinner" aria-label="Carregando"></div></div>
  <header class="pcm-directors-head"><div><span class="pcm-section-label">Apresentação executiva permanente</span><h1>Situação da manutenção</h1><p>Visão fixa para a Diretoria, calculada diretamente dos registros do sistema.</p><span class="pcm-period-chip" id="periodoResumo">Período analisado: <%= d.filtros.data_inicial||'-' %> a <%= d.filtros.data_final||'-' %></span></div><div class="pcm-module-actions"><button class="pcm-button primary" id="btnAtualizar" type="button">Atualizar dados</button><button class="pcm-button" id="btnFull" type="button">Modo apresentação</button><button class="pcm-button" id="btnPdf" type="button">PDF</button><a class="pcm-button" href="/pcm/dashboard-gerencial/excel?<%= qp %>">Excel</a></div></header>
  <div class="pcm-directors-layout"><%- include('partials/internal-nav', { activePcmSection }) %><main class="pcm-directors-content">
    <% if (d.filtros.aviso) { %><div class="pcm-alert-box"><%= d.filtros.aviso %></div><% } %><% if(d.erros?.length){ %><div class="pcm-alert-box"><%= d.erros.join(' | ') %></div><% } %>
    <section class="pcm-directors-filter"><form id="pcmFilters" method="GET" action="/pcm/dashboard-gerencial"><label>Período<select name="periodo"><% [['mes_atual','Mês atual'],['mes_anterior','Mês anterior'],['ultimos_3_meses','Últimos 3 meses'],['ultimos_6_meses','Últimos 6 meses'],['ultimos_12_meses','Últimos 12 meses'],['personalizado','Personalizado']].forEach(function(o){ %><option value="<%= o[0] %>" <%= selected(d.filtros.shortcut,o[0]) %>><%= o[1] %></option><% }) %></select></label><label>Início<input type="date" name="data_inicial" value="<%= d.filtros.data_inicial||'' %>"></label><label>Fim<input type="date" name="data_final" value="<%= d.filtros.data_final||'' %>"></label><label>Setor<select name="setor"><option value="">Todos</option><% opcoes.setores.forEach(function(s){ %><option value="<%= s.setor %>" <%= selected(d.filtros.setor,s.setor) %>><%= s.setor %></option><% }) %></select></label><label>Equipamento<select name="equipamento_id"><option value="">Todos</option><% opcoes.equipamentos.forEach(function(e){ %><option value="<%= e.id %>" <%= selected(d.filtros.equipamento_id,e.id) %>><%= e.nome %></option><% }) %></select></label><button class="pcm-button primary" type="submit">Aplicar</button><button class="pcm-button" id="btnLimpar" type="button">Limpar</button></form><div class="pcm-updated"><span class="pcm-dot"></span>Atualizado em <strong id="lastUpdate"><%= new Date().toLocaleString('pt-BR') %></strong></div></section>
    <section class="pcm-directors-kpis"><% [['total_os','OS no período','Volume total','info'],['backlog_manutencao','Backlog','Pendências ativas','warn'],['os_atrasadas','Fora do SLA','Mais de 7 dias','danger'],['cumprimento_programacao','Programação','Cumprimento (%)',''],['percentual_manutencao_planejada','Planejada','Participação (%)','info'],['equipamentos_criticos','Equipamentos críticos','Risco operacional','danger']].forEach(function(c){ %><a class="pcm-director-kpi <%= c[3] %>" href="#ordens" data-card="<%= c[0] %>"><span><%= c[1] %></span><strong class="pcm-kpi-value"><%= d.cards[c[0]]??0 %></strong><small><%= c[2] %></small></a><% }) %></section>
    <section class="pcm-directors-grid"><article class="pcm-director-panel wide"><span class="pcm-section-label">Confiabilidade</span><h2>Equipamentos com mais falhas</h2><p>Somente ocorrências corretivas no período.</p><div class="pcm-chart"><canvas id="chartTopFalhas"></canvas><div class="pcm-empty">Sem falhas nos filtros atuais.</div></div></article><article class="pcm-director-panel"><span class="pcm-section-label">Estratégia</span><h2>Tipos de manutenção</h2><p>Distribuição das intervenções.</p><div class="pcm-chart"><canvas id="chartCorPrev"></canvas><div class="pcm-empty">Sem intervenções.</div></div></article><article class="pcm-director-panel"><span class="pcm-section-label">Tendência</span><h2>OS por mês</h2><p>Evolução do volume de trabalho.</p><div class="pcm-chart"><canvas id="chartOsMes"></canvas><div class="pcm-empty">Sem histórico no período.</div></div></article><article class="pcm-director-panel"><span class="pcm-section-label">Fluxo</span><h2>Situação das OS</h2><p>Distribuição por status real.</p><div class="pcm-chart"><canvas id="chartStatus"></canvas><div class="pcm-empty">Sem ordens no período.</div></div></article></section>
    <section class="pcm-director-panel"><div class="pcm-card-head"><div><span class="pcm-section-label">Decisão</span><h2>Equipamentos que exigem atenção</h2><p>Regras objetivas apontam prioridade; a decisão técnica continua humana.</p></div><a class="pcm-button small" href="/pcm/engenharia">Abrir engenharia</a></div><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>Equipamento</th><th>Setor</th><th>Criticidade</th><th>Motivo</th><th>Falhas</th><th>Última ocorrência</th><th>Situação</th><th>Responsável</th></tr></thead><tbody id="equipAtencao"></tbody></table></div></section>
    <section class="pcm-director-panel" id="ordens"><div class="pcm-card-head"><div><span class="pcm-section-label">Rastreabilidade</span><h2>Ordens consideradas no painel</h2></div></div><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>OS</th><th>Abertura</th><th>Tipo</th><th>Status</th><th>Equipamento</th><th>Setor</th><th>Solicitante</th></tr></thead><tbody><% if(!d.tabelas.ordens.length){ %><tr><td colspan="7" class="pcm-empty-row">Nenhuma ordem encontrada.</td></tr><% } %><% d.tabelas.ordens.slice(0,50).forEach(function(o){ %><tr><td><a href="/os/<%= o.id %>">#<%= o.id %></a></td><td><%= o.opened_at||'-' %></td><td><%= o.tipo||'-' %></td><td><%= o.status||'-' %></td><td><%= o.equipamento||'-' %></td><td><%= o.setor||'-' %></td><td><%= o.solicitante||'-' %></td></tr><% }) %></tbody></table></div></section>
    <table hidden><tbody id="rankingFalhas"></tbody></table>
  </main></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>window.PCM_DASHBOARD_INITIAL=<%- JSON.stringify(d) %>;</script><script src="/js/pcm-dashboard.js" defer></script>
