<% layout('layout') %>
<%- include('partials/internal-styles') %>
<% const d = dashboard; const cardLabel = { total_os:'Total de OS', os_abertas:'OS abertas', os_andamento:'OS em andamento', os_concluidas:'OS concluídas', os_atrasadas:'OS atrasadas', preventivas_realizadas:'Preventivas realizadas', preventivas_programadas:'Preventivas programadas', preventivas_pendentes:'Preventivas pendentes', preventivas_atrasadas:'Preventivas atrasadas', falhas_recorrentes:'Falhas recorrentes', tempo_medio_atendimento:'Tempo médio atendimento', tempo_medio_conclusao:'Tempo médio conclusão (h)', corretivas:'Intervenções corretivas', preventivas:'Intervenções preventivas', equipamentos_parados:'Equipamentos parados/atrasados', equipamentos_atencao:'Equipamentos atenção' }; %>
<div class="page-head"><div><h1>Dashboard Gerencial da Manutenção</h1><p class="muted">Indicadores reais do PCM, OS, equipamentos e preventivas entre <strong><%= d.filtros.data_inicial %></strong> e <strong><%= d.filtros.data_final %></strong>.</p></div><div class="pcm-actions"><a class="btn btn-outline" href="/pcm/dashboard-gerencial/configurar">Configurar dashboard</a><a class="btn" href="/pcm/dashboard-gerencial/pdf?<%= new URLSearchParams(d.filtros).toString() %>">PDF</a><a class="btn" href="/pcm/dashboard-gerencial/excel?<%= new URLSearchParams(d.filtros).toString() %>">Excel</a></div></div>
<div class="pcm-shell"><%- include('partials/internal-nav', { activePcmSection: 'dashboard-gerencial' }) %><div class="pcm-content">
<form class="card grid-4" method="GET" action="/pcm/dashboard-gerencial">
  <label>Atalho<select class="input" name="periodo"><% [['mes_atual','Mês atual'],['mes_anterior','Mês anterior'],['ultimos_3_meses','Últimos 3 meses'],['ultimos_6_meses','Últimos 6 meses'],['ultimos_12_meses','Últimos 12 meses'],['personalizado','Personalizado']].forEach(function(o){ %><option value="<%= o[0] %>" <%= d.filtros.shortcut===o[0]?'selected':'' %>><%= o[1] %></option><% }) %></select></label>
  <label>Inicial<input class="input" type="date" name="data_inicial" value="<%= d.filtros.data_inicial %>"></label><label>Final<input class="input" type="date" name="data_final" value="<%= d.filtros.data_final %>"></label>
  <label>Setor<select class="input" name="setor"><option value="">Todos</option><% opcoes.setores.forEach(function(s){ %><option value="<%= s.setor %>" <%= d.filtros.setor===s.setor?'selected':'' %>><%= s.setor %></option><% }) %></select></label>
  <label>Equipamento<select class="input" name="equipamento_id"><option value="">Todos</option><% opcoes.equipamentos.forEach(function(e){ %><option value="<%= e.id %>" <%= Number(d.filtros.equipamento_id)===Number(e.id)?'selected':'' %>><%= e.nome %></option><% }) %></select></label>
  <label>Tipo<input class="input" name="tipo_manutencao" value="<%= d.filtros.tipo_manutencao || '' %>" placeholder="CORRETIVA"></label><label>Situação<input class="input" name="status" value="<%= d.filtros.status || '' %>" placeholder="ABERTA"></label><label>Prioridade<input class="input" name="prioridade" value="<%= d.filtros.prioridade || '' %>"></label>
  <div style="align-self:end"><button class="btn" type="submit">Filtrar</button></div>
</form>
<div class="pcm-kpi-grid" style="margin-top:12px"><% (d.prefs.cards||[]).forEach(function(k){ if (typeof d.cards[k] === 'undefined') return; %><a class="card" href="#detalhes" style="text-decoration:none;color:inherit"><div class="muted-xs"><%= cardLabel[k] || k %></div><div style="font-size:26px;font-weight:900;color:#166534"><%= d.cards[k] === null ? 'Sem dado' : d.cards[k] %></div></a><% }) %></div>
<div class="card" style="margin-top:12px"><div class="label">Ordens de serviço por período</div><canvas id="chartOs"></canvas></div>
<div class="grid-2" style="margin-top:12px"><div class="card"><div class="label">Tipos de manutenção</div><canvas id="chartTipos"></canvas></div><div class="card"><div class="label">Cumprimento das preventivas</div><canvas id="chartPrev"></canvas></div></div>
<div class="card" style="margin-top:12px"><div class="label">Equipamentos com maior incidência de falhas</div><div class="table-wrap"><table class="table compact"><thead><tr><th>Código</th><th>Equipamento</th><th>Setor</th><th>Falhas</th><th>Última ocorrência</th><th>Parada</th></tr></thead><tbody><% if(!d.graficos.falhas_equipamento.length){ %><tr><td colspan="6" class="muted">Sem dados no período.</td></tr><% } %><% d.graficos.falhas_equipamento.forEach(function(e){ %><tr><td><%= e.codigo||'-' %></td><td><a href="/equipamentos/<%= e.equipamento_id %>"><%= e.nome %></a></td><td><%= e.setor||'-' %></td><td><%= e.falhas %></td><td><%= e.ultima_ocorrencia||'-' %></td><td class="muted">Não registrado</td></tr><% }) %></tbody></table></div></div>
<div class="grid-2" style="margin-top:12px"><div class="card"><div class="label">Ranking operacional dos mecânicos</div><p class="muted-xs">Indicador operacional, sem avaliação disciplinar automática.</p><div class="table-wrap"><table class="table compact"><thead><tr><th>Mecânico</th><th>Atendidas</th><th>Concluídas</th><th>Tempo médio (h)</th><th>Tipos</th></tr></thead><tbody><% if(!d.graficos.ranking_mecanicos.length){ %><tr><td colspan="5" class="muted">Sem registros confiáveis de execução por mecânico.</td></tr><% } %><% d.graficos.ranking_mecanicos.forEach(function(m){ %><tr><td><%= m.mecanico %></td><td><%= m.atendidas %></td><td><%= m.concluidas %></td><td><%= Number(m.tempo_medio_h||0).toFixed(1) %></td><td><%= m.tipos_servico||'-' %></td></tr><% }) %></tbody></table></div></div>
<div class="card"><div class="label">Ranking dos solicitantes</div><div class="table-wrap"><table class="table compact"><thead><tr><th>Solicitante</th><th>Demandas</th><th>Concluídas</th><th>Pendentes</th><th>Equipamentos</th></tr></thead><tbody><% if(!d.graficos.ranking_solicitantes.length){ %><tr><td colspan="5" class="muted">Sem dados no período.</td></tr><% } %><% d.graficos.ranking_solicitantes.forEach(function(s){ %><tr><td><%= s.solicitante %></td><td><%= s.demandas %></td><td><%= s.concluidas %></td><td><%= s.pendentes %></td><td><%= (s.equipamentos||'-').slice(0,80) %></td></tr><% }) %></tbody></table></div><p class="muted-xs"><%= d.observacoes.visualizacoes %></p></div></div>
<div class="card" style="margin-top:12px"><div class="label">Equipamentos que exigem atenção</div><p class="muted">Sinalização para análise técnica e gerencial; não classifica equipamento como condenado.</p><div class="table-wrap"><table class="table compact"><thead><tr><th>Código</th><th>Equipamento</th><th>Setor</th><th>Criticidade</th><th>Motivos</th></tr></thead><tbody><% if(!d.equipamentos_atencao.length){ %><tr><td colspan="5" class="muted">Nenhum equipamento excedeu os limites configurados.</td></tr><% } %><% d.equipamentos_atencao.forEach(function(e){ %><tr><td><%= e.codigo||'-' %></td><td><a href="/equipamentos/<%= e.equipamento_id %>"><%= e.nome %></a></td><td><%= e.setor||'-' %></td><td><%= e.criticidade||'-' %></td><td><%= e.motivos.join('; ') %></td></tr><% }) %></tbody></table></div></div>
<div id="detalhes" class="card" style="margin-top:12px"><div class="label">Relação das OS filtradas</div><div class="table-wrap"><table class="table compact"><thead><tr><th>OS</th><th>Abertura</th><th>Tipo</th><th>Status</th><th>Equipamento</th><th>Setor</th><th>Solicitante</th></tr></thead><tbody><% d.tabelas.ordens.slice(0,80).forEach(function(o){ %><tr><td><a href="/os/<%= o.id %>">#<%= o.id %></a></td><td><%= o.opened_at %></td><td><%= o.tipo %></td><td><%= o.status %></td><td><%= o.equipamento %></td><td><%= o.setor||'-' %></td><td><%= o.solicitante||'-' %></td></tr><% }) %></tbody></table></div></div>
</div></div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>const D=<%- JSON.stringify(d.graficos) %>;function ch(id,type,labels,data){new Chart(document.getElementById(id),{type,data:{labels,datasets:[{label:'Total',data,backgroundColor:'#16a34a55',borderColor:'#166534'}]},options:{responsive:true,maintainAspectRatio:false}})};ch('chartOs','line',D.os_periodo.map(x=>x.mes),D.os_periodo.map(x=>x.total));ch('chartTipos','doughnut',D.tipos_manutencao.map(x=>x.tipo),D.tipos_manutencao.map(x=>x.total));ch('chartPrev','bar',D.preventivas_cumprimento.map(x=>x.situacao),D.preventivas_cumprimento.map(x=>x.total));</script>
