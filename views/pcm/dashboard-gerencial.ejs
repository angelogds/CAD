<% layout('layout') %>
<%- include('partials/internal-styles') %>
<%
  const d=dashboard||{filtros:{},cards:{},graficos:{},tabelas:{ordens:[]},equipamentos_atencao:[],opcoesExtras:{}};
  const extras=d.opcoesExtras||{tipos:[],status:[],criticidades:[]};
  const quality=d.qualidade_dados||{score:null,status:'SEM_DADOS',status_label:'Sem dados suficientes',campos_pendentes:[]};
  const reliability=d.confiabilidade||{status:'SEM_DADOS',status_label:'Dados insuficientes',publicado:false,mtbf_horas:null,mttr_horas:null,disponibilidade_pct:null,tempo_parada_horas:0,mtbf_amostras:0,mttr_amostras:0};
  const qp=new URLSearchParams(d.filtros||{}).toString();
  const basePath=typeof dashboardBasePath!=='undefined'&&dashboardBasePath?dashboardBasePath:'/pcm/dashboard-gerencial';
  const executiveTitle=typeof dashboardTitle!=='undefined'&&dashboardTitle?dashboardTitle:'Situação da manutenção';
  const executiveSubtitle=typeof dashboardSubtitle!=='undefined'&&dashboardSubtitle?dashboardSubtitle:'Visão fixa para a Diretoria, calculada diretamente dos registros do sistema.';
  const executiveEyebrow=typeof dashboardEyebrow!=='undefined'&&dashboardEyebrow?dashboardEyebrow:'Apresentação executiva permanente';
  const renderPcmNav=typeof showPcmNav==='undefined'?true:Boolean(showPcmNav);
  const money=(cents)=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(Number(cents||0)/100);
  function selected(a,b){return String(a||'')===String(b||'')?'selected':''}
  function metric(value,suffix=''){return value===null||typeof value==='undefined'?'Dados insuficientes':`${value}${suffix}`}
%>
<link rel="stylesheet" href="/css/pcm-dashboard.css?v=20260920-v4">
<div class="pcm-directors-page">
  <div class="pcm-loading"><div class="pcm-spinner" aria-label="Carregando"></div></div>
  <header class="pcm-directors-head"><div><span class="pcm-section-label"><%= executiveEyebrow %></span><h1><%= executiveTitle %></h1><p><%= executiveSubtitle %></p><span class="pcm-period-chip" id="periodoResumo">Período analisado: <%= d.filtros.data_inicial||'-' %> a <%= d.filtros.data_final||'-' %></span></div><div class="pcm-module-actions"><button class="pcm-button primary ui-btn ui-btn--primary" id="btnAtualizar" type="button">Atualizar dados</button><button class="pcm-button ui-btn ui-btn--outline" id="btnFull" type="button">Modo apresentação</button><button class="pcm-button ui-btn ui-btn--outline" id="btnPdf" type="button">PDF</button><a class="pcm-button ui-btn ui-btn--outline" href="<%= basePath %>/excel?<%= qp %>">Excel</a></div></header>
  <div class="pcm-directors-layout"><% if(renderPcmNav){ %><%- include('partials/internal-nav', { activePcmSection }) %><% } %><main class="pcm-directors-content">
    <% if (d.filtros.aviso) { %><div class="pcm-alert-box"><%= d.filtros.aviso %></div><% } %><% if(d.erros?.length){ %><div class="pcm-alert-box"><%= d.erros.join(' | ') %></div><% } %>
    <section class="pcm-directors-filter"><form id="pcmFilters" method="GET" action="<%= basePath %>"><label>Período<select name="periodo"><% [['mes_atual','Mês atual'],['mes_anterior','Mês anterior'],['ultimos_3_meses','Últimos 3 meses'],['ultimos_6_meses','Últimos 6 meses'],['ultimos_12_meses','Últimos 12 meses'],['personalizado','Personalizado']].forEach(function(o){ %><option value="<%= o[0] %>" <%= selected(d.filtros.shortcut,o[0]) %>><%= o[1] %></option><% }) %></select></label><label>Início<input type="date" name="data_inicial" value="<%= d.filtros.data_inicial||'' %>"></label><label>Fim<input type="date" name="data_final" value="<%= d.filtros.data_final||'' %>"></label><label>Setor<select name="setor"><option value="">Todos</option><% opcoes.setores.forEach(function(s){ %><option value="<%= s.setor %>" <%= selected(d.filtros.setor,s.setor) %>><%= s.setor %></option><% }) %></select></label><label>Equipamento<select name="equipamento_id"><option value="">Todos</option><% opcoes.equipamentos.forEach(function(e){ %><option value="<%= e.id %>" <%= selected(d.filtros.equipamento_id,e.id) %>><%= e.nome %></option><% }) %></select></label><button class="pcm-button primary ui-btn ui-btn--primary" type="submit">Aplicar</button><button class="pcm-button ui-btn ui-btn--outline" id="btnLimpar" type="button">Limpar</button></form><div class="pcm-updated"><span class="pcm-dot"></span>Atualizado em <strong id="lastUpdate"><%= new Date().toLocaleString('pt-BR') %></strong></div></section>

    <section class="pcm-directors-kpis"><% [['total_os','OS no período','Volume total','info'],['backlog_manutencao','Backlog','Pendências ativas','warn'],['os_atrasadas','Fora do SLA','Mais de 7 dias','danger'],['cumprimento_programacao','Programação','Cumprimento (%)',''],['percentual_manutencao_planejada','Planejada','Participação (%)','info'],['equipamentos_criticos','Equipamentos críticos','Risco operacional','danger']].forEach(function(c){ %><a class="pcm-director-kpi <%= c[3] %>" href="#ordens" data-card="<%= c[0] %>"><span><%= c[1] %></span><strong class="pcm-kpi-value"><%= d.cards[c[0]]??0 %></strong><small><%= c[2] %></small></a><% }) %></section>

    <section class="pcm-directors-kpis pcm-directors-kpis--secondary" aria-label="Indicadores executivos de evolução">
      <a class="pcm-director-kpi info" href="#backlog" data-card="backlog_os_atual"><span>Backlog de OS</span><strong class="pcm-kpi-value"><%= d.cards.backlog_os_atual??0 %></strong><small>OS ativas até a data final</small></a>
      <a class="pcm-director-kpi danger" href="#backlog" data-card="backlog_acima_30_dias"><span>Backlog &gt; 30 dias</span><strong class="pcm-kpi-value"><%= d.cards.backlog_acima_30_dias??0 %></strong><small>Envelhecimento crítico</small></a>
      <a class="pcm-director-kpi" href="#ordens" data-card="tempo_medio_conclusao" data-suffix=" h"><span>Tempo médio de conclusão</span><strong class="pcm-kpi-value"><%= metric(d.cards.tempo_medio_conclusao,' h') %></strong><small>Abertura até fechamento</small></a>
      <a class="pcm-director-kpi warn" href="#reincidencia" data-card="reincidencia_corretiva_pct" data-suffix="%"><span>Reincidência corretiva</span><strong class="pcm-kpi-value"><%= metric(d.cards.reincidencia_corretiva_pct,'%') %></strong><small>Repetições após a 1ª corretiva</small></a>
      <a class="pcm-director-kpi warn" href="#reincidencia" data-card="equipamentos_reincidentes"><span>Equip. reincidentes</span><strong class="pcm-kpi-value"><%= d.cards.equipamentos_reincidentes??0 %></strong><small>2+ corretivas no período</small></a>
      <a class="pcm-director-kpi <%= quality.status==='BOM'?'':quality.status==='ATENCAO'?'danger':'warn' %>" href="#qualidade-dados" data-card="qualidade_dados_pct" data-suffix="%"><span>Qualidade dos dados</span><strong class="pcm-kpi-value"><%= metric(d.cards.qualidade_dados_pct,'%') %></strong><small>Base para indicadores confiáveis</small></a>
    </section>

    <section class="pcm-reliability-strip" id="confiabilidade" aria-label="Indicadores de confiabilidade">
      <div class="pcm-cost-head">
        <div>
          <span class="pcm-section-label">Confiabilidade operacional</span>
          <h2>MTBF, MTTR e disponibilidade</h2>
          <p>Calculados a partir das falhas classificadas no PCM e dos intervalos reais de parada/retorno.</p>
        </div>
        <span class="pcm-quality-status <%= reliability.publicado ? '' : 'pending' %>" data-reliability-status><%= reliability.status_label || 'Dados insuficientes' %></span>
      </div>
      <div class="pcm-reliability-kpis">
        <div><span>MTBF</span><strong data-card="mtbf_horas" data-suffix=" h"><%= metric(d.cards.mtbf_horas,' h') %></strong><small><%= reliability.mtbf_amostras||0 %> intervalo(s) entre falhas</small></div>
        <div><span>MTTR</span><strong data-card="mttr_horas" data-suffix=" h"><%= metric(d.cards.mttr_horas,' h') %></strong><small><%= reliability.mttr_amostras||0 %> parada(s) com início/fim</small></div>
        <div><span>Disponibilidade estimada</span><strong data-card="disponibilidade_pct" data-suffix="%"><%= metric(d.cards.disponibilidade_pct,'%') %></strong><small>MTBF / (MTBF + MTTR)</small></div>
        <div><span>Tempo total de parada</span><strong data-card="tempo_parada_horas" data-suffix=" h"><%= metric(d.cards.tempo_parada_horas,' h') %></strong><small>Somatório dos intervalos válidos</small></div>
      </div>
      <div class="pcm-reliability-note <%= reliability.publicado ? 'ok' : 'pending' %>">
        <% if (reliability.publicado) { %>
          <strong>Indicadores liberados:</strong> a cobertura mínima de rastreabilidade foi atendida para o período filtrado.
        <% } else { %>
          <strong>Indicadores em formação:</strong> MTBF, MTTR e disponibilidade só são publicados quando a cobertura de falhas/paradas atingir os limites de qualidade definidos.
        <% } %>
      </div>
    </section>

    <section class="pcm-cost-strip" id="custos" aria-label="Custos reais de manutenção">
      <div class="pcm-cost-head"><div><span class="pcm-section-label">Custos por equipamento</span><h2>Custo real da manutenção</h2><p>Consumo real vem das baixas físicas do estoque; compras e recebimentos aparecem separados para não misturar estoque parado com custo aplicado.</p></div><a class="pcm-button small ui-btn ui-btn--outline ui-btn--compact" href="/dashboard/diretoria/compras">Abrir acompanhamento de compras</a></div>
      <div class="pcm-cost-kpis">
        <div><span>Consumido na manutenção</span><strong data-card-money="custo_consumido_centavos"><%= money(d.cards.custo_consumido_centavos) %></strong><small>Baixas reais vinculadas a equipamentos/OS</small></div>
        <div><span>Comprado no período</span><strong data-card-money="custo_comprado_centavos"><%= money(d.cards.custo_comprado_centavos) %></strong><small>Quantidade comprada × valor unitário</small></div>
        <div><span>Já recebido</span><strong data-card-money="custo_recebido_centavos"><%= money(d.cards.custo_recebido_centavos) %></strong><small>Parcela dos materiais recebidos</small></div>
        <div><span>A receber</span><strong data-card-money="custo_pendente_recebimento_centavos"><%= money(d.cards.custo_pendente_recebimento_centavos) %></strong><small>Compra ainda não recebida integralmente</small></div>
        <div><span>Baixas de estoque</span><strong data-card="consumo_movimentos" class="pcm-kpi-value"><%= d.cards.consumo_movimentos??0 %></strong><small>Movimentos considerados como consumo real</small></div>
      </div>
    </section>

    <section class="pcm-directors-grid">
      <article class="pcm-director-panel wide"><span class="pcm-section-label">Confiabilidade</span><h2>Equipamentos com mais falhas</h2><p>Somente ocorrências corretivas no período.</p><div class="pcm-chart"><canvas id="chartTopFalhas"></canvas><div class="pcm-empty">Sem falhas nos filtros atuais.</div></div></article>
      <article class="pcm-director-panel"><span class="pcm-section-label">Impacto operacional</span><h2>Horas de parada por equipamento</h2><p>Somente intervalos válidos registrados no PCM.</p><div class="pcm-chart"><canvas id="chartParadasEquipamentos"></canvas><div class="pcm-empty">Sem paradas válidas no período.</div></div></article>
      <article class="pcm-director-panel"><span class="pcm-section-label">Estratégia</span><h2>Tipos de manutenção</h2><p>Distribuição das intervenções.</p><div class="pcm-chart"><canvas id="chartCorPrev"></canvas><div class="pcm-empty">Sem intervenções.</div></div></article>
      <article class="pcm-director-panel"><span class="pcm-section-label">Tendência</span><h2>OS por mês</h2><p>Evolução do volume de trabalho.</p><div class="pcm-chart"><canvas id="chartOsMes"></canvas><div class="pcm-empty">Sem histórico no período.</div></div></article>
      <article class="pcm-director-panel"><span class="pcm-section-label">Fluxo</span><h2>Situação das OS</h2><p>Distribuição por status real.</p><div class="pcm-chart"><canvas id="chartStatus"></canvas><div class="pcm-empty">Sem ordens no período.</div></div></article>
      <article class="pcm-director-panel wide pcm-cost-chart-panel"><span class="pcm-section-label">Custo de manutenção</span><h2>Custo real consumido por equipamento</h2><p>Ranking das baixas físicas do estoque vinculadas aos ativos no período selecionado.</p><div class="pcm-chart pcm-chart-tall"><canvas id="chartCustosEquipamentos"></canvas><div class="pcm-empty">Sem consumo de materiais vinculado a equipamentos neste período.</div></div></article>
      <article class="pcm-director-panel pcm-cost-chart-panel"><span class="pcm-section-label">Tendência de custos</span><h2>Evolução mensal</h2><p>Compara o custo efetivamente consumido com o valor comprado.</p><div class="pcm-chart"><canvas id="chartCustosMes"></canvas><div class="pcm-empty">Sem histórico de custos no período.</div></div></article>
      <article class="pcm-director-panel wide" id="backlog"><span class="pcm-section-label">Backlog</span><h2>Idade das OS pendentes</h2><p>Mostra o estoque real de OS ainda abertas até a data final, inclusive as abertas antes do início do filtro.</p><div class="pcm-chart"><canvas id="chartBacklogIdade"></canvas><div class="pcm-empty">Sem backlog para os filtros atuais.</div></div></article>
      <article class="pcm-director-panel" id="reincidencia"><span class="pcm-section-label">Reincidência</span><h2>Corretivas repetidas por equipamento</h2><p>Equipamentos com duas ou mais corretivas no período. Não substitui análise de modo de falha.</p><div class="pcm-chart"><canvas id="chartReincidencia"></canvas><div class="pcm-empty">Sem equipamentos reincidentes.</div></div></article>
    </section>

    <section class="pcm-director-panel pcm-data-quality" id="qualidade-dados">
      <div class="pcm-card-head"><div><span class="pcm-section-label">Governança do indicador</span><h2>Qualidade dos dados de manutenção</h2><p>Antes de liberar MTBF, MTTR e disponibilidade como indicadores oficiais, o sistema mede se os registros possuem base suficiente.</p></div><span class="pcm-quality-status" data-quality-status><%= quality.status_label||'Sem dados suficientes' %></span></div>
      <div class="pcm-quality-grid">
        <div><span>OS com equipamento vinculado</span><strong data-quality="os_com_equipamento_pct"><%= metric(quality.os_com_equipamento_pct,'%') %></strong></div>
        <div><span>OS concluídas com data de fechamento</span><strong data-quality="encerramento_com_data_pct"><%= metric(quality.encerramento_com_data_pct,'%') %></strong></div>
        <div><span>Corretivas classificadas no PCM</span><strong data-quality="corretivas_classificadas_pct"><%= metric(quality.corretivas_classificadas_pct,'%') %></strong></div>
        <div><span>Corretivas com início/fim de parada</span><strong data-quality="paradas_com_intervalo_pct"><%= metric(quality.paradas_com_intervalo_pct,'%') %></strong></div>
      </div>
      <div class="pcm-quality-note"><strong>MTBF, MTTR e disponibilidade:</strong> são liberados automaticamente quando a rastreabilidade mínima de equipamento, classificação de falha e intervalo de parada for atendida. Até lá, o sistema mantém “dados insuficientes”.</div>
      <div class="pcm-quality-actions"><strong>Para amadurecer a base:</strong><ul id="qualityPendencias"><% (quality.campos_pendentes||[]).forEach(function(item){ %><li><%= item %></li><% }) %></ul></div>
    </section>

    <section class="pcm-director-panel"><div class="pcm-card-head"><div><span class="pcm-section-label">Decisão</span><h2>Equipamentos que exigem atenção</h2><p>Regras objetivas apontam prioridade; a decisão técnica continua humana.</p></div><a class="pcm-button small ui-btn ui-btn--outline ui-btn--compact" href="<%= renderPcmNav ? '/pcm/engenharia' : '/equipamentos' %>"><%= renderPcmNav ? 'Abrir engenharia' : 'Abrir equipamentos' %></a></div><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>Equipamento</th><th>Setor</th><th>Criticidade</th><th>Motivo</th><th>Falhas</th><th>Última ocorrência</th><th>Situação</th><th>Responsável</th></tr></thead><tbody id="equipAtencao"></tbody></table></div></section>
    <section class="pcm-director-panel" id="ordens"><div class="pcm-card-head"><div><span class="pcm-section-label">Rastreabilidade</span><h2>Ordens consideradas no painel</h2></div></div><div class="pcm-table-wrap"><table class="pcm-table"><thead><tr><th>OS</th><th>Abertura</th><th>Tipo</th><th>Status</th><th>Equipamento</th><th>Setor</th><th>Solicitante</th></tr></thead><tbody><% if(!d.tabelas.ordens.length){ %><tr><td colspan="7" class="pcm-empty-row">Nenhuma ordem encontrada.</td></tr><% } %><% d.tabelas.ordens.slice(0,50).forEach(function(o){ %><tr><td><a href="/os/<%= o.id %>">#<%= o.id %></a></td><td><%= o.opened_at||'-' %></td><td><%= o.tipo||'-' %></td><td><%= o.status||'-' %></td><td><%= o.equipamento||'-' %></td><td><%= o.setor||'-' %></td><td><%= o.solicitante||'-' %></td></tr><% }) %></tbody></table></div></section>
    <table hidden><tbody id="rankingFalhas"></tbody></table>
  </main></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>window.PCM_DASHBOARD_INITIAL=<%- JSON.stringify(d) %>;window.PCM_DASHBOARD_ENDPOINTS={base:<%- JSON.stringify(basePath) %>,data:<%- JSON.stringify(basePath+'/dados') %>,pdf:<%- JSON.stringify(basePath+'/pdf') %>};</script><script src="/js/pcm-dashboard.js?v=20260920-v4" defer></script>
