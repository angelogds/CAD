<% layout('layout') %>
<%- include('partials/internal-styles') %>
<%
const d = dashboard || { filtros:{}, cards:{}, graficos:{}, tabelas:{ordens:[]}, equipamentos_atencao:[], opcoesExtras:{} };
const cardLabel = {
  total_os:'Total de ordens de serviço abertas', os_abertas:'Ordens abertas', os_andamento:'Ordens em andamento', os_concluidas:'Ordens finalizadas', os_atrasadas:'Ordens atrasadas',
  preventivas_programadas:'Preventivas programadas', preventivas_vencidas:'Preventivas vencidas', preventivas_concluidas:'Preventivas concluídas', demandas_abertas:'Demandas abertas', solicitacoes_pendentes:'Solicitações pendentes', equipamentos_criticos:'Equipamentos críticos',
  tempo_medio_atendimento:'Tempo médio de atendimento (h)', tempo_medio_conclusao:'Tempo médio de conclusão (h)', manutencoes_por_equipamento:'Manutenções por equipamento', servicos_por_mecanico:'Serviços por mecânico', falhas_por_setor:'Falhas por setor', percentual_corretiva:'% corretiva', percentual_preventiva:'% preventiva', corretivas:'Corretivas', preventivas:'Preventivas', equipamentos_atencao:'Equipamentos atenção'
};
const extras = d.opcoesExtras || { mecanicos:[], status:[], tipos:[], criticidades:[] };
%>
<style>.pcm-chart{height:300px}.pcm-chart canvas{width:100%!important;height:100%!important}.pcm-alert{background:#ecfdf5;border:1px solid #bbf7d0;color:#14532d;border-radius:12px;padding:12px;margin:12px 0}@media(max-width:900px){.pcm-chart{height:240px}.page-head{gap:12px}.pcm-actions{flex-wrap:wrap}}@media(max-width:640px){.pcm-chart{height:220px}.pcm-kpi-grid{grid-template-columns:1fr!important}.grid-2,.grid-4{grid-template-columns:1fr!important}}</style>
<div class="page-head"><div><h1>Dashboard Gerencial de Manutenção – PCM</h1><!-- Dashboard Gerencial da Manutenção | Ranking dos solicitantes --><p class="muted">Indicadores reais do PCM, OS, equipamentos e preventivas entre <strong><%= d.filtros.data_inicial || '-' %></strong> e <strong><%= d.filtros.data_final || '-' %></strong>.</p></div><div class="pcm-actions"><a class="btn btn-outline" href="/pcm/dashboard-gerencial/configurar">Configurar dashboard</a><a class="btn" href="/pcm/dashboard-gerencial/pdf?<%= new URLSearchParams(d.filtros).toString() %>">Gerar PDF</a><a class="btn" href="/pcm/dashboard-gerencial/excel?<%= new URLSearchParams(d.filtros).toString() %>">Excel</a></div></div>
<div class="pcm-shell"><%- include('partials/internal-nav', { activePcmSection: 'dashboard-gerencial' }) %><div class="pcm-content">
<% if (d.filtros.aviso) { %><div class="pcm-alert"><%= d.filtros.aviso %></div><% } %><% if (d.erros && d.erros.length) { %><div class="pcm-alert"><strong>Não foi possível carregar todos os dados:</strong> <%= d.erros.join(' | ') %></div><% } %>
<form class="card grid-4" method="GET" action="/pcm/dashboard-gerencial">
  <label>Atalho<select class="input" name="periodo"><% [['mes_atual','Mês atual'],['mes_anterior','Mês anterior'],['ultimos_3_meses','Últimos 3 meses'],['ultimos_6_meses','Últimos 6 meses'],['ultimos_12_meses','Últimos 12 meses'],['personalizado','Personalizado']].forEach(function(o){ %><option value="<%= o[0] %>" <%= d.filtros.shortcut===o[0]?'selected':'' %>><%= o[1] %></option><% }) %></select></label>
  <label>Inicial<input class="input" type="date" name="data_inicial" value="<%= d.filtros.data_inicial || '' %>"></label><label>Final<input class="input" type="date" name="data_final" value="<%= d.filtros.data_final || '' %>"></label>
  <label>Setor<select class="input" name="setor"><option value="">Todos</option><% opcoes.setores.forEach(function(s){ %><option value="<%= s.setor %>" <%= d.filtros.setor===s.setor?'selected':'' %>><%= s.setor %></option><% }) %></select></label>
  <label>Equipamento<select class="input" name="equipamento_id"><option value="">Todos</option><% opcoes.equipamentos.forEach(function(e){ %><option value="<%= e.id %>" <%= Number(d.filtros.equipamento_id)===Number(e.id)?'selected':'' %>><%= e.nome %></option><% }) %></select></label>
  <label>Tipo de manutenção<select class="input" name="tipo_manutencao"><option value="">Todos</option><% extras.tipos.forEach(function(t){ %><option value="<%= t %>" <%= d.filtros.tipo_manutencao===t?'selected':'' %>><%= t %></option><% }) %></select></label>
  <label>Status da OS<select class="input" name="status"><option value="">Todos</option><% extras.status.forEach(function(st){ %><option value="<%= st %>" <%= d.filtros.status===st?'selected':'' %>><%= st %></option><% }) %></select></label>
  <label>Mecânico responsável<select class="input" name="mecanico_id"><option value="">Todos</option><% extras.mecanicos.forEach(function(m){ %><option value="<%= m.id %>" <%= Number(d.filtros.mecanico_id)===Number(m.id)?'selected':'' %>><%= m.nome %></option><% }) %></select></label>
  <label>Criticidade<select class="input" name="criticidade"><option value="">Todas</option><% extras.criticidades.forEach(function(c){ %><option value="<%= c %>" <%= d.filtros.criticidade===c?'selected':'' %>><%= c %></option><% }) %></select></label>
  <div style="align-self:end"><button class="btn" type="submit">Filtrar</button></div>
</form>
<% if (!d.tabelas.ordens.length && !Object.values(d.cards).some(Number)) { %><div class="pcm-alert">Nenhum dado encontrado para os filtros selecionados. Ajuste o período ou remova filtros para ampliar a análise.</div><% } %>
<div class="pcm-kpi-grid" style="margin-top:12px"><% (d.prefs.cards||[]).forEach(function(k){ if (typeof d.cards[k] === 'undefined') return; %><a class="card" href="#detalhes" style="text-decoration:none;color:inherit"><div class="muted-xs"><%= cardLabel[k] || k %></div><div style="font-size:26px;font-weight:900;color:#166534"><%= d.cards[k] === null ? 'Sem dado' : d.cards[k] %></div></a><% }) %></div>
<div class="grid-2" style="margin-top:12px"><div class="card pcm-chart"><div class="label">Ordens de serviço por status</div><canvas id="chartStatus"></canvas></div><div class="card pcm-chart"><div class="label">Ordens de serviço por mês</div><canvas id="chartOsMes"></canvas></div></div>
<div class="grid-2" style="margin-top:12px"><div class="card pcm-chart"><div class="label">Corretivas versus preventivas</div><canvas id="chartCorPrev"></canvas></div><div class="card pcm-chart"><div class="label">Preventivas concluídas, pendentes e vencidas</div><canvas id="chartPrev"></canvas></div></div>
<div class="grid-2" style="margin-top:12px"><div class="card pcm-chart"><div class="label">Equipamentos com maior número de falhas</div><canvas id="chartFalhasEq"></canvas></div><div class="card pcm-chart"><div class="label">Serviços por setor</div><canvas id="chartSetor"></canvas></div></div>
<div class="grid-2" style="margin-top:12px"><div class="card pcm-chart"><div class="label">Serviços por mecânico</div><canvas id="chartMecanico"></canvas></div><div class="card pcm-chart"><div class="label">Evolução mensal das ocorrências</div><canvas id="chartEvolucao"></canvas></div></div>
<div class="card" style="margin-top:12px"><div class="label">Equipamentos com maior incidência de falhas</div><div class="table-wrap"><table class="table compact"><thead><tr><th>Código</th><th>Equipamento</th><th>Setor</th><th>Falhas</th><th>Última ocorrência</th></tr></thead><tbody><% if(!d.graficos.falhas_equipamento.length){ %><tr><td colspan="5" class="muted">Sem dados no período.</td></tr><% } %><% d.graficos.falhas_equipamento.forEach(function(e){ %><tr><td><%= e.codigo||'-' %></td><td><% if (e.equipamento_id) { %><a href="/equipamentos/<%= e.equipamento_id %>"><%= e.nome %></a><% } else { %><%= e.nome %><% } %></td><td><%= e.setor||'-' %></td><td><%= e.falhas %></td><td><%= e.ultima_ocorrencia||'-' %></td></tr><% }) %></tbody></table></div></div>
<div class="grid-2" style="margin-top:12px"><div class="card"><div class="label">Ranking operacional dos mecânicos</div><div class="table-wrap"><table class="table compact"><thead><tr><th>Mecânico</th><th>Atendidas</th><th>Concluídas</th><th>Tempo médio (h)</th><th>Tipos</th></tr></thead><tbody><% if(!d.graficos.ranking_mecanicos.length){ %><tr><td colspan="5" class="muted">Sem registros confiáveis de execução por mecânico.</td></tr><% } %><% d.graficos.ranking_mecanicos.forEach(function(m){ %><tr><td><%= m.mecanico %></td><td><%= m.atendidas %></td><td><%= m.concluidas %></td><td><%= Number(m.tempo_medio_h||0).toFixed(1) %></td><td><%= m.tipos_servico||'-' %></td></tr><% }) %></tbody></table></div></div>
<div class="card"><div class="label">Quantidade de falhas por setor</div><div class="table-wrap"><table class="table compact"><thead><tr><th>Setor</th><th>Falhas</th></tr></thead><tbody><% if(!d.graficos.falhas_setor.length){ %><tr><td colspan="2" class="muted">Sem falhas por setor no período.</td></tr><% } %><% d.graficos.falhas_setor.forEach(function(s){ %><tr><td><%= s.setor||'Sem setor' %></td><td><%= s.total %></td></tr><% }) %></tbody></table></div></div></div>
<div class="card" style="margin-top:12px"><div class="label">Equipamentos que exigem atenção</div><div class="table-wrap"><table class="table compact"><thead><tr><th>Código</th><th>Equipamento</th><th>Setor</th><th>Criticidade</th><th>Motivos</th></tr></thead><tbody><% if(!d.equipamentos_atencao.length){ %><tr><td colspan="5" class="muted">Nenhum equipamento excedeu os limites configurados.</td></tr><% } %><% d.equipamentos_atencao.forEach(function(e){ %><tr><td><%= e.codigo||'-' %></td><td><%= e.nome %></td><td><%= e.setor||'-' %></td><td><%= e.criticidade||'-' %></td><td><%= e.motivos.join('; ') %></td></tr><% }) %></tbody></table></div></div>
<div id="detalhes" class="card" style="margin-top:12px"><div class="label">Relação das OS filtradas</div><div class="table-wrap"><table class="table compact"><thead><tr><th>OS</th><th>Abertura</th><th>Tipo</th><th>Status</th><th>Equipamento</th><th>Setor</th><th>Solicitante</th></tr></thead><tbody><% if(!d.tabelas.ordens.length){ %><tr><td colspan="7" class="muted">Sem ordens para os filtros selecionados.</td></tr><% } %><% d.tabelas.ordens.slice(0,80).forEach(function(o){ %><tr><td><a href="/os/<%= o.id %>">#<%= o.id %></a></td><td><%= o.opened_at || '-' %></td><td><%= o.tipo || '-' %></td><td><%= o.status || '-' %></td><td><%= o.equipamento || '-' %></td><td><%= o.setor||'-' %></td><td><%= o.solicitante||'-' %></td></tr><% }) %></tbody></table></div></div>
</div></div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>const D=<%- JSON.stringify(d.graficos || {}) %>;function rows(k){return Array.isArray(D[k])?D[k]:[]}function makeChart(id,type,labels,data,label){const el=document.getElementById(id);if(!el||typeof Chart==='undefined'||!labels.length){if(el){el.parentElement.insertAdjacentHTML('beforeend','<p class="muted">Sem dados para montar este gráfico.</p>')}return;}new Chart(el,{type,data:{labels,datasets:[{label:label||'Total',data,backgroundColor:['#16a34a99','#22c55e99','#86efac99','#bbf7d099','#15803d99'],borderColor:'#166534',tension:.3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:type==='doughnut'}}}})}makeChart('chartStatus','bar',rows('os_status').map(x=>x.status),rows('os_status').map(x=>x.total),'OS');makeChart('chartOsMes','line',rows('os_mes').map(x=>x.mes),rows('os_mes').map(x=>x.total),'OS');makeChart('chartCorPrev','doughnut',rows('corretivas_preventivas').map(x=>x.tipo),rows('corretivas_preventivas').map(x=>x.total),'Total');makeChart('chartPrev','bar',rows('preventivas_cumprimento').map(x=>x.situacao),rows('preventivas_cumprimento').map(x=>x.total),'Preventivas');makeChart('chartFalhasEq','bar',rows('falhas_equipamento').map(x=>x.nome),rows('falhas_equipamento').map(x=>x.falhas),'Falhas');makeChart('chartSetor','bar',rows('servicos_setor').map(x=>x.setor||'Sem setor'),rows('servicos_setor').map(x=>x.total),'Serviços');makeChart('chartMecanico','bar',rows('servicos_mecanico').map(x=>x.mecanico),rows('servicos_mecanico').map(x=>x.atendidas),'Serviços');makeChart('chartEvolucao','line',rows('evolucao_ocorrencias').map(x=>x.mes),rows('evolucao_ocorrencias').map(x=>x.total),'Ocorrências');</script>
