    <article><small>RECEBIDO NO TANQUE · FT-IN</small><strong id="dec-inlet-total">— L</strong><span>Totalizador de entrada a integrar</span></article>
    <article><small>TRANSFERIDO · FT-OUT</small><strong id="dec-outlet-total">— L</strong><span id="dec-shift-label">Turno noturno · medição a integrar</span></article>
  </section>
