        <svg id="dec-process-svg" class="dec-process-svg" viewBox="0 0 1400 700" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="dec-svg-title dec-svg-desc">
          <title id="dec-svg-title">Circuito conceitual das decanters</title><desc id="dec-svg-desc">Tanque de quinze mil litros com cinco sensores, mexedor, vapor e PT100. Bomba helicoidal com seleção FAST ou GRATE, dois tachos e rosca de borra. Bombas um e dois para cinco tanques futuros. Sem escala.</desc>
          <defs><clipPath id="dec-tank-clip"><rect x="70" y="165" width="150" height="230" rx="16"/></clipPath></defs>
          <rect width="1400" height="700" fill="#f5f6f8"/>
          <g class="dec-svg-caption"><text x="36" y="40">2A · CIRCUITO FUNCIONAL · SEM ESCALA</text><text x="950" y="40">ARMAZENAMENTO · EXPANSÃO FUTURA</text></g>
          <g class="dec-svg-pipe"><path data-flow="inlet" d="M25 115H145V170"/><path data-flow="steam" d="M25 350H70"/><path data-flow="feed" d="M220 360H290V430H420V120H650"/><path data-flow="GRATE" d="M650 120H1010"/>
            <path data-flow="FAST" d="M650 120V205"/><path data-flow="GRATE" d="M1000 120V205"/>
            <path data-flow="tachoFAST" d="M680 280V345"/><path data-flow="tachoGRATE" d="M1030 280V345"/>
            <path data-flow="borraFAST" d="M575 280V530"/><path data-flow="borraGRATE" d="M925 280V530"/>
            <path data-flow="outFAST" d="M680 425V460H1140"/><path data-flow="outGRATE" d="M1030 425V460H1140"/>
            <path data-flow="out1" d="M1140 460V375H1200M1270 375H1340V100H985"/><path data-flow="out2" d="M1140 460V505H1200M1270 505H1340V100"/>
          </g>
          <g class="dec-svg-future"><% for(let i=1;i<=5;i++){ const x=725+(i-1)*112; %><g data-select-key="storage<%= i %>"><rect x="<%= x %>" y="62" width="60" height="62" rx="14"/><text x="<%= x+30 %>" y="89" text-anchor="middle">T<%= i %></text><text x="<%= x+30 %>" y="111" text-anchor="middle">FUTURO</text></g><% } %></g>
          <g data-select-key="tank"><rect x="68" y="160" width="154" height="240" rx="19" fill="#e4e6ea" stroke="#8c929f" stroke-width="3"/><rect id="dec-svg-tank-fill" x="70" y="395" width="150" height="0" fill="#bc934c" clip-path="url(#dec-tank-clip)"/>
            <ellipse cx="145" cy="165" rx="77" ry="16" fill="#f1f2f4" stroke="#8c929f" stroke-width="3"/><text x="145" y="445" text-anchor="middle">TANQUE DE SERVIÇO</text><text x="145" y="466" text-anchor="middle">15.000 L · nominal</text></g>
          <g data-select-key="mixer"><rect x="128" y="137" width="34" height="27" rx="5" fill="#ba1931"/><path d="M145 160V377" stroke="#555b66" stroke-width="5"/><g id="dec-svg-mixer"><path d="M105 255L185 245M105 245L185 255M105 345L185 335M105 335L185 345" stroke="#555b66" stroke-width="8"/></g></g>
          <g class="dec-svg-sensors"><% [10,25,50,75,90].forEach((p,i)=>{ const y=395-p*2.3; %><g data-select-key="sensor<%= i+1 %>"><path d="M215 <%= y %>H245"/><circle data-level-sensor="<%= i %>" cx="245" cy="<%= y %>" r="6"/><text x="260" y="<%= y+4 %>"><%= ['LSL','LS2','LS3','LS4','LSH'][i] %> · <%= p %>%</text></g><% }) %></g>
          <g class="dec-svg-tag" data-select-key="pt100"><rect x="30" y="490" width="214" height="48" rx="9"/><text x="45" y="511">TT-101 · PT100</text><text x="45" y="529" id="dec-svg-temperature">Temperatura: sem sinal</text></g>
          <g class="dec-svg-tag" data-select-key="inlet"><rect x="20" y="66" width="184" height="35" rx="8"/><text x="31" y="88">FT-IN · total recebido</text></g>
          <g class="dec-svg-valve" data-select-key="steam"><path d="M35 340L55 360V340L35 360Z"/><text x="25" y="330">VAPOR</text></g>
          <g data-select-key="feed"><use href="#dec-bomba" x="284" y="385" width="130" height="86"/><text x="350" y="495" text-anchor="middle">BOMBA HELICOIDAL</text><text x="350" y="515" text-anchor="middle">Alimentação</text></g>
          <% ['FAST','GRATE'].forEach((name,i)=>{const x=520+i*350; %><g data-select-key="<%= name %>"><use href="#dec-decanter" x="<%= x %>" y="183" width="280" height="140"/><text x="<%= x+140 %>" y="182" text-anchor="middle">DECANTER <%= name %></text></g>
          <g class="dec-svg-valve" data-select-key="valve<%= name %>"><path d="M<%= x+120 %> 136L<%= x+140 %> 154L<%= x+140 %> 136L<%= x+120 %> 154Z"/></g>
          <g class="dec-svg-tacho" data-select-key="tacho<%= name %>"><path d="M<%= x+105 %> 345H<%= x+205 %>L<%= x+195 %> 425H<%= x+115 %>Z"/><text x="<%= x+155 %>" y="387" text-anchor="middle">TACHO <%= name %></text></g><% }) %>
