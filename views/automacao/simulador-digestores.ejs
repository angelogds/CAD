<% layout('layout') %>
<% const bancadaPermitida = typeof simuladorBancadaPermitida !== 'undefined' ? simuladorBancadaPermitida : (typeof simuladorBancadaAdmin !== 'undefined' && simuladorBancadaAdmin); %>
<link rel="stylesheet" href="/css/automacao.css?v=20261031-painel-compacto">
<link rel="stylesheet" href="/css/automacao-simulador.css?v=20261031-painel-compacto">
<link rel="stylesheet" href="/css/automacao-digestores-circuito.css?v=20261031-painel-compacto">
<main class="auto-page auto-hmi auto-2a" id="sim-digestores" data-ciclos-csrf="<%= typeof csrfCiclos!=='undefined'?csrfCiclos:'' %>">
  <%- include('partials/brand') %>
  <section class="sim-controls-top sim-command-panel" id="sim-circuit-controls" aria-label="Controles do simulador">
    <div class="sim-command-heading">
      <h1>Simulador dos Digestores</h1>
      <span class="auto-state waiting" id="sim-hardware-indicator" aria-live="polite"><%= bancadaPermitida ? 'Verificando ESP32…' : 'Simulação local' %></span>
      <nav class="sim-command-links" aria-label="Navegação do simulador"><a class="auto-back-link" href="<%= typeof visualizacaoAutomacaoCompleta !== 'undefined' && !visualizacaoAutomacaoCompleta ? '/automacao' : '/automacao/digestores' %>">Voltar</a></nav>
    </div>
    <div class="sim-command-main">
      <label class="sim-command-field" for="sim-select-digestor">Digestores<select id="sim-select-digestor"><option value="1">Digestor 1</option><option value="2">Digestor 2</option><option value="3">Digestor 3</option><option value="4">Digestor 4</option><option value="all" selected>Todos os quatro</option></select></label>
      <div class="sim-command-buttons" role="group" aria-label="Comandos do ciclo">
        <button type="button" id="sim-start" class="sim-command-primary"><span aria-hidden="true">▶</span> Iniciar</button>
        <button type="button" id="sim-pause" disabled><span aria-hidden="true">Ⅱ</span> Pausar</button>
        <button type="button" id="sim-reset"><span aria-hidden="true">↻</span> Reiniciar</button>
      </div>
      <% if (bancadaPermitida) { %>
      <div class="sim-command-connection" role="group" aria-label="Conexão ESP32">
        <button type="button" id="sim-connect-esp32">Conectar ESP32</button>
        <label class="sim-command-switch"><input type="checkbox" id="sim-remote-enable" data-csrf="<%= csrfAutomacao %>"> Espelhar LEDs</label>
      </div>
      <% } %>
    </div>
    <div class="sim-command-secondary">
      <% if (typeof simulacaoCircuitoPermitida !== 'undefined' && simulacaoCircuitoPermitida === true) { %><button type="button" id="sim-link-circuits" aria-pressed="true" title="Integra o ciclo térmico e mecânico da simulação">✓ Ciclo integrado</button><% } %>
      <label class="sim-command-field sim-command-inline" for="sim-speed">Velocidade<select id="sim-speed"><option value="1">1×</option><option value="3" selected>3×</option><option value="8">8×</option></select></label>
      <label class="sim-command-field sim-command-inline" for="sim-purge-seconds">Purgadores (s)<input id="sim-purge-seconds" type="number" min="1" max="300" step="1" value="30" inputmode="numeric"></label>
      <div class="sim-view-buttons" role="group" aria-label="Visualização do circuito"><button type="button" data-circuito-action="view-3d" aria-pressed="true">Cena 3D</button><button type="button" data-circuito-action="view-scheme" aria-pressed="false">Esquema técnico</button></div>
    </div>
    <div class="sim-command-footer">
    <details class="sim-command-details">
      <summary>Ajustes e comunicação</summary>
      <div class="sim-command-detail-body">
        <div class="sim-extra-actions"><button type="button" data-circuito-action="fit">Enquadrar circuito</button><button type="button" data-circuito-action="motion" aria-pressed="false">Pausar animação</button><button type="button" id="sim-presentation" aria-pressed="false">Apresentação</button><a href="/automacao/digestores/ciclos">Histórico e relatórios dos ciclos</a></div>
        <p><span id="sim-selection-status" role="status">Quatro digestores selecionados</span> · <span id="sim-integration-state" role="status">Ciclo integrado</span></p>
        <p id="digestores-circuito-3d-status" role="status" aria-live="polite">Preparando visualização 3D…</p>
        <% if (bancadaPermitida) { %>
        <label class="sim-command-switch"><input type="checkbox" id="sim-auto-sync" checked> Conectar automaticamente ao iniciar</label>
        <p id="sim-remote-status" role="status" aria-live="polite">Aguardando simulação.</p>
        <div class="sim-remote-table-scroll"><table class="sim-remote-table" id="sim-remote-table" aria-label="Estado do ESP32 por digestor"><thead><tr><th>Digestor</th><th>Modo ESP32</th><th>Temperatura</th><th>Faixa</th><th>Sinaleiro</th><th>Sensor</th><th>Enviada</th><th>Recebida</th><th>Aplicada</th><th>Saída</th><th>Contato</th><th>ESP32</th></tr></thead><tbody id="sim-remote-rows"><tr><td colspan="12">Carregando…</td></tr></tbody></table></div>
        <% if (typeof configuracaoAdmin !== 'undefined' && configuracaoAdmin) { %><p><a href="/automacao/configuracao">Configurar ESP32 e abrir IHM local</a></p><% } %>
        <% } %>
        <p class="sim-command-help">Somente LEDs de bancada. Selecione Simulação CAD e habilite GPIO27 na ESP32; não conectar solenóides ou cilindros. Pausar ou reiniciar envia PARADO; confirme na IHM. Após desarmar, selecione novamente Simulação CAD localmente.</p>
        <p class="sim-command-help">Os tempos são virtuais e acompanham a velocidade. Ajuste os purgadores com o ciclo pausado.</p>
        <%- include('partials/digestores-circuito-demo', { controls: typeof simulacaoCircuitoPermitida !== 'undefined' && simulacaoCircuitoPermitida === true }) %>
      </div>
    </details>
    <span id="sim-clock" class="sim-command-clock" aria-live="polite">Tempo virtual: 00:00</span>
    </div>
  </section>
  <%- include('partials/digestores-circuito', { controls: typeof simulacaoCircuitoPermitida !== 'undefined' && simulacaoCircuitoPermitida === true, compact: true }) %>
  <section class="sim-grid" aria-label="Quatro digestores simulados">
    <% for(let id=1;id<=4;id++){ %>
      <article class="sim-vessel-card" data-digestor="<%= id %>">
        <header><div><small>D<%= id %> • SIMULADO</small><h2>Digestor <%= id %></h2></div><span class="sim-status" data-role="status">Carregado</span></header>
        <div class="sim-cycle-steps" aria-label="Etapas simuladas do ciclo">
          <span data-step="CARREGADO" class="is-current">1. Carregado</span>
          <span data-step="AQUECIMENTO">2. Aquecimento</span>
          <span data-step="COZIMENTO">3. Cozimento</span>
          <span data-step="PRONTO">4. Pronto</span>
        </div>
        <div class="sim-machine-row">
          <div class="sim-signal-tower" data-role="tower" data-stage="green" role="img" aria-label="Sinaleiro simulado: verde fixo">
            <span class="sim-lamp sim-lamp-red"></span><span class="sim-lamp sim-lamp-yellow"></span><span class="sim-lamp sim-lamp-green"></span><i class="sim-tower-pole"></i>
            <small>Sinaleiro</small>
          </div>
        <svg viewBox="0 0 280 145" role="img" aria-label="Desenho esquemático do digestor <%= id %>">
          <defs><linearGradient id="sim-metal-<%= id %>" x1="0" x2="1"><stop stop-color="#e9eef1"/><stop offset=".5" stop-color="#bfcad0"/><stop offset="1" stop-color="#8d9da5"/></linearGradient></defs>
          <path d="M28 118H253" stroke="#84949c" stroke-width="7" stroke-linecap="round"/>
          <path d="M72 107V120M216 107V120" stroke="#81939a" stroke-width="10"/>
          <rect x="36" y="35" width="210" height="80" rx="40" fill="url(#sim-metal-<%= id %>)" stroke="#778b94" stroke-width="5"/>
          <ellipse cx="38" cy="75" rx="16" ry="38" fill="#c9d3d7" stroke="#81929a" stroke-width="4"/>
          <path d="M86 35V115M204 35V115" stroke="#8d9da5" stroke-dasharray="5 5" stroke-width="2"/>
          <path d="M154 33V12H187" stroke="#8498a1" stroke-width="7" fill="none"/>
          <circle class="sim-led" cx="218" cy="55" r="10" fill="#94a3ad" stroke="#fff" stroke-width="4"/>
          <text x="140" y="83" text-anchor="middle" fill="#344a54" font-size="19" font-weight="800">D<%= id %></text>
        </svg>
        </div>
        <div class="sim-temperature"><small>Temperatura simulada</small><strong data-role="temperature">30,0 °C</strong><div class="sim-track" data-role="progress" role="progressbar" aria-label="Progresso térmico simulado do digestor <%= id %>" aria-valuemin="30" aria-valuemax="121" aria-valuenow="30"><i data-role="bar"></i></div><div class="sim-scale"><span>0–50 °C · verde</span><span>50–100 °C · amarelo</span><span>100–120 °C · vermelho</span></div></div>
        <div class="sim-io">
          <span>Contator aquecimento <b data-role="contactor">DESLIGADO</b></span>
          <span>Etapa térmica <b data-role="alarm">Carregado / frio</b></span>
        </div>
        <div class="sim-purge" aria-label="Purgadores simulados do digestor <%= id %>">
          <div class="sim-purge-head"><strong>Empurradores / purgadores simulados</strong><span data-role="purga-countdown">Aguardando simulação</span></div>
          <p class="sim-purge-note">Motor do digestor: <strong data-role="motor-virtual">AGUARDANDO CICLO</strong>. Na fase COZIMENTO, os purgadores alternam; o espelhamento em LED depende da autorização local da bancada.</p>
          <div class="sim-purge-grid">
            <div class="sim-purger" data-role="camisa-box" data-state="closed">
              <span class="sim-valve-icon" data-role="camisa-icon" aria-hidden="true">◁▷</span>
              <small>Camisa</small><b data-role="camisa-state">FECHADO</b>
            </div>
            <div class="sim-purger" data-role="eixo-box" data-state="closed">
              <span class="sim-valve-icon" data-role="eixo-icon" aria-hidden="true">◁▷</span>
              <small>Eixo</small><b data-role="eixo-state">FECHADO</b>
            </div>
          </div>
          <small class="sim-purge-note">Estados simulados: um aberto por vez. Relés de LED somente na bancada autorizada.</small>
        </div>
        <div class="sim-card-controls">
          <button type="button" data-action="load">↺ Carregar material</button>
          <button type="button" data-action="heat">▶ Iniciar cozimento</button>
          <span class="sim-unit-clock">Ciclo: <strong data-role="cycle-clock">00:00</strong></span>
        </div>
      </article>
    <% } %>
  </section>
  <p id="sim-cycles-storage-status" role="status" aria-live="polite">Ciclos virtuais concluídos serão gravados em relatório separado. Não representam produção real.</p>
  <section class="sim-events-panel" aria-label="Histórico dos eventos simulados">
    <div class="sim-events-title">
      <div><h2>Histórico da simulação</h2><p>Carregamentos, partidas, mudanças de fase e inversões dos purgadores.</p></div>
      <label for="sim-events-filter">Exibir
        <select id="sim-events-filter">
          <option value="all">Todos os digestores</option>
          <% for(let id=1;id<=4;id++){ %><option value="<%= id %>">Digestor <%= id %></option><% } %>
        </select>
      </label>
    </div>
    <ol id="sim-events-list" class="sim-events-list" aria-live="polite" aria-relevant="additions text"></ol>
    <small>Histórico local e temporário; apagado ao reiniciar ou atualizar a página.</small>
  </section>
  <details class="sim-secondary-details"><summary>Faixas e limites da simulação</summary>
  <section class="auto-bottom-grid">
    <article class="auto-panel"><h2>Faixas demonstrativas</h2><p><strong>0 a 50 °C:</strong> verde fixo · <strong>acima de 50 e abaixo de 100 °C:</strong> amarelo fixo · <strong>100 a 120 °C:</strong> vermelho fixo · <strong>acima de 120 °C:</strong> vermelho piscando, pronto para descarga. O aviso de pronto é uma indicação térmica e não autoriza descarga automática.</p></article>
    <article class="auto-panel"><h2>Limites do simulador</h2><p>O ciclo é gerado no navegador e pode ser sincronizado com a bancada. O aquecimento é apenas representado. Empurradores/purgadores alternam durante o cozimento no intervalo virtual ajustado acima; motor virtual, guilhotinas e etapas mecânicas são espelhados na IHM ESP32. Relés de LED dependem de comunicação, chave local e intertravamentos. Pausar ou reiniciar envia PARADO; confira a confirmação na IHM. Após um desarme, selecione novamente Simulação CAD localmente para retomar os LEDs. Solenóides e cilindros reais ficam fora desta bancada.</p></article>
  </section>
  </details>
</main>
<script src="/js/automacao-simulador-core.js?v=20261031-painel-compacto" defer></script>
<script src="/js/automacao-simulador.js?v=20261031-painel-compacto" defer></script>
<% if (bancadaPermitida) { %><script src="/js/automacao-simulador-http.js?v=20261031-painel-compacto" defer></script><script src="/js/automacao-digestores.js?v=20261031-painel-compacto" defer></script><script src="/js/automacao-simulador-remoto.js?v=20261031-painel-compacto" defer></script><% } %>
<script src="/js/automacao-digestores-circuito-core.js?v=20261031-painel-compacto" defer></script>
<script src="/js/automacao-digestores-circuito.js?v=20261031-painel-compacto" defer></script>
<script type="module" src="/js/automacao-digestores-3d.mjs?v=20261031-painel-compacto"></script>
<% if (typeof csrfCiclos !== 'undefined' && csrfCiclos) { %><script src="/js/automacao-digestores-ciclos-simulacao.js?v=20261030-ciclos1" defer></script><% } %>
