<% layout('layout') %>
<link rel="stylesheet" href="/css/automacao.css?v=20261015-sim">
<link rel="stylesheet" href="/css/automacao-simulador.css?v=20261015-v1">
<main class="auto-page auto-hmi" id="sim-digestores">
  <div class="auto-actions-top"><a class="auto-back-link" href="/automacao/digestores">← Voltar aos Digestores</a></div>
  <header class="auto-hero">
    <div><span class="auto-eyebrow">AUTOMAÇÃO • DIGESTORES • MODO DEMONSTRAÇÃO</span>
      <h1>Simulador dos Digestores</h1>
      <p>Demonstração visual de aquecimento, contatores e alarmes — totalmente separada dos comandos reais.</p>
    </div><span class="auto-state waiting">SIMULAÇÃO • SEM HARDWARE</span>
  </header>
  <section class="auto-alert" role="status"><strong>Simulação, não operação</strong><span>Valores fictícios e faixas demonstrativas: atenção a partir de 110 °C, alarme a partir de 120 °C. Não transmite comandos ao CLP, ESP32, válvulas ou contatores reais.</span></section>
  <div class="sim-toolbar">
    <button type="button" id="sim-start">▶ Iniciar simulação</button>
    <button type="button" id="sim-pause" disabled>Ⅱ Pausar</button>
    <button type="button" id="sim-reset">↺ Reiniciar</button>
    <label for="sim-speed">Velocidade</label><select id="sim-speed"><option value="1">1×</option><option value="3" selected>3×</option><option value="8">8×</option></select>
    <span id="sim-clock" aria-live="polite">Tempo virtual: 00:00</span>
  </div>
  <section class="sim-grid" aria-label="Quatro digestores simulados">
    <% for(let id=1;id<=4;id++){ %>
      <article class="sim-vessel-card" data-digestor="<%= id %>">
        <header><div><small>D<%= id %> • SIMULADO</small><h2>Digestor <%= id %></h2></div><span class="sim-status" data-role="status">Parado</span></header>
        <svg viewBox="0 0 280 145" role="img" aria-label="Desenho esquemático do digestor <%= id %>">
          <defs><linearGradient id="sim-metal-<%= id %>" x1="0" x2="1"><stop stop-color="#e9eef1"/><stop offset=".5" stop-color="#bfcad0"/><stop offset="1" stop-color="#8d9da5"/></linearGradient></defs>
          <path d="M28 118H253" stroke="#84949c" stroke-width="7" stroke-linecap="round"/>
          <path d="M72 107V120M216 107V120" stroke="#81939a" stroke-width="10"/>
          <rect x="36" y="35" width="210" height="80" rx="40" fill="url(#sim-metal-<%= id %>)" stroke="#778b94" stroke-width="5"/>
          <ellipse cx="38" cy="75" rx="16" ry="38" fill="#c9d3d7" stroke="#81929a" stroke-width="4"/>
          <path d="M86 35V115M204 35V115" stroke="#8d9da5" stroke-dasharray="5 5" stroke-width="2"/>
          <path d="M154 33V12H187" stroke="#8498a1" stroke-width="7" fill="none"/>
          <circle class="sim-led" cx="218" cy="55" r="10" fill="#94a3ad" stroke="#fff" stroke-width="4"/>
          <text x="140" y="83" text-anchor="middle" fill="#344a54" font-size="19" font-weight="800">D<%= id %></text>
        </svg>
        <div class="sim-temperature"><small>Temperatura simulada</small><strong data-role="temperature">30,0 °C</strong><div class="sim-track"><i data-role="bar"></i></div></div>
        <div class="sim-io">
          <span>Contator aquecimento <b data-role="contactor">DESLIGADO</b></span>
          <span>Indicador térmico <b data-role="alarm">Normal</b></span>
        </div>
        <label class="sim-toggle"><input type="checkbox" data-role="enabled"> Habilitar aquecimento simulado</label>
      </article>
    <% } %>
  </section>
  <section class="auto-bottom-grid">
    <article class="auto-panel"><h2>Faixas demonstrativas</h2><p><strong>Menor que 110 °C:</strong> aquecimento / normal · <strong>110 a 119,9 °C:</strong> atenção (amarelo) · <strong>120 °C ou mais:</strong> alarme (vermelho). Valores sujeitos à validação técnica.</p></article>
    <article class="auto-panel"><h2>Limites do simulador</h2><p>Funciona somente no navegador, sem rede industrial e sem persistência. Os contatores são indicadores gráficos fictícios; não representam estados elétricos reais.</p></article>
  </section>
</main>
<script src="/js/automacao-simulador.js?v=20261015-v1" defer></script>
