<% layout('layout') %>
<link rel="stylesheet" href="/css/automacao.css?v=20261014-decanters">
<main class="auto-page">
  <nav class="auto-area-nav" aria-label="Navegação das áreas de automação">
    <span class="auto-area-nav-label">ÁREAS</span>
    <a href="/automacao" aria-current="page">Visão das áreas</a>
    <a href="/automacao/digestores">Digestores</a>
    <a href="/automacao/decanters">Decanters e tanque</a>
    <a href="/automacao/prensas">Prensas</a>
  </nav>

  <header class="auto-hero">
    <div>
      <span class="auto-eyebrow">RECICLAGEM • AUTOMAÇÃO INDUSTRIAL</span>
      <h1>Automação</h1>
      <p>IHM web para acompanhar sensores e, futuramente, comandar equipamentos com segurança pela rede industrial.</p>
    </div>
    <span class="auto-state waiting">Em implantação</span>
  </header>
  <section class="auto-grid auto-sectors">
    <% (setores || []).forEach((setor) => { %>
      <a class="auto-sector-card" href="<%= setor.href %>">
        <span class="auto-sector-icon" aria-hidden="true">⚙</span>
        <div><small>SETOR</small><h2><%= setor.title %></h2><p><%= setor.description %></p></div>
        <span class="auto-open">Abrir IHM →</span>
      </a>
    <% }) %>

    <% if (configuracaoAdmin) { %>
      <a class="auto-sector-card" href="/automacao/configuracao" aria-label="Configuração: chaves ESP32 e associação aos digestores">
        <span class="auto-sector-icon" aria-hidden="true">🔐</span>
        <div><small>ADMINISTRADOR • RESTRITO</small><h2>Configuração</h2>
          <p>Gerar, copiar uma vez, substituir ou revogar tokens ESP32. Vincular cada dispositivo a um digestor ou a todos os quatro.</p>
        </div>
        <span class="auto-open">Gerenciar dispositivos →</span>
      </a>
    <% } %>
  </section>
  <section class="auto-note">
    <strong>Primeira etapa</strong>
    <p>Monitoramento por área, com equipamentos e estados indisponíveis até a integração de hardware. As interligações e os comandos dependem de validação de campo e segurança.</p>
  </section>
</main>
