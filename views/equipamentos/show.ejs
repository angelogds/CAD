<% layout('layout') %>
<link rel="stylesheet" href="/css/equipamentos-show.css">
<% const informed = value => value === null || value === undefined || String(value).trim() === '' ? 'Não informado' : value; %>
<% const statusText = String(equip.status_operacional || (equip.ativo ? 'EM_OPERACAO' : 'INATIVO')).replaceAll('_',' ').toLowerCase().replace(/^./, c=>c.toUpperCase()); %>
<% const criticality = String(equip.criticidade || 'Não informada').toLowerCase(); %>
<% const riskClass = riscoFalha ? String(riscoFalha.classificacao_risco || '').toLowerCase() : ''; %>
<% const riskTone = riskClass.includes('crít') || riskClass.includes('crit') ? 'tone-red' : riskClass.includes('elev') ? 'tone-orange' : riskClass.includes('moder') ? 'tone-blue' : ''; %>
<% const nextPreventive = dashboard.proximaPreventiva; const lastMaintenance = dashboard.ultimaManutencao; %>
<svg width="0" height="0" class="hidden" aria-hidden="true"><defs>
<symbol id="eq-edit" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L8 18l-4 1 1-4z"/></symbol><symbol id="eq-doc" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></symbol><symbol id="eq-qr" viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 20h3"/></symbol><symbol id="eq-pulse" viewBox="0 0 24 24"><path d="M3 12h4l2-5 4 10 2-5h6"/><circle cx="12" cy="12" r="10"/></symbol><symbol id="eq-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></symbol><symbol id="eq-clipboard" viewBox="0 0 24 24"><path d="M9 5h6M9 3h6v4H9zM7 5H5v17h14V5h-2M8 12h8M8 16h8"/></symbol><symbol id="eq-alert" viewBox="0 0 24 24"><path d="M10.3 3.8L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L14.7 3.8a2 2 0 00-3.4 0zM12 9v4M12 17h.01"/></symbol><symbol id="eq-camera" viewBox="0 0 24 24"><path d="M4 7h3l2-3h6l2 3h3v13H4z"/><circle cx="12" cy="13" r="4"/></symbol><symbol id="eq-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 15H6L5 6M10 11v6M14 11v6"/></symbol><symbol id="eq-box" viewBox="0 0 24 24"><path d="M21 16V8l-9-5-9 5v8l9 5zM3 8l9 5 9-5M12 13v8"/></symbol></defs></svg>
<div class="equipment-page">
<header class="equipment-header"><div><div class="equipment-breadcrumb"><a href="/equipamentos">Equipamentos</a> / <%= informed(equip.codigo) %></div><div class="equipment-title-line"><h1><%= informed(equip.nome) %></h1><span class="equipment-badge"><%= statusText %></span><span class="equipment-badge <%= criticality==='alta'?'warn':criticality==='critica'?'danger':'info' %>"><%= criticality %></span><span class="equipment-badge"><%= equip.ativo ? 'Ativo' : 'Inativo' %></span></div><div class="equipment-subtitle"><%= informed(equip.tipo) %> • <%= informed(equip.setor) %></div></div>
<div class="equipment-actions"><a class="btn" href="/equipamentos/<%= equip.id %>/editar"><svg class="equipment-icon"><use href="#eq-edit"/></svg>Editar ficha</a><a class="btn" href="/equipamentos/<%= equip.id %>/pdf" target="_blank"><svg class="equipment-icon"><use href="#eq-doc"/></svg>PDF do equipamento</a><a class="btn" href="?tab=qrcode"><svg class="equipment-icon"><use href="#eq-qr"/></svg>QR Code</a><details><summary class="btn">Mais ações</summary><div class="equipment-actions-menu"><% if(qr){ %><a class="btn" target="_blank" href="/equipamentos/<%= equip.id %>/qrcode/print">Imprimir QR Code</a><% } %><form method="POST" action="/equipamentos/<%= equip.id %>/qrcode"><button class="btn" type="submit"><%= qr ? 'Regenerar QR Code' : 'Gerar QR Code' %></button></form><% if(isAdmin){ %><form method="POST" action="/equipamentos/<%= equip.id %>/excluir" onsubmit="return confirm('Excluir este equipamento permanentemente?')"><button class="btn btn-red">Excluir equipamento</button></form><% } %></div></details><a class="btn" href="/equipamentos">Voltar</a></div></header>
<section class="equipment-hero"><article class="equipment-card equipment-photo-card"><div class="equipment-photo"><% if(equip.foto_url && (typeof attachmentExists !== 'function' || attachmentExists(equip.foto_url))){ %><img src="<%= equip.foto_url %>" alt="Foto de <%= equip.nome %>"><% } else { %><div class="equipment-photo-placeholder"><svg class="equipment-icon"><use href="#eq-camera"/></svg><span><%= equip.foto_url ? (REMOVED_ATTACHMENT_MESSAGE || 'Anexo removido.') : 'Sem foto cadastrada' %></span></div><% } %></div><div class="equipment-photo-caption">Foto principal do equipamento</div><div class="equipment-photo-caption"><a class="btn" href="/equipamentos/<%= equip.id %>/editar"><svg class="equipment-icon"><use href="#eq-camera"/></svg>Atualizar foto</a></div><div class="equipment-quick-id"><div><small>Identificação rápida</small><small>CÓDIGO DO EQUIPAMENTO</small><div class="equipment-code"><%= informed(equip.codigo) %></div></div><% if(qrImage){ %><img class="equipment-qr" src="<%= qrImage %>" alt="QR Code do equipamento"><% } else { %><form class="equipment-qr-empty" method="POST" action="/equipamentos/<%= equip.id %>/qrcode">QR Code não gerado<br><button class="btn" type="submit">Gerar</button></form><% } %></div></article>
<div><div class="equipment-summary-grid"><article class="equipment-card equipment-kpi"><svg class="equipment-icon"><use href="#eq-pulse"/></svg><small>Situação</small><strong><%= statusText %></strong><span><%= equip.ativo && String(equip.status_operacional)==='EM_OPERACAO' ? 'Equipamento disponível' : 'Verifique a condição operacional' %></span></article><article class="equipment-card equipment-kpi <%= criticality==='alta'?'tone-orange':criticality==='critica'?'tone-red':'tone-blue' %>"><svg class="equipment-icon"><use href="#eq-shield"/></svg><small>Criticidade</small><strong><%= criticality.replace(/^./,c=>c.toUpperCase()) %></strong><span>Classificação do ativo</span></article><article class="equipment-card equipment-kpi"><svg class="equipment-icon"><use href="#eq-clipboard"/></svg><small>OS ativas</small><strong><%= dashboard.osAtivas.length %></strong><span><%= dashboard.osAtivas.length ? dashboard.osAtivas.length+' ordens aguardando atendimento' : 'Nenhuma pendência' %></span></article><article class="equipment-card equipment-kpi <%= riskTone %>"><svg class="equipment-icon"><use href="#eq-alert"/></svg><small>Risco de falha</small><strong><%= riscoFalha ? riscoFalha.score_risco+' / 100' : 'Não calculado' %></strong><span><%= riscoFalha ? 'Classificação '+informed(riscoFalha.classificacao_risco) : 'Sem avaliação PCM' %></span></article></div>
<article class="equipment-card equipment-identification"><h2 class="equipment-section-title">Identificação do equipamento</h2><div class="equipment-fields"><% [['Código interno',equip.codigo],['Nome',equip.nome],['Setor / Área',equip.setor],['Tipo / Categoria',equip.tipo],['Fabricante',equip.fabricante],['Modelo',equip.modelo],['Número de série',equip.numero_serie],['Ano de fabricação',equip.ano_fabricacao],['Data/Ano de instalação',equip.data_instalacao || equip.ano_instalacao]].forEach(f=>{ %><div class="equipment-field"><small><%= f[0] %></small><strong><%= informed(f[1]) %></strong></div><% }) %></div></article>
<article class="equipment-card equipment-maintenance-strip"><div><h2 class="equipment-section-title">Acompanhamento da manutenção</h2></div><div class="equipment-maintenance-items"><div class="equipment-maintenance-item"><small>Última manutenção</small><strong><%= lastMaintenance ? fmtBR(lastMaintenance.data) : 'Não registrada' %></strong></div><div class="equipment-maintenance-item"><small>Próxima preventiva</small><strong><%= nextPreventive ? nextPreventive.data_prevista : 'A programar' %></strong></div><div class="equipment-maintenance-item"><small>Disponibilidade</small><strong>Não calculada</strong></div><div class="equipment-maintenance-item"><small>Tempo sem falhas</small><strong><%= dashboard.ultimaFalha ? 'Desde '+fmtBR(dashboard.ultimaFalha.opened_at) : 'Não calculado' %></strong></div></div><a class="btn btn-green" href="/os/novo?equipamento_id=<%= equip.id %>">Abrir nova OS</a></article></div></section>
<nav class="equipment-tabs" aria-label="Seções do equipamento"><% [['dados','Visão geral',''],['historico','Histórico de manutenção',''],['pecas','Peças e lista técnica',pecas.length],['preventivas','Preventivas',historicoPreventivas.length],['documentos','Documentos',documentos.length],['tracagem','Traçagens',tracagens.length],['desenho-tecnico','Desenhos técnicos',desenhosTecnicos.length]].forEach(t=>{ %><a class="equipment-tab <%= tab===t[0]?'active':'' %>" href="?tab=<%= t[0] %>"><%= t[1] %><% if(t[2] !== ''){ %><span class="equipment-tab-count"><%= t[2] %></span><% } %></a><% }) %></nav>
<section class="equipment-content"><div class="equipment-card equipment-content-card">
      <% if (tab === 'historico') { %>
        <form class="grid-4" method="GET">
          <input type="hidden" name="tab" value="historico"/>
          <input class="input" type="date" name="data_inicio" value="<%= filtros.data_inicio %>"/>
          <input class="input" type="date" name="data_fim" value="<%= filtros.data_fim %>"/>
          <select class="input" name="tipo">
            <option value="">Tipo da ordem</option>
            <option value="CORRETIVA" <%= filtros.tipo === 'CORRETIVA' ? 'selected' : '' %>>Corretiva</option>
            <option value="PREVENTIVA" <%= filtros.tipo === 'PREVENTIVA' ? 'selected' : '' %>>Preventiva</option>
            <option value="NRS" <%= filtros.tipo === 'NRS' ? 'selected' : '' %>>NR12</option>
            <option value="OUTROS" <%= filtros.tipo === 'OUTROS' ? 'selected' : '' %>>Outras</option>
          </select>
          <select class="input" name="grau">
            <option value="">Grau</option>
            <option value="BAIXA" <%= filtros.grau === 'BAIXA' ? 'selected' : '' %>>Baixo</option>
            <option value="MEDIA" <%= filtros.grau === 'MEDIA' ? 'selected' : '' %>>Médio</option>
            <option value="ALTA" <%= filtros.grau === 'ALTA' ? 'selected' : '' %>>Alto</option>
            <option value="CRITICA" <%= filtros.grau === 'CRITICA' ? 'selected' : '' %>>Crítico</option>
          </select>
          <button class="btn">Filtrar</button>
        </form>
        <h3>OS do equipamento</h3>
        <div class="table-wrap"><table class="table"><thead><tr><th>#</th><th>Abertura</th><th>Fechamento</th><th>Tipo</th><th>Grau</th><th>Descrição</th><th>Parada (h)</th><th>Custo</th></tr></thead><tbody><% if(!historicoOS.length){ %><tr><td colspan="8">Sem OS no período.</td></tr><% } %><% historicoOS.forEach(o=>{ %><tr><td><%= o.id %></td><td><%= fmtBR(o.opened_at) %></td><td><%= fmtBR(o.closed_at) %></td><td><%= o.tipo %></td><td><%= o.grau %></td><td><%= o.descricao %></td><td><%= o.tempo_parada_horas || '-' %></td><td>R$ <%= Number(o.custo_total||0).toFixed(2) %></td></tr><% }) %></tbody></table></div>
        <h3 style="margin-top:12px;">Preventivas executadas</h3>
        <div class="table-wrap"><table class="table"><thead><tr><th>Preventiva</th><th>Datas</th><th>Equipe</th><th>Descrição</th><th>Não conformidade</th><th>Ações / situação final</th><th>Registro</th></tr></thead><tbody><% if(!historicoPreventivas.length){ %><tr><td colspan="7">Sem preventivas.</td></tr><% } %><% historicoPreventivas.forEach(p=>{ const equipe = [p.responsavel_1_nome, p.responsavel_2_nome].filter(Boolean).join(' + ') || p.responsavel || '-'; %><tr><td><strong><%= p.atividade %></strong><br><span class="muted"><%= p.tipo_preventiva || 'preventiva' %></span></td><td>Prevista: <%= p.data_prevista || '-' %><br>Executada: <%= p.data_executada || '-' %></td><td><%= equipe %></td><td><%= p.descricao_preventiva || p.observacao || '-' %></td><td><%= p.nao_conformidade || '-' %></td><td>Corretiva: <%= p.acao_corretiva || '-' %><br>Preventiva: <%= p.acao_preventiva || '-' %><br>Final: <%= String(p.situacao_final || '-').replaceAll('_',' ') %></td><td><a href="/preventivas/<%= p.id ? p.plano_id || '' : '' %>">Ver registro</a><% if(p.os_corretiva_id){ %><br><a href="/os/<%= p.os_corretiva_id %>">OS #<%= p.os_corretiva_id %></a><% } %></td></tr><% }) %></tbody></table></div>
      <% } else if (tab === 'pecas') { %>
        <form method="POST" action="/equipamentos/<%= equip.id %>/pecas" class="grid-3">
          <select name="peca_id" class="input"><option value="">Selecionar peça catálogo</option><% catalogoPecas.forEach(c=>{ %><option value="<%= c.id %>"><%= c.tipo %> - <%= c.modelo_descricao %></option><% }) %></select>
          <input class="input" name="descricao_item" placeholder="Descrição do item" required/>
          <input class="input" name="modelo_descricao" placeholder="Medida (ex: 3/4, 20mm)"/>
          <select class="input" name="unidade_medida">
            <option value="UNIDADE">Unidade</option>
            <option value="CAIXA">Caixa</option>
            <option value="QUILO">Quilo</option>
            <option value="LITRO">Litro</option>
            <option value="METRO">Metro</option>
          </select>
          <input class="input" type="number" min="1" name="quantidade" placeholder="Quantidade" value="1"/>
          <input class="input" name="aplicacao" placeholder="Aplicação (opcional)"/>
          <button class="btn btn-green">+ Adicionar novo item</button>
          <input class="input" name="tipo" placeholder="(nova) Tipo"/>
          <input class="input" name="codigo_interno" placeholder="(nova) Código interno"/>
          <input class="input" name="fabricante" placeholder="(nova) Fabricante"/>
        </form>
        <div class="table-wrap"><table class="table"><thead><tr><th>Item</th><th>Descrição</th><th>Medida</th><th>Unidade</th><th>Quantidade</th><th>Ações</th></tr></thead><tbody><% if(!pecas.length){ %><tr><td colspan="6">Nenhuma peça associada.</td></tr><% } %><% pecas.forEach((p, idx)=>{ const emEdicao = editItemId === p.id; %><tr><td>Item <%= idx + 1 %></td><% if (emEdicao) { %><td colspan="4"><form method="POST" action="/equipamentos/<%= equip.id %>/pecas/<%= p.id %>" class="grid-4"><input class="input" name="descricao_item" value="<%= p.descricao_item || '' %>" placeholder="Descrição" required/><input class="input" name="modelo_descricao" value="<%= p.modelo_descricao || '' %>" placeholder="Medida"/><select class="input" name="unidade_medida"><% ['UNIDADE','CAIXA','QUILO','LITRO','METRO'].forEach(un=>{ %><option value="<%= un %>" <%= (p.unidade_medida || 'UNIDADE') === un ? 'selected' : '' %>><%= un.charAt(0) + un.slice(1).toLowerCase() %></option><% }) %></select><input class="input" type="number" min="1" name="quantidade" value="<%= p.quantidade || 1 %>"/><input type="hidden" name="aplicacao" value="<%= p.aplicacao || '' %>"/><button class="btn">Salvar</button><a class="btn" href="?tab=pecas">Cancelar</a></form></td><td><div class="acao-inline"><% if (isAdmin) { %><form method="POST" action="/equipamentos/<%= equip.id %>/pecas/<%= p.id %>/remover"><button class="btn btn-red btn-icon" title="Remover"><svg class="equipment-icon" aria-hidden="true"><use href="#eq-trash"/></svg></button></form><% } %></div></td><% } else { %><td><%= p.descricao_item || '-' %></td><td><%= p.modelo_descricao || '-' %></td><td><%= p.unidade_medida || 'UNIDADE' %></td><td><%= p.quantidade || 1 %></td><td><div class="acao-inline"><a class="btn btn-icon" title="Editar" href="?tab=pecas&editar_item=<%= p.id %>"><svg class="equipment-icon" aria-hidden="true"><use href="#eq-edit"/></svg></a><% if (isAdmin) { %><form method="POST" action="/equipamentos/<%= equip.id %>/pecas/<%= p.id %>/remover"><button class="btn btn-red btn-icon" title="Remover"><svg class="equipment-icon" aria-hidden="true"><use href="#eq-trash"/></svg></button></form><% } %></div></td><% } %></tr><% }) %></tbody></table></div>
      <% } else if (tab === 'preventivas') { %>
        <div class="equipment-card-head"><h2 class="equipment-section-title">Preventivas</h2><a class="btn btn-green" href="/preventivas">Abrir módulo de Preventivas</a></div>
        <div class="equipment-preventive-list"><% if(!historicoPreventivas.length){ %><div class="equipment-empty">Nenhuma preventiva programada ou executada para este equipamento.</div><% } %><% historicoPreventivas.forEach(p=>{ %><article class="equipment-preventive"><strong><%= p.atividade || 'Preventiva' %></strong><div class="muted">Prevista: <%= p.data_prevista || 'Não informada' %> · Executada: <%= p.data_executada || 'Não executada' %> · Situação: <%= String(p.status || 'Não informada').replaceAll('_',' ') %></div><a href="/preventivas/<%= p.plano_id || '' %>">Ver registro</a></article><% }) %></div>
      <% } else if (tab === 'documentos') { %>
        <form method="POST" action="/equipamentos/<%= equip.id %>/documentos" enctype="multipart/form-data" class="grid-3">
          <select class="input" name="tipo_documento" id="tipo_documento" required>
            <option value="">Selecione o tipo do documento</option>
            <option value="manual">Manual</option>
            <option value="laudo">Laudo</option>
          </select>
          <input class="input" name="descricao" placeholder="Descrição"/>
          <input class="input" type="file" name="arquivo" accept="application/pdf" required/>
          <input class="input" type="date" name="data_emissao" id="data_emissao"/>
          <input class="input" type="date" name="validade" id="validade"/>
          <input class="input" name="responsavel" placeholder="Responsável"/>
          <button class="btn btn-green">Anexar documento</button>
        </form>
        <script>
          (() => {
            const tipoSelect = document.getElementById("tipo_documento");
            const dataEmissao = document.getElementById("data_emissao");
            const validade = document.getElementById("validade");

            if (!tipoSelect || !dataEmissao || !validade) return;

            function atualizarCamposDeData() {
              const ehLaudo = tipoSelect.value === "laudo";

              dataEmissao.required = ehLaudo;
              validade.required = ehLaudo;
              dataEmissao.classList.toggle("hidden", !ehLaudo);
              validade.classList.toggle("hidden", !ehLaudo);

              if (!ehLaudo) {
                dataEmissao.value = "";
                validade.value = "";
              }
            }

            tipoSelect.addEventListener("change", atualizarCamposDeData);
            atualizarCamposDeData();
          })();
        </script>
        <div class="table-wrap"><table class="table"><thead><tr><th>Tipo</th><th>Descrição</th><th>Emissão</th><th>Validade</th><th>Responsável</th><th>Ações</th></tr></thead><tbody><% if(!documentos.length){ %><tr><td colspan="6">Sem documentos anexados.</td></tr><% } %><% documentos.forEach(d=>{ %><tr><td><%= d.tipo_documento %></td><td><%= d.descricao || '-' %></td><td><%= d.data_emissao || '-' %></td><td><%= d.validade || '-' %></td><td><%= d.responsavel || '-' %></td><td><a class="btn" href="<%= d.caminho_arquivo %>" download>Baixar</a><% if (isAdmin) { %><form method="POST" action="/equipamentos/<%= equip.id %>/documentos/<%= d.id %>/remover" style="display:inline;"><button class="btn btn-red">Remover</button></form><% } %></td></tr><% }) %></tbody></table></div>
      <% } else if (tab === 'tracagem') { %>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
          <h3>Traçagens relacionadas</h3>
          <a class="btn btn-green" href="/tracagem">Abrir Traçagem</a>
        </div>
        <div class="table-wrap"><table class="table"><thead><tr><th>ID</th><th>Título</th><th>Tipo</th><th>Data</th><th>PDF</th><th>Ações</th></tr></thead><tbody><% if(!tracagens.length){ %><tr><td colspan="6">Sem traçagens vinculadas a este equipamento.</td></tr><% } %><% tracagens.forEach(t=>{ %><tr><td>#<%= t.id %></td><td><%= t.titulo || '-' %></td><td><%= t.tipo %></td><td><%= fmtBR(t.created_at) %></td><td><a class="btn" href="/tracagens/pdf/<%= t.id %>" target="_blank">Baixar PDF</a></td><td><a class="btn" href="/tracagem/<%= t.id %>">Visualizar</a></td></tr><% }) %></tbody></table></div>

      <% } else if (tab === 'desenho-tecnico') { %>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
          <h3>Desenhos Técnicos relacionados</h3>
          <a class="btn btn-green" href="/desenho-tecnico">Abrir Desenho Técnico</a>
        </div>
        <div class="table-wrap"><table class="table"><thead><tr><th>ID</th><th>Título</th><th>Equipamento</th><th>Data</th><th>Ações</th></tr></thead><tbody><% if(!desenhosTecnicos.length){ %><tr><td colspan="5">Sem desenhos técnicos vinculados a este equipamento.</td></tr><% } %><% desenhosTecnicos.filter(d => d.tipo_origem==='cad').forEach(d=>{ %><tr><td><%= d.id %></td><td><%= d.titulo %></td><td><%= d.equipamento_nome || '-' %></td><td><%= (d.atualizado_em || '').slice(0,10) %></td><td><a class="btn" href="/desenho-tecnico/cad/<%= d.id %>/editor">Abrir editor</a> <a class="btn" href="/desenho-tecnico/cad/<%= d.id %>/pdf" target="_blank">PDF</a></td></tr><% }) %></tbody></table></div>

      <% } else if (tab === 'qrcode') { %>
        <% if (qrImage) { %><img src="<%= qrImage %>" style="max-width:260px;"/><p><a href="<%= qrUrl %>" target="_blank"><%= qrUrl %></a></p><a class="btn" href="/equipamentos/<%= equip.id %>/qrcode/print" target="_blank">Imprimir QR Code</a><% } else { %><p>Ainda sem QR Code. Use o botão de gerar.</p><% } %>
      <% } else { %>
<div class="equipment-overview-grid"><article class="equipment-card equipment-tech-card"><div class="equipment-card-head"><h2 class="equipment-section-title">Dados técnicos</h2><a class="btn" href="/equipamentos/<%= equip.id %>/editar">Editar dados técnicos</a></div><div class="equipment-tech-grid"><% [['Capacidade',[equip.capacidade,equip.unidade_capacidade].filter(Boolean).join(' ')],['Pressão de trabalho',[equip.pressao_trabalho,equip.unidade_pressao].filter(Boolean).join(' ')],['Potência',[equip.potencia,equip.unidade_potencia].filter(Boolean).join(' ')],['Tensão',equip.tensao],['Idade do equipamento',idadeEquipamento===null?'Não informada':idadeEquipamento+' anos'],['Situação do cadastro',equip.ativo?'Ativo':'Inativo']].forEach(f=>{ %><div class="equipment-field"><small><%= f[0] %></small><strong><%= informed(f[1]) %></strong></div><% }) %><div class="equipment-field equipment-observations"><small>Observações técnicas</small><strong><%= informed(equip.observacoes_tecnicas || equip.observacao) %></strong></div></div></article><div><article class="equipment-card equipment-maintenance-card"><h2 class="equipment-section-title">Manutenção atual</h2><% if(!dashboard.osAtivas.length){ %><div class="equipment-empty"><svg class="equipment-icon"><use href="#eq-clipboard"/></svg><div><strong>Nenhuma OS ativa para este equipamento.</strong><br>O equipamento está disponível para operação.</div></div><a class="btn" href="?tab=historico">Ver histórico de OS</a><% } else { dashboard.osAtivas.forEach(o=>{ %><article class="equipment-current-os"><strong>OS #<%= o.id %> · <%= informed(o.prioridade) %></strong><div class="muted"><%= informed(o.status) %> · Aberta em <%= fmtBR(o.opened_at) %></div><p><%= informed(o.descricao) %></p><a href="/os/<%= o.id %>">Abrir ordem</a></article><% }) } %></article><article class="equipment-card equipment-links-card"><h2 class="equipment-section-title">Documentos e vínculos</h2><div class="equipment-links-grid"><% [['documentos','Manuais e documentos',documentos.length,'eq-doc'],['tracagem','Traçagens vinculadas',tracagens.length,'eq-pulse'],['pecas','Peças cadastradas',pecas.length,'eq-box'],['desenho-tecnico','Desenhos técnicos',desenhosTecnicos.length,'eq-edit']].forEach(x=>{ %><a class="equipment-link" href="?tab=<%= x[0] %>"><svg class="equipment-icon"><use href="#<%= x[3] %>"/></svg><span><%= x[1] %></span><b><%= x[2] %> →</b></a><% }) %></div></article></div></div>
<article class="equipment-card equipment-activity"><div class="equipment-card-head"><h2 class="equipment-section-title">Atividade recente</h2><a href="?tab=historico">Ver histórico completo →</a></div><div class="equipment-timeline"><% if(equip.created_at){ %><div class="equipment-event"><strong>Equipamento cadastrado</strong><span><%= fmtBR(equip.created_at) %></span></div><% } %><% if(qr && qr.criado_em){ %><div class="equipment-event"><strong>QR Code disponível</strong><span><%= fmtBR(qr.criado_em) %></span></div><% } %><% historicoOS.slice(0,3).forEach(o=>{ %><div class="equipment-event"><strong>OS #<%= o.id %> <%= o.closed_at?'concluída':'aberta' %></strong><span><%= fmtBR(o.closed_at || o.opened_at) %> · <%= informed(o.descricao) %></span></div><% }) %><% if(!equip.created_at && !qr && !historicoOS.length){ %><div class="muted">Nenhuma atividade confiável registrada.</div><% } %></div></article>
      <% } %>
</div></section></div>
