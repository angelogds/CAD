<% layout('layout') %>
<link rel="stylesheet" href="/css/equipamentos.css">
<% const qs=(over={})=>new URLSearchParams(Object.entries({...filters,...over}).filter(([,v])=>v!==''&&v!=null)).toString(); const statusLabel=s=>({EM_OPERACAO:'Em operação',EM_MANUTENCAO:'Em manutenção',PARADO:'Parado',INATIVO:'Inativo'}[s]||s||'Não registrada'); const dist=Object.fromEntries(painel.distribution.map(x=>[x.criticidade,Number(x.total)])); const maxDist=Math.max(...Object.values(dist),1); %>
<div class="equip-page">
<header class="equip-head"><div><h1>Equipamentos</h1><div class="equip-sub">Gestão do parque industrial, disponibilidade e criticidade</div></div><div class="equip-actions"><a class="eq-btn" href="/equipamentos/pdf/lista" target="_blank">PDF dos equipamentos</a><% if(canManage){ %><a class="eq-btn primary" href="/equipamentos/novo">+ Novo equipamento</a><% } %></div></header>
<section class="metrics" aria-label="Indicadores de equipamentos">
<% [['','Total de equipamentos',painel.indicators.total,'Parque cadastrado','#168b4c'],['EM_OPERACAO','Em operação',painel.indicators.operacao,'Disponíveis para operação','#168b4c'],['EM_MANUTENCAO','Em manutenção',painel.indicators.manutencao,'Acompanhamento ativo','#087caa'],['','Equipamentos críticos',painel.indicators.criticos,'Requerem atenção','#ed6b16'],['OS_ABERTAS','OS abertas',painel.indicators.os_abertas,'Vinculadas a equipamentos','#7048cf']].forEach((m,i)=>{ const href=i===3?`?${qs({criticidade:'critica',tab:'',situacao:'',page:1})}`:`?${qs({tab:m[0],situacao:'',criticidade:i===0?'':filters.criticidade,page:1})}`; %>
<a class="metric" style="--accent:<%= m[4] %>" href="<%= href %>"><div class="metric-label"><%= m[1] %></div><div class="metric-value"><%= m[2]||0 %></div><div class="metric-note"><%= m[3] %></div></a><% }) %>
</section>
<section class="eq-card"><h2>Equipamentos que exigem atenção</h2><% if(!painel.attention.length){ %><div class="empty">Nenhum equipamento exige atenção neste momento.</div><% } else { %><div class="attention-list"><% painel.attention.forEach(e=>{ %><article class="attention-item"><strong><%= e.nome %></strong><span class="badge crit-<%= e.criticidade %>"><%= e.criticidade %></span> <span class="badge status-<%= String(e.status_operacional).toLowerCase() %>"><%= statusLabel(e.status_operacional) %></span><span class="subline"><%= e.falhas %> OS no histórico • <%= e.os_ativas %> ativa(s)</span><div class="inline-links"><a href="/equipamentos/<%= e.id %>">Abrir ficha</a><a href="/dashboard/criticidade">Ver painel de criticidade</a></div></article><% }) %></div><% } %></section>
<section class="eq-card">
<nav class="quick-tabs" aria-label="Filtros rápidos"><% [['','Todos'],['EM_OPERACAO','Em operação'],['EM_MANUTENCAO','Em manutenção'],['PARADO','Parados'],['INATIVOS','Inativos']].forEach(t=>{ %><a class="<%= (filters.tab||'')===t[0]?'active':'' %>" href="?<%= qs({tab:t[0],situacao:'',page:1}) %>"><%= t[1] %></a><% }) %></nav>
<form method="GET" class="filter-grid"><input type="hidden" name="tab" value="<%= filters.tab %>"><div class="field"><label for="q">Pesquisa</label><input class="eq-input" id="q" name="q" value="<%= filters.q %>" placeholder="Código, equipamento, setor ou tipo"></div><div class="field"><label for="setor">Setor</label><select class="eq-input" id="setor" name="setor"><option value="">Todos</option><% options.setores.forEach(v=>{ %><option <%= filters.setor===v?'selected':'' %>><%= v %></option><% }) %></select></div><div class="field"><label for="tipo">Tipo</label><select class="eq-input" id="tipo" name="tipo"><option value="">Todos</option><% options.tipos.forEach(v=>{ %><option <%= filters.tipo===v?'selected':'' %>><%= v %></option><% }) %></select></div><div class="field"><label for="criticidade">Criticidade</label><select class="eq-input" id="criticidade" name="criticidade"><option value="">Todas</option><% ['baixa','media','alta','critica'].forEach(v=>{ %><option value="<%= v %>" <%= filters.criticidade===v?'selected':'' %>><%= v %></option><% }) %></select></div><div class="field"><label for="situacao">Situação</label><select class="eq-input" id="situacao" name="situacao"><option value="">Todas</option><% [['EM_OPERACAO','Em operação'],['EM_MANUTENCAO','Em manutenção'],['PARADO','Parado'],['INATIVO','Inativo']].forEach(v=>{ %><option value="<%= v[0] %>" <%= filters.situacao===v[0]?'selected':'' %>><%= v[1] %></option><% }) %></select></div><div class="equip-actions"><button class="eq-btn" type="submit">Filtrar</button><a class="eq-btn" href="/equipamentos">Limpar</a></div></form>
</section>
<section class="eq-card"><div style="display:flex;justify-content:space-between"><h2>Lista de equipamentos</h2><form method="GET"><% Object.entries(filters).filter(([k])=>!['limit','page'].includes(k)).forEach(([k,v])=>{ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %><label>Exibir <select name="limit" onchange="this.form.submit()"><% [10,20,50].forEach(n=>{ %><option <%= painel.pageSize===n?'selected':'' %>><%= n %></option><% }) %></select></label></form></div>
<div class="table-scroll"><table class="eq-table"><thead><tr><th>Código</th><th>Equipamento</th><th>Setor / Tipo</th><th>Criticidade</th><th>Situação</th><th>OS ativas</th><th>Última manutenção</th><th>Ações</th></tr></thead><tbody><% if(!painel.items.length){ %><tr><td colspan="8" class="empty">Nenhum equipamento encontrado para os filtros selecionados.</td></tr><% } painel.items.forEach(e=>{ %><tr><td><strong><%= e.codigo||'—' %></strong></td><td><span class="eq-name"><%= e.nome %></span></td><td><%= e.setor||'Não registrado' %><span class="subline"><%= e.tipo||'Tipo não registrado' %></span></td><td><span class="badge crit-<%= e.criticidade||'media' %>"><%= e.criticidade||'Média' %></span></td><td><span class="badge status-<%= String(e.status_operacional||'').toLowerCase() %>"><%= statusLabel(e.status_operacional) %></span></td><td><% if(e.os_ativas>0){ %><a class="os-link" href="/os?equipamento_id=<%= e.id %>"><%= e.os_ativas %> OS</a><% }else{%>0 OS<%}%></td><td><%= e.ultima_manutencao?fmtBR(e.ultima_manutencao):'Não registrada' %></td><td><div class="row-actions"><a class="eq-btn" style="min-height:32px;padding:0 10px" href="/equipamentos/<%= e.id %>">Abrir ficha</a><% if(canManage){%><details class="more"><summary>Mais</summary><div class="more-menu"><a href="/equipamentos/<%= e.id %>/editar">Editar</a><% if(isAdmin){%><form method="POST" action="/equipamentos/<%= e.id %>/excluir" onsubmit="return confirm('Excluir ou inativar este equipamento?')"><button type="submit">Excluir / inativar</button></form><%}%></div></details><%}%></div></td></tr><% }) %></tbody></table></div>
<div class="table-footer"><span>Mostrando <%= painel.items.length %> de <%= painel.total %> equipamentos</span><nav class="pagination"><% for(let p=1;p<=painel.pages;p++){ if(p===1||p===painel.pages||Math.abs(p-painel.page)<=1){ %><a class="<%= p===painel.page?'active':'' %>" href="?<%= qs({page:p}) %>"><%= p %></a><% }} %></nav></div></section>
<div class="bottom-grid"><section class="eq-card"><h2>Distribuição por criticidade</h2><% [['baixa','#168b4c'],['media','#2384df'],['alta','#ef6c00'],['critica','#db2027']].forEach(x=>{const n=dist[x[0]]||0;%><div class="bar-row"><span><%= x[0] %></span><div class="bar"><span style="--bar:<%=x[1]%>;width:<%=n/maxDist*100%>%"></span></div><strong><%=n%></strong></div><%})%></section><section class="eq-card"><h2>Equipamentos em manutenção</h2><% if(!painel.maintenance.length){%><div class="empty">Nenhum equipamento em manutenção.</div><%} painel.maintenance.forEach(e=>{%><div class="maint-row"><div><strong><%=e.nome%></strong><span class="subline"><%=e.responsavel||'Responsável não informado'%> • <%=e.dias||0%> dia(s)</span></div><span class="badge status-<%=String(e.status_operacional).toLowerCase()%>"><%=statusLabel(e.status_operacional)%></span><a class="os-link" href="<%=e.os_id?'/os/'+e.os_id:'/equipamentos/'+e.id%>"><%=e.os_id?'OS #'+e.os_id:'Abrir ficha'%></a></div><%})%></section></div>
</div>
