<% layout('layout') %><link rel="stylesheet" href="/css/equipamentos.css">
<% const v=n=>equip?.[n]??''; const err=n=>errors?.[n]||''; %>
<div class="equip-page"><header class="equip-head"><div><div style="display:flex;gap:10px;align-items:center"><h1><%= editing?'Editar equipamento':'Novo equipamento' %></h1><span class="form-head-badge">CADASTRO TÉCNICO</span></div><div class="equip-sub">Cadastre a identificação, os dados técnicos e o plano de manutenção</div></div><a class="eq-btn" href="<%= editing?'/equipamentos/'+equip.id:'/equipamentos' %>">Voltar</a></header>
<div class="steps"><div class="step">1. Identificação</div><div class="step">2. Dados técnicos</div><div class="step">3. Manutenção e documentos</div></div>
<form data-equipment-form action="<%= editing?'/equipamentos/'+equip.id+'/editar':'/equipamentos' %>" method="POST" enctype="multipart/form-data"><div class="form-layout"><main>
<section class="form-card"><h2>Identificação do equipamento</h2><div class="form-grid"><% [['codigo','Código interno / Tag *','Ex.: EQP-0001'],['nome','Nome do equipamento *','Ex.: Bomba centrífuga'],['setor','Setor / Área *','Ex.: Caldeiras'],['tipo','Tipo / Categoria *','Ex.: Bomba'],['fabricante','Fabricante','Ex.: WEG'],['modelo','Modelo','Ex.: W22 Premium'],['numero_serie','Número de série','Ex.: SN-123456']].forEach(f=>{%><div class="field"><label for="<%=f[0]%>"><%=f[1]%></label><input class="eq-input" id="<%=f[0]%>" name="<%=f[0]%>" value="<%=v(f[0])%>" placeholder="<%=f[2]%>" <%=['codigo','nome','setor','tipo'].includes(f[0])?'required':''%>><%if(err(f[0])){%><div class="field-error" role="alert"><%=err(f[0])%></div><%}%></div><%})%><div class="field"><label for="ano_fabricacao">Ano de fabricação</label><input class="eq-input" type="number" min="1900" max="<%=new Date().getFullYear()+1%>" id="ano_fabricacao" name="ano_fabricacao" value="<%=v('ano_fabricacao')%>"><%if(err('ano_fabricacao')){%><div class="field-error"><%=err('ano_fabricacao')%></div><%}%></div><div class="field"><label for="data_instalacao">Data de instalação</label><input class="eq-input" type="date" id="data_instalacao" name="data_instalacao" value="<%=v('data_instalacao')%>"></div></div></section>
<section class="form-card"><h2>Dados técnicos</h2><div class="form-grid three"><% [['capacidade','Capacidade'],['unidade_capacidade','Unidade da capacidade'],['pressao_trabalho','Pressão de trabalho'],['unidade_pressao','Unidade da pressão'],['potencia','Potência'],['unidade_potencia','Unidade da potência'],['tensao','Tensão']].forEach(f=>{%><div class="field"><label for="<%=f[0]%>"><%=f[1]%></label><input class="eq-input" id="<%=f[0]%>" name="<%=f[0]%>" value="<%=v(f[0])%>" inputmode="decimal"></div><%})%><div class="field full"><label for="observacoes_tecnicas">Observações técnicas</label><textarea class="eq-input eq-textarea" id="observacoes_tecnicas" name="observacoes_tecnicas"><%=v('observacoes_tecnicas')%></textarea></div></div></section>
<section class="form-card"><h2>Manutenção e classificação</h2><div class="form-grid three"><div class="field"><label for="criticidade">Criticidade</label><select class="eq-input" id="criticidade" name="criticidade"><%[['baixa','Baixa'],['media','Média'],['alta','Alta'],['critica','Crítica']].forEach(x=>{%><option value="<%=x[0]%>" <%=String(v('criticidade')||'media')===x[0]?'selected':''%>><%=x[1]%></option><%})%></select></div><div class="field"><label for="status_operacional">Situação operacional</label><select class="eq-input" id="status_operacional" name="status_operacional"><%[['EM_OPERACAO','Em operação'],['EM_MANUTENCAO','Em manutenção'],['PARADO','Parado'],['INATIVO','Inativo']].forEach(x=>{%><option value="<%=x[0]%>" <%=String(v('status_operacional')||'EM_OPERACAO')===x[0]?'selected':''%>><%=x[1]%></option><%})%></select></div><div class="field"><label for="ativo">Situação do cadastro</label><select class="eq-input" id="ativo" name="ativo"><option value="1" <%=Number(equip?.ativo ?? 1)===1?'selected':''%>>Ativo</option><option value="0" <%=Number(equip?.ativo ?? 1)===0?'selected':''%>>Inativo</option></select></div><div class="field"><label for="responsavel_setor">Responsável / Setor</label><input class="eq-input" id="responsavel_setor" name="responsavel_setor" value="<%=v('responsavel_setor')%>"></div><div class="field"><label><input type="checkbox" name="possui_plano_preventivo" value="1" <%=Number(v('possui_plano_preventivo'))===1?'checked':''%>> Cadastrar periodicidade preventiva</label></div><div class="field"><label for="periodicidade_preventiva">Periodicidade</label><select class="eq-input" name="periodicidade_preventiva" id="periodicidade_preventiva"><option value="">Selecione</option><%['Semanal','Mensal','Trimestral','Semestral','Anual'].forEach(x=>{%><option <%=v('periodicidade_preventiva')===x?'selected':''%>><%=x%></option><%})%></select></div></div></section>
<section class="form-card"><h2>Foto e documentos</h2><div class="form-grid"><div class="field upload"><label for="foto">Foto principal</label><input id="foto" type="file" name="foto" accept="image/jpeg,image/png,image/webp"><span class="subline">JPG, PNG ou WEBP (máx. 10 MB)</span><%if(editing&&v('foto_url')){%><label><input type="checkbox" name="remover_foto" value="1"> Remover foto atual</label><%}%></div><div class="field upload"><label for="documento_tecnico">Manual / ficha técnica</label><input id="documento_tecnico" type="file" name="documento_tecnico" accept="application/pdf,image/jpeg,image/png,image/webp"><span class="subline">PDF ou imagem (máx. 10 MB). O anexo atual será preservado.</span></div><div class="field full"><label for="observacao">Observações gerais</label><textarea class="eq-input eq-textarea" id="observacao" name="observacao"><%=v('observacao')%></textarea></div></div></section>
<div class="form-actions"><a data-cancel class="eq-btn" href="<%=editing?'/equipamentos/'+equip.id:'/equipamentos'%>">Cancelar</a><button class="eq-btn" name="submit_action" value="open" type="submit">Salvar e abrir ficha</button><button class="eq-btn primary" name="submit_action" value="list" type="submit">Salvar equipamento</button></div></main>
<aside class="form-side"><section class="side-card"><h2>Resumo do cadastro</h2><p>Identificação básica</p><p>Dados técnicos</p><p>Classificação</p><p>Foto e documentos</p><span data-progress-text></span><div class="progress"><span data-progress></span></div></section><section class="side-card preview"><h2>Pré-visualização</h2><img data-preview-image src="<%=v('foto_url')||'/images/pwa/icon.png'%>" alt="Pré-visualização do equipamento"><h3 data-preview-name></h3><div data-preview-code></div><p><span class="badge" data-preview-status></span> <span class="badge" data-preview-criticality></span></p><div data-preview-sector></div></section><section class="side-card"><h2>Após salvar</h2><p>O equipamento ficará disponível para:</p><ul><li>Ordens de serviço</li><li>Preventivas e inspeções</li><li>Histórico de manutenção</li><li>Solicitações de materiais</li></ul></section></aside></div></form></div><script src="/js/equipamentos-form.js" defer></script>
