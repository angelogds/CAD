<!doctype html>
<html lang="pt-BR" class="tv-theme-light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
  <meta name="theme-color" content="#087443">
  <title><%= title || 'Modo TV — Oficina' %></title>
  <link rel="stylesheet" href="/css/tv-mode.css">
  <link rel="stylesheet" href="/css/tv-mode-2026.css">
</head>
<body>
<div id="tvApp" class="tv-shell">
  <header class="tv-header">
    <div class="tv-brand">
      <img src="/IMG/logo_menu.png.png" alt="Campo do Gado">
      <div><strong>Manutenção Campo do Gado</strong><span>Modo TV — Oficina</span></div>
    </div>
    <div id="tvMechanics" class="tv-mechanics" aria-label="Mecânicos da escala atual"></div>
    <div class="tv-screen-meta">
      <strong id="tvScreenLabel">Ordens de Serviço ativas</strong>
      <span id="tvScreenIndicator">Tela 1 de 6</span>
    </div>
    <div class="tv-status">
      <strong id="tvClock">--:--:--</strong>
      <span id="tvDate">--</span>
      <small id="tvOnlineStatus">Sistema online</small>
      <small id="tvLastUpdate">Última atualização: --:--</small>
    </div>
    <div class="tv-controls">
      <button id="tvSoundBtn" type="button" aria-label="Ativar ou desativar alertas sonoros">Som ativo</button>
      <button id="tvVoiceBtn" type="button" aria-label="Ativar ou desativar assistente por voz">Assistente ativa</button>
      <button id="tvThemeToggle" type="button" aria-label="Alternar tema">◐</button>
      <button id="tvFullscreenBtn" type="button" aria-label="Tela cheia">⛶</button>
    </div>
    <div class="tv-progress-line"><i id="tvProgress"></i></div>
  </header>

  <main id="tvContent" class="tv-content">
    <section class="tv-slide is-active" data-tv-screen="os" aria-label="Ordens de Serviço ativas"></section>
    <section class="tv-slide" data-tv-screen="preventivas" aria-label="Preventivas e corretivas"></section>
    <section class="tv-slide" data-tv-screen="escala" aria-label="Escala da semana"></section>
    <section class="tv-slide" data-tv-screen="desempenho" aria-label="Desempenho da equipe"></section>
    <section class="tv-slide" data-tv-screen="criticidade" aria-label="Criticidade dos equipamentos"></section>
    <section class="tv-slide" data-tv-screen="materiais" aria-label="Materiais e próximas demandas"></section>
  </main>

  <footer class="tv-ticker" aria-label="Ordens de Serviço ativas">
    <strong>OS ATIVAS</strong>
    <div class="tv-ticker-window"><div id="tvTickerTrack" class="tv-ticker-track"></div></div>
  </footer>

  <aside id="tvActivation" class="tv-activation" role="status">
    <span>Para receber os chamados com voz, aviso sonoro e tela cheia, clique em “Ativar Modo TV”.</span>
    <button id="tvActivateBtn" type="button">Ativar Modo TV</button>
  </aside>

  <section id="tvNewOSAlert" class="tv-alert" hidden aria-live="assertive">
    <div class="tv-alert-card">
      <span>NOVA ORDEM DE SERVIÇO</span>
      <strong id="tvAlertNumber"></strong>
      <h2 id="tvAlertEquipment"></h2>
      <p id="tvAlertDescription"></p>
      <dl id="tvAlertDetails"></dl>
      <small id="tvVoiceReadingStatus">A assistente lerá responsável, OS, equipamento, local, prioridade, abertura e a descrição completa do chamado.</small>
    </div>
  </section>

  <audio id="tvAudioNew" preload="auto" src="/audio/os-nova.mp3"></audio>
  <audio id="tvAudioCritical" preload="auto" src="/audio/os-critica.mp3"></audio>
</div>
<script>
  window.CG_TV_CONFIG = {
    snapshotUrl: '/api/tv/snapshot',
    streamUrl: '/api/tv/stream',
    refreshMs: 60000,
    fastRefreshMs: 15000,
    rotationMs: 30000,
    alertMs: 15000,
    criticalAlertMs: 25000
  };
</script>
<script src="/js/tv-mode.js"></script>
<script src="/js/tv-voice-assistant.js"></script>
</body>
</html>
