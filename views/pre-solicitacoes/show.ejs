<% layout('layout') %>
<link rel="stylesheet" href="/css/pre-solicitacoes.css?v=20260928-2">
<%
const st=String(sol.pre_status||'RASCUNHO');
const statusClass=st==='ENVIADA_COMPRAS'?'ok':st==='REPROVADA'?'danger':st==='EM_ANALISE'?'amber':st==='AGUARDANDO_APROVACAO'?'warn':'draft';
const done=sol.itens_analisados||0,total=sol.itens_total||0;
%>
<div class="pre-page">
  <div class="pre-hero">
    <div>
      <span class="pre-kicker">PRÉ-SOLICITAÇÃO • <%=sol.setor_origem%></span>
      <h1><%=sol.numero||('Pré #'+sol.id)%></h1>
      <p>Semana <strong><%=sol.semana_referencia||'-'%></strong> • <%=sol.subarea_destino||'-'%></p>
    </div>
    <div class="pre-head-actions"><span class="pre-status <%=statusClass%>"><%=st.replaceAll('_',' ')%></span><a class="ui-btn ui-btn--outline" href="/pre-solicitacoes">Voltar</a><% if(canEdit){%><a class="ui-btn ui-btn--secondary" href="/pre-solicitacoes/<%=sol.id%>/editar">Editar rascunho</a><%}%></div>
  </div>

  <section class="pre-card pre-summary-strip">
    <div><span>Criada por</span><strong><%=sol.solicitante_nome||'-'%></strong></div>
    <div><span>Responsável</span><strong><%=sol.aprovador_nome||'Aguardando responsável ativo'%></strong></div>
    <div><span>Setor / subárea</span><strong><%=sol.setor_origem||'-'%> • <%=sol.subarea_destino||'-'%></strong></div>
    <div><span>Itens</span><strong><%=done%> / <%=total%> analisados</strong></div>
    <div class="pre-summary-progress"><span>Andamento</span><strong><%=sol.progresso_analise%>%</strong><div class="pre-track"><i style="width:<%=sol.progresso_analise%>%"></i></div></div>
  </section>

  <% if (sol.pre_observacao_aprovacao) { %><div class="pre-note"><strong>Observação final</strong><%=sol.pre_observacao_aprovacao%></div><% } %>

  <% if(canAddItems){ %>
    <section class="pre-card pre-materials-card" id="adicionar-materiais">
      <div class="pre-section-head">
        <div><span>+</span><h2>Adicionar materiais</h2></div>
        <div class="pre-section-actions">
          <small>Disponível enquanto a pré-solicitação ainda não entrou em análise.</small>
          <button class="ui-btn ui-btn--secondary" type="button" data-add-pending-item>+ Outro item</button>
        </div>
      </div>
      <form method="POST" action="/pre-solicitacoes/<%=sol.id%>/itens/adicionar" id="pre-add-items-form">
        <div class="pre-items" data-pending-items>
          <div class="pre-item-row">
            <div class="pre-item-head"><strong>Novo item <span data-pending-item-number>1</span></strong><button class="pre-remove" type="button" data-remove-pending-item>Remover</button></div>
            <div class="pre-item-fields">
              <label class="pre-material-name">Material<input name="itens_nome[]" required placeholder="Ex.: Rolamento 6205"></label>
              <label>Quantidade<input name="itens_qtd[]" inputmode="decimal" required placeholder="1"></label>
              <label>Unidade
                <select name="itens_un[]" required>
                  <% unidades.forEach(function(u){ %><option value="<%=u.value%>" <%=u.value==='UN'?'selected':''%>><%=u.value%> • <%=u.label%></option><% }) %>
                </select>
              </label>
              <label class="pre-stock-link">Item de estoque
                <select name="itens_item_id[]"><option value="">Ainda não cadastrado</option><% estoqueItens.forEach(function(e){ %><option value="<%=e.id%>"><%=e.codigo?e.codigo+' • ':''%><%=e.nome%></option><% }) %></select>
              </label>
            </div>
            <label class="pre-item-spec">Especificação<textarea name="itens_especificacao[]" rows="1" placeholder="Marca, medida, aplicação ou detalhe técnico"></textarea></label>
          </div>
        </div>
        <div class="pre-form-actions pre-action-bar">
          <span class="pre-action-hint">Os novos materiais serão incluídos como PENDENTE e seguirão para análise do responsável do setor.</span>
          <button class="ui-btn ui-btn--primary" type="submit" onclick="return confirm('Adicionar estes materiais à pré-solicitação?')">Adicionar à pré-solicitação</button>
        </div>
      </form>
    </section>

    <template id="pre-pending-item-template">
      <div class="pre-item-row">
        <div class="pre-item-head"><strong>Novo item <span data-pending-item-number></span></strong><button class="pre-remove" type="button" data-remove-pending-item>Remover</button></div>
        <div class="pre-item-fields">
          <label class="pre-material-name">Material<input name="itens_nome[]" required placeholder="Material"></label>
          <label>Quantidade<input name="itens_qtd[]" inputmode="decimal" required></label>
          <label>Unidade
            <select name="itens_un[]" required>
              <% unidades.forEach(function(u){ %><option value="<%=u.value%>" <%=u.value==='UN'?'selected':''%>><%=u.value%> • <%=u.label%></option><% }) %>
            </select>
          </label>
          <label class="pre-stock-link">Item de estoque
            <select name="itens_item_id[]"><option value="">Ainda não cadastrado</option><% estoqueItens.forEach(function(e){ %><option value="<%=e.id%>"><%=e.codigo?e.codigo+' • ':''%><%=e.nome%></option><% }) %></select>
          </label>
        </div>
        <label class="pre-item-spec">Especificação<textarea name="itens_especificacao[]" rows="1" placeholder="Marca, medida, aplicação ou detalhe técnico"></textarea></label>
      </div>
    </template>
  <% } %>

  <section class="pre-card pre-review-card" id="itens">
    <div class="pre-section-head"><div><span>2</span><h2>Análise dos itens</h2></div><small>A quantidade original do Almoxarifado sempre fica registrada no histórico.</small></div>
    <div class="pre-review-list">
      <% sol.itens.forEach(function(item,index){
        const ist=String(item.pre_aprovacao_item_status||'PENDENTE');
        const suggested=Number(item.qtd_sugerida_almox??item.qtd_solicitada??item.quantidade??0);
        const approved=item.qtd_aprovada_setor==null?suggested:Number(item.qtd_aprovada_setor);
      %>
        <article class="pre-review-item <%=ist.toLowerCase()%>">
          <div class="pre-review-copy">
            <div class="pre-review-title"><span class="pre-review-number"><%=index+1%></span><strong><%=item.item_nome||item.descricao||'Item'%></strong><% if(item.rateio_setores_json&&item.rateio_setores_json!=='{}'){let rateio={};try{rateio=JSON.parse(item.rateio_setores_json)}catch{}; %><span>Previsão de uso: <%=Object.entries(rateio).filter(([s,q])=>q>0).map(([s,q])=>s+': '+q+' '+item.unidade).join(' • ')%></span><% } %><span class="pre-item-status <%=ist.toLowerCase()%>"><%=ist%></span></div>
            <% if(item.item_descricao||item.descricao){ %><p><%=item.item_descricao||item.descricao%></p><% } %>
            <div class="pre-item-metrics">
              <span><small>Solicitado</small><strong><%=suggested%> <%=item.unidade||'UN'%></strong></span>
              <% if(item.pre_aprovacao_item_status && item.pre_aprovacao_item_status!=='PENDENTE'){ %><span><small>Aprovado</small><strong><%=item.pre_aprovacao_item_status==='REPROVADO'?'0':approved%> <%=item.unidade||'UN'%></strong></span><% } %>
              <% if(item.estoque_codigo){%><span><small>Estoque</small><strong><%=item.estoque_codigo%></strong></span><%}%>
            </div>
            <% if(item.pre_aprovacao_item_observacao){%><div class="pre-item-note"><%=item.pre_aprovacao_item_observacao%></div><%}%>
          </div>
          <% if(canReview && ['AGUARDANDO_APROVACAO','EM_ANALISE'].includes(st)){ %>
            <form method="POST" action="/pre-solicitacoes/<%=sol.id%>/itens/<%=item.id%>/decisao" class="pre-decision-form">
              <label>Quantidade aprovada<input name="qtd_aprovada_setor" value="<%=approved%>" inputmode="decimal"></label>
              <label>Decisão<select name="decisao" required><option value="">Selecionar</option><option value="APROVADO" <%=ist==='APROVADO'?'selected':''%>>Aprovar</option><option value="AJUSTADO" <%=ist==='AJUSTADO'?'selected':''%>>Aprovar com ajuste</option><option value="REPROVADO" <%=ist==='REPROVADO'?'selected':''%>>Reprovar</option></select></label>
              <label class="wide">Motivo / observação<textarea name="observacao" rows="1" placeholder="Obrigatório somente em ajuste ou reprovação"><%=item.pre_aprovacao_item_observacao||''%></textarea></label>
              <button class="ui-btn ui-btn--secondary" type="submit">Salvar decisão</button>
            </form>
          <% } else { %>
            <div class="pre-approved-qty"><span>Quantidade final</span><strong><%=item.pre_aprovacao_item_status==='REPROVADO'?'0':approved%> <%=item.unidade||'UN'%></strong></div>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>

  <% if(canReview && ['AGUARDANDO_APROVACAO','EM_ANALISE'].includes(st)){ %>
    <section class="pre-card pre-final-card">
      <div><h2>Concluir análise</h2><p>Todos os itens precisam estar decididos. Somente os aprovados ou ajustados seguirão para Compras.</p></div>
      <form method="POST" action="/pre-solicitacoes/<%=sol.id%>/finalizar">
        <textarea name="observacao_final" rows="1" placeholder="Observação final para Compras (opcional)"></textarea>
        <button class="ui-btn ui-btn--primary" type="submit" <%=done<total?'disabled':''%> onclick="return confirm('Finalizar a análise desta pré-solicitação?')">Aprovar e enviar para Compras</button>
      </form>
    </section>
  <% } %>

  <% if(st==='ENVIADA_COMPRAS'){ %>
    <div class="pre-release-banner"><strong>Pedido liberado para Compras.</strong><span>Os itens aprovados já estão disponíveis no fluxo normal de cotação. Os reprovados permanecem somente no histórico.</span><a href="/compras/solicitacoes?setor=<%=encodeURIComponent(sol.setor_origem)%>">Abrir Compras</a></div>
  <% } %>
</div>

<script>
(() => {
  const list=document.querySelector('[data-pending-items]');
  const tpl=document.querySelector('#pre-pending-item-template');
  if(!list || !tpl) return;
  const renumber=()=>list.querySelectorAll('[data-pending-item-number]').forEach((el,index)=>{el.textContent=String(index+1);});
  document.querySelector('[data-add-pending-item]')?.addEventListener('click',()=>{
    list.appendChild(tpl.content.cloneNode(true));
    renumber();
  });
  list.addEventListener('click',(e)=>{
    const btn=e.target.closest('[data-remove-pending-item]');
    if(!btn) return;
    const rows=list.querySelectorAll('.pre-item-row');
    if(rows.length<=1) return;
    btn.closest('.pre-item-row')?.remove();
    renumber();
  });
})();
</script>
