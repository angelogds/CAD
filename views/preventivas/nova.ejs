<% layout("layout") %>

<link rel="stylesheet" href="/css/preventivas-form.css?v=20260919-1">

<div class="preventive-form-page">

<h1>Nova Preventiva Manual</h1>
<p class="muted" style="margin-top:-6px;">Criar preventiva pendente com origem MANUAL.</p>

<div class="card">
  <form method="POST" action="/preventivas">
    <div class="field">
      <label for="equipamento_id" class="muted" style="font-size:12px;font-weight:800;">Equipamento</label>
      <select id="equipamento_id" name="equipamento_id" required>
        <option value="">— Selecione —</option>
        <% (equipamentos || []).forEach(e => { %>
          <option value="<%= e.id %>"><%= (e.codigo ? e.codigo + " • " : "") + e.nome %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="titulo" class="muted" style="font-size:12px;font-weight:800;">Título</label>
      <input id="titulo" name="titulo" required placeholder="Ex: Lubrificação dos mancais do Digestor Laranja" />
    </div>

    <div class="grid field">
      <div>
        <label for="tipo_preventiva" class="muted" style="font-size:12px;font-weight:800;">Tipo da preventiva</label>
        <select id="tipo_preventiva" name="tipo_preventiva">
          <option value="preventiva" selected>Preventiva</option>
          <option value="preventiva_reforcada">Preventiva reforçada</option>
          <option value="reforma">Reforma</option>
          <option value="inspecao">Inspeção</option>
        </select>
      </div>
      <div>
        <label for="criticidade" class="muted" style="font-size:12px;font-weight:800;">Criticidade</label>
        <select id="criticidade" name="criticidade">
          <option value="BAIXA">BAIXA</option>
          <option value="MEDIA" selected>MÉDIA</option>
          <option value="ALTA">ALTA</option>
          <option value="CRITICA">CRÍTICA</option>
        </select>
      </div>
    </div>

    <div class="grid field">
      <div>
        <label for="data_prevista" class="muted" style="font-size:12px;font-weight:800;">Data prevista</label>
        <input id="data_prevista" name="data_prevista" type="date" required />
      </div>
      <div>
        <label for="frequencia_tipo" class="muted" style="font-size:12px;font-weight:800;">Frequência</label>
        <select id="frequencia_tipo" name="frequencia_tipo">
          <option value="diario">Diário</option>
          <option value="semanal">Semanal</option>
          <option value="mensal" selected>Mensal</option>
          <option value="anual">Anual</option>
        </select>
      </div>
    </div>

    <div class="field">
      <label for="observacao" class="muted" style="font-size:12px;font-weight:800;">Observação</label>
      <textarea id="observacao" name="observacao" placeholder="Observações técnicas (opcional)"></textarea>
    </div>

    <div class="muted" style="margin-top:8px;font-size:12px;">
      Status inicial da execução: <strong>PENDENTE</strong>. Os responsáveis serão escalados automaticamente conforme a escala vigente.
    </div>

    <div class="field preventive-form-actions">
      <a class="btn btn-secondary" href="/preventivas">Voltar</a>
      <button class="btn btn-primary" type="submit">Salvar preventiva manual</button>
    </div>
  </form>
</div>
</div>
