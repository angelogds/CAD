<% layout('layout') %>
<link rel="stylesheet" href="/css/preventivas-index.css?v=20260929-operacao">
<%
 const d=dashboard||{}; const m=d.metrics||{}; const f=d.filters||{};
 const qs=(extra={})=>{const p=new URLSearchParams();Object.entries({...f,...extra}).forEach(([k,v])=>{if(v!==undefined&&v!==null&&v!=='')p.set(k,v)});return p.toString()};
 const prazoLabel={ATRASADA:'Atrasada',VENCE_HOJE:'Vence hoje',NA_SEMANA:'Na semana',PROGRAMADA:'Programada',EM_EXECUCAO:'Em execução',CONCLUIDA:'Concluída',CANCELADA:'Cancelada'};
 const rows=d.programming||[];
%>
<main class="preventive-page preventive-operation">
  <header class="preventive-header">
    <div><span class="pv-eyebrow">EXECUÇÃO DE CAMPO</span><h1>Minhas Preventivas</h1><p>Consulte as atividades programadas, veja os detalhes do equipamento e registre a execução da preventiva.</p></div>
    <div class="preventive-header-actions"><a class="pv-btn" href="/preventivas/pdf?<%= qs() %>">PDF</a></div>
  </header>

  <section class="preventive-kpis pv-operation-kpis">
    <a class="preventive-kpi red" href="/preventivas?<%= qs({situacao:'ATRASADA',tab:'programacao',page:1}) %>"><span>Atrasadas</span><strong><%= rows.filter(r=>r.prazo==='ATRASADA').length %></strong><small>requer atenção</small></a>
    <a class="preventive-kpi red" href="/preventivas?<%= qs({situacao:'VENCE_HOJE',tab:'programacao',page:1}) %>"><span>Vencem hoje</span><strong><%= m.vencemHoje||0 %></strong><small>prioridade do dia</small></a>
    <a class="preventive-kpi orange" href="/preventivas?<%= qs({situacao:'NA_SEMANA',tab:'programacao',page:1}) %>"><span>Próximos 7 dias</span><strong><%= m.vencemSemana||0 %></strong><small>programadas</small></a>
    <a class="preventive-kpi blue" href="/preventivas?<%= qs({tab:'execucao',situacao:'',page:1}) %>"><span>Em execução</span><strong><%= d.executionSummary?.emAndamento||0 %></strong><small>atividades iniciadas</small></a>
  </section>

  <section class="panel pv-operation-filter">
    <form class="preventive-toolbar" method="get">
      <input type="hidden" name="tab" value="<%= d.activeTab||'programacao' %>">
      <label class="search"><span>Pesquisar</span><input name="q" value="<%= f.q||'' %>" placeholder="Equipamento, atividade ou código"></label>
      <label><span>Responsável</span><input name="responsavel" value="<%= f.responsavel||'' %>" placeholder="Digite seu nome"></label>
      <label>Setor<select name="setor"><option value="">Todos</option><% (d.filterOptions?.setores||[]).forEach(v=>{ %><option <%= f.setor===v?'selected':'' %>><%= v %></option><% }) %></select></label>
      <label>Situação<select name="situacao"><option value="">Todas</option><% ['ATRASADA','VENCE_HOJE','NA_SEMANA','PROGRAMADA','EM_EXECUCAO'].forEach(v=>{ %><option value="<%= v %>" <%= f.situacao===v?'selected':'' %>><%= prazoLabel[v] %></option><% }) %></select></label>
      <button class="pv-btn pv-btn-primary">Pesquisar</button><a class="pv-btn" href="/preventivas">Limpar</a>
    </form>
  </section>

  <section class="panel pv-operation-workspace">
    <div class="section-title"><div><h2>Preventivas para execução</h2><p>Os cards estão ordenados por vencimento e criticidade. Abra a atividade para ver checklist, observações e realizar a baixa.</p></div><strong><%= d.pagination?.total||0 %> atividade(s)</strong></div>
    <div class="pv-task-grid">
      <% rows.forEach(r=>{ %>
        <article class="pv-task-card pv-task-<%= String(r.prazo||'').toLowerCase() %>">
          <div class="pv-task-head"><div style="display:flex;gap:6px;flex-wrap:wrap"><span class="badge status-<%= String(r.prazo||'').toLowerCase() %>"><%= prazoLabel[r.prazo]||r.status %></span><% if(String(r.tipo_plano||'').toUpperCase()==='TROCA_CORREIA'){ %><span class="badge" style="background:#eef7f1;color:#147a41;border-color:#bbf7d0">TROCA DE CORREIA</span><% } %></div><span class="badge crit-<%= String(r.criticidade_exibicao||'media').toLowerCase() %>"><%= r.criticidade_exibicao||'MEDIA' %></span></div>
          <div class="pv-task-image">
            <% if (r.equipamento_foto_url) { %>
              <img src="<%= r.equipamento_foto_url %>" alt="<%= r.equipamento_nome||'Equipamento' %>" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">
              <div class="pv-task-image-fallback" style="display:none"><span>⚙</span><small>SEM IMAGEM</small></div>
            <% } else { %>
              <div class="pv-task-image-fallback"><span>⚙</span><small>SEM IMAGEM</small></div>
            <% } %>
          </div>
          <div class="pv-task-equipment"><small><%= r.equipamento_codigo||('PREV #'+r.id) %></small><h3><%= r.equipamento_nome||'Equipamento não informado' %></h3><span><%= r.setor||'Setor não informado' %></span></div>
          <div class="pv-task-activity"><strong><%= r.titulo||'Rotina preventiva' %></strong><p><%= r.observacao||'Consulte o plano para os detalhes da atividade.' %></p></div>
          <div class="pv-task-meta"><div><span>Frequência</span><strong><%= r.frequencia_tipo||'-' %></strong></div><div><span>Data prevista</span><strong><%= r.data_prevista?String(r.data_prevista).slice(0,10).split('-').reverse().join('/'):'-' %></strong></div><div class="wide"><span>Responsável</span><strong><%= r.responsaveis||'A definir' %></strong></div></div>
          <a class="pv-task-open" href="/preventivas/<%= r.plano_id %>">Abrir preventiva</a>
        </article>
      <% }) %>
      <% if(!rows.length){ %><div class="pv-operation-empty"><strong>Nenhuma preventiva encontrada.</strong><span>Altere os filtros ou pesquise pelo nome do responsável.</span></div><% } %>
    </div>
    <footer class="pagination"><span>Exibindo <%= rows.length %> de <%= d.pagination?.total||0 %></span><div><a class="<%= d.pagination?.page<=1?'disabled':'' %>" href="/preventivas?<%= qs({page:Math.max(1,(d.pagination?.page||1)-1)}) %>">Anterior</a><% for(let p=Math.max(1,(d.pagination?.page||1)-2);p<=Math.min(d.pagination?.pages||1,(d.pagination?.page||1)+2);p++){ %><a class="<%= p===d.pagination.page?'active':'' %>" href="/preventivas?<%= qs({page:p}) %>"><%= p %></a><% } %><a class="<%= d.pagination?.page>=d.pagination?.pages?'disabled':'' %>" href="/preventivas?<%= qs({page:Math.min(d.pagination?.pages||1,(d.pagination?.page||1)+1)}) %>">Próxima</a></div></footer>
  </section>
</main>
