<% layout('layout') %>
<link rel="stylesheet" href="/css/preventivas-index.css">
<% const d=dashboard||{}; const m=d.metrics||{}; const cov=d.coverage||{}; const f=d.filters||{}; const qs=(extra={})=>{const p=new URLSearchParams(); Object.entries({...f,...extra}).forEach(([k,v])=>{if(v!==undefined&&v!==null&&v!=='')p.set(k,v)}); return p.toString()}; const prazoLabel={ATRASADA:'Atrasada',VENCE_HOJE:'Vence hoje',NA_SEMANA:'Na semana',PROGRAMADA:'Programada',EM_EXECUCAO:'Em execução',CONCLUIDA:'Concluída',CANCELADA:'Cancelada'}; %>
<main class="preventive-page">
  <header class="preventive-header">
    <div><h1>Manutenção Preventiva</h1><p>Planejamento dos equipamentos, execução das rotinas e controle de vencimentos</p></div>
    <div class="preventive-header-actions">
      <a class="pv-btn" href="/preventivas/programadas">Calendário</a>
      <a class="pv-btn" href="/preventivas/pdf?<%= qs() %>">PDF das preventivas</a>
      <% if(canAdminPreventivas){ %><a class="pv-btn pv-btn-primary" href="/preventivas/nova">+ Novo plano</a><details class="preventive-menu"><summary class="pv-btn">Menu Preventivas</summary><div><a href="/preventivas/nova">Nova preventiva manual</a><a href="/preventivas/programadas">Preventivas programadas</a><a href="/preventivas/eleger-mecanico">Eleger mecânico</a><form method="post" action="/preventivas/programadas/lancar-os-lote-dia" onsubmit="return confirm('Confirmar lançamento do lote diário de preventivas?')"><button>Lançar lote de preventivas</button></form></div></details><% } %>
    </div>
  </header>

  <section class="preventive-kpis" aria-label="Indicadores preventivos">
    <% [['elegiveis','Equipamentos elegíveis','Parque monitorado','',{}],['planosAtivos','Planos ativos','Rotinas cadastradas','green',{tab:'planos'}],['semPlano','Sem plano','Requer planejamento','orange',{tab:'sem_plano'}],['pendentes','Pendentes','Aguardando execução','red',{tab:'programacao'}],['vencemHoje','Vencem hoje','Prioridade do dia','red',{tab:'programacao',situacao:'VENCE_HOJE'}],['vencemSemana','Vencem na semana','Próximos 7 dias','blue',{tab:'programacao',periodo:'7'}]].forEach(([key,title,sub,tone,query])=>{ %>
      <a class="preventive-kpi <%= tone %>" href="/preventivas?<%= qs(query) %>"><span><%= title %></span><strong><%= m[key]||0 %></strong><small><%= sub %></small></a>
    <% }) %>
  </section>

  <section class="preventive-overview">
    <article class="preventive-coverage panel">
      <h2>Cobertura do plano preventivo</h2><div class="coverage-main"><div class="coverage-copy"><p><strong><%= cov.covered||0 %> de <%= cov.eligible||0 %></strong> equipamentos cobertos — <%= cov.percent||0 %>%</p><div class="bar"><i style="width:<%= cov.percent||0 %>%"></i></div></div><div class="ring" style="--value:<%= cov.percent||0 %>"><strong><%= cov.percent||0 %>%</strong></div></div>
      <div class="criticality-grid"><% (cov.byCriticality||[]).forEach(c=>{ %><div class="crit <%= c.key.toLowerCase() %>"><span><%= c.label %></span><strong><%= c.covered %> de <%= c.total %></strong></div><% }) %></div>
      <a class="panel-link" href="/preventivas?<%= qs({tab:'sem_plano'}) %>">Ver equipamentos sem plano →</a>
    </article>
    <article class="preventive-week-priority panel"><div class="panel-head"><h2>Prioridades da semana</h2><a href="/preventivas?<%= qs({tab:'programacao'}) %>">Ver programação completa →</a></div>
      <div class="priority-list"><% if(!(d.weeklyPriorities||[]).length){ %><p class="empty">Nenhuma preventiva pendente no período.</p><% } %><% (d.weeklyPriorities||[]).forEach(r=>{ %><div class="priority priority-<%= String(r.prazo||'').toLowerCase() %>"><div><strong>#<%= r.id %> • <%= r.equipamento_nome||'Equipamento não informado' %></strong><small><%= r.titulo||r.observacao||'-' %></small></div><span class="badge"><%= prazoLabel[r.prazo]||r.status %></span><span><%= r.responsaveis %></span><a class="pv-open" href="/preventivas/<%= r.plano_id %>">Abrir</a></div><% }) %></div>
    </article>
  </section>

  <section class="preventive-workspace panel">
    <nav class="preventive-tabs"><% [['programacao','Programação'],['planos','Planos ativos'],['execucao','Em execução'],['historico','Histórico']].forEach(([key,label])=>{ %><a class="<%= d.activeTab===key?'active':'' %>" href="/preventivas?<%= qs({tab:key,page:1}) %>"><%= label %></a><% }) %></nav>
    <details class="mobile-filter"><summary>Filtros da programação</summary>
    <form class="preventive-toolbar" method="get"><input type="hidden" name="tab" value="<%= d.activeTab %>"><label class="search"><span>Busca</span><input name="q" value="<%= f.q||'' %>" placeholder="Plano, equipamento, código ou responsável"></label><label>Setor<select name="setor"><option value="">Todos</option><% (d.filterOptions?.setores||[]).forEach(v=>{ %><option <%= f.setor===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Frequência<select name="frequencia"><option value="">Todas</option><% (d.filterOptions?.frequencias||[]).forEach(v=>{ %><option <%= f.frequencia===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Criticidade<select name="criticidade"><option value="">Todas</option><% (d.filterOptions?.criticidades||[]).forEach(v=>{ %><option <%= f.criticidade===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Situação<select name="situacao"><option value="">Todas</option><% ['ATRASADA','VENCE_HOJE','NA_SEMANA','PROGRAMADA','EM_EXECUCAO','CONCLUIDA'].forEach(v=>{ %><option value="<%= v %>" <%= f.situacao===v?'selected':'' %>><%= prazoLabel[v] %></option><% }) %></select></label><label>Período<select name="periodo"><option value="">Todos</option><option value="hoje" <%= f.periodo==='hoje'?'selected':'' %>>Hoje</option><option value="7" <%= f.periodo==='7'?'selected':'' %>>Próximos 7 dias</option><option value="30" <%= f.periodo==='30'?'selected':'' %>>Próximos 30 dias</option><option value="90" <%= f.periodo==='90'?'selected':'' %>>Próximos 90 dias</option></select></label><button class="pv-btn pv-btn-primary">Filtrar</button><a class="pv-btn" href="/preventivas?tab=<%= d.activeTab %>">Limpar filtros</a></form></details>

    <% if(d.activeTab==='sem_plano'){ %><div class="section-title"><div><h2>Equipamentos sem plano</h2><p>Equipamentos elegíveis que requerem planejamento preventivo.</p></div></div><div class="empty-list"><% (d.semPlano||[]).forEach(e=>{ %><div><strong><%= e.nome||('Equipamento #'+e.id) %></strong><span><%= e.criticidade||'Criticidade não informada' %></span><% if(canAdminPreventivas){ %><a class="pv-open" href="/preventivas/nova?equipamento_id=<%= e.id %>">Criar plano</a><% } %></div><% }) %><% if(!(d.semPlano||[]).length){ %><p class="empty">Todos os equipamentos elegíveis possuem plano ativo.</p><% } %></div><% } else if(d.activeTab==='planos'){ %>
      <div class="section-title"><div><h2>Planos ativos</h2><p>Rotinas preventivas cadastradas e disponíveis.</p></div></div><div class="table-scroll"><table class="preventive-table"><thead><tr><th>ID / Equipamento</th><th>Atividade</th><th>Frequência</th><th>Status</th><th>Ação</th></tr></thead><tbody><% (d.planos||[]).forEach(p=>{ %><tr><td>#<%= p.id %> • <%= p.equipamento_nome||'-' %></td><td><%= p.titulo %></td><td><span class="badge"><%= p.frequencia_tipo||'-' %></span></td><td><span class="badge good">Ativo</span></td><td><a class="pv-open" href="/preventivas/<%= p.id %>">Abrir</a></td></tr><% }) %><% if(!(d.planos||[]).length){ %><tr><td colspan="5" class="empty">Nenhum plano preventivo ativo.</td></tr><% } %></tbody></table></div>
    <% } else { %>
      <div class="section-title"><div><h2><%= d.activeTab==='historico'?'Histórico preventivo':d.activeTab==='execucao'?'Preventivas em execução':'Programação preventiva' %></h2><p><%= d.activeTab==='historico'?'Preventivas concluídas e vínculos técnicos.':d.activeTab==='execucao'?'Atividades com execução iniciada.':'Atividades pendentes organizadas por vencimento e criticidade.' %></p></div><form method="get"><% Object.entries(f).forEach(([k,v])=>{if(k!=='pageSize'&&v){ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }}); %><label>Mostrando <strong><%= d.programming.length %> de <%= d.pagination.total %></strong> preventivas <select name="pageSize" onchange="this.form.submit()"><% [10,20,50,100].forEach(v=>{ %><option value="<%= v %>" <%= d.pagination.pageSize===v?'selected':'' %>>Exibir <%= v %></option><% }) %></select></label></form></div>
      <div class="table-scroll"><table class="preventive-table"><thead><tr><th>ID / Equipamento</th><th>Atividade</th><th>Frequência</th><th>Criticidade</th><th>Responsáveis</th><th>Data prevista</th><th>Situação</th><th>Ação</th></tr></thead><tbody><% (d.programming||[]).forEach(r=>{ %><tr class="row-<%= String(r.prazo||'').toLowerCase() %>"><td data-label="Equipamento"><strong>#<%= r.id %> • <%= r.equipamento_codigo||r.equipamento_nome||'-' %></strong><small><%= r.equipamento_codigo?r.equipamento_nome:'' %></small></td><td data-label="Atividade"><%= r.titulo||r.observacao||'-' %></td><td data-label="Frequência"><span class="badge"><%= r.frequencia_tipo||'-' %></span></td><td data-label="Criticidade"><span class="badge crit-<%= r.criticidade_exibicao.toLowerCase() %>"><%= r.criticidade_exibicao %></span></td><td data-label="Responsáveis"><%= r.responsaveis %></td><td data-label="Data prevista"><%= r.data_prevista?String(r.data_prevista).slice(0,10).split('-').reverse().join('/'):'-' %></td><td data-label="Situação"><span class="badge status-<%= String(r.prazo).toLowerCase() %>"><%= prazoLabel[r.prazo]||r.status %></span><% if(r.os_corretiva_id){ %><a class="os-link" href="/os/<%= r.os_corretiva_id %>">OS #<%= r.os_corretiva_id %></a><% } %></td><td><a class="pv-open" href="/preventivas/<%= r.plano_id %>">Abrir</a></td></tr><% }) %><% if(!(d.programming||[]).length){ %><tr><td colspan="8" class="empty"><%= d.activeTab==='historico'?'Nenhuma preventiva concluída encontrada.':'Nenhuma preventiva pendente no período.' %></td></tr><% } %></tbody></table></div>
      <footer class="pagination"><span>Exibindo <%= d.programming.length %> de <%= d.pagination.total %> atividades</span><div><a class="<%= d.pagination.page<=1?'disabled':'' %>" href="/preventivas?<%= qs({page:Math.max(1,d.pagination.page-1)}) %>">Anterior</a><% for(let p=Math.max(1,d.pagination.page-2);p<=Math.min(d.pagination.pages,d.pagination.page+2);p++){ %><a class="<%= p===d.pagination.page?'active':'' %>" href="/preventivas?<%= qs({page:p}) %>"><%= p %></a><% } %><a class="<%= d.pagination.page>=d.pagination.pages?'disabled':'' %>" href="/preventivas?<%= qs({page:Math.min(d.pagination.pages,d.pagination.page+1)}) %>">Próxima</a></div></footer>
    <% } %>
  </section>

  <section class="preventive-charts"><article class="preventive-frequency-chart panel"><h2>Distribuição por frequência</h2><% const maxFreq=Math.max(1,...(d.frequencyDistribution||[]).map(x=>x.total)); (d.frequencyDistribution||[]).forEach(x=>{ %><div class="chart-row"><span><%= x.label %></span><div class="bar"><i style="width:<%= Math.round(x.total*100/maxFreq) %>%"></i></div><strong><%= x.total %></strong></div><% }) %></article><article class="preventive-execution-chart panel"><h2>Execução no período</h2><% const es=d.executionSummary||{}; const maxEx=Math.max(1,es.noPrazo||0,es.comAtraso||0,es.pendentes||0,es.emAndamento||0); [['noPrazo','Concluídas no prazo','good'],['comAtraso','Concluídas com atraso','bad'],['pendentes','Pendentes','warn'],['emAndamento','Em andamento','info']].forEach(([k,l,c])=>{ %><div class="chart-row <%= c %>"><span><%= l %></span><div class="bar"><i style="width:<%= Math.round((es[k]||0)*100/maxEx) %>%"></i></div><strong><%= es[k]||0 %></strong></div><% }) %></article></section>
</main>
