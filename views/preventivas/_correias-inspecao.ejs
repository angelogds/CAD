<% const links=typeof correiasVinculos==='undefined'?[]:correiasVinculos; const pedidos=typeof correiasPedidos==='undefined'?[]:correiasPedidos; const autorizadas=typeof execucoesAutorizadas==='undefined'?[]:execucoesAutorizadas; %>
<% if(links.length||pedidos.length){ %><section class="card" style="margin-top:16px"><h2>Inspeção de correias</h2><p>Confira as correias mesmo quando houver troca recente. Se precisar substituir, solicite aqui; o Almoxarifado reserva, separa e entrega.</p>
<% execucoes.filter(x=>autorizadas.includes(x.id)&&!['CONCLUIDA','EXECUTADA','FINALIZADA','CANCELADA'].includes(x.status)).forEach(x=>{ %>
<form method="post" action="/preventivas/<%=plano.id%>/execucoes/<%=x.id%>/correias" data-lock-submit><h3>Execução #<%=x.id%> • <%=x.data_prevista%></h3><div class="row"><% if(user?.role!=='MECANICO'){ %><label>Mecânico atribuído<select name="mecanico_user_id" required><option value="">Selecione</option><% (typeof correiasMecanicos==='undefined'?[]:correiasMecanicos).forEach(m=>{ %><option value="<%=m.id%>"><%=m.name%></option><% }) %></select></label><% } %><label>Correia<select name="estoque_item_id" required onchange="this.form.elements.quantidade.value=this.selectedOptions[0].dataset.qtd"><option value="">Selecione</option><% links.forEach(v=>{ %><option value="<%=v.estoque_item_id%>" data-qtd="<%=v.quantidade_material%>"><%=v.codigo||''%> • <%=v.nome%> • jogo de <%=v.quantidade_material%></option><% }) %></select></label><label>Quantidade<input name="quantidade" type="number" step="1" min="1" required></label><label>Empresa consumidora<input name="empresa_consumidora" required></label><label>Setor<select name="setor_consumidor" required><% ['RECICLAGEM','FRIGORIFICO','LOGISTICA','ADMINISTRATIVO'].forEach(s=>{ %><option><%=s%></option><% }) %></select></label></div><button class="btn btn-primary">Solicitar substituição ao Almoxarifado</button></form>
<% }) %>
<% pedidos.forEach(p=>{ %><article style="padding:12px;border-top:1px solid #ddd"><strong><%=p.material_nome%> — <%=p.status%></strong><p>Pedido #<%=p.id%> • <%=p.quantidade-p.quantidade_devolvida%> unidade(s) • <%=p.mecanico_nome%><% if(p.troca_em){ %> • troca em <%=p.troca_em%>. Verificar desgaste na próxima inspeção.<% } %></p>
<% if(p.status==='RETIRADA'&&(Number(user?.id)===p.mecanico_user_id||['ADMIN','MANUTENCAO_SUPERVISOR','SUPERVISOR_MANUTENCAO'].includes(user?.role))){ %><form method="post" action="/preventivas/<%=plano.id%>/correias/<%=p.id%>/troca" data-lock-submit><label>Data em que a substituição foi realizada<input name="troca_em" type="date" required></label><button class="btn btn-primary">Confirmar troca realizada</button></form><% } %>
</article><% }) %></section><% } %>
