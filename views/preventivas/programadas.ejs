<% layout('layout') %>
<link rel="stylesheet" href="/css/preventivas-form.css?v=20260919-p3">
<%
  const proximaSegunda = resumo?.proximaSegunda ? dateBr.formatDateBR(resumo.proximaSegunda) : '-';
  const totalExecucoes = Number(resumo?.totalExecucoesProxima || 0);
  const regra = resumo?.regraLancamento || { horario: '05:00', adiarFeriados: true, feriadosLocais: [] };
%>

<main class="preventive-secondary-page">
  <header class="preventive-secondary-hero">
    <div>
      <span class="preventive-secondary-eyebrow">PREVENTIVAS • PROGRAMAÇÃO SEMANAL</span>
      <h1>Preventivas Programadas</h1>
      <p>Prepare a manutenção preventiva da próxima segunda-feira e acompanhe templates, planos e execuções antes de gerar Ordens de Serviço.</p>
    </div>
    <div class="preventive-secondary-actions">
      <a class="ui-btn ui-btn--secondary" href="<%= typeof backUrl !== 'undefined' ? backUrl : '/preventivas' %>">Voltar ao painel</a>
    </div>
  </header>

  <section class="preventive-secondary-kpis" aria-label="Resumo da programação preventiva">
    <article class="preventive-secondary-kpi">
      <span>Próxima segunda</span>
      <strong><%= proximaSegunda %></strong>
      <small>Lançamento: <%= resumo?.dataLancamento ? dateBr.formatDateBR(resumo.dataLancamento) : proximaSegunda %> às <%= regra.horario %> (Bahia).</small>
    </article>
    <article class="preventive-secondary-kpi">
      <span>Templates</span>
      <strong><%= resumo?.totalTemplates || 0 %></strong>
      <small>Modelos padrão disponíveis</small>
    </article>
    <article class="preventive-secondary-kpi">
      <span>Planos programados</span>
      <strong><%= resumo?.totalPlanos || 0 %></strong>
      <small>Planos semanais já cadastrados</small>
    </article>
    <article class="preventive-secondary-kpi <%= totalExecucoes > 0 ? 'is-alert' : '' %>">
      <span>Execuções pendentes</span>
      <strong><%= totalExecucoes %></strong>
      <small>Programadas para a próxima segunda</small>
    </article>
  </section>

  <% if (canAdminPreventivas) { %>
    <section class="preventive-secondary-panel">
      <h2>Regra de lançamento das OSs preventivas</h2>
      <p>Horário da Bahia. Quando o adiamento estiver habilitado, uma segunda-feira feriada passa para o próximo dia útil. A regra vale também para lotes e lançamentos manuais de OS preventiva.</p>
      <form method="POST" action="/pcm/preventivas/programadas/configuracao" class="preventive-secondary-grid">
        <div class="preventive-secondary-field">
          <label for="pv-horario">Lançar a partir de</label>
          <input id="pv-horario" name="horario" type="time" required value="<%= regra.horario %>">
        </div>
        <div class="preventive-secondary-field">
          <label class="preventive-rule-checkbox"><input type="checkbox" name="adiarFeriados" value="1" <%= regra.adiarFeriados ? 'checked' : '' %>> Adiar em feriados nacionais e locais cadastrados</label>
        </div>
        <div class="preventive-secondary-field is-wide">
          <label for="pv-feriados">Feriados estaduais, municipais ou dias sem expediente</label>
          <textarea id="pv-feriados" name="feriadosLocais" rows="3" maxlength="2000" placeholder="2026-12-08"><%= regra.feriadosLocais.join('\n') %></textarea>
          <small>Uma data por linha, no formato AAAA-MM-DD. Feriados nacionais são reconhecidos automaticamente; pontos facultativos só entram se cadastrados.</small>
        </div>
        <div class="preventive-secondary-form-actions is-wide"><button class="ui-btn ui-btn--primary" type="submit">Salvar regra de lançamento</button></div>
      </form>
    </section>
    <section class="preventive-secondary-panel is-warning">
      <div class="preventive-secondary-head">
        <div>
          <h2>Ações da programação</h2>
          <p>Execute primeiro a geração semanal. O lançamento em OS deve ocorrer somente após conferir a programação.</p>
        </div>
      </div>
      <div class="preventive-secondary-danger-zone">
        <form method="POST" action="/pcm/preventivas/programadas/gerar" onsubmit="return confirm('Gerar as preventivas programadas para a próxima segunda-feira?');">
          <button class="ui-btn ui-btn--primary" type="submit">Gerar programação semanal</button>
        </form>
        <form method="POST" action="/pcm/preventivas/programadas/lancar-os-segunda" onsubmit="return confirm('Confirmar o lançamento das preventivas programadas da segunda-feira como Ordens de Serviço?');">
          <button class="ui-btn ui-btn--outline" type="submit">Lançar OS da segunda-feira</button>
        </form>
      </div>
    </section>
  <% } %>

  <section class="preventive-secondary-panel">
    <div class="preventive-secondary-head">
      <div>
        <h2>Templates padrão</h2>
        <p>Modelos utilizados pela geração automática das preventivas programadas.</p>
      </div>
      <span class="preventive-secondary-badge info"><%= resumo?.templates?.length || 0 %> modelo(s)</span>
    </div>

    <% if (!resumo?.templates?.length) { %>
      <div class="preventive-secondary-empty">Nenhum template configurado.</div>
    <% } else { %>
      <div class="preventive-secondary-template-list">
        <% (resumo.templates || []).forEach(function(t){ %>
          <article class="preventive-secondary-template">
            <h4><%= t.titulo %></h4>
            <div class="meta">
              <span class="preventive-secondary-badge"><%= (t.frequencia_tipo || '-').toUpperCase() %> x<%= t.frequencia_valor || 1 %></span>
              <span class="preventive-secondary-badge good"><%= (t.checklist || []).length %> item(ns) no checklist</span>
            </div>
            <% if ((t.checklist || []).length) { %>
              <ul>
                <% (t.checklist || []).forEach(function(item){ %>
                  <li><%= item %></li>
                <% }) %>
              </ul>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="preventive-secondary-panel">
    <div class="preventive-secondary-head">
      <div>
        <h2>Planos já criados</h2>
        <p>Planos de origem programada semanal atualmente cadastrados no sistema.</p>
      </div>
      <span class="preventive-secondary-badge"><%= resumo?.planos?.length || 0 %> plano(s)</span>
    </div>

    <div class="preventive-secondary-table-wrap">
      <table class="preventive-secondary-table">
        <thead>
          <tr>
            <th>Plano</th>
            <th>Atividade</th>
            <th>Equipamento</th>
            <th>Frequência</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody>
          <% if (!resumo?.planos?.length) { %>
            <tr><td colspan="5" class="preventive-secondary-empty">Nenhuma preventiva programada criada ainda.</td></tr>
          <% } %>
          <% (resumo?.planos || []).forEach(function(p){ %>
            <tr>
              <td data-label="Plano"><strong>#<%= p.id %></strong></td>
              <td data-label="Atividade"><strong><%= p.titulo %></strong></td>
              <td data-label="Equipamento">
                <strong><%= p.equipamento_nome || '-' %></strong>
                <% if (p.equipamento_tipo) { %><small><%= p.equipamento_tipo %></small><% } %>
              </td>
              <td data-label="Frequência"><span class="preventive-secondary-badge"><%= (p.frequencia_tipo || '-').toUpperCase() %> x<%= p.frequencia_valor || 1 %></span></td>
              <td data-label="Ação"><a class="ui-btn ui-btn--outline ui-btn--compact" href="/preventivas/<%= p.id %>">Abrir plano</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
