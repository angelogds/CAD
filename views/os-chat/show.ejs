<% layout('layout') %>
<link rel="stylesheet" href="/css/chat-os.css">
<% const os=conversa.os, sol=conversa.solicitacao; const timeline=[...conversa.mensagens.map(m=>({...m,at:m.created_at,kind:'message'})),...conversa.historico.map(h=>({...h,at:h.registrado_em,kind:'justification'}))].sort((a,b)=>new Date(a.at)-new Date(b.at)); let lastDay=''; const closed=['FECHADA','FECHADO','CONCLUIDA','CONCLUÍDA','FINALIZADA','FINALIZADO','CANCELADA','CANCELADO'].includes(String(os.status||'').toUpperCase()); %>
<div class="chat-os-page chat-os-show">
<header class="chat-os-page-header"><div><div class="chat-os-breadcrumb"><a href="/chat-os">Chat das OS</a> / OS #<%= os.id %></div><h1>Conversa da OS #<%= os.id %></h1><p>Comunicação oficial e rastreabilidade da Ordem de Serviço</p></div><div class="chat-os-header-actions row"><a class="btn btn-ghost" href="/chat-os/<%= os.id %>">↻ Atualizar</a><a class="btn btn-ghost" href="/os/<%= os.id %>">Abrir OS</a><a class="btn btn-ghost" href="/chat-os">← Voltar às conversas</a></div></header>
<div class="chat-os-thread-layout">
<aside class="chat-os-sidebar chat-os-thread-sidebar"><header><h2>Conversas ativas</h2></header><label class="chat-os-search"><span>⌕</span><input data-contact-search placeholder="Buscar conversas..."></label><nav class="chat-os-tabs"><a class="<%= !closed?'active':'' %>" href="/chat-os/<%= os.id %>?filtro=todas">Ativas</a><a class="<%= closed?'active':'' %>" href="/chat-os?filtro=finalizadas">Finalizadas</a></nav><div class="chat-os-contacts"><% conversas.forEach(c=>{ %><a data-contact class="chat-os-contact <%= Number(c.id)===Number(os.id)?'active':'' %>" href="/chat-os/<%= c.id %>?filtro=<%= filtro %>"><div class="chat-os-contact-top"><strong>OS #<%= c.id %> • <%= c.equipamento %></strong><time><%= c.ultima_interacao_em?fmtBR(c.ultima_interacao_em):'' %></time><% if(c.nao_lidas){ %><b class="badge-unread"><%= c.nao_lidas %></b><% } %></div><div class="chat-os-badges"><span><%= c.status||'-' %></span><span class="priority"><%= c.prioridade||'-' %></span></div><p><%= c.motivo_atual||c.ultima_mensagem||'Sem atualizações registradas.' %></p></a><% }) %></div></aside>
<section class="chat-os-thread" data-os-chat-root data-os-id="<%= os.id %>" data-user-id="<%= user.id %>" data-polling-ms="20000">
<header class="chat-os-thread-head"><div><h2>OS #<%= os.id %> • <%= os.equipamento_resolvido %></h2><p><%= os.setor_resolvido %></p></div><div><b>Responsável: <%= os.mecanico_nome||'-' %></b><small>Aberta em <%= os.opened_at?fmtBR(os.opened_at):'-' %></small></div><div class="chat-os-badges"><span><%= os.status||'-' %></span><span class="priority"><%= os.prioridade||'-' %></span><% if(os.motivo_atual){ %><span><%= os.motivo_atual %></span><% } %></div></header>
<% if(os.motivo_atual||sol){ %><div class="chat-os-context"><span>Motivo atual: <b><%= os.motivo_atual||'-' %></b></span><% if(sol){ %><span>Solicitação: <b><%= sol.numero||('#'+sol.id) %></b></span><span class="status"><%= sol.status||'-' %></span><a href="/solicitacoes/<%= sol.id %>">Abrir solicitação</a><% } %></div><% } %>
<% const messageSignature=conversa.mensagens.map(m=>`${m.id}:${m.created_at}`).join('|'); %><div id="chat-messages" class="chat-os-messages" data-signature="<%= messageSignature %>" aria-live="polite"><% if(!timeline.length){ %><div class="chat-os-empty"><h3>Esta OS ainda não possui registros</h3><p>Envie a primeira atualização operacional.</p></div><% } %><% timeline.forEach(item=>{ const day=new Date(item.at).toLocaleDateString('pt-BR'); if(day!==lastDay){ lastDay=day; %><div class="chat-os-date"><span><%= day %></span></div><% } if(item.kind==='justification'){ %><article class="chat-os-justification"><header><b>Justificativa técnica • <%= item.autor_nome %></b><span><%= item.motivo_nome %></span><time><%= item.registrado_em?fmtBR(item.registrado_em):'' %></time></header><p><%= item.texto_ia||item.observacao_mecanico||item.texto_padrao %></p><a href="/os/<%= os.id %>">Ver registro completo</a></article><% } else { const mine=Number(item.user_id||0)===Number(user.id||0), type=String(item.tipo||'MENSAGEM').toLowerCase(), system=type==='sistema'||type.includes('solicitacao')||type.includes('encerrada'); if(system){ %><article class="chat-os-system-event" data-message-id="<%= item.id %>"><b><%= String(item.tipo||'Evento da OS').replaceAll('_',' ') %></b><p><%= item.mensagem %></p><time><%= item.created_at?fmtBR(item.created_at):'' %></time></article><% } else { %><article class="chat-os-message <%= mine?'mine':'' %> sector-<%= type %>" data-message-id="<%= item.id %>"><span class="avatar"><%= String(item.autor_nome||'S').charAt(0).toUpperCase() %></span><div><header><b><%= item.autor_nome||'Sistema' %></b><small> • <%= String(item.perfil||item.tipo||'').replaceAll('_',' ') %></small><time><%= item.created_at?fmtBR(item.created_at):'' %></time></header><p><%= item.mensagem %></p></div></article><% } } }) %></div>
<div id="chat-status" class="os-chat-status" hidden role="status"></div><% if(!closed){ %><form id="chat-form" class="chat-os-composer" method="POST" action="/chat-os/<%= os.id %>/mensagens" data-enviando="0"><div class="chat-os-compose-row"><span class="composer-icon" title="Anexos são adicionados pela ficha da OS">⌁</span><textarea id="chat-input" name="mensagem" placeholder="Digite uma mensagem sobre esta OS..." required></textarea><select id="quick-reply"><option value="">Resposta rápida</option><% ['Serviço iniciado.','Serviço em andamento.','Aguardando material.','Aguardando liberação da produção.','Material recebido, retomando serviço.','Serviço concluído.','Necessária avaliação do encarregado.','Aguardando retorno de Compras.'].forEach(t=>{ %><option value="<%= t %>"><%= t %></option><% }) %></select><button id="chat-submit" class="btn btn-green">Enviar</button></div><small>Fotos, vídeos, PDF e documentos devem ser registrados como evidência na ficha da OS.</small></form><% } %>
</section>
<aside class="chat-os-details" id="os-details"><button class="chat-os-details-close" type="button">×</button><section class="chat-os-summary-card"><h3>Resumo da OS</h3><dl><dt>Equipamento</dt><dd><%= os.equipamento_resolvido %></dd><dt>Status</dt><dd><%= os.status||'-' %></dd><dt>Prioridade</dt><dd><%= os.prioridade||'-' %></dd><dt>Dias em aberto</dt><dd><%= os.dias_aberta %></dd><dt>Responsável</dt><dd><%= os.mecanico_nome||'-' %></dd></dl><a class="btn btn-ghost" href="/os/<%= os.id %>">Abrir ficha da OS</a></section><section class="chat-os-summary-card"><h3>Materiais e compras</h3><% if(sol){ %><p>Solicitação vinculada</p><a class="request-number" href="/solicitacoes/<%= sol.id %>"><%= sol.numero||('#'+sol.id) %></a><p><span class="status"><%= sol.status||'-' %></span></p><% if(conversa.solicitacoes.length>1){ %><small>+ <%= conversa.solicitacoes.length-1 %> outra(s) solicitação(ões)</small><% } %><a class="btn btn-ghost" href="/solicitacoes/<%= sol.id %>">Acompanhar compra</a><% }else{ %><div class="chat-os-empty compact">Nenhuma solicitação vinculada.</div><% } %></section><section class="chat-os-summary-card"><h3>Ações rápidas</h3><a href="/os/<%= os.id %>" class="btn btn-ghost">Registrar justificativa</a><a href="/os/<%= os.id %>" class="btn btn-ghost">Adicionar evidência</a><a href="/os/<%= os.id %>" class="btn btn-ghost">Ver histórico completo</a></section><section class="chat-os-participants"><b><%= conversa.mensagens.reduce((s,m)=>s.add(m.autor_nome||'Sistema'),new Set()).size %> participantes</b><span>Atualizado agora</span></section></aside>
<button type="button" class="btn btn-green chat-os-info-toggle">Informações da OS</button>
</div></div><script src="/js/chat-os.js" defer></script>
