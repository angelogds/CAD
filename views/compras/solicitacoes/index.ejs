<% layout('layout') %>
<%
const labels = { ABERTA:'Aberta', EM_COTACAO:'Em cotação', COMPRADA:'Comprada', EM_RECEBIMENTO:'Em recebimento', RECEBIDA_PARCIAL:'Recebida parcial', RECEBIDA_TOTAL:'Recebida total', FECHADA:'Fechada', REABERTA:'Reaberta', CANCELADA:'Cancelada' };
const colors = { ABERTA:'#9bdd8e', EM_COTACAO:'#29a6a0', COMPRADA:'#f4b942', EM_RECEBIMENTO:'#f59e0b', RECEBIDA_PARCIAL:'#65a30d', RECEBIDA_TOTAL:'#15803d', FECHADA:'#087334', REABERTA:'#3b82f6', CANCELADA:'#ef4444' };
const total = statusList.reduce((n, s) => n + Number(resumo?.[s] || 0), 0);
const received = Number(resumo?.RECEBIDA_TOTAL || 0) + Number(resumo?.FECHADA || 0);
const completion = total ? Math.round(received / total * 100) : 0;
const linked = (lista || []).filter(s => s.os_id);
const urgent = (lista || []).filter(s => ['ALTA','URGENTE','CRITICA','CRÍTICA','EMERGENCIAL'].includes(String(s.prioridade || '').toUpperCase()));
const attention = [...urgent, ...(lista || []).filter(s => ['ABERTA','EM_COTACAO'].includes(s.status))].filter((s,i,a) => a.findIndex(x => x.id === s.id) === i).slice(0,4);
const money = value => Number(value || 0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' });
const quotedValue = (lista || []).reduce((n,s) => n + Number(s.valor_total || s.valor_estimado || 0), 0);
const purchasedValue = (lista || []).filter(s => !['ABERTA','EM_COTACAO','CANCELADA'].includes(s.status)).reduce((n,s) => n + Number(s.valor_total || s.valor_estimado || 0), 0);
const activeStatuses = statusList.filter(s => !['CANCELADA','REABERTA'].includes(s));
const maxStatus = Math.max(1, ...activeStatuses.map(s => Number(resumo?.[s] || 0)));
const queryFor = values => new URLSearchParams(Object.entries(values).filter(([,v]) => v)).toString();
%>
<link rel="stylesheet" href="/css/compras-dashboard.css">

<div class="purchase-dashboard">
  <header class="dashboard-heading">
    <div><h1>Painel de Compras</h1><p>Visão operacional das solicitações, cotações, compras e recebimentos</p></div>
    <form class="dashboard-filters" method="get" action="/compras/solicitacoes">
      <label><span class="sr-only">Período</span><select name="period" id="periodFilter"><option value="30">Últimos 30 dias</option><option value="7">Últimos 7 dias</option><option value="90">Últimos 90 dias</option></select></label>
      <label class="dashboard-search"><span class="sr-only">Buscar</span><input name="q" placeholder="Número, título, setor ou solicitante" value="<%= filters?.query || '' %>"></label>
      <label><span class="sr-only">Setor</span><select name="setor"><option value="">Todos os setores</option><% [...new Set((lista || []).map(s => s.setor_origem).filter(Boolean))].forEach(setor => { %><option value="<%= setor %>"><%= setor %></option><% }) %></select></label>
      <button class="refresh-button" type="submit"><span aria-hidden="true">↻</span> Atualizar</button>
    </form>
  </header>

  <nav class="quick-filters" aria-label="Filtros rápidos"><a href="/compras/solicitacoes?vinculadas_os=1">Vinculadas à OS</a><a href="/compras/solicitacoes?urgentes=1">Urgentes</a></nav>
  <section class="metric-grid compras-summary" aria-label="Indicadores de compras">
    <% [
      ['OS VINCULADAS', linked.length, '+1 nesta semana', '#22a53a', 'vinculadas_os=1'],
      ['SOLICITAÇÕES ABERTAS', resumo?.ABERTA || 0, '+1 nesta semana', '#16843a', 'status=ABERTA'],
      ['EM COTAÇÃO', resumo?.EM_COTACAO || 0, 'Aguardando Compras', '#2563eb', 'status=EM_COTACAO'],
      ['EM RECEBIMENTO', resumo?.EM_RECEBIMENTO || 0, 'Aguardando recebimento', '#f97316', 'status=EM_RECEBIMENTO'],
      ['RECEBIDAS', received, '+1 nesta semana', '#15803d', 'status=RECEBIDA_TOTAL'],
      ['ATRASADAS', urgent.length, urgent.length ? 'Requer atenção' : 'Tudo em dia', '#ef2938', 'urgentes=1']
    ].forEach((item, index) => { %>
      <a class="metric-card <%= index === 5 && item[1] ? 'metric-alert' : '' %>" style="--metric-color:<%= item[3] %>" href="/compras/solicitacoes?<%= item[4] %>">
        <span><%= item[0] %></span><strong><%= item[1] %></strong><small><%= item[2] %></small>
      </a>
    <% }) %>
  </section>

  <section class="dashboard-card progress-overview">
    <div class="progress-main"><h2>ANDAMENTO GERAL DAS COMPRAS</h2>
      <% [["Cotação dos itens", Number(resumo?.EM_COTACAO || 0) + purchasedValue > 0, Math.min(100, total ? Math.round((total-Number(resumo?.ABERTA||0))/total*100) : 0), '#16843a'],["Compras realizadas", true, total ? Math.round((purchasedValue ? (total-Number(resumo?.ABERTA||0)-Number(resumo?.EM_COTACAO||0)) : received)/total*100) : 0, '#55b52d'],["Recebimento dos materiais", true, completion, '#f59e0b']].forEach((row,i) => { const pct=Math.max(0,Math.min(100,row[2])); %>
        <div class="progress-row"><span><%= row[0] %></span><div><small><%= pct %> de 100% concluído</small><i><b style="width:<%= pct %>%;background:<%= row[3] %>"></b></i></div><strong style="color:<%= row[3] %>"><%= pct %>%</strong></div>
      <% }) %>
    </div>
    <div class="completion"><div><span>Solicitações concluídas</span><strong><%= received %> de <%= total %></strong><small>Fluxo concluído no período</small></div><div class="completion-ring" style="--progress:<%= completion %>"><b><%= completion %>%</b></div></div>
  </section>

  <div class="dashboard-columns">
    <section class="dashboard-card status-chart"><h2>SOLICITAÇÕES POR STATUS</h2>
      <% activeStatuses.forEach(status => { const count=Number(resumo?.[status]||0); %><a href="/compras/solicitacoes?<%= queryFor({status}) %>"><span><%= labels[status] || status %></span><i><b style="width:<%= count/maxStatus*100 %>%;background:<%= colors[status] %>"></b></i><strong><%= count %></strong></a><% }) %>
      <div class="chart-axis"><span>0</span><span><%= maxStatus %></span></div>
    </section>
    <section class="dashboard-card cost-card"><h2>CUSTOS DO PERÍODO</h2>
      <dl><div><dt>Cotado</dt><dd><%= money(quotedValue) %></dd></div><div><dt>Comprado / comprometido</dt><dd><%= money(purchasedValue) %></dd></div><div><dt>Recebido / realizado</dt><dd><%= money(quotedValue * completion / 100) %></dd></div><div><dt>Pendente de cotação</dt><dd><%= money(Math.max(0, quotedValue-purchasedValue)) %></dd></div></dl>
      <div class="cost-progress"><i><b style="width:<%= completion %>%"></b></i><strong><%= completion %>%</strong><span>do valor cotado já foi recebido</span></div>
    </section>
  </div>

  <section class="dashboard-card attention-card"><h2>PENDÊNCIAS QUE EXIGEM ATENÇÃO</h2>
    <div class="responsive-table"><table><thead><tr><th>Solicitação</th><th>OS / Equipamento</th><th>Prioridade</th><th>Situação</th><th>Prazo</th><th>Responsável</th><th>Ação</th></tr></thead><tbody>
      <% if (!attention.length) { %><tr><td colspan="7" class="empty-state">Nenhuma pendência no período.</td></tr><% } %>
      <% attention.forEach(s => { const high=['ALTA','URGENTE','CRITICA','CRÍTICA','EMERGENCIAL'].includes(String(s.prioridade||'').toUpperCase()); %><tr class="<%= high ? 'danger-row' : '' %>"><td><strong><%= s.numero || '#'+s.id %></strong></td><td><%= s.os_id ? 'OS '+s.os_id : 'Sem OS' %> • <%= s.titulo || 'Material' %></td><td><span class="tag <%= high?'tag-danger':'tag-neutral' %>"><%= s.prioridade || 'MÉDIA' %></span></td><td><span class="tag <%= s.status==='ABERTA'?'tag-danger':'tag-warning' %>"><%= labels[s.status] || s.status %></span></td><td><%= s.previsao_entrega ? fmtBR(s.previsao_entrega) : 'A definir' %></td><td><%= s.solicitante_nome || '-' %></td><td><a class="table-action" href="/compras/solicitacoes/<%= s.id %>">Abrir</a></td></tr><% }) %>
    </tbody></table></div>
  </section>

  <div class="dashboard-columns bottom-panels">
    <section class="dashboard-card"><h2>OS VINCULADAS ÀS COMPRAS</h2><% if(!linked.length){ %><p class="empty-state">Nenhuma OS vinculada.</p><% } linked.slice(0,3).forEach(s=>{ const pct=['RECEBIDA_TOTAL','FECHADA'].includes(s.status)?100:s.status==='EM_COTACAO'?50:25; %><div class="linked-row"><strong>OS <%= s.os_id %></strong><span><%= s.titulo || 'Material solicitado' %></span><i><b style="width:<%= pct %>%"></b></i><small><%= pct %>%</small><a href="/compras/solicitacoes/<%= s.id %>"><%= labels[s.status]||s.status %></a></div><% }) %><a class="all-link" href="/compras/solicitacoes?vinculadas_os=1">Ver todas as OS vinculadas</a></section>
    <section class="dashboard-card"><h2>RECEBIMENTOS PREVISTOS</h2><% const arrivals=(lista||[]).filter(s=>s.previsao_entrega).slice(0,3); if(!arrivals.length){ %><p class="empty-state">Nenhum recebimento agendado.</p><% } arrivals.forEach(s=>{ %><div class="arrival-row"><strong><%= fmtBR(s.previsao_entrega) %></strong><span><%= s.titulo || 'Material solicitado' %></span><em class="tag tag-success">No prazo</em></div><% }) %></section>
  </div>
</div>
<span class="sr-only">Gerar PDF</span>
<script src="/js/compras-dashboard.js" defer></script>
