<% layout('layout') %>
<%
const labels={ABERTA:'Aberta',REABERTA:'Reaberta',EM_COTACAO:'Em cotação',COMPRADA:'Comprada',EM_RECEBIMENTO:'Em recebimento',RECEBIDA_PARCIAL:'Recebida parcial',RECEBIDA_TOTAL:'Recebida total',FECHADA:'Fechada',CANCELADA:'Cancelada'};
const cardDefs=[['os','OS VINCULADAS','#22a53a'],['abertas','SOLICITAÇÕES ABERTAS','#16843a'],['cotacao','EM COTAÇÃO','#2563eb'],['recebimento','EM RECEBIMENTO','#f97316'],['recebidas','RECEBIDAS','#15803d'],['atrasadas','ATRASADAS','#ef2938']];
const groupDefs=[['high','Críticas e altas'],['medium','Prioridade média'],['low','Prioridade baixa'],['undefined','Sem prioridade definida']];
const params=new URLSearchParams(); Object.entries(filters||{}).forEach(([k,v])=>{if(v&&k!=='query')params.set(k,v)}); if(filters?.query)params.set('q',filters.query);
const url=(changes={})=>{const p=new URLSearchParams(params);Object.entries(changes).forEach(([k,v])=>v===null||v===''?p.delete(k):p.set(k,v));return '/compras/solicitacoes'+(p.toString()?'?'+p:'')};
const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const totalAnalytics=statusList.reduce((n,s)=>n+Number(resumo?.[s]||0),0); const received=Number(resumo?.RECEBIDA_TOTAL||0)+Number(resumo?.FECHADA||0); const completion=totalAnalytics?Math.round(received/totalAnalytics*100):0;
%>
<link rel="stylesheet" href="/css/compras-dashboard.css">
<div class="purchase-dashboard">
<header class="dashboard-heading"><h1>Painel de Compras</h1><p>Fila operacional e indicadores do setor de Compras</p></header>
<form class="dashboard-filters" method="get"><input type="hidden" name="tab" value="<%= filters.tab %>"><input type="hidden" name="card" value="<%= filters.card %>">
<label><span>Período dos indicadores</span><select name="period"><option value="7" <%= filters.period===7?'selected':'' %>>Últimos 7 dias</option><option value="30" <%= filters.period===30?'selected':'' %>>Últimos 30 dias</option><option value="90" <%= filters.period===90?'selected':'' %>>Últimos 90 dias</option></select></label>
<label class="dashboard-search"><span>Busca</span><input name="q" placeholder="Número, título, setor ou solicitante, OS, equipamento..." value="<%= filters.query %>"></label>
<label><span>Setor</span><select name="setor"><option value="">Todos</option><% queue.setores.forEach(v=>{ %><option <%= filters.setor===v?'selected':'' %>><%= v %></option><% }) %></select></label>
<label><span>Prioridade</span><select name="prioridade"><option value="">Todas</option><option value="high" <%= filters.prioridade==='high'?'selected':'' %>>Crítica / alta</option><option value="medium" <%= filters.prioridade==='medium'?'selected':'' %>>Média</option><option value="low" <%= filters.prioridade==='low'?'selected':'' %>>Baixa</option><option value="undefined" <%= filters.prioridade==='undefined'?'selected':'' %>>Não definida</option></select></label>
<label><span>Responsável</span><select name="responsavel"><option value="">Todos</option><% queue.responsaveis.forEach(v=>{ %><option value="<%= v.id %>" <%= String(filters.responsavel)===String(v.id)?'selected':'' %>><%= v.nome %></option><% }) %></select></label>
<div class="dashboard-filter-actions"><button class="ui-btn" type="submit">Aplicar</button><a class="ui-btn ui-btn--outline" href="/compras/solicitacoes">Limpar filtros</a></div></form>
<span class="sr-only">Vinculadas à OS</span><span class="sr-only">Urgentes</span><section class="metric-grid compras-summary" aria-label="Filtros rápidos da fila"><% cardDefs.forEach(([key,label,color])=>{const selected=filters.tab==='active'&&filters.card===key;%>
<form method="get" class="metric-form"><% Object.entries(filters).forEach(([k,v])=>{if(v&& !['card','page','tab'].includes(k)){%><input type="hidden" name="<%= k==='query'?'q':k %>" value="<%= v %>"><%}})%><input type="hidden" name="tab" value="active"><% if(!selected){%><input type="hidden" name="card" value="<%= key %>"><%}%><button type="submit" class="metric-card <%= selected?'is-selected':'' %>" style="--metric-color:<%=color%>" aria-pressed="<%= selected %>"><span><%= label %></span><strong><%= queue.cards[key] %></strong><small><%= selected?'Filtro ativo':'Filtrar fila' %></small></button></form><% }) %></section>
<section class="dashboard-card attention-card">
<div class="queue-tabs" role="tablist"><a role="tab" aria-selected="<%= filters.tab==='active' %>" class="ui-btn ui-btn--soft <%= filters.tab==='active'?'active':'' %>" href="<%= url({tab:'active',card:null,page:null}) %>">Ativas</a><a role="tab" aria-selected="<%= filters.tab==='history' %>" class="ui-btn ui-btn--soft <%= filters.tab==='history'?'active':'' %>" href="<%= url({tab:'history',card:null,page:null}) %>">Fechadas e histórico</a></div>
<div class="attention-heading"><div><h2><%= filters.tab==='active'?'Solicitações ativas para Compras':'Fechadas e histórico' %></h2><p><%= filters.tab==='active'?'Fila operacional com todas as solicitações que ainda não foram fechadas.':'Solicitações fechadas e canceladas para consulta.' %></p></div><div class="attention-controls"><span>Mostrando <%= lista.length %> de <%= queue.total %> solicitações <%= filters.tab==='active'?'ativas':'' %></span><form method="get"><% Object.entries(filters).forEach(([k,v])=>{if(v&&k!=='limit'&&k!=='page'){%><input type="hidden" name="<%= k==='query'?'q':k %>" value="<%= v %>"><%}})%><select name="limit" aria-label="Quantidade de solicitações" onchange="this.form.submit()"><% [10,20,50].forEach(n=>{%><option value="<%=n%>" <%=queue.limit===n?'selected':''%>>Exibir <%=n%></option><%})%></select></form></div></div>
<% if(!lista.length){ %><p class="empty-state"><%= filters.card?'Não há solicitações nessa situação.':filters.tab==='active'?'Nenhuma solicitação ativa encontrada':'Nenhum registro no histórico encontrado.' %></p><% } %>
<% if(lista.length){ %><div class="request-list"><div class="request-columns" aria-hidden="true"><span>Solicitação</span><span>OS / Equipamento</span><span>Prioridade / Status</span><span>Itens</span><span>Progresso</span><span>Prazo / Responsável</span><span>Ação</span></div><% groupDefs.forEach(([group,label])=>{const rows=lista.filter(s=>s.priorityGroup===group);if(!rows.length)return;%><section class="priority-section priority-<%=group%>"><h3><span><%=label%></span><b><%=rows.length%></b></h3><%if(group==='undefined'){%><p class="data-warning">Prioridade não definida</p><%}%><%rows.forEach(s=>{const total=Number(s.itens_count||0),done=Number(s.itens_cotados||0),pct=total?Math.round(done/total*100):0;const priorityLabel=group==='high'?(String(s.prioridade||'ALTA').toUpperCase()):group==='medium'?'MÉDIA':group==='low'?'BAIXA':'NÃO DEFINIDA';%><article class="request-row <%=s.overdue?'is-overdue':''%>"><div class="request-main" data-label="Solicitação"><strong><%=s.numero||'#'+s.id%></strong><span><%=s.titulo||'Título não definido'%></span></div><div data-label="OS / Equipamento"><b><%=s.os_id?'OS '+s.os_id:'Sem OS vinculada'%></b><span><%=s.equipamento_nome||'Equipamento não definido'%></span></div><div class="request-badges" data-label="Prioridade / Status"><span class="tag tag-priority tag-<%=group%>"><%=priorityLabel%></span><span class="tag tag-status"><%=String(labels[s.status]||s.status).toUpperCase()%></span></div><div class="item-counts" data-label="Itens"><span><small>Total</small><b><%=total%></b></span><span><small>Cotados</small><b><%=done%></b></span><span><small>Comprados</small><b><%=s.itens_comprados||0%></b></span><span><small>Recebidos</small><b><%=s.itens_recebidos||0%></b></span></div><div class="request-progress" data-label="Progresso"><span><%=done%> de <%=total%> <%=total===1?'item':'itens'%> cotado<%=total===1?'':'s'%> — <%=pct%>%</span><i class="item-progress"><b style="width:<%=pct%>%"></b></i></div><div data-label="Prazo / Responsável"><b><%=s.deadline?(s.overdue?'Atrasada: ':s.dueToday?'Vence hoje: ':'Prazo: ')+s.deadline:'Prazo a definir'%></b><span><%=s.responsavel_nome?'Responsável: '+s.responsavel_nome:'Responsável não definido'%></span></div><div class="row-actions" data-label="Ação"><a class="ui-btn ui-btn--table" href="/compras/solicitacoes/<%=s.id%>">Abrir</a><%if(filters.tab==='history'){%><small>Fechamento: <%=s.data_fechamento||'Não definido'%><br>Fornecedor: <%=s.fornecedor_nome||s.fornecedor||'Não definido'%><br>Valor: <%=money(s.valor_total)%></small><a class="ui-btn ui-btn--outline ui-btn--table" href="/compras/solicitacoes/<%=s.id%>/pdf">Gerar PDF</a><%}%></div></article><%})%></section><%})%></div><% } %>
<%if(queue.pages>1){%><nav class="pagination" aria-label="Paginação"><%for(let p=1;p<=queue.pages;p++){%><a class="<%=p===queue.page?'active':''%>" href="<%=url({page:p})%>"><%=p%></a><%}%></nav><%}%></section>
<section class="dashboard-card progress-overview"><div class="progress-main"><h2>ANDAMENTO GERAL DAS COMPRAS</h2><p>Indicadores dos últimos <%=filters.period%> dias</p><%[['Abertas',resumo.ABERTA],['Em cotação',resumo.EM_COTACAO],['Recebidas',received]].forEach(r=>{%><div class="progress-row"><span><%=r[0]%></span><i><b style="width:<%=totalAnalytics?Number(r[1]||0)/totalAnalytics*100:0%>%"></b></i><strong><%=r[1]||0%></strong></div><%})%></div><div class="completion"><div><span>Solicitações concluídas</span><strong><%=received%> de <%=totalAnalytics%></strong><small>No período dos indicadores</small></div><div class="completion-ring" style="--progress:<%=completion%>"><b><%=completion%>%</b></div></div></section>
<div class="dashboard-columns"><section class="dashboard-card"><h2>SOLICITAÇÕES POR STATUS</h2><%statusList.forEach(s=>{%><p><%=labels[s]||s%>: <strong><%=resumo[s]||0%></strong></p><%})%></section><section class="dashboard-card cost-card"><h2>CUSTOS DO PERÍODO</h2><p>Valores calculados sobre os registros do período: <strong><%=money(lista.reduce((n,s)=>n+Number(s.valor_total||0),0))%></strong></p></section></div>
<div class="dashboard-columns bottom-panels"><section class="dashboard-card"><h2>OS VINCULADAS ÀS COMPRAS</h2><p><%=queue.cards.os%> solicitações ativas vinculadas.</p></section><section class="dashboard-card"><h2>RECEBIMENTOS PREVISTOS</h2><p>Consulte prazos reais na fila operacional.</p></section></div>
</div><script src="/js/compras-dashboard.js" defer></script>
