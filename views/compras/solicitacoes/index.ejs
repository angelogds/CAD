<% layout('layout') %>
<%
const labels={ABERTA:'Aberta',REABERTA:'Reaberta',EM_COTACAO:'Em cotação',COMPRADA:'Comprada',EM_RECEBIMENTO:'Em recebimento',RECEBIDA_PARCIAL:'Recebida parcial',RECEBIDA_TOTAL:'Recebida total',FECHADA:'Fechada',CANCELADA:'Cancelada'};
const cardDefs=[['os','OS VINCULADAS','#22a53a'],['abertas','SOLICITAÇÕES ABERTAS','#16843a'],['cotacao','EM COTAÇÃO','#2563eb'],['recebimento','EM RECEBIMENTO','#f97316'],['recebidas','RECEBIDAS','#15803d'],['atrasadas','ATRASADAS','#ef2938']];
const groupDefs=[['critical','Críticas'],['high','Alta prioridade'],['medium','Prioridade média'],['low','Prioridade baixa'],['undefined','Sem prioridade definida']];
const params=new URLSearchParams(); Object.entries(filters||{}).forEach(([k,v])=>{if(v&&k!=='query')params.set(k,v)}); if(filters?.query)params.set('q',filters.query);
const url=(changes={})=>{const p=new URLSearchParams(params);Object.entries(changes).forEach(([k,v])=>v===null||v===''?p.delete(k):p.set(k,v));return '/compras/solicitacoes'+(p.toString()?'?'+p:'')};
const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const dateBR=v=>{if(!v)return'-';const parts=String(v).slice(0,10).split('-');return parts.length===3?`${parts[2]}/${parts[1]}/${parts[0]}`:String(v)};
const totalAnalytics=statusList.reduce((n,s)=>n+Number(resumo?.[s]||0),0); const received=Number(resumo?.RECEBIDA_TOTAL||0)+Number(resumo?.FECHADA||0); const completion=totalAnalytics?Math.round(received/totalAnalytics*100):0;
const lower=lowerDashboard||{period:filters.period,total:0,status:[],financial:{committed:0,quoted:0,receivedTracked:0,hasTrackedReceivedValue:false,withValue:0},requestCosts:[],linkedOs:[],receipts:[],receiptShortages:[],receiptShortageItems:0,receiptShortageQty:0};
const statusColors={ABERTA:'#16843a',EM_COTACAO:'#2563eb',COMPRADA:'#7c3aed',EM_RECEBIMENTO:'#f97316',RECEBIDA_PARCIAL:'#0ea5a4',RECEBIDA_TOTAL:'#15803d',FECHADA:'#64748b',REABERTA:'#a16207',CANCELADA:'#ef2938'};
%>
<link rel="stylesheet" href="/css/compras-dashboard.css?v=20260819-selection-artifacts-v2">
<link rel="stylesheet" href="/css/compras-active-priority-fix.css?v=20260819-selection-artifacts-v2">
<link rel="stylesheet" href="/css/compras-dashboard-lower.css?v=20260902-lower-real-v1">
<link rel="stylesheet" href="/css/compras-recebimento-alertas.css?v=20260902-v1">
<div class="purchase-dashboard">
<header class="dashboard-heading"><h1>Painel de Compras</h1><p>Fila operacional e indicadores do setor de Compras</p></header>
<form class="dashboard-filters" method="get"><input type="hidden" name="tab" value="<%= filters.tab %>"><input type="hidden" name="card" value="<%= filters.card %>">
<label><span>Período dos indicadores</span><select name="period"><option value="7" <%= filters.period===7?'selected':'' %>>Últimos 7 dias</option><option value="30" <%= filters.period===30?'selected':'' %>>Últimos 30 dias</option><option value="90" <%= filters.period===90?'selected':'' %>>Últimos 90 dias</option></select></label>
<label class="dashboard-search"><span>Busca</span><input name="q" placeholder="Número, título, setor ou solicitante, OS, equipamento..." value="<%= filters.query %>"></label>
<label><span>Setor</span><select name="setor"><option value="">Todos</option><% queue.setores.forEach(v=>{ %><option <%= filters.setor===v?'selected':'' %>><%= v %></option><% }) %></select></label>
<label><span>Prioridade</span><select name="prioridade"><option value="">Todas</option><option value="critical" <%= filters.prioridade==='critical'?'selected':'' %>>Crítica</option><option value="high" <%= filters.prioridade==='high'?'selected':'' %>>Alta</option><option value="medium" <%= filters.prioridade==='medium'?'selected':'' %>>Média</option><option value="low" <%= filters.prioridade==='low'?'selected':'' %>>Baixa</option><option value="undefined" <%= filters.prioridade==='undefined'?'selected':'' %>>Não definida</option></select></label>
<label><span>Responsável</span><select name="responsavel"><option value="">Todos</option><% queue.responsaveis.forEach(v=>{ %><option value="<%= v.id %>" <%= String(filters.responsavel)===String(v.id)?'selected':'' %>><%= v.nome %></option><% }) %></select></label>
<div class="dashboard-filter-actions"><button class="ui-btn" type="submit">Aplicar</button><a class="ui-btn ui-btn--outline" href="/compras/solicitacoes">Limpar filtros</a></div></form>
<span class="sr-only">Vinculadas à OS</span><span class="sr-only">Urgentes</span><section class="metric-grid compras-summary" aria-label="Filtros rápidos da fila"><% cardDefs.forEach(([key,label,color])=>{const selected=filters.tab==='active'&&filters.card===key;%>
<form method="get" class="metric-form"><% Object.entries(filters).forEach(([k,v])=>{if(v&& !['card','page','tab'].includes(k)){%><input type="hidden" name="<%= k==='query'?'q':k %>" value="<%= v %>"><%}})%><input type="hidden" name="tab" value="active"><% if(!selected){%><input type="hidden" name="card" value="<%= key %>"><%}%><button type="submit" class="metric-card <%= selected?'is-selected':'' %>" style="--metric-color:<%=color%>" aria-pressed="<%= selected %>"><span><%= label %></span><strong><%= queue.cards[key] %></strong><small><%= selected?'Filtro ativo':'Filtrar fila' %></small></button></form><% }) %></section>

<% if(lower.receiptShortages && lower.receiptShortages.length){ %>
<section class="dashboard-card receipt-shortage-panel" aria-labelledby="receipt-shortage-title">
  <div class="receipt-shortage-head">
    <div><span class="receipt-shortage-kicker">ALERTA DO ALMOXARIFADO</span><h2 id="receipt-shortage-title">Material recebido com quantidade menor que a comprada</h2><p>O alerta nasce somente após uma conferência física parcial e desaparece automaticamente quando o Almoxarifado recebe o restante.</p></div>
    <div class="receipt-shortage-total"><strong><%= lower.receiptShortageItems %></strong><span>item(ns) com falta</span><small>Quantidade faltante somada: <%= Number(lower.receiptShortageQty||0) %></small></div>
  </div>
  <div class="receipt-shortage-list">
    <% lower.receiptShortages.forEach(row=>{ %>
      <a class="receipt-shortage-row" href="/compras/solicitacoes/<%= row.id %>">
        <div><strong><%= row.numero || '#'+row.id %></strong><span><%= row.titulo || 'Solicitação de materiais' %></span></div>
        <div><small>Divergência no recebimento</small><b><%= row.itens_divergentes_recebimento %> item(ns) • faltam <%= Number(row.qtd_faltante_recebimento||0) %></b></div>
        <span class="receipt-shortage-action">Abrir e verificar fornecedor →</span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<section class="dashboard-card attention-card">
<div class="queue-tabs" role="tablist"><a role="tab" aria-selected="<%= filters.tab==='active' %>" class="ui-btn ui-btn--soft <%= filters.tab==='active'?'active':'' %>" href="<%= url({tab:'active',card:null,page:null}) %>">Ativas</a><a role="tab" aria-selected="<%= filters.tab==='history' %>" class="ui-btn ui-btn--soft <%= filters.tab==='history'?'active':'' %>" href="<%= url({tab:'history',card:null,page:null}) %>">Fechadas e histórico</a></div>
<div class="attention-heading"><div><h2><%= filters.tab==='active'?'Solicitações ativas para Compras':'Fechadas e histórico' %></h2><p><%= filters.tab==='active'?'Fila operacional com solicitações que ainda exigem acompanhamento do setor de Compras.':'Solicitações concluídas, fechadas e canceladas para consulta.' %></p></div><div class="attention-controls"><span>Mostrando <%= lista.length %> de <%= queue.total %> solicitações <%= filters.tab==='active'?'ativas':'' %></span><form method="get"><% Object.entries(filters).forEach(([k,v])=>{if(v&&k!=='limit'&&k!=='page'){%><input type="hidden" name="<%= k==='query'?'q':k %>" value="<%= v %>"><%}})%><select name="limit" aria-label="Quantidade de solicitações" onchange="this.form.submit()"><% [10,20,50].forEach(n=>{%><option value="<%=n%>" <%=queue.limit===n?'selected':''%>>Exibir <%=n%></option><%})%></select></form></div></div>
<% if(!lista.length){ %><p class="empty-state"><%= filters.card?'Não há solicitações nessa situação.':filters.tab==='active'?'Nenhuma solicitação ativa encontrada':'Nenhum registro no histórico encontrado.' %></p><% } %>
<% if(lista.length){ %><div class="request-list"><div class="request-columns" aria-hidden="true"><span>Solicitação</span><span>OS / Equipamento</span><span>Dados da compra</span><span>Prioridade / Andamento</span><span>Ações</span></div><% groupDefs.forEach(([group,label])=>{const rows=lista.filter(s=>s.priorityGroup===group);if(!rows.length)return;%><section class="priority-section priority-<%=group%>"><h3><span><%=label%></span><b><%=rows.length%></b></h3><%if(group==='undefined'){%><p class="data-warning">Prioridade não definida</p><%}%><%rows.forEach(s=>{const total=Number(s.itens_count||0),done=Number(s.itens_cotados||0),bought=Number(s.itens_comprados||0),receivedItems=Number(s.itens_recebidos||0),pct=total?Math.round(done/total*100):0;const priorityLabel=group==='critical'?'CRÍTICA':group==='high'?'ALTA':group==='medium'?'MÉDIA':group==='low'?'BAIXA':'NÃO DEFINIDA';%><article class="request-row <%=s.overdue?'is-overdue':''%>" data-href="/compras/solicitacoes/<%=s.id%>" tabindex="0" role="link" aria-label="Abrir solicitação <%=s.numero||s.id%>"><div class="request-main" data-label="Solicitação"><span class="request-title-line"><strong><%=s.numero||'#'+s.id%></strong><small class="tag tag-status"><%=String(labels[s.status]||s.status).toUpperCase()%></small></span><span><%=s.titulo||'Título não definido'%></span><small><%=s.setor_origem?'Setor: '+s.setor_origem:'Setor não informado'%></small></div><div class="request-os" data-label="OS / Equipamento"><small>OS / EQUIPAMENTO</small><b><%=s.os_id?'OS '+s.os_id+(s.equipamento_nome?' — '+s.equipamento_nome:''):'Sem OS vinculada'%></b></div><div class="purchase-data" data-label="Dados da compra"><span><b><%=total%></b> <%=total===1?'item':'itens'%> · <b><%=done%></b> cotado<%=done===1?'':'s'%> · <b><%=bought%></b> comprado<%=bought===1?'':'s'%></span><span><b><%=receivedItems%></b> recebido<%=receivedItems===1?'':'s'%> · <%=s.responsavel_nome?'Responsável: '+s.responsavel_nome:'Responsável não definido'%></span><span class="purchase-deadline <%=s.overdue?'is-late':''%>"><%=s.deadline?(s.overdue?'Atrasada: ':s.dueToday?'Vence hoje: ':'Prazo: ')+s.deadline:'Prazo a definir'%></span><%if(filters.tab==='history'){%><small>Fornecedor: <%=s.fornecedor_nome||s.fornecedor||'Não definido'%> · <%=money(s.valor_total)%></small><%}%></div><div class="request-flow" data-label="Prioridade / Andamento"><span class="tag tag-priority tag-<%=group%>"><%=priorityLabel%></span><span><%=done%> de <%=total%> <%=total===1?'item cotado':'itens cotados'%> — <%=pct%>%</span><i class="item-progress"><b style="width:<%=pct%>%"></b></i></div><div class="row-actions" data-label="Ações" onclick="event.stopPropagation()"><a class="ui-btn ui-btn--table" href="/compras/solicitacoes/<%=s.id%>">Abrir</a><details><summary class="ui-btn ui-btn--outline ui-btn--table">Mais ações</summary><div class="action-menu"><a href="/compras/solicitacoes/<%=s.id%>"><%=['ABERTA','REABERTA'].includes(s.status)?'Iniciar cotação':'Continuar cotação'%></a><a href="/compras/solicitacoes/<%=s.id%>/pdf" target="_blank">Gerar PDF</a></div></details></div></article><%})%></section><%})%></div><% } %>
<%if(queue.pages>1){%><nav class="pagination" aria-label="Paginação"><%for(let p=1;p<=queue.pages;p++){%><a class="<%=p===queue.page?'active':''%>" href="<%=url({page:p})%>"><%=p%></a><%}%></nav><%}%></section>
<section class="dashboard-card progress-overview"><div class="progress-main"><h2>ANDAMENTO GERAL DAS COMPRAS</h2><p>Indicadores dos últimos <%=filters.period%> dias</p><%[['Abertas',resumo.ABERTA],['Em cotação',resumo.EM_COTACAO],['Recebidas',received]].forEach(r=>{%><div class="progress-row"><span><%=r[0]%></span><i><b style="width:<%=totalAnalytics?Number(r[1]||0)/totalAnalytics*100:0%>%"></b></i><strong><%=r[1]||0%></strong></div><%})%></div><div class="completion"><div><span>Solicitações concluídas</span><strong><%=received%> de <%=totalAnalytics%></strong><small>No período dos indicadores</small></div><div class="completion-ring" style="--progress:<%=completion%>"><b><%=completion%>%</b></div></div></section>

<div class="dashboard-lower-grid">
  <section class="dashboard-card dashboard-lower-card" aria-labelledby="compras-status-title">
    <div class="dashboard-lower-head">
      <div><h2 id="compras-status-title">SOLICITAÇÕES POR STATUS</h2><p>Distribuição real das solicitações nos últimos <%= lower.period %> dias.</p></div>
      <span class="dashboard-lower-badge"><%= lower.total %></span>
    </div>
    <% if(!lower.status.length || !lower.total){ %>
      <div class="lower-empty">Sem solicitações no período e filtros selecionados.</div>
    <% } else { %>
      <div class="status-real-chart">
        <% lower.status.forEach(row=>{ %>
          <div class="status-real-row" style="--status-color:<%= statusColors[row.key] || '#16a34a' %>">
            <div class="status-real-label"><span><%= row.label %></span><b><%= row.count %></b></div>
            <div class="status-real-track" title="<%= row.percent %>% do período"><span style="width:<%= row.percent %>%"></span></div>
            <div class="status-real-value"><strong><%= row.percent %>%</strong><span><%= row.value>0?money(row.value):'—' %></span></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="dashboard-card dashboard-lower-card" aria-labelledby="compras-cost-title">
    <div class="dashboard-lower-head">
      <div><h2 id="compras-cost-title">CUSTOS DO PERÍODO</h2><p>Valores registrados nas solicitações/cotações selecionadas. Sem valores fictícios.</p></div>
      <span class="dashboard-lower-badge"><%= lower.financial.withValue %> com valor</span>
    </div>
    <div class="finance-kpis">
      <div class="finance-kpi"><span>Custo comprometido</span><strong><%= money(lower.financial.committed) %></strong><small>Compradas, em recebimento e concluídas no período.</small></div>
      <div class="finance-kpi"><span>Em cotação</span><strong><%= money(lower.financial.quoted) %></strong><small>Valor já registrado enquanto a compra ainda está em cotação.</small></div>
      <div class="finance-kpi"><span>Recebido com preço rastreável</span><strong><%= lower.financial.hasTrackedReceivedValue?money(lower.financial.receivedTracked):'—' %></strong><small><%= lower.financial.hasTrackedReceivedValue?'Calculado por item recebido com preço unitário registrado.':'O banco ainda não possui preço por item suficiente para calcular esse valor com segurança.' %></small></div>
      <div class="finance-kpi"><span>Solicitações com custo</span><strong><%= lower.financial.withValue %> de <%= lower.total %></strong><small>Registros do período com valor financeiro disponível.</small></div>
    </div>
    <% if(!lower.requestCosts.length){ %>
      <div class="lower-empty">Nenhum custo ou recebimento registrado neste período.</div>
    <% } else { %>
      <div class="request-cost-list">
        <% lower.requestCosts.forEach(row=>{ %>
          <div class="request-cost-row">
            <div class="request-cost-main"><a href="/compras/solicitacoes/<%= row.id %>"><%= row.numero || '#'+row.id %> — <%= row.titulo || 'Sem título' %></a><small><%= row.os_id?'OS '+row.os_id+(row.equipamento_nome?' · '+row.equipamento_nome:''):'Sem OS vinculada' %></small></div>
            <div class="request-cost-money"><%= row.custo_total>0?money(row.custo_total):'Sem custo' %><% if(row.valor_recebido_rastreado>0){ %><small>Recebido: <%= money(row.valor_recebido_rastreado) %></small><% } %></div>
            <div class="request-cost-progress"><i><b style="width:<%= row.recebimento_pct %>%"></b></i><span><%= row.recebimento_pct %>% recebido</span></div>
          </div>
        <% }) %>
      </div>
    <% } %>
    <p class="financial-note"><strong>Regra financeira:</strong> o painel usa valores realmente registrados. Quando não há preço unitário confiável por item, o percentual recebido continua físico e o sistema não transforma esse percentual em dinheiro por estimativa.</p>
  </section>
</div>

<div class="dashboard-lower-grid bottom-panels">
  <section class="dashboard-card dashboard-lower-card" aria-labelledby="compras-os-title">
    <div class="dashboard-lower-head">
      <div><h2 id="compras-os-title">OS VINCULADAS ÀS COMPRAS</h2><p>Solicitações do período associadas a uma Ordem de Serviço.</p></div>
      <span class="dashboard-lower-badge"><%= lower.linkedOs.length %> exibidas</span>
    </div>
    <% if(!lower.linkedOs.length){ %>
      <div class="lower-empty">Nenhuma solicitação vinculada a OS no período selecionado.</div>
    <% } else { %>
      <div class="lower-scroll"><table class="lower-table"><thead><tr><th>Solicitação</th><th>OS / Equipamento</th><th>Status</th><th>Custo</th><th>Recebimento</th></tr></thead><tbody>
      <% lower.linkedOs.forEach(row=>{ %><tr><td><a href="/compras/solicitacoes/<%=row.id%>"><%=row.numero||'#'+row.id%></a><small><%=row.titulo||'Sem título'%></small></td><td><strong>OS <%=row.os_id%></strong><small><%=row.equipamento_nome||'Equipamento não informado'%></small></td><td><span class="tag tag-neutral"><%=row.status_label%></span></td><td><strong><%=row.custo_total>0?money(row.custo_total):'—'%></strong></td><td><div class="lower-progress"><i><b style="width:<%=row.recebimento_pct%>%"></b></i><span><%=row.recebimento_pct%>%</span></div></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </section>

  <section class="dashboard-card dashboard-lower-card" aria-labelledby="compras-recebimentos-title">
    <div class="dashboard-lower-head">
      <div><h2 id="compras-recebimentos-title">RECEBIMENTOS PREVISTOS</h2><p>Prazos reais registrados na solicitação ou na cotação selecionada.</p></div>
      <span class="dashboard-lower-badge"><%= lower.receipts.length %> próximos</span>
    </div>
    <% if(!lower.receipts.length){ %>
      <div class="lower-empty">Nenhuma previsão de recebimento registrada para as solicitações do período.</div>
    <% } else { %>
      <div class="receipt-list">
        <% lower.receipts.forEach(row=>{ %><div class="receipt-row"><div class="receipt-date"><strong><%=dateBR(row.previsao_entrega_real)%></strong><span class="<%=row.atrasado?'is-late':row.vence_hoje?'is-today':''%>"><%=row.atrasado?'Atrasado':row.vence_hoje?'Hoje':'Programado'%></span></div><div class="receipt-main"><a href="/compras/solicitacoes/<%=row.id%>"><%=row.numero||'#'+row.id%> — <%=row.titulo||'Sem título'%></a><small><%=row.fornecedor_real||'Fornecedor não informado'%> · <%=row.status_label%></small></div><div class="receipt-value"><%=row.custo_total>0?money(row.custo_total):'Valor não informado'%></div></div><% }) %>
      </div>
    <% } %>
  </section>
</div>
</div><script src="/js/compras-dashboard.js?v=20260819-selection-artifacts-v2" defer></script><script>document.querySelectorAll('.request-row[data-href]').forEach(row=>{const open=()=>location.href=row.dataset.href;row.addEventListener('click',event=>{if(!event.target.closest('a,button,details,summary,form'))open()});row.addEventListener('keydown',event=>{if(event.key==='Enter'&&!event.target.closest('a,button,details,summary'))open()})});</script>