<% layout('layout') %>
<%
const labels={ABERTA:'Aberta',REABERTA:'Reaberta',EM_COTACAO:'Em cotação',COMPRADA:'Comprada',EM_RECEBIMENTO:'Em recebimento',RECEBIDA_PARCIAL:'Recebida parcial',RECEBIDA_TOTAL:'Recebida total',FECHADA:'Fechada',CANCELADA:'Cancelada'};
const cardDefs=[['os','OS VINCULADAS'],['abertas','SOLICITAÇÕES ABERTAS'],['cotacao','EM COTAÇÃO'],['recebimento','EM RECEBIMENTO'],['recebidas','RECEBIDAS'],['atrasadas','ATRASADAS']];
const groupDefs=[['high','Críticas e altas'],['medium','Prioridade média'],['low','Prioridade baixa'],['undefined','Sem prioridade definida']];
const params=new URLSearchParams(); Object.entries(filters||{}).forEach(([k,v])=>{if(v&&k!=='query')params.set(k,v)}); if(filters?.query)params.set('q',filters.query);
const url=(changes={})=>{const p=new URLSearchParams(params);Object.entries(changes).forEach(([k,v])=>v===null||v===''?p.delete(k):p.set(k,v));return '/compras/solicitacoes'+(p.toString()?'?'+p:'')};
const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const totalAnalytics=statusList.reduce((n,s)=>n+Number(resumo?.[s]||0),0); const received=Number(resumo?.RECEBIDA_TOTAL||0)+Number(resumo?.FECHADA||0); const completion=totalAnalytics?Math.round(received/totalAnalytics*100):0;
%>
<link rel="stylesheet" href="/css/compras-dashboard.css">
<div class="purchase-dashboard">
<header class="dashboard-heading"><div><h1>Painel de Compras</h1><p>Fila operacional e indicadores do setor de Compras</p></div>
<form class="dashboard-filters" method="get"><input type="hidden" name="tab" value="<%= filters.tab %>"><input type="hidden" name="card" value="<%= filters.card %>">
<label>Período dos indicadores<select name="period"><option value="7" <%= filters.period===7?'selected':'' %>>Últimos 7 dias</option><option value="30" <%= filters.period===30?'selected':'' %>>Últimos 30 dias</option><option value="90" <%= filters.period===90?'selected':'' %>>Últimos 90 dias</option></select></label>
<label>Busca<input name="q" placeholder="Número, título, setor ou solicitante, OS, equipamento..." value="<%= filters.query %>"></label>
<label>Setor<select name="setor"><option value="">Todos</option><% queue.setores.forEach(v=>{ %><option <%= filters.setor===v?'selected':'' %>><%= v %></option><% }) %></select></label>
<label>Prioridade<select name="prioridade"><option value="">Todas</option><option value="high" <%= filters.prioridade==='high'?'selected':'' %>>Crítica / alta</option><option value="medium" <%= filters.prioridade==='medium'?'selected':'' %>>Média</option><option value="low" <%= filters.prioridade==='low'?'selected':'' %>>Baixa</option><option value="undefined" <%= filters.prioridade==='undefined'?'selected':'' %>>Não definida</option></select></label>
<label>Responsável<select name="responsavel"><option value="">Todos</option><% queue.responsaveis.forEach(v=>{ %><option value="<%= v.id %>" <%= String(filters.responsavel)===String(v.id)?'selected':'' %>><%= v.nome %></option><% }) %></select></label>
<button class="refresh-button" type="submit">Aplicar</button><a class="clear-filters" href="/compras/solicitacoes">Limpar filtros</a></form></header>
<span class="sr-only">Vinculadas à OS</span><span class="sr-only">Urgentes</span><section class="metric-grid compras-summary" aria-label="Filtros rápidos da fila"><% cardDefs.forEach(([key,label])=>{const selected=filters.tab==='active'&&filters.card===key;%>
<form method="get" class="metric-form"><% Object.entries(filters).forEach(([k,v])=>{if(v&& !['card','page','tab'].includes(k)){%><input type="hidden" name="<%= k==='query'?'q':k %>" value="<%= v %>"><%}})%><input type="hidden" name="tab" value="active"><% if(!selected){%><input type="hidden" name="card" value="<%= key %>"><%}%><button type="submit" class="metric-card <%= selected?'is-selected':'' %>" aria-pressed="<%= selected %>"><span><%= label %></span><strong><%= queue.cards[key] %></strong><small><%= selected?'Filtro ativo':'Filtrar fila' %></small></button></form><% }) %></section>
<section class="dashboard-card attention-card">
<div class="queue-tabs" role="tablist"><a role="tab" aria-selected="<%= filters.tab==='active' %>" class="<%= filters.tab==='active'?'active':'' %>" href="<%= url({tab:'active',card:null,page:null}) %>">Ativas</a><a role="tab" aria-selected="<%= filters.tab==='history' %>" class="<%= filters.tab==='history'?'active':'' %>" href="<%= url({tab:'history',card:null,page:null}) %>">Fechadas e histórico</a></div>
<div class="attention-heading"><div><h2><%= filters.tab==='active'?'Solicitações ativas para Compras':'Fechadas e histórico' %></h2><p><%= filters.tab==='active'?'Fila operacional com todas as solicitações que ainda não foram fechadas.':'Solicitações fechadas e canceladas para consulta.' %></p></div><div class="attention-controls"><span>Mostrando <%= lista.length %> de <%= queue.total %> solicitações <%= filters.tab==='active'?'ativas':'' %></span><form method="get"><% Object.entries(filters).forEach(([k,v])=>{if(v&&k!=='limit'&&k!=='page'){%><input type="hidden" name="<%= k==='query'?'q':k %>" value="<%= v %>"><%}})%><select name="limit" aria-label="Quantidade de solicitações" onchange="this.form.submit()"><% [10,20,50].forEach(n=>{%><option value="<%=n%>" <%=queue.limit===n?'selected':''%>>Exibir <%=n%></option><%})%></select></form></div></div>
<% if(!lista.length){ %><p class="empty-state"><%= filters.card?'Não há solicitações nessa situação.':filters.tab==='active'?'Nenhuma solicitação ativa encontrada':'Nenhum registro no histórico encontrado.' %></p><% } %>
<% groupDefs.forEach(([group,label])=>{const rows=lista.filter(s=>s.priorityGroup===group);if(!rows.length)return;%><div class="priority-section priority-<%=group%>"><h3><%=label%> — <%=rows.length%></h3><%if(group==='undefined'){%><p class="data-warning">Cadastro precisa ser corrigido.</p><%}%><div class="request-list"><%rows.forEach(s=>{const total=Number(s.itens_count||0),done=Number(s.itens_cotados||0),pct=total?Math.round(done/total*100):0;%><article class="request-row <%=s.overdue?'is-overdue':''%>"><div><strong><%=s.numero||'#'+s.id%></strong><span><%=s.titulo||'Não definido'%></span></div><div><b><%=s.os_id?'OS '+s.os_id:'OS: Não definido'%></b><span><%=s.equipamento_nome||'Equipamento: Não definido'%></span></div><div><span class="tag"><%=s.prioridade||'Não definida'%></span><span><%=labels[s.status]||s.status%></span></div><div class="item-counts"><span>Total <b><%=total%></b></span><span>Cotados <b><%=done%></b></span><span>Comprados <b><%=s.itens_comprados||0%></b></span><span>Recebidos <b><%=s.itens_recebidos||0%></b></span></div><div><span><%=done%> de <%=total%> itens cotados — <%=pct%>%</span><i class="item-progress"><b style="width:<%=pct%>%"></b></i></div><div><b><%=s.deadline?(s.overdue?'Atrasada: ':s.dueToday?'Vence hoje: ':'Prazo: ')+s.deadline:'Prazo a definir'%></b><span><%=s.responsavel_nome||'Responsável: Não definido'%></span></div><div class="row-actions"><a class="table-action" href="/compras/solicitacoes/<%=s.id%>">Abrir</a><%if(filters.tab==='history'){%><small>Fechamento: <%=s.data_fechamento||'Não definido'%><br>Fornecedor: <%=s.fornecedor_nome||s.fornecedor||'Não definido'%><br>Valor: <%=money(s.valor_total)%></small><a href="/compras/solicitacoes/<%=s.id%>/pdf">Gerar PDF</a><%}%></div></article><%})%></div></div><%})%>
<%if(queue.pages>1){%><nav class="pagination" aria-label="Paginação"><%for(let p=1;p<=queue.pages;p++){%><a class="<%=p===queue.page?'active':''%>" href="<%=url({page:p})%>"><%=p%></a><%}%></nav><%}%></section>
<section class="dashboard-card progress-overview"><div class="progress-main"><h2>ANDAMENTO GERAL DAS COMPRAS</h2><p>Indicadores dos últimos <%=filters.period%> dias</p><%[['Abertas',resumo.ABERTA],['Em cotação',resumo.EM_COTACAO],['Recebidas',received]].forEach(r=>{%><div class="progress-row"><span><%=r[0]%></span><i><b style="width:<%=totalAnalytics?Number(r[1]||0)/totalAnalytics*100:0%>%"></b></i><strong><%=r[1]||0%></strong></div><%})%></div><div class="completion"><div><span>Solicitações concluídas</span><strong><%=received%> de <%=totalAnalytics%></strong><small>No período dos indicadores</small></div><div class="completion-ring" style="--progress:<%=completion%>"><b><%=completion%>%</b></div></div></section>
<div class="dashboard-columns"><section class="dashboard-card"><h2>SOLICITAÇÕES POR STATUS</h2><%statusList.forEach(s=>{%><p><%=labels[s]||s%>: <strong><%=resumo[s]||0%></strong></p><%})%></section><section class="dashboard-card cost-card"><h2>CUSTOS DO PERÍODO</h2><p>Valores calculados sobre os registros do período: <strong><%=money(lista.reduce((n,s)=>n+Number(s.valor_total||0),0))%></strong></p></section></div>
<div class="dashboard-columns bottom-panels"><section class="dashboard-card"><h2>OS VINCULADAS ÀS COMPRAS</h2><p><%=queue.cards.os%> solicitações ativas vinculadas.</p></section><section class="dashboard-card"><h2>RECEBIMENTOS PREVISTOS</h2><p>Consulte prazos reais na fila operacional.</p></section></div>
</div><script src="/js/compras-dashboard.js" defer></script>
