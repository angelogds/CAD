<% layout('layout') %>
<%
const money = (c) => (Number(c || 0) / 100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const activeItems = Array.isArray(sol.itensAtivos) ? sol.itensAtivos : (sol.itens||[]).filter(it=>String(it.status_compra||'').toUpperCase()!=='CANCELADO');
const cancelledItems = Array.isArray(sol.itensCancelados) ? sol.itensCancelados : (sol.itens||[]).filter(it=>String(it.status_compra||'').toUpperCase()==='CANCELADO');
const receiptShortages=activeItems.map(it=>{const expected=Number(it.qtd_comprada??it.qtd_solicitada??0),received=Number(it.qtd_recebida_total||0),missing=Math.max(expected-received,0),purchased=String(it.status_compra||'').toUpperCase()==='COMPRADO';return{...it,expected,received,missing,purchased,partial:purchased&&received>0&&missing>0};}).filter(it=>it.partial);
const pendingDeletionCount = activeItems.filter(it=>String(it.exclusao_status||'').toUpperCase()==='PENDENTE').length;
const blockedExtraStatuses = ['RECEBIDA_TOTAL','SEPARADA_PARA_RETIRADA','ENTREGUE_SOLICITANTE','FECHADA','CANCELADA'];
const canAddExtra = !blockedExtraStatuses.includes(String(sol.status||'').toUpperCase());
%>
<link rel="stylesheet" href="/css/compras-recebimento-alertas.css?v=20260902-v1">
<link rel="stylesheet" href="/css/compras-painel.css?v=20260903-consenso-v1">
<link rel="stylesheet" href="/css/compras-itens-consenso.css?v=20260903-v1">

<div class="page-head quote-page-head"><div><h1><%= sol.numero || ('Solicitação #' + sol.id) %></h1><p class="muted">Solicitante: <%= sol.solicitante_nome || '-' %> • Setor: <%= sol.setor_origem || '-' %> • Status: <strong><%= String(sol.status).replaceAll('_',' ') %></strong></p></div><div class="quote-actions"><a class="ui-btn ui-btn--outline" href="/compras/solicitacoes">Voltar</a><a class="ui-btn" href="/compras/solicitacoes/<%= sol.id %>/pdf">Baixar cópia do PDF</a></div></div>
<% if (sol.os_id) { %><div class="card linked-os"><div><strong>🔗 Vinculada à OS <%= sol.os_id %><%= sol.equipamento_nome ? (' — ' + sol.equipamento_nome) : '' %></strong></div><div class="linked-os-actions"><a class="ui-btn ui-btn--table" href="/chat-os/<%= sol.os_id %>">Abrir conversa da OS</a><a class="ui-btn ui-btn--outline ui-btn--table" href="/os/<%= sol.os_id %>">Abrir OS</a></div></div><% } %>

<% if(pendingDeletionCount){ %>
<div class="card purchase-consensus-banner"><div><span class="purchase-consensus-kicker">AGUARDANDO SOLICITANTE</span><strong><%= pendingDeletionCount %> item(ns) com pedido de exclusão pendente</strong><p>Esses itens continuam registrados e não podem ser comprados ou alterados até o solicitante confirmar ou recusar a exclusão.</p></div><a class="ui-btn ui-btn--outline" href="#itens-cotacao">Ver itens</a></div>
<% } %>

<% if(receiptShortages.length){ %>
<div class="card purchase-receipt-alert-detail">
  <div class="purchase-receipt-alert-head"><div><span>ALERTA DO ALMOXARIFADO</span><h2>Recebimento com quantidade menor que a comprada</h2><p>Verifique o fornecedor e a necessidade de complemento. O estoque só será alterado quando o Almoxarifado conferir fisicamente a nova entrega.</p></div><strong><%=receiptShortages.length%> item(ns)</strong></div>
  <div class="purchase-receipt-alert-items">
    <% receiptShortages.forEach(it=>{ %><div><span><strong><%=it.item_nome||'Item #'+it.id%></strong><small><%=it.item_descricao||''%></small></span><span>Comprado <b><%=it.expected%> <%=it.unidade||'UN'%></b></span><span>Recebido <b><%=it.received%> <%=it.unidade||'UN'%></b></span><span class="is-missing">Faltante <b><%=it.missing%> <%=it.unidade||'UN'%></b></span></div><% }) %>
  </div>
  <p class="purchase-receipt-alert-note">Esta sinalização é automática: quando o Almoxarifado registrar o restante e a quantidade recebida atingir a quantidade comprada, o alerta desaparece.</p>
</div>
<% } %>

<div class="card progress-card"><div class="section-title">ANDAMENTO DA COTAÇÃO</div><div class="progress-track" role="progressbar" aria-label="Itens cotados" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= sol.resumoItens.progresso %>"><span style="width:<%= sol.resumoItens.progresso %>%"><b><%= sol.resumoItens.progresso %>%</b></span></div><div class="progress-stats"><span><i class="progress-icon success">✓</i><strong><%= sol.resumoItens.cotados %> de <%= sol.resumoItens.total %> itens ativos cotados</strong></span><span><i class="progress-icon warning">□</i><strong><%= sol.resumoItens.comprados %> de <%= sol.resumoItens.total %> itens ativos comprados</strong></span><span><i class="progress-icon success">$</i><strong>Total ativo da solicitação: <b data-total-geral><%= money(sol.resumoItens.totalCentavos) %></b></strong></span></div></div>

<form id="quote-form" method="POST" action="/compras/solicitacoes/<%= sol.id %>/painel-itens">
<div class="card quote-items-card" id="itens-cotacao"><div class="section-title">COTAÇÃO, COMPRA E ACOMPANHAMENTO DO RECEBIMENTO</div><p class="muted purchase-receipt-rule">Compras registra cotação e compra. A quantidade recebida é somente leitura aqui e é alimentada exclusivamente pela conferência do Almoxarifado.</p>
<% if (!sol.valores_itens_revisados && sol.valor_total) { %><div class="legacy-warning">⚠️ Valor legado preservado: <strong><%= Number(sol.valor_total).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></strong>. Revise os preços por item.</div><% } %>
<div class="table-wrap quote-table-wrap purchase-table-organized"><table class="table quote-table"><thead><tr><th class="col-select"><input type="checkbox" id="select-all-items" aria-label="Selecionar todos os itens cotados"></th><th class="col-status">Status</th><th class="col-item">Item / descrição</th><th class="col-qty">Qtd.</th><th class="col-un">UN</th><th class="col-supplier">Fornecedor</th><th class="col-price">Valor unitário</th><th class="col-subtotal">Subtotal</th><th class="col-receipt">Recebimento</th><th class="col-actions">Ações</th></tr></thead><tbody>
<% if (!activeItems.length) { %><tr><td colspan="10" class="muted">Sem itens ativos para cotação.</td></tr><% } %>
<% activeItems.forEach((it) => { const exclusionPending=String(it.exclusao_status||'').toUpperCase()==='PENDENTE'; const state=it.status_compra==='COMPRADO'?'comprado':it.status_cotacao==='COTADO'?'cotado':'pendente'; const expected=Number(it.qtd_comprada??it.qtd_solicitada??0),receivedQty=Number(it.qtd_recebida_total||0),missing=Math.max(expected-receivedQty,0),isPurchased=String(it.status_compra||'').toUpperCase()==='COMPRADO',partialReceipt=isPurchased&&receivedQty>0&&missing>0,completeReceipt=isPurchased&&expected>0&&receivedQty>=expected; %>
<% if(exclusionPending){ %>
<tr class="quote-row-flow is-exclusion-pending"><td data-label="Seleção">—</td><td data-label="Status"><span class="status-badge consensus-pending">AGUARDANDO</span></td><td data-label="Item"><strong><%= it.item_nome || '-' %></strong><small><%= it.item_descricao || '' %></small><small class="extra-origin"><%= String(it.origem_item||'')==='COMPRAS_EXTRA'?'Adicionado por Compras':'' %></small></td><td data-label="Quantidade"><%= it.qtd_solicitada %></td><td data-label="Unidade"><%= it.unidade || 'UN' %></td><td colspan="4" data-label="Exclusão"><div class="consensus-inline"><strong>Exclusão aguardando o solicitante</strong><span><%= it.exclusao_motivo || 'Motivo não informado' %></span><small>O item permanece no histórico e está bloqueado para novas ações de compra.</small></div></td><td data-label="Ações"><button class="ui-btn ui-btn--outline ui-btn--table" type="submit" formaction="/compras/solicitacoes/<%=sol.id%>/itens/<%=it.id%>/exclusao/cancelar" formmethod="post" formnovalidate onclick="return confirm('Cancelar o pedido de exclusão deste item?')">Cancelar pedido</button></td></tr>
<% } else { %>
<tr class="quote-row state-<%= state %> <%=partialReceipt?'row-receipt-shortage':''%>" data-quantity="<%= it.qtd_solicitada %>"><td data-label="Seleção"><input type="hidden" name="item_id" value="<%= it.id %>"><input class="buy-check" type="checkbox" name="comprar" value="<%= it.id %>" <%= state==='pendente'?'disabled':'' %> aria-label="Selecionar <%= it.item_nome || 'item' %> para comprar"></td><td data-label="Status"><label class="check-label"><input class="quoted-check" type="checkbox" name="cotado" value="<%= it.id %>" <%= it.status_cotacao==='COTADO'?'checked':'' %>><span class="status-badge"><%= state.toUpperCase() %></span></label><% if(String(it.origem_item||'')==='COMPRAS_EXTRA'){%><span class="origin-badge">EXTRA</span><%}%></td><td data-label="Item"><strong><%= it.item_nome || '-' %></strong><small><%= it.item_descricao || '' %></small><% if(String(it.origem_item||'')==='COMPRAS_EXTRA'){%><small class="extra-origin">Adicionado por Compras · <%=it.adicao_justificativa||''%></small><%}%></td><td data-label="Quantidade"><%= it.qtd_solicitada %></td><td data-label="Unidade"><%= it.unidade || 'UN' %></td><td data-label="Fornecedor"><input class="input supplier-search" type="search" placeholder="Buscar nome, CNPJ, material..." aria-label="Pesquisar fornecedor"><select class="input supplier" name="fornecedor_id"><option value="">Selecionar fornecedor</option><% fornecedores.forEach(f=>{ const autoSelected=Number(selectedSupplierId)===Number(f.id)&&(!selectedItemId||Number(selectedItemId)===Number(it.id)); %><option value="<%= f.id %>" data-search="<%= [f.nome,f.cnpj,f.cidade,f.uf,f.categorias,f.produtos].filter(Boolean).join(' ') %>" <%= Number(it.fornecedor_id)===Number(f.id)||autoSelected?'selected':'' %>><%= f.nome %><%= f.cidade?' · '+f.cidade+(f.uf?'/'+f.uf:''):'' %><%= f.total_compras?' · '+f.total_compras+' compras':'' %></option><% }) %></select><small class="supplier-hint"></small><a class="link-button new-supplier" data-item-id="<%=it.id%>" data-item-name="<%=it.item_nome||''%>" href="/fornecedores/novo?solicitacao_id=<%=sol.id%>&item_id=<%=it.id%>&numero=<%=encodeURIComponent(sol.numero||'')%>&equipamento=<%=encodeURIComponent(sol.equipamento_nome||'')%>&item=<%=encodeURIComponent(it.item_nome||'')%>">+ Cadastrar fornecedor</a></td><td data-label="Valor unitário"><input class="input unit-price" name="valor_unitario" inputmode="decimal" value="<%= it.valor_unitario_centavos == null ? '' : (it.valor_unitario_centavos/100).toFixed(2).replace('.',',') %>" placeholder="R$ 0,00"></td><td data-label="Subtotal"><strong class="item-subtotal"><%= money(it.subtotal_centavos) %></strong></td><td data-label="Recebimento"><div class="purchase-receipt-readonly <%=partialReceipt?'is-shortage':completeReceipt?'is-complete':''%>"><strong><%=receivedQty%> de <%=expected%> <%=it.unidade||'UN'%></strong><% if(partialReceipt){%><span>Faltam <%=missing%> <%=it.unidade||'UN'%></span><small>Conferência parcial do Almoxarifado — verificar fornecedor.</small><%}else if(completeReceipt){%><span>Recebimento completo</span><small>Conferido pelo Almoxarifado.</small><%}else if(isPurchased){%><span>Aguardando Almoxarifado</span><small>Nenhuma entrada física registrada ainda.</small><%}else{%><span>Não liberado</span><small>O item ainda não foi marcado como comprado.</small><%}%></div></td><td data-label="Ações"><div class="purchase-row-actions"><button type="button" class="ui-btn ui-btn--table edit-item">Editar</button><button type="button" class="ui-btn ui-btn--danger-soft ui-btn--table js-request-item-delete" data-action="/compras/solicitacoes/<%=sol.id%>/itens/<%=it.id%>/exclusao" data-item="<%=String(it.item_nome||'Item').replace(/&/g,'&amp;').replace(/\"/g,'&quot;')%>" <%=receivedQty>0?'disabled title="Item com recebimento não pode ser excluído"':''%>>Excluir</button></div></td></tr>
<% } %>
<% }) %></tbody></table></div></div>

<div class="purchase-grid"><div class="card"><div class="section-title">DADOS GERAIS DA COMPRA</div><div class="grid-3">
<div><label class="label">Fornecedor principal</label><select class="input" name="fornecedor_principal_id" id="main-supplier"><option value="">Selecionar</option><% fornecedores.forEach(f=>{ %><option value="<%= f.id %>" <%= Number(sol.fornecedor_id)===Number(f.id)?'selected':'' %>><%= f.nome %></option><% }) %></select><button type="button" class="link-button" id="apply-supplier">Aplicar aos itens sem fornecedor</button></div>
<div><label class="label">Condição de pagamento</label><input class="input" name="condicao_pagamento" value="<%= sol.condicao_pagamento || '' %>"></div><div><label class="label">Validade da cotação</label><input class="input" type="date" name="validade_cotacao" value="<%= sol.validade_cotacao ? String(sol.validade_cotacao).slice(0,10):'' %>"></div>
<div><label class="label">Previsão de entrega</label><input class="input" type="date" name="previsao_entrega" value="<%= sol.previsao_entrega ? String(sol.previsao_entrega).slice(0,10):'' %>"></div><div><label class="label">Número do pedido</label><input class="input" name="numero_pedido" value="<%= sol.numero_pedido || '' %>"></div><div><label class="label">Número da nota fiscal</label><input class="input" name="numero_nota_fiscal" value="<%= sol.numero_nota_fiscal || '' %>"></div><div class="span-all"><label class="label">Observações de Compras</label><textarea class="input" name="observacoes_compras"><%= sol.observacoes_compras || '' %></textarea></div></div></div>
<div class="card financial"><div class="section-title">RESUMO FINANCEIRO</div><div><span>Subtotal dos itens ativos</span><strong data-subtotal><%= money(sol.resumoItens.subtotalCentavos) %></strong></div><label><span>Frete</span><input class="input adjustment" name="frete" value="<%= (sol.resumoItens.freteCentavos/100).toFixed(2).replace('.',',') %>"></label><label><span>Desconto</span><input class="input adjustment" name="desconto" value="<%= (sol.resumoItens.descontoCentavos/100).toFixed(2).replace('.',',') %>"></label><div class="grand-total"><span>Total geral</span><strong data-total-geral><%= money(sol.resumoItens.totalCentavos) %></strong></div></div></div>
<div class="form-actions"><button class="ui-btn ui-btn--outline" type="submit" name="acao" value="salvar">Salvar rascunho</button><button class="ui-btn" type="submit" name="acao" value="comprar">Marcar itens selecionados como COMPRADOS</button></div></form>

<section class="card exceptional-item-card" id="item-excepcional">
  <div class="exceptional-item-head"><div><span class="section-kicker">EXCEÇÃO CONTROLADA</span><h2>Adicionar item fora da solicitação original</h2><p>Use quando Compras precisar incluir um material adquirido ou cotado depois da abertura. O item passa a integrar esta mesma solicitação e seguirá normalmente para o Almoxarifado e Estoque.</p></div><span class="origin-badge">AUDITADO</span></div>
  <% if(canAddExtra){ %>
  <form method="POST" action="/compras/solicitacoes/<%=sol.id%>/itens-excepcionais" class="exceptional-item-form">
    <label class="span-2"><span class="label">Item / material</span><input class="input" name="item_nome" maxlength="180" required placeholder="Ex.: Rolamento 22218 completo"></label>
    <label><span class="label">Quantidade</span><input class="input" type="number" min="0.001" step="0.001" name="qtd_solicitada" required></label>
    <label><span class="label">Unidade</span><input class="input" name="unidade" value="UN" maxlength="20" required></label>
    <label class="span-2"><span class="label">Descrição técnica / referência</span><input class="input" name="item_descricao" maxlength="1200" placeholder="Marca, modelo, medidas, referência..."></label>
    <label><span class="label">Situação inicial</span><select class="input" name="modo" id="extra-item-mode"><option value="COTACAO">Adicionar para cotação</option><option value="COMPRADO">Já foi comprado</option></select></label>
    <label><span class="label">Fornecedor</span><select class="input" name="fornecedor_id"><option value="">Selecionar quando aplicável</option><% fornecedores.forEach(f=>{ %><option value="<%=f.id%>"><%=f.nome%></option><% }) %></select></label>
    <label><span class="label">Valor unitário</span><input class="input" name="valor_unitario" inputmode="decimal" placeholder="0,00"></label>
    <label class="span-3"><span class="label">Justificativa obrigatória</span><textarea class="input" name="adicao_justificativa" maxlength="1200" required placeholder="Explique por que este item está sendo incluído após a solicitação original."></textarea></label>
    <div class="span-3 exceptional-item-actions"><small>Se “Já foi comprado” for selecionado, fornecedor e valor unitário tornam-se obrigatórios.</small><button class="ui-btn" type="submit">Adicionar à solicitação</button></div>
  </form>
  <% } else { %><div class="exceptional-item-blocked">A solicitação já está em uma etapa encerrada para inclusão de novos itens.</div><% } %>
</section>

<% if(cancelledItems.length){ %>
<details class="card cancelled-items-card"><summary><span>Itens removidos por consenso</span><strong><%=cancelledItems.length%></strong></summary><div class="cancelled-items-list"><% cancelledItems.forEach(it=>{ %><div><span><strong><%=it.item_nome||'Item #'+it.id%></strong><small><%=it.qtd_solicitada%> <%=it.unidade||'UN'%> · <%=it.exclusao_motivo||'Sem motivo registrado'%></small></span><span class="status-badge cancelled">REMOVIDO</span></div><% }) %></div></details>
<% } %>

<% if(Array.isArray(historicoExclusoes) && historicoExclusoes.length){ %>
<details class="card consensus-history"><summary>Histórico de pedidos de exclusão</summary><div class="consensus-history-list"><% historicoExclusoes.forEach(row=>{ %><div><span><strong><%=row.item_nome||'Item'%></strong><small><%=row.motivo%></small></span><span><b><%=row.status%></b><small>Solicitado por <%=row.solicitada_por_nome||'-'%><%=row.respondida_por_nome?' · respondido por '+row.respondida_por_nome:''%></small></span></div><% }) %></div></details>
<% } %>

<div class="card attachments"><div class="section-title">ANEXAR COTAÇÃO / NOTA FISCAL</div><form method="POST" action="/compras/solicitacoes/<%= sol.id %>/anexos" enctype="multipart/form-data" class="attachment-form"><label><span class="label">Tipo</span><select class="input" name="tipo"><option>COTACAO</option><option>PEDIDO_COMPRA</option><option>NOTA_FISCAL</option><option>COMPROVANTE</option><option>OUTRO</option></select></label><label><span class="label">Arquivo (PDF/JPG/PNG/WEBP)</span><input class="input" type="file" name="arquivo" accept="application/pdf,image/jpeg,image/png,image/webp" required></label><button class="ui-btn ui-btn--outline" type="submit">Enviar anexo</button></form><div class="table-wrap"><table class="table"><thead><tr><th>Tipo</th><th>Nome original</th><th>Data</th><th>Usuário</th><th>Ações</th></tr></thead><tbody><% if(!sol.anexos.length){ %><tr><td colspan="5" class="empty-state">Sem anexos.</td></tr><% } sol.anexos.forEach(a=>{ %><tr><td><%= a.tipo %></td><td><%= a.original_name || a.filename %></td><td><%= fmtBR(a.created_at || a.uploaded_at) %></td><td><%= a.uploaded_by_nome || '-' %></td><td><a class="ui-btn ui-btn--outline ui-btn--table" href="/compras/anexos/<%= a.id %>/download">Visualizar / baixar</a></td></tr><% }) %></tbody></table></div></div>

<dialog class="purchase-consensus-dialog" id="delete-item-dialog">
  <form method="POST" id="delete-item-form">
    <div class="dialog-head"><div><span class="section-kicker">EXCLUSÃO COM CONSENSO</span><h2>Solicitar exclusão de item</h2></div><button type="button" class="dialog-close" data-close-dialog aria-label="Fechar">×</button></div>
    <p>O item <strong data-delete-item-name></strong> não será apagado agora. O solicitante original precisará confirmar a exclusão.</p>
    <label><span class="label">Motivo da exclusão</span><textarea class="input" name="motivo" minlength="5" maxlength="1000" required placeholder="Ex.: material localizado internamente na empresa; compra externa não é mais necessária."></textarea></label>
    <div class="dialog-actions"><button type="button" class="ui-btn ui-btn--outline" data-close-dialog>Cancelar</button><button type="submit" class="ui-btn ui-btn--danger-soft">Enviar para confirmação</button></div>
  </form>
</dialog>

<script src="/js/compras-painel.js" defer></script>
<script src="/js/compras-itens-consenso.js" defer></script>
