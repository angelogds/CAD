<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260913-rh">
<link rel="stylesheet" href="/css/escala-rh-self.css?v=20260913-rh">
<link rel="stylesheet" href="/css/escala-aprovacoes-folgas.css?v=20260913-rh">
<%
  const fmtMin = (value) => { const n=Number(value||0); const sign=n<0?'-':''; const m=Math.abs(n); return `${sign}${Math.floor(m/60)}h${String(m%60).padStart(2,'0')}`; };
  const requests = Array.isArray(solicitacoesFolga) ? solicitacoesFolga : [];
  const requestPendente = requests.find(s=>s.status==='PENDENTE_APROVACAO');
  const saldoMinutos = Number(banco?.saldo?.minutos ?? card?.saldo?.minutos ?? 0);
  const periodoMap = periodosFolga || {};
  const periodoFolgaItens = [
    { value: 'MANHA', titulo: 'Manhã', descricao: 'Meio período', minutos: Number(periodoMap.MANHA?.minutos || 240), minimo: Number(periodoMap.MANHA?.minimo || 210) },
    { value: 'TARDE', titulo: 'Tarde', descricao: 'Meio período', minutos: Number(periodoMap.TARDE?.minutos || 240), minimo: Number(periodoMap.TARDE?.minimo || 210) },
    { value: 'DIA_TODO', titulo: 'Dia todo', descricao: 'Jornada completa', minutos: Number(periodoMap.DIA_TODO?.minutos || minutosFolga || 480), minimo: Number(periodoMap.DIA_TODO?.minimo || minutosFolga || 480) },
  ].map((item) => ({ ...item, permitido: saldoMinutos >= item.minimo }));
  const podeSolicitar = periodoFolgaItens.some((item) => item.permitido) && !requestPendente;
  const periodoDefault = periodoFolgaItens.find((item) => item.permitido)?.value || 'MANHA';
%>
<div class="escala-page escala-self-page">
  <header class="escala-head"><div><h1>Minha Escala</h1><p>Consulta pessoal de escala, horas extras, Banco de Horas e solicitação de folga.</p></div><div class="escala-actions"><a class="btn" href="/escala/banco-horas">Meu banco de horas</a><% if(vinculado && canOpenProfile){ %><a class="btn btn-green" href="/colaboradores/<%= colaborador.id %>">Meu perfil</a><% } %></div></header>

  <% if(!vinculado){ %>
    <section class="escala-section self-empty-state"><h2>Cadastro ainda não vinculado</h2><p class="muted">Seu usuário está ativo, mas ainda não está associado a um cadastro de colaborador. Solicite ao RH que faça a vinculação.</p></section>
  <% } else { %>
    <section class="self-profile-card"><div class="self-profile-main"><% if(card?.foto_path || colaborador.foto_url){ %><img class="self-avatar" src="<%= card?.foto_path || colaborador.foto_url %>" alt="Foto de <%= colaborador.nome %>"><% } else { %><div class="self-avatar self-avatar-fallback"><%= String(colaborador.nome||'C').charAt(0).toUpperCase() %></div><% } %><div><h2><%= colaborador.nome %></h2><p><%= card?.funcaoLabel || colaborador.funcao || '-' %> • <%= colaborador.setor || 'Manutenção' %></p></div></div><span class="self-status"><%= card?.statusAtual || 'Sem informação da escala atual' %></span></section>

    <section class="escala-kpis self-kpis"><div class="escala-kpi"><span>Situação atual</span><strong><%= card?.statusAtual || '-' %></strong><small>Status da escala vigente</small></div><div class="escala-kpi"><span>Turno atual</span><strong><%= card?.turnoAtual || '-' %></strong><small>Programação da semana</small></div><div class="escala-kpi"><span>Banco de horas</span><strong><%= banco?.saldo?.horas || card?.saldo?.horas || '0h00' %></strong><small>Créditos e débitos aprovados</small></div><div class="escala-kpi"><span>Horas extras no mês</span><strong><%= card?.horasExtrasMes || '0h00' %></strong><small>Somente registros aprovados</small></div></section>

    <section class="escala-section self-leave-request" id="solicitar-folga">
      <div class="escala-section-head"><div><h2>Solicitar folga pelo Banco de Horas</h2><p>Escolha a data e o período. A origem do direito à folga vem automaticamente das horas extras já aprovadas.</p></div><span class="approval-counter"><%= requestPendente ? '1 aguardando' : 'Disponível' %></span></div>
      <div class="leave-rules"><span>Meio período libera com <strong>3h30</strong></span><span>Meio período debita <strong>4h00</strong></span><span><strong>Dia todo</strong> usa 8h00</span><span><strong>1 colaborador por dia</strong></span><span>Segunda-feira bloqueada</span></div>
      <% if(requestPendente){ %><div class="self-pending-request"><div><span>Data reservada</span><strong><%= dateBr.formatDateBR(requestPendente.data_folga) %></strong><small>Aguardando aprovação da gestão</small></div><form method="POST" action="/escala/folgas/solicitacoes/<%= requestPendente.id %>/cancelar" onsubmit="return confirm('Cancelar sua solicitação e liberar esta data?');"><button class="btn btn-sm" type="submit">Cancelar solicitação</button></form></div><% } else { %>
        <form method="POST" action="/escala/folgas/solicitar" class="self-leave-form self-leave-form--compact" id="selfLeaveForm">
          <label class="escala-field"><span class="label">Data desejada</span><input class="input" type="date" name="data_folga" id="selfLeaveDate" min="<%= todayISO %>" required <%= podeSolicitar?'':'disabled' %>></label>
          <div class="self-leave-options" role="radiogroup" aria-label="Período da folga">
            <% periodoFolgaItens.forEach((item)=>{ %>
              <label class="self-leave-option <%= item.permitido ? '' : 'is-disabled' %>">
                <input type="radio" name="periodo_folga" value="<%= item.value %>" data-minutos="<%= item.minutos %>" data-minimo="<%= item.minimo %>" <%= item.value===periodoDefault ? 'checked' : '' %> <%= item.permitido ? '' : 'disabled' %>>
                <span><strong><%= item.titulo %></strong><small><%= item.descricao %> • <%= fmtMin(item.minutos) %></small></span>
              </label>
            <% }) %>
          </div>
          <div class="self-leave-impact" data-saldo="<%= saldoMinutos %>">
            <span>Saldo atual</span><strong><%= fmtMin(saldoMinutos) %></strong>
            <span>Débito</span><strong id="leaveDebitPreview">-<%= fmtMin(periodoFolgaItens.find((item)=>item.value===periodoDefault)?.minutos || 240) %></strong>
            <span>Saldo após aprovação</span><strong id="leaveBalancePreview"><%= fmtMin(saldoMinutos-(periodoFolgaItens.find((item)=>item.value===periodoDefault)?.minutos || 240)) %></strong>
          </div>
          <button class="btn btn-green" type="submit" <%= podeSolicitar?'':'disabled' %>>Solicitar</button>
        </form>
        <% if(!podeSolicitar){ %><div class="escala-audit-note">Seu saldo atual ainda não libera folga. Para meio período, o mínimo é 3h30; para dia todo, 8h00.</div><% } else if(saldoMinutos >= 210 && saldoMinutos < 240){ %><div class="escala-audit-note">Com 3h30 ou mais, a folga de meio período pode ser solicitada; se aprovada, o saldo pode ficar até -0h30.</div><% } %>
      <% } %>
      <% if(requests.length){ %><div class="self-table-wrap" style="margin-top:14px"><table class="self-table"><thead><tr><th>Data</th><th>Período</th><th>Status</th><th>Decisão</th></tr></thead><tbody><% requests.slice(0,10).forEach(s=>{ %><tr><td><strong><%= dateBr.formatDateBR(s.data_folga) %></strong><small><%= dateBr.formatDateTimeBR(s.solicitado_em) %></small></td><td><%= s.motivo || fmtMin(s.minutos_solicitados) %></td><td><span class="self-badge"><%= String(s.status||'').replaceAll('_',' ') %></span></td><td><%= s.observacao_decisao || '-' %></td></tr><% }) %></tbody></table></div><% } %>
    </section>

    <section class="self-grid-2"><article class="escala-section"><div class="escala-section-head"><div><h2>Movimentos recentes do banco</h2><div class="muted">Créditos e débitos que formam seu saldo.</div></div><a class="btn btn-sm" href="/escala/banco-horas/<%= colaborador.id %>">Ver tudo</a></div><div class="self-table-wrap"><table class="self-table"><thead><tr><th>Data</th><th>Movimento</th><th>Horas</th><th>Descrição</th></tr></thead><tbody><% if(!movimentos.length){ %><tr><td colspan="4" class="muted">Nenhum movimento registrado.</td></tr><% } %><% movimentos.forEach(m=>{ const minutos=Number(m.minutos ?? m.total_minutos ?? 0); %><tr><td><%= dateBr.formatDateBR(m.data_movimento || m.created_at || m.data) %></td><td><%= m.tipo || m.movimento || '-' %></td><td><strong><%= fmtMin(minutos) %></strong></td><td><%= m.descricao || m.observacao || '-' %></td></tr><% }) %></tbody></table></div></article><article class="escala-section"><div class="escala-section-head"><div><h2>Horas extras recentes</h2><div class="muted">Serviços adicionais registrados em seu nome.</div></div></div><div class="self-table-wrap"><table class="self-table"><thead><tr><th>Data</th><th>OS</th><th>Serviço</th><th>Tempo</th><th>Status</th></tr></thead><tbody><% if(!horasExtras.length){ %><tr><td colspan="5" class="muted">Nenhuma hora extra registrada.</td></tr><% } %><% horasExtras.forEach(h=>{ %><tr><td><%= dateBr.formatDateBR(h.data_servico) %></td><td><%= h.os_id ? '#'+h.os_id : '-' %></td><td><%= h.equipamento_nome || h.descricao_servico || h.os_descricao || '-' %></td><td><%= fmtMin(h.total_minutos) %></td><td><span class="self-badge"><%= h.status || '-' %></span></td></tr><% }) %></tbody></table></div></article></section>

    <section class="escala-section"><div class="escala-section-head"><div><h2>Folgas e ausências</h2><div class="muted">Afastamentos e compensações já efetivados no seu cadastro.</div></div></div><div class="self-table-wrap"><table class="self-table"><thead><tr><th>Início</th><th>Fim</th><th>Tipo / Status</th><th>Referência</th></tr></thead><tbody><% if(!folgas.length){ %><tr><td colspan="4" class="muted">Nenhuma folga ou ausência registrada.</td></tr><% } %><% folgas.forEach(f=>{ %><tr><td><%= dateBr.formatDateBR(f.data_folga || f.data_inicio || f.inicio || f.data) %></td><td><%= dateBr.formatDateBR(f.data_fim || f.data_folga || f.data_inicio || f.inicio || f.data) %></td><td><%= String(f.tipo_lancamento || f.tipo || f.status || 'Folga').replaceAll('_',' ') %></td><td><%= f.motivo || f.observacao || '-' %></td></tr><% }) %></tbody></table></div></section>
    <div class="escala-audit-note">Esta área é individual. Dados de outros colaboradores não são exibidos. A escala é um controle operacional interno e não substitui o registro oficial de jornada do RH.</div>
  <% } %>
</div>
<script>
(() => {
  const form=document.getElementById('selfLeaveForm'),input=document.getElementById('selfLeaveDate');
  const impact=document.querySelector('.self-leave-impact[data-saldo]');
  const debit=document.getElementById('leaveDebitPreview');
  const balance=document.getElementById('leaveBalancePreview');
  const fmt=(value)=>{const n=Number(value||0),sign=n<0?'-':'',m=Math.abs(n);return sign+Math.floor(m/60)+'h'+String(m%60).padStart(2,'0');};
  function updateImpact(){const checked=form?.querySelector('input[name="periodo_folga"]:checked');if(!checked||!impact)return;const saldo=Number(impact.dataset.saldo||0),min=Number(checked.dataset.minutos||0);if(debit)debit.textContent='-'+fmt(min);if(balance)balance.textContent=fmt(saldo-min);}
  function validarData(){if(!input||!input.value)return true;const [y,m,d]=input.value.split('-').map(Number);const day=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();if(day===1){alert('Segunda-feira não está disponível para folga pelo Banco de Horas. Escolha outro dia.');input.value='';input.focus();return false;}return true;}
  document.querySelectorAll('input[name="periodo_folga"]').forEach((radio)=>radio.addEventListener('change',updateImpact));
  input?.addEventListener('change',validarData);
  form?.addEventListener('submit',(event)=>{if(!validarData())event.preventDefault();});
  updateImpact();
})();
</script>
