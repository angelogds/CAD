<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260913-rh">
<link rel="stylesheet" href="/css/escala-ui.css?v=20261103-v1">
<%
const listaColaboradores=Array.isArray(colaboradores)?colaboradores:(colaborador?[colaborador]:[]);
const listaOs=Array.isArray(osDisponiveis)?osDisponiveis:[];
const listaHistorico=Array.isArray(historico)?historico:[];
const inicioFixo17=typeof modoInicioFixo17!=='undefined'&&modoInicioFixo17;
const acessoInicioFixo17=typeof podeInicioFixo17!=='undefined'&&podeInicioFixo17;
const liberado17=typeof podeAbrir17Agora==='undefined'?true:podeAbrir17Agora;
const caminhoFormulario=inicioFixo17?'/escala/hora-extra/desde-17':'/escala/hora-extra/nova';
const fmtMin=v=>{const n=Math.max(0,Number(v)||0);return Math.floor(n/60)+'h'+String(n%60).padStart(2,'0');};
%>
<div class="escala-page"><div class="escala-hour-page">
<header class="escala-head"><div><span class="escala-eyebrow">EQUIPE · HORA EXTRA</span><h1><%=inicioFixo17?'Hora extra das 17h':'Registrar hora extra'%></h1></div></header>
<%- include('_tabs',{escalaTab:'extras'}) %>
<% if(!colaborador){ %><section class="escala-section"><p>Nenhum funcionário disponível para este registro.</p></section><% }else{ %>
<section class="escala-section escala-hour-form">
<% if(canManageEscala&&listaColaboradores.length>1){ %><form method="get" action="<%=caminhoFormulario%>"><label class="escala-field">Funcionário<select class="input" name="colaborador_id" onchange="this.form.submit()"><% listaColaboradores.forEach(c=>{ %><option value="<%=c.id%>" <%=c.id===colaborador.id?'selected':''%>><%=c.nome%></option><% }) %></select></label></form><% }else{ %><div class="escala-identity"><div class="escala-avatar"><%=String(colaborador.nome||'F').charAt(0)%></div><strong><%=colaborador.nome%></strong></div><% } %>
<% if(emAndamento){ %>
<header class="escala-section-head" style="margin-top:18px"><h2>Em andamento</h2><span class="escala-status">Iniciada às <%=dateBr.formatTimeBR(emAndamento.inicio_extra)%></span></header>
<div class="escala-extra-clock js-extra-clock" data-start="<%=emAndamento.inicio_extra%>">0h00</div>
<p><%=emAndamento.os_id?'OS #'+emAndamento.os_id:'Sem OS'%> · <%=emAndamento.descricao_servico||'Serviço em execução'%></p>
<form method="post" action="/escala/hora-extra/<%=emAndamento.id%>/finalizar" enctype="multipart/form-data" id="horaExtraFinalizarForm" data-geo-context="fim">
<input type="hidden" name="latitude_fim"><input type="hidden" name="longitude_fim"><input type="hidden" name="precisao_fim">
<div class="escala-geo"><div><strong>Localização</strong><small class="js-geo-status" data-context="fim" role="status" aria-live="polite">Permita a localização para finalizar.</small></div><button class="btn js-geo-retry" type="button" data-context="fim">Ativar localização</button></div>
<details class="escala-compact-details"><summary>Adicionar foto da conclusão</summary><input class="input" type="file" name="foto_fim" accept="image/*" capture="environment"></details>
<div class="escala-actionbar"><button class="btn btn-green" type="submit" data-geo-submit disabled>Finalizar hora extra</button></div>
</form>
<% }else{ %>
<form method="post" action="<%=inicioFixo17?'/escala/hora-extra/desde-17/iniciar':'/escala/hora-extra/iniciar'%>" enctype="multipart/form-data" id="horaExtraForm" data-geo-context="inicio" data-before-17="<%=inicioFixo17&&!liberado17?'1':'0'%>">
<input type="hidden" name="colaborador_id" value="<%=colaborador.id%>"><input type="hidden" name="latitude_inicio"><input type="hidden" name="longitude_inicio"><input type="hidden" name="precisao_inicio">
<div class="escala-form-grid" style="margin-top:16px">
<label class="escala-field full">Ordem de serviço<select class="input" name="os_id" id="horaExtraOs"><option value="">Sem OS</option><% listaOs.forEach(os=>{ %><option value="<%=os.id%>" <%=Number(osSelecionadaId)===Number(os.id)?'selected':''%>>OS #<%=os.id%> · <%=os.equipamento_nome||os.equipamento||'Equipamento'%> · <%=os.descricao%></option><% }) %></select></label>
<label class="escala-field full">Serviço realizado<textarea class="input" name="descricao_servico" id="horaExtraDescricao" rows="2" placeholder="Descreva o serviço"></textarea><small id="horaExtraDescricaoAjuda">Obrigatório quando não houver OS.</small></label>
<% if(acessoInicioFixo17&&!inicioFixo17){ %><label class="escala-field full">Início<select class="input" name="modo_inicio" id="horaExtraModoInicio"><option value="AGORA">Agora</option><option value="FIXO_17H" <%=liberado17?'':'disabled'%>>Desde as 17h de hoje</option></select></label><% } %>
</div>
<% if(inicioFixo17){ %><p><%=liberado17?'Início contado a partir das 17h de hoje.':'Disponível a partir das 17h.'%></p><% } %>
<div class="escala-geo"><div><strong>Localização</strong><small class="js-geo-status" data-context="inicio" role="status" aria-live="polite">Permita a localização para iniciar.</small></div><button class="btn js-geo-retry" type="button" data-context="inicio">Ativar localização</button></div>
<details class="escala-compact-details"><summary>Adicionar foto inicial</summary><input class="input" type="file" name="foto_inicio" accept="image/*" capture="environment"></details>
<div class="escala-actionbar"><button class="btn btn-green" id="horaExtraIniciarButton" type="submit" data-geo-submit disabled><%=inicioFixo17?'Iniciar desde as 17h':'Iniciar hora extra'%></button></div>
</form>
<% } %>
</section>
<details class="escala-section escala-hour-history"><summary>Histórico recente</summary><div class="escala-table-wrap"><table class="escala-table"><thead><tr><th>Data</th><th>Serviço</th><th>Início</th><th>Fim</th><th>Total</th><th>Situação</th></tr></thead><tbody><% if(!listaHistorico.length){ %><tr><td colspan="6">Sem registros.</td></tr><% } %><% listaHistorico.forEach(h=>{ %><tr><td><%=dateBr.formatDateBR(h.data_servico)%></td><td><%=h.os_id?'OS #'+h.os_id:h.descricao_servico%></td><td><%=dateBr.formatTimeBR(h.inicio_extra)%></td><td><%=h.fim_extra?dateBr.formatTimeBR(h.fim_extra):'—'%></td><td><%=fmtMin(h.total_minutos)%></td><td><%=String(h.status).replaceAll('_',' ')%></td></tr><% }) %></tbody></table></div></details>
<% } %>
</div></div>
<script src="/js/escala-localizacao.js?v=20261103-v1" defer></script>
