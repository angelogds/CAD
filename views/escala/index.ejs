<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260903b">
<%
  const colaboradores = painel.colaboradores || [];
  const fmtMin = (value) => { const n=Number(value||0); const sign=n<0?'-':''; const m=Math.abs(n); return `${sign}${Math.floor(m/60)}h${String(m%60).padStart(2,'0')}`; };
  const totalSaldo = colaboradores.reduce((sum,c)=>sum+Number(c.saldo?.minutos||0),0);
  const totalExtras = colaboradores.reduce((sum,c)=>sum+Number(c.horasExtrasMesMinutos||0),0);
  const indisponiveis = colaboradores.filter(c=>/(folga|férias|ferias|atestado|ausente|falta)/i.test(c.statusAtual||'')).length;
  const working = colaboradores.filter(c=>/trabalhando|hora extra/i.test(c.statusAtual||'')).length;
  const statusClass = (status) => { const s=String(status||'').toLowerCase(); if(s.includes('folga'))return'is-folga'; if(s.includes('férias')||s.includes('ferias'))return'is-ferias'; if(s.includes('atestado'))return'is-atestado'; if(s.includes('ausente')||s.includes('falta'))return'is-ausente'; return''; };
%>
<div class="escala-page">
  <header class="escala-head"><div><h1>Escala</h1><p>Central de gestão operacional da equipe de manutenção.</p></div><div class="escala-actions"><a class="btn" href="/escala/semana">Calendário</a><a class="btn" href="/escala/relatorios">Relatórios</a><% if(canManageEscala){ %><a class="btn btn-green" href="/escala/completa">+ Nova escala</a><% } %></div></header>
  <div class="escala-notice">Controle interno da manutenção para organizar escala, Banco de Horas, folgas e horas extras vinculadas à OS. Este módulo não substitui o registro oficial de jornada nem os controles do RH.</div>

  <section class="escala-kpis" aria-label="Indicadores da escala">
    <div class="escala-kpi"><span>Funcionários ativos</span><strong><%= colaboradores.length %></strong><small>Integrantes considerados no painel</small></div>
    <div class="escala-kpi"><span>Escala da semana</span><strong><%= colaboradores.length %></strong><small>Colaboradores escalados</small></div>
    <div class="escala-kpi"><span>Folgas / afastamentos</span><strong><%= indisponiveis %></strong><small>Indisponibilidades identificadas</small></div>
    <div class="escala-kpi"><span>Horas extras (mês)</span><strong><%= fmtMin(totalExtras) %></strong><small><%= painel.pendentes || 0 %> pendente(s) de aprovação</small></div>
    <div class="escala-kpi"><span>Banco de horas (total)</span><strong><%= fmtMin(totalSaldo) %></strong><small>Indicador gerencial; saldos são individuais</small></div>
  </section>

  <section class="escala-section"><div class="escala-section-head"><div><h2>Acesso rápido</h2><div class="muted">Fluxos principais da gestão da equipe.</div></div></div><div class="escala-quick-grid">
    <% [{t:'Escala da Semana',d:'Equipe, turnos e programação atual.',u:'/escala/semana'},{t:'Escala Completa',d:'Consulta e gestão por período.',u:'/escala/completa'},{t:'Folgas / Atestados / Férias',d:'Indisponibilidades da equipe.',u:'/escala/ausencias'},{t:'Registrar Hora Extra',d:'Registro individual ou em equipe vinculado à OS.',u:'/escala/hora-extra/nova'},{t:'Horas Extras Pendentes',d:'Fila de aprovação e rastreabilidade.',u:'/escala/hora-extra/pendentes'},{t:'Banco de Horas',d:'Créditos, débitos e saldos individuais.',u:'/escala/banco-horas'},{t:'Programar Folga',d:'Folga compensatória e demais ocorrências.',u:'/escala/folgas'},{t:'Relatórios PDF',d:'Relatórios operacionais da escala.',u:'/escala/relatorios'}].forEach(c=>{ %><a class="escala-quick-card" href="<%= c.u %>"><strong><%= c.t %></strong><small><%= c.d %></small></a><% }) %>
  </div></section>

  <nav class="escala-tabs" aria-label="Navegação da Escala"><a class="escala-tab is-active" href="/escala">Painel da Equipe</a><a class="escala-tab" href="/escala/completa">Escalas</a><a class="escala-tab" href="/escala/banco-horas">Banco de Horas</a><a class="escala-tab" href="/escala/hora-extra/pendentes">Horas Extras</a><a class="escala-tab" href="/escala/ausencias">Ausências</a><a class="escala-tab" href="/escala/relatorios">Histórico / Relatórios</a></nav>

  <section class="escala-section">
    <div class="escala-section-head"><div><h2>Painel da Equipe</h2><div class="muted"><%= canViewAllEscala ? 'Visão consolidada da manutenção.' : 'Você está visualizando apenas suas próprias informações.' %></div></div><div class="escala-tabs"><button class="escala-tab is-active" type="button" data-view-mode="cards">Cards</button><button class="escala-tab" type="button" data-view-mode="table">Tabela</button></div></div>
    <div class="escala-filterbar"><input id="escala-search" placeholder="Buscar por nome ou função"><select id="escala-turno"><option value="">Todos os turnos</option><option value="Dia">Dia</option><option value="Noite">Noite</option><option value="Folga">Folga</option></select><select id="escala-status"><option value="">Todas as situações</option><option value="Trabalhando">Trabalhando</option><option value="Folga">Folga</option><option value="Férias">Férias</option><option value="Atestado">Atestado</option></select><span></span><button class="btn" type="button" data-escala-clear>Limpar filtros</button></div>

    <div id="escala-card-view" class="escala-team-grid"><% colaboradores.forEach(c=>{ const search=`${c.nome} ${c.funcaoLabel||''}`; %><article class="escala-person" data-escala-person data-search="<%= search %>" data-turno="<%= c.turnoAtual %>" data-status="<%= c.statusAtual %>"><div class="escala-person-head"><% if(c.foto_path){ %><img class="escala-avatar" src="<%= c.foto_path %>" alt="Foto de <%= c.nome %>"><% } else { %><div class="escala-avatar"><%= c.iniciais || String(c.nome||'M').charAt(0).toUpperCase() %></div><% } %><div class="escala-person-name"><strong><%= c.nome %></strong><small><%= c.funcaoLabel || 'Mecânico Industrial' %></small></div><span class="escala-status <%= statusClass(c.statusAtual) %>"><%= c.statusAtual %></span></div><div class="escala-person-meta"><div class="escala-meta"><span>Turno</span><strong><%= c.turnoAtual %></strong></div><div class="escala-meta"><span>Saldo</span><strong class="<%= Number(c.saldo?.minutos||0)>0?'saldo-positive':Number(c.saldo?.minutos||0)<0?'saldo-negative':'saldo-zero' %>"><%= c.saldo?.horas || '0h00' %></strong></div><div class="escala-meta"><span>Extras aprovadas</span><strong><%= c.horasExtrasMes %></strong></div><div class="escala-meta"><span>Última hora extra</span><strong><%= c.ultimaHoraExtra || 'Sem registro' %></strong></div></div><% if(canReadEscalaDetails){ %><div class="escala-person-foot"><a class="btn btn-sm" href="/escala/banco-horas/<%= c.id %>">Ver detalhes →</a></div><% } %></article><% }) %><div id="escala-filter-empty" class="escala-audit-note" hidden>Nenhum colaborador encontrado para os filtros informados.</div></div>

    <div id="escala-table-view" class="escala-bank-table-wrap" hidden><table class="escala-bank-table"><thead><tr><th>Colaborador</th><th>Função</th><th>Situação</th><th>Turno</th><th>Saldo</th><th>Extras no mês</th><th>Última hora extra</th><th>Ação</th></tr></thead><tbody><% colaboradores.forEach(c=>{ const search=`${c.nome} ${c.funcaoLabel||''}`; %><tr data-escala-row data-search="<%= search %>" data-turno="<%= c.turnoAtual %>" data-status="<%= c.statusAtual %>"><td><strong><%= c.nome %></strong></td><td><%= c.funcaoLabel || 'Mecânico Industrial' %></td><td><%= c.statusAtual %></td><td><%= c.turnoAtual %></td><td><%= c.saldo?.horas || '0h00' %></td><td><%= c.horasExtrasMes %></td><td><%= c.ultimaHoraExtra || '-' %></td><td><% if(canReadEscalaDetails){ %><a class="btn btn-sm" href="/escala/banco-horas/<%= c.id %>">Abrir</a><% } %></td></tr><% }) %></tbody></table></div>
  </section>

  <section class="escala-summary-grid"><article class="escala-section"><div class="escala-section-head"><h3>Resumo da escala</h3></div><div class="escala-summary-bars"><% [{label:'Trabalhando',value:working},{label:'Folgas / afastamentos',value:indisponiveis},{label:'Hora extra pendente',value:Number(painel.pendentes||0)}].forEach(item=>{ const pct=Math.round((item.value/Math.max(1,colaboradores.length))*100); %><div class="escala-summary-row"><span><%= item.label %></span><div class="escala-summary-track"><div class="escala-summary-fill" style="width:<%= Math.min(100,pct) %>%"></div></div><strong><%= item.value %></strong></div><% }) %></div></article><article class="escala-section"><div class="escala-section-head"><h3>Como funciona</h3></div><p class="muted">A escala organiza turnos e funções da equipe. Horas extras realizadas e aprovadas entram no Banco de Horas conforme o fluxo interno. Folgas compensatórias são registradas com rastreabilidade.</p><p class="escala-audit-note">O módulo é controle operacional interno e não substitui o registro oficial de jornada/RH.</p></article></section>
</div>
<% if(canManageEscala){ %><a class="btn btn-green fab-extra" href="/escala/hora-extra/nova">+ Hora Extra</a><% } %>
<script src="/js/escala-dashboard.js?v=20260819a"></script>
