<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260903b">
<div class="escala-page">
  <header class="escala-head">
    <div><h1>Lançar Escala</h1><p>Registro manual de colaborador no turno dia ou noite, mantendo a lógica existente do módulo.</p></div>
    <div class="escala-actions"><a class="btn" href="/escala">← Voltar</a></div>
  </header>

  <nav class="escala-tabs"><a class="escala-tab" href="/escala">Painel da Equipe</a><a class="escala-tab" href="/escala/semana">Escala da Semana</a><a class="escala-tab" href="/escala/completa">Escala Completa</a><a class="escala-tab is-active" href="/escala/nova">Novo lançamento</a></nav>

  <div class="escala-notice is-info">Use o lançamento manual somente para inclusão pontual. Para organização recorrente de plantões e turnos, utilize a configuração de rodízio.</div>

  <section class="escala-section">
    <div class="escala-section-head"><div><h2>Dados da alocação</h2><p>Informe data, turno e colaborador.</p></div></div>
    <form action="/escala" method="POST" class="escala-form-grid">
      <label class="escala-field"><span class="label">Data</span><input class="input" name="data" type="date" value="<%= today %>" required></label>
      <label class="escala-field"><span class="label">Turno</span><select class="input" name="turno"><option value="dia">Dia</option><option value="noite">Noite</option></select></label>
      <label class="escala-field"><span class="label">Categoria</span><select class="input" name="categoria"><option value="mecanico">Mecânico Industrial</option></select></label>
      <label class="escala-field"><span class="label">Nome</span><input class="input" name="nome" placeholder="Nome do colaborador" required></label>
      <label class="escala-field full"><span class="label">Observação</span><textarea class="input" name="observacao" rows="4" placeholder="Ex.: plantão, substituição, apoio temporário..."></textarea></label>
      <div class="escala-field full"><div class="escala-actionbar"><span class="muted">A inclusão seguirá as mesmas regras e rotas já utilizadas pela Escala.</span><div class="escala-actions"><a class="btn" href="/escala">Cancelar</a><button class="btn btn-green" type="submit">Salvar lançamento</button></div></div></div>
    </form>
  </section>
</div>
