<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260903b">
<%
  const fmtMin = (value) => { const n=Number(value||0); const sign=n<0?'-':''; const m=Math.abs(n); return `${sign}${Math.floor(m/60)}h${String(m%60).padStart(2,'0')}`; };
  const saldoClass = (value) => Number(value||0)>0?'saldo-positive':Number(value||0)<0?'saldo-negative':'saldo-zero';
  const movimentoLabel = (tipo) => String(tipo||'').replaceAll('_',' ');
%>
<div class="escala-page">
  <header class="escala-head"><div><h1>Banco de Horas da Manutenção</h1><p>Créditos, débitos e saldo operacional por colaborador.</p></div><div class="escala-actions"><a class="btn" href="/escala">← Voltar à Escala</a><a class="btn" href="/escala/relatorios">Relatórios</a></div></header>
  <div class="escala-notice">O saldo principal é apresentado em horas e minutos. A equivalência em dias é apenas uma referência operacional conforme a jornada configurada atualmente no módulo.</div>
  <nav class="escala-tabs"><a class="escala-tab" href="/escala">Painel da Equipe</a><a class="escala-tab" href="/escala/completa">Escalas</a><a class="escala-tab is-active" href="/escala/banco-horas">Banco de Horas</a><a class="escala-tab" href="/escala/hora-extra/pendentes">Horas Extras</a><a class="escala-tab" href="/escala/ausencias">Ausências</a></nav>

  <section class="escala-section">
    <div class="escala-section-head"><div><h2>Saldos por colaborador</h2><div class="muted"><%= banco.length %> colaborador(es) listado(s)</div></div></div>
    <div class="escala-bank-table-wrap"><table class="escala-bank-table"><thead><tr><th>Colaborador</th><th>Créditos de extra no mês</th><th>Débitos por folga</th><th>Saldo</th><th>Equivalência</th><th>Última hora extra</th><th>Ações</th></tr></thead><tbody>
      <% if(!banco.length){ %><tr><td colspan="7"><div class="escala-audit-note">Nenhum colaborador disponível para o Banco de Horas.</div></td></tr><% } %>
      <% banco.forEach(b=>{ %><tr><td><strong><%= b.nome %></strong><br><small class="muted"><%= b.funcaoLabel || 'Mecânico Industrial' %></small></td><td class="saldo-positive">+<%= fmtMin(b.horasExtrasMesMinutos) %></td><td class="saldo-negative"><%= Number(b.folgasCompensadasMinutos||0) ? '-' + fmtMin(Math.abs(Number(b.folgasCompensadasMinutos||0))) : '0h00' %></td><td class="<%= saldoClass(b.saldo?.minutos) %>"><%= b.saldo?.horas || '0h00' %></td><td><%= b.saldo?.diasFolgaDecimal ?? 0 %> dia(s)</td><td><%= b.ultimaHoraExtra || 'Sem registro' %></td><td><a class="btn btn-sm btn-green" href="/escala/banco-horas/<%= b.id %>">Extrato</a> <a class="btn btn-sm" href="/escala/relatorios/funcionario/<%= b.id %>/pdf">PDF</a></td></tr><% }) %>
    </tbody></table></div>
  </section>

  <% if(selecionado){ %><section class="escala-section"><div class="escala-section-head"><div><h2>Extrato — <%= selecionado.nome %></h2><div class="muted">Histórico de movimentos preservado para rastreabilidade.</div></div><a class="btn btn-sm" href="/escala/relatorios/funcionario/<%= selecionado.id %>/pdf">Gerar PDF</a></div><div class="escala-bank-table-wrap"><table class="escala-bank-table"><thead><tr><th>Data</th><th>Tipo</th><th>Origem / descrição</th><th>Crédito</th><th>Débito</th></tr></thead><tbody>
    <% if(!(movimentos||[]).length){ %><tr><td colspan="5">Nenhuma movimentação registrada.</td></tr><% } %>
    <% (movimentos||[]).forEach(m=>{ const min=Number(m.minutos||0); const credito=String(m.tipo||'').includes('CREDITO'); const debito=String(m.tipo||'').includes('DEBITO') || min<0; %><tr><td><%= m.data_movimento || '-' %></td><td><span class="escala-status"><%= movimentoLabel(m.tipo) %></span></td><td><%= m.descricao || '-' %></td><td class="saldo-positive"><%= credito ? '+'+fmtMin(Math.abs(min)) : '-' %></td><td class="saldo-negative"><%= debito ? '-'+fmtMin(Math.abs(min)) : '-' %></td></tr><% }) %>
  </tbody></table></div></section><% } %>
</div>
