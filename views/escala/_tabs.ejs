<% const active=typeof escalaTab==='undefined'?'painel':escalaTab; const gestor=typeof canManageEscala!=='undefined'&&canManageEscala; const roles=typeof user==='undefined'?'':String(user?.role||''); const heGestor=gestor||['ADMIN','ENCARREGADO_MANUTENCAO','MANUTENCAO_SUPERVISOR','SUPERVISOR_MANUTENCAO'].includes(roles); %>
<nav class="escala-tabs escala-main-tabs" aria-label="Navegação da Escala"><% [['painel','Painel da equipe','/escala'],['escalas','Escalas','/escala/completa'],['banco','Banco de horas','/escala/banco-horas'],['extras','Horas extras',heGestor?'/escala/hora-extra/pendentes':'/escala/hora-extra/nova'],['ausencias','Ausências','/escala/ausencias'],['relatorios','Histórico / Relatórios','/escala/relatorios']].forEach(([id,label,url])=>{ %><a class="escala-tab <%=active===id?'is-active':''%>" href="<%=url%>" <%-active===id?'aria-current="page"':''%>><%=label%></a><% }) %></nav>
