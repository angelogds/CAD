<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260903b">
<% const listaFolgas = Array.isArray(folgas) ? folgas : []; %>
<div class="escala-page">
  <header class="escala-head">
    <div><h1>Programar Folga / Afastamento</h1><p>Programação de folgas compensatórias, férias, atestados e demais ocorrências da equipe.</p></div>
    <div class="escala-actions"><a class="btn" href="/escala">← Voltar</a></div>
  </header>

  <nav class="escala-tabs">
    <a class="escala-tab" href="/escala">Painel da Equipe</a>
    <a class="escala-tab" href="/escala/semana">Escala da Semana</a>
    <a class="escala-tab" href="/escala/completa">Escala Completa</a>
    <a class="escala-tab is-active" href="/escala/folgas">Programar Folga</a>
    <a class="escala-tab" href="/escala/ausencias">Folgas / Afastamentos</a>
    <a class="escala-tab" href="/escala/banco-horas">Banco de Horas</a>
  </nav>

  <div class="escala-notice">Folga compensatória desconta exatamente o saldo informado. Atestado, férias e demais afastamentos permanecem separados do Banco de Horas, conforme a regra atual do módulo.</div>

  <section class="escala-section">
    <div class="escala-section-head"><div><h2>Novo registro</h2><p>Preencha os dados do colaborador e do período.</p></div></div>
    <form method="post" action="/escala/folgas/programar" enctype="multipart/form-data" id="folga-form" class="escala-form-grid is-3">
      <label class="escala-field"><span class="label">Funcionário</span><select class="input" name="colaborador_id" id="colaborador" required><option value="">Selecione</option><% colaboradores.forEach(c=>{ %><option value="<%= c.id %>" data-saldo="<%= c.saldo.minutos %>"><%= c.nome %> — saldo <%= c.saldo.horas %></option><% }) %></select></label>
      <label class="escala-field"><span class="label">Tipo</span><select class="input" name="tipo_lancamento" id="tipo" required><option value="FOLGA_COMPENSATORIA">Folga compensatória (desconta)</option><option value="FOLGA_MANUAL">Folga manual — não desconta</option><option value="ATESTADO">Atestado — não desconta</option><option value="FERIAS">Férias — não desconta</option><option value="FALTA_JUSTIFICADA">Falta justificada — não desconta</option><option value="FALTA_NAO_JUSTIFICADA">Falta não justificada — não desconta</option><option value="OUTRO">Outro afastamento — não desconta</option></select></label>
      <label class="escala-field"><span class="label">Motivo</span><input class="input" name="motivo" required placeholder="Motivo / referência do afastamento"></label>
      <label class="escala-field"><span class="label">Data inicial</span><input class="input" type="date" name="data_folga" required></label>
      <label class="escala-field"><span class="label">Data final</span><input class="input" type="date" name="data_fim" required></label>
      <label class="escala-field" id="horas-wrap"><span class="label">Horas a descontar</span><input class="input" type="number" min="0.01" step="0.01" name="horas" id="horas"></label>
      <label class="escala-field"><span class="label">Data do serviço</span><input class="input" type="date" name="data_servico"></label>
      <label class="escala-field"><span class="label">Início do serviço</span><input class="input" type="time" name="hora_inicio"></label>
      <label class="escala-field"><span class="label">Fim do serviço</span><input class="input" type="time" name="hora_fim"></label>
      <label class="escala-field"><span class="label">Equipamento / setor</span><input class="input" name="equipamento" placeholder="Ex.: Caldeira 1 / Reciclagem"></label>
      <label class="escala-field"><span class="label">Descrição do serviço</span><input class="input" name="descricao_servico" placeholder="Serviço que originou a compensação"></label>
      <label class="escala-field"><span class="label">Anexo</span><input class="input" type="file" name="anexo" accept="image/*,.pdf,application/pdf"><small>Imagem ou PDF.</small></label>
      <label class="escala-field full"><span class="label">Justificativa ADMIN para saldo negativo</span><input class="input" name="justificativa_saldo_negativo" placeholder="Preencher somente quando necessário"></label>
      <div class="escala-field full"><div class="escala-notice is-info"><strong id="saldo-info">Selecione o funcionário.</strong><br><span id="debito-info">Este tipo desconta o Banco de Horas.</span></div></div>
      <div class="escala-field full"><div class="escala-actionbar"><span class="muted">Revise colaborador, período e impacto no saldo antes de confirmar.</span><button class="btn btn-green" type="submit">Programar ocorrência</button></div></div>
    </form>
  </section>

  <section class="escala-section">
    <div class="escala-section-head"><div><h2>Registros programados</h2><p><%= listaFolgas.length %> registro(s) encontrado(s).</p></div></div>
    <div class="escala-table-wrap"><table class="escala-table"><thead><tr><th>Funcionário</th><th>Tipo</th><th>Período</th><th>Saldo antes</th><th>Desconto</th><th>Saldo depois</th><th>Status</th><th>Ações</th></tr></thead><tbody>
      <% if(!listaFolgas.length){ %><tr><td colspan="8"><div class="escala-empty">Nenhuma folga ou afastamento programado.</div></td></tr><% } %>
      <% listaFolgas.forEach(f=>{ %><tr><td><strong><%= f.colaborador_nome %></strong></td><td><%= String(f.tipo_lancamento||'').replaceAll('_',' ') %></td><td><%= f.data_folga %> a <%= f.data_fim || f.data_folga %></td><td><%= f.saldo_antes_minutos == null ? '-' : f.saldo_antes_minutos+' min' %></td><td><%= f.debita_banco ? f.minutos_descontados+' min' : 'Não desconta' %></td><td><%= f.saldo_depois_minutos == null ? '-' : f.saldo_depois_minutos+' min' %></td><td><span class="escala-status <%= f.status==='CANCELADA'?'is-ausente':(f.status==='REALIZADA'?'':'is-atestado') %>"><%= f.status %></span></td><td><% if(f.status==='PROGRAMADA'){ %><div style="display:flex;gap:5px;flex-wrap:wrap"><form method="post" action="/escala/folgas/<%= f.id %>/realizar"><button class="btn btn-sm btn-green" type="submit">Marcar realizada</button></form><form method="post" action="/escala/folgas/<%= f.id %>/cancelar"><input type="hidden" name="motivo" value="Cancelado pelo responsável"><button class="btn btn-sm" type="submit">Cancelar</button></form></div><% } %></td></tr><% }) %>
    </tbody></table></div>
  </section>
</div>
<script>
const tipo=document.getElementById('tipo'),col=document.getElementById('colaborador'),horas=document.getElementById('horas');
function update(){const debita=tipo.value==='FOLGA_COMPENSATORIA';document.getElementById('horas-wrap').style.display=debita?'grid':'none';horas.required=debita;document.getElementById('debito-info').textContent=debita?'A folga compensatória desconta exatamente as horas informadas.':'Este tipo não desconta do Banco de Horas.';const o=col.selectedOptions[0],saldo=Number(o?.dataset.saldo||0),min=debita?Math.round(Number(horas.value||0)*60):0;document.getElementById('saldo-info').textContent=o?.value?`Saldo atual: ${saldo} min • saldo previsto: ${saldo-min} min`:'Selecione o funcionário.'}
tipo.addEventListener('change',update);col.addEventListener('change',update);horas.addEventListener('input',update);update();
</script>