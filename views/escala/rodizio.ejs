<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260903b">
<% const modoAtual = config?.modo_noturno === 'dupla' ? 'dupla' : 'individual'; const tamanhoCiclo = Math.max(Number(config?.tamanho_ciclo||3),3); %>
<div class="escala-page">
  <header class="escala-head">
    <div><h1>Editor de Rodízio da Escala</h1><p>Configure o ciclo base do plantão noturno, os mecânicos fixos do dia e o período de aplicação.</p></div>
    <div class="escala-actions"><a class="btn" href="/escala/completa">← Voltar</a></div>
  </header>

  <nav class="escala-tabs"><a class="escala-tab" href="/escala">Painel da Equipe</a><a class="escala-tab" href="/escala/semana">Escala da Semana</a><a class="escala-tab" href="/escala/completa">Escala Completa</a><a class="escala-tab is-active" href="/escala/rodizio">Rodízio</a><a class="escala-tab" href="/escala/folgas-sabado">Folgas / Sábado</a></nav>

  <div class="escala-notice is-warning">Alterações no rodízio podem afetar semanas futuras. Semanas com ajuste manual continuam preservadas, exceto quando a opção de sobrescrever tudo for escolhida de forma explícita.</div>

  <form method="POST" action="/escala/rodizio/preview" class="escala-page">
    <section class="escala-section">
      <div class="escala-section-head"><div><h2>Configuração do ciclo</h2><p>Defina o período e o comportamento do plantão noturno.</p></div></div>
      <div class="escala-form-grid is-3">
        <label class="escala-field"><span class="label">Nome</span><input class="input" name="nome" value="<%= config?.nome || 'Rodízio da Escala' %>"></label>
        <label class="escala-field"><span class="label">Semanas no ciclo</span><input class="input" type="number" min="1" name="tamanho_ciclo" value="<%= config?.tamanho_ciclo || 3 %>"></label>
        <label class="escala-field"><span class="label">Modo do plantão noturno</span><select class="input" name="modoNoturno" id="modoNoturno"><option value="individual" <%= modoAtual==='individual'?'selected':'' %>>Individual — 1 por semana</option><option value="dupla" <%= modoAtual==='dupla'?'selected':'' %>>Equipe dupla — 2 por semana</option></select></label>
        <label class="escala-field"><span class="label">Data inicial de aplicação</span><input class="input" type="date" name="data_inicio" value="<%= config?.data_inicio || '' %>" required></label>
        <label class="escala-field"><span class="label">Data final de aplicação</span><input class="input" type="date" name="data_fim" value="<%= config?.data_fim || '' %>"></label>
      </div>
    </section>

    <section class="escala-section">
      <div class="escala-section-head"><div><h2>Ciclo do turno noturno</h2><p>Cada posição representa uma semana do ciclo. No modo dupla, defina dois plantonistas.</p></div></div>
      <div class="escala-team-grid">
        <% for (let i=0;i<tamanhoCiclo;i++) { const semanaAtual=(config?.semanas||[])[i] || []; const atual1=semanaAtual[0] || (config?.noturnos||[]).find(n=>Number(n.posicao)===i+1 && Number(n.ordem_noturno||1)===1); const atual2=semanaAtual[1] || (config?.noturnos||[]).find(n=>Number(n.posicao)===i+1 && Number(n.ordem_noturno||1)===2); %>
          <article class="escala-person">
            <div class="escala-person-head"><div class="escala-avatar"><%= i+1 %></div><div class="escala-person-name"><strong>Semana <%= i+1 %></strong><small>Posição no ciclo do plantão</small></div><span class="escala-status"><%= modoAtual==='dupla'?'Dupla':'Individual' %></span></div>
            <label class="escala-field" style="margin-top:10px"><span class="label">Plantonista <span class="label-individual">da noite</span><span class="label-dupla">Noite 1</span></span><select class="input" name="noturnos"><option value="">Selecione</option><% colaboradores.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(atual1?.colaborador_id)===Number(c.id)?'selected':'' %>><%= c.nome %></option><% }) %></select></label>
            <label class="escala-field campo-dupla" style="margin-top:8px"><span class="label">Plantonista Noite 2</span><select class="input" name="noturnos"><option value="">Selecione</option><% colaboradores.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(atual2?.colaborador_id)===Number(c.id)?'selected':'' %>><%= c.nome %></option><% }) %></select></label>
          </article>
        <% } %>
      </div>
    </section>

    <section class="escala-section">
      <div class="escala-section-head"><div><h2>Mecânicos fixos do turno diurno</h2><p>Selecione os colaboradores que permanecem no dia em todas as semanas do ciclo.</p></div></div>
      <div class="escala-team-grid"><% colaboradores.forEach(c=>{ const checked=(config?.diurnosFixos||[]).some(f=>Number(f.colaborador_id)===Number(c.id)); %><label class="escala-choice" style="display:flex;align-items:center;gap:9px"><input type="checkbox" name="diurnos_fixos" value="<%= c.id %>" <%= checked?'checked':'' %>><span><strong><%= c.nome %></strong><small><%= c.funcaoLabel || c.funcao || 'Mecânico Industrial' %></small></span></label><% }) %></div>
    </section>

    <section class="escala-section"><div class="escala-actionbar"><label style="display:flex;align-items:center;gap:8px"><input type="checkbox" name="sobrescreverTudo" value="1"> Sobrescrever também semanas com ajuste manual ao aplicar</label><div class="escala-actions"><button class="btn" type="submit">Pré-visualizar escala</button><button class="btn" type="submit" formaction="/escala/rodizio/salvar">Salvar configuração</button><button class="btn btn-green" type="submit" formaction="/escala/rodizio/salvar-aplicar">Salvar e aplicar na escala</button></div></div></section>
  </form>
</div>
<script>
(function(){
  const select=document.getElementById('modoNoturno');
  function sync(){const dupla=select&&select.value==='dupla';document.querySelectorAll('.campo-dupla,.label-dupla').forEach(el=>{el.style.display=dupla?'':'none';});document.querySelectorAll('.campo-dupla select').forEach(el=>{el.disabled=!dupla;});document.querySelectorAll('.label-individual').forEach(el=>{el.style.display=dupla?'none':'';});}
  if(select)select.addEventListener('change',sync);sync();
})();
</script>
