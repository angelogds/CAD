<%- layout('layout') -%>
<link rel="stylesheet" href="/css/escala-dashboard.css?v=20260903b">
<%
  const linhas = semana?.linhas || [];
  const totalDia = linhas.filter(l => String(l.turnoLabel || '').toUpperCase().includes('DIA')).length;
  const totalNoite = linhas.filter(l => String(l.turnoLabel || '').toUpperCase().includes('NOIT')).length;
  const totalAusentes = linhas.filter(l => /FOLGA|ATEST|FERI/.test(String(l.statusLabel || '').toUpperCase())).length;
%>
<div class="escala-page">
  <header class="escala-head">
    <div>
      <h1>Escala da Semana</h1>
      <p>Visualização operacional da equipe com período, turno, situação e ajustes da semana.</p>
    </div>
    <div class="escala-actions"><a class="btn" href="/escala">← Voltar</a></div>
  </header>

  <% if (!canManageEscala) { %><div class="escala-notice is-info">Escala em modo somente leitura. Alterações continuam restritas à gestão da Manutenção.</div><% } %>

  <nav class="escala-tabs">
    <a class="escala-tab" href="/escala">Painel da Equipe</a>
    <a class="escala-tab is-active" href="/escala/semana">Escala da Semana</a>
    <a class="escala-tab" href="/escala/completa">Escala Completa</a>
    <a class="escala-tab" href="/escala/ausencias">Folgas / Afastamentos</a>
    <a class="escala-tab" href="/escala/banco-horas">Banco de Horas</a>
    <a class="escala-tab" href="/escala/relatorios">Relatórios</a>
  </nav>

  <section class="escala-kpis">
    <div class="escala-kpi"><span>Equipe na semana</span><strong><%= linhas.length %></strong><small>Colaboradores programados</small></div>
    <div class="escala-kpi"><span>Turno dia</span><strong><%= totalDia %></strong><small>Alocações diurnas</small></div>
    <div class="escala-kpi"><span>Turno noite</span><strong><%= totalNoite %></strong><small>Alocações noturnas</small></div>
    <div class="escala-kpi"><span>Folgas / afastamentos</span><strong><%= totalAusentes %></strong><small>Indisponibilidades identificadas</small></div>
    <div class="escala-kpi"><span>Semana</span><strong><%= semana?.semana_numero || '-' %></strong><small><%= semana ? `${semana.data_inicio} a ${semana.data_fim}` : 'Sem semana cadastrada' %></small></div>
  </section>

  <section class="escala-section">
    <div class="escala-section-head">
      <div><h2>Período consultado</h2><p>Selecione uma data para abrir automaticamente a semana correspondente.</p></div>
      <form method="GET" action="/escala/semana" class="escala-toolbar">
        <div class="escala-field"><span class="label">Data de referência</span><input type="date" name="date" value="<%= alvo %>" class="input"></div>
        <button class="btn btn-green" type="submit">Consultar</button>
        <a class="btn" href="/escala/semana?date=<%= (new Date()).toISOString().slice(0,10) %>">Hoje</a>
      </form>
    </div>
    <% if (!semana) { %><div class="escala-empty">Não existe semana cadastrada para a data selecionada.</div><% } %>
  </section>

  <section class="escala-section">
    <div class="escala-section-head"><div><h2>Equipe programada</h2><p><%= semana ? `Período ${semana.data_inicio} até ${semana.data_fim}` : 'Aguardando período válido' %></p></div></div>
    <div class="escala-team-grid">
      <% if (!linhas.length) { %><div class="escala-empty">Nenhum colaborador cadastrado nesta semana.</div><% } %>
      <% linhas.forEach(l => { const turno = String(l.turnoLabel || '').toUpperCase(); const status = String(l.statusLabel || 'Trabalhando'); const statusUp = status.toUpperCase(); const statusClass = statusUp.includes('FOLGA') ? 'is-folga' : (statusUp.includes('ATEST') ? 'is-atestado' : (statusUp.includes('FERI') ? 'is-ferias' : '')); %>
        <article class="escala-person">
          <div class="escala-person-head">
            <div class="escala-avatar"><%= String(l.nome || 'M').charAt(0).toUpperCase() %></div>
            <div class="escala-person-name"><strong><%= l.nome %></strong><small><%= l.funcaoLabel || 'Mecânico Industrial' %></small></div>
            <span class="escala-status"><%= turno || 'TURNO' %></span>
          </div>
          <div class="escala-person-meta">
            <div class="escala-meta"><span>Situação</span><strong><span class="escala-status <%= statusClass %>"><%= status %></span></strong></div>
            <div class="escala-meta"><span>Período</span><strong><%= semana?.data_inicio || '-' %> → <%= semana?.data_fim || '-' %></strong></div>
          </div>
          <% if (l.observacao) { %><div class="muted" style="margin-top:10px"><strong>Observação:</strong> <%= l.observacao %></div><% } %>
          <% if (canManageEscala && semana) { %><div class="escala-person-foot" style="gap:6px"><a class="btn btn-sm btn-green" href="/escala/editar/<%= semana.id %>">Editar</a><form method="POST" action="/escala/alocacao/<%= l.alocacao_id %>/delete" onsubmit="return confirm('Deseja excluir este registro?');"><input type="hidden" name="date" value="<%= alvo %>"><button class="btn btn-sm" type="submit">Excluir</button></form></div><% } %>
        </article>
      <% }) %>
    </div>
  </section>

  <% if (canManageEscala) { %>
  <section class="escala-section">
    <div class="escala-section-head"><div><h2>Adicionar à escala</h2><p>Inclua um colaborador sem alterar a lógica do rodízio existente.</p></div></div>
    <form method="POST" action="/escala/adicionar" class="escala-form-grid is-3">
      <input type="hidden" name="date" value="<%= alvo %>">
      <label class="escala-field"><span class="label">Data início</span><input class="input" type="date" name="inicio" value="<%= alvo %>" required></label>
      <label class="escala-field"><span class="label">Data fim</span><input class="input" type="date" name="fim" value="<%= alvo %>" required></label>
      <label class="escala-field"><span class="label">Colaborador</span><input class="input" name="nome" placeholder="Nome do colaborador" required></label>
      <label class="escala-field"><span class="label">Turno</span><select class="input" name="turno" required><option value="">Selecione</option><option value="Dia">Dia</option><option value="Noite">Noite</option></select></label>
      <label class="escala-field"><span class="label">Função</span><select class="input" name="funcao" required><option value="Mecânico">Mecânico Industrial</option></select></label>
      <div class="escala-field" style="align-self:end"><button class="btn btn-green" type="submit">Salvar na escala</button></div>
    </form>
  </section>
  <% } %>
</div>