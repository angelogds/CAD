<% layout('layout') %>
<div class="almox-central">
<header class="ac-header">
<div>
<span class="ac-eyebrow">CAMPO DO GADO · ALMOXARIFADO</span>
<h1>Central do almoxarifado</h1>
<p>Receba compras, prepare entregas e acompanhe o estoque por setor.</p>
</div>
<% if(canWithdraw){ %>
<a class="ac-button ac-primary" href="/almoxarifado/retiradas/qr">Registrar retirada <span aria-hidden="true">→</span>
</a>
<% } %>
</header>
<%- include('_tabs',{tab:'painel'}) %>
<section class="ac-metrics" aria-label="Resumo operacional">
<a class="ac-card ac-metric" href="/almoxarifado/recebimentos">
<span>Solicitações abertas</span>
<strong>
<%=resumo.abertas%>
</strong>
<small>
<%=resumo.aguardandoCompras%> aguardando Compras</small>
</a>
<a class="ac-card ac-metric" href="/almoxarifado/recebimentos?situacao=PENDENTES">
<span>Com materiais a receber</span>
<strong>
<%=resumo.aReceber%>
</strong>
<small>
<%=resumo.parciais%> com recebimento parcial</small>
</a>
<a class="ac-card ac-metric" href="/almoxarifado/retiradas/qr">
<span>Solicitações para entregar</span>
<strong>
<%=totalSeparados%>
</strong>
<small>Materiais recebidos e separados</small>
</a>
</section>
<div class="ac-dashboard-grid">
<section class="ac-card">
<header class="ac-section-head">
<div>
<h2>Solicitações em andamento</h2>
<p>Itens comprados aparecem prontos para conferência.</p>
</div>
<a href="/almoxarifado/recebimentos">Ver todas →</a>
</header>
<% if(!lista.length){ %>
<p class="ac-empty">Nenhuma solicitação aberta neste momento.</p>
<% } %>
<% lista.forEach(s=>{ %>
<a class="ac-request-row" href="/almoxarifado/recebimentos?solicitacao_id=<%=s.id%>#conferencia">
<div>
<span class="ac-overline">
<%=s.numero||'#'+s.id%> · <%=s.setor_exibicao%>
</span>
<strong>
<%=s.titulo%>
</strong>
<small>
<%=s.equipamento_nome||'Materiais para prateleira'%>
</small>
</div>
<span class="ac-badge <%=s.itens_a_receber?'ac-ready':''%>">
<%=s.itens_a_receber?s.itens_a_receber+' item(ns) a receber':s.etapa_nome%>
</span>
<span aria-hidden="true">→</span>
</a>
<% }) %>
</section>
<section class="ac-card">
<header class="ac-section-head">
<div>
<h2>Próximas entregas</h2>
<p>Uma solicitação, uma confirmação.</p>
</div>
</header>
<% if(!separados.length){ %>
<p class="ac-empty">Nenhum material separado aguardando retirada.</p>
<% } %>
<% separados.forEach(g=>{ %>
<a class="ac-request-row" href="/almoxarifado/retiradas/qr?solicitacao_id=<%=g.solicitacao_id%>">
<div>
<span class="ac-overline">
<%=g.numero%>
</span>
<strong>
<%=g.equipamento_nome||g.titulo%>
</strong>
<small>
<%=g.itens.filter(i=>Number(i.quantidade_disponivel)>0).length%> material(is) disponível(is)</small>
</div>
<span aria-hidden="true">→</span>
</a>
<% }) %>
</section>
</div>
<section class="ac-card">
<header class="ac-section-head">
<div>
<h2>Estoque por setor</h2>
<p>Prateleira e materiais de uso contínuo. Compras dedicadas ficam nas solicitações.</p>
</div>
<a href="/almoxarifado/estoque">Abrir estoque →</a>
</header>
<div class="ac-sectors">
<% setores.forEach(s=>{ %>
<a href="/almoxarifado/estoque?setor_utilizacao=<%=encodeURIComponent(s.nome)%>">
<span>
<%=s.nome==='COMUM'?'Comum · compartilhado':s.nome%>
</span>
<strong>
<%=s.itens%>
</strong>
<small>materiais cadastrados</small>
</a>
<% }) %>
</div>
</section>
<% if(reposicao.length){ %>
<section class="ac-card">
<header class="ac-section-head">
<div>
<h2>Atenção à reposição</h2>
<p>Somente materiais de prateleira com política cadastrada.</p>
</div>
<a href="/almoxarifado/gerencial">Consultar relatório →</a>
</header>
<% reposicao.forEach(i=>{ %>
<a class="ac-request-row" href="/estoque/itens/<%=i.id%>">
<div>
<strong>
<%=i.nome%>
</strong>
<small>
<%=i.setor_utilizacao_exibicao%>
</small>
</div>
<span>
<%=i.disponivel%> <%=i.unidade%> livre(s)</span>
</a>
<% }) %>
</section>
<% } %>
</div>
