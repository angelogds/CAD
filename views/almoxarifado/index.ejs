<% layout('layout') %>
<link rel="stylesheet" href="/css/almoxarifado-modern.css?v=20260824-v1" />

<div class="almox-page">
  <header class="almox-hero">
    <div>
      <span class="almox-hero__eyebrow">ALMOXARIFADO • CONTROLE DE MATERIAIS</span>
      <h1>Central do Almoxarifado</h1>
      <p class="muted">Entrada de compras, retirada vinculada à manutenção e consulta do saldo em estoque em um único fluxo integrado.</p>
    </div>
  </header>

  <%- include('_tabs', { tab: typeof tab !== 'undefined' ? tab : '' }) %>

  <section class="almox-kpis">
    <a class="almox-kpi" href="/almoxarifado/recebimentos" style="text-decoration:none;">
      <span class="almox-kpi__label">Recebimentos</span>
      <strong class="almox-kpi__value" style="font-size:1.08rem;">Compras → Estoque</strong>
      <span class="almox-kpi__meta">Conferir materiais comprados e registrar a entrada.</span>
    </a>
    <a class="almox-kpi almox-kpi--blue" href="/estoque/saidas/nova?contexto=almoxarifado" style="text-decoration:none;">
      <span class="almox-kpi__label">Retiradas</span>
      <strong class="almox-kpi__value" style="font-size:1.08rem;">Estoque → OS</strong>
      <span class="almox-kpi__meta">Dar baixa no material com vínculo obrigatório à OS.</span>
    </a>
    <a class="almox-kpi almox-kpi--amber" href="/estoque" style="text-decoration:none;">
      <span class="almox-kpi__label">Estoque</span>
      <strong class="almox-kpi__value" style="font-size:1.08rem;">Consultar saldo</strong>
      <span class="almox-kpi__meta">Visualizar materiais cadastrados e disponibilidade.</span>
    </a>
    <a class="almox-kpi almox-kpi--slate" href="/estoque/movimentos" style="text-decoration:none;">
      <span class="almox-kpi__label">Rastreabilidade</span>
      <strong class="almox-kpi__value" style="font-size:1.08rem;">Movimentações</strong>
      <span class="almox-kpi__meta">Auditar entradas e saídas registradas no estoque.</span>
    </a>
  </section>

  <section class="almox-summary-card">
    <div class="almox-summary-card__title">Fluxo operacional preservado</div>
    <div class="almox-summary-list">
      <div class="almox-summary-box"><span>1. Compras</span><strong>Define item e quantidade comprada</strong></div>
      <div class="almox-summary-box"><span>2. Almoxarifado</span><strong>Confere a quantidade recebida</strong></div>
      <div class="almox-summary-box"><span>3. Estoque</span><strong>Recebe a entrada automaticamente</strong></div>
      <div class="almox-summary-box"><span>4. Manutenção</span><strong>Retira o material vinculado à OS</strong></div>
    </div>
  </section>
</div>
