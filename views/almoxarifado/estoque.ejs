<% layout('layout') %>
<link rel="stylesheet" href="/css/almoxarifado-modern.css?v=20261007-v3" />
<link rel="stylesheet" href="/css/almoxarifado-operacional-v3.css?v=20261007-v1" />
<%
  const queryForCategory=(id)=>{
    const p=new URLSearchParams();
    if(id)p.set('categoria_id',String(id));
    if(filtros.setor_utilizacao)p.set('setor_utilizacao',filtros.setor_utilizacao);
    if(filtros.equipamento_id)p.set('equipamento_id',filtros.equipamento_id);
    if(filtros.destino)p.set('destino',filtros.destino);
    return p.toString();
  };
%>
<div class="almox-page almox-op-page">
  <header class="almox-store-head">
    <div>
      <span class="almox-hero__eyebrow">ALMOXARIFADO • PRATELEIRAS E SALDOS</span>
      <h1 style="margin:0">Estoque organizado</h1>
      <p class="muted">Localize o material como em uma prateleira: por categoria, setor ou equipamento. O saldo reservado continua protegido.</p>
    </div>
    <div class="almox-hero__actions">
      <% if(canWithdraw){ %><a class="btn btn-green" href="/estoque/saidas/nova?contexto=almoxarifado">Retirada avulsa</a><% } %>
      <a class="btn btn-ghost" href="/estoque">Visão analítica</a>
    </div>
  </header>

  <%- include('_tabs', { tab: 'estoque' }) %>

  <section class="almox-store-category-strip" aria-label="Categorias do estoque">
    <a class="almox-store-category <%= !filtros.categoria_id?'is-active':'' %>" href="/almoxarifado/estoque?<%=queryForCategory('')%>">
      <span>Prateleira</span><strong>Todas as categorias</strong><b><%= itens.length %> visível(is)</b>
    </a>
    <% categoriasResumo.filter(c=>c.itens>0).forEach(categoria=>{ %>
      <a class="almox-store-category <%= String(filtros.categoria_id)===String(categoria.id)?'is-active':'' %>" href="/almoxarifado/estoque?<%=queryForCategory(categoria.id)%>">
        <span>Categoria</span><strong><%=categoria.nome%></strong><b><%=categoria.itens%> item(ns)</b>
      </a>
    <% }) %>
  </section>

  <form class="almox-store-filters" method="GET" action="/almoxarifado/estoque">
    <label class="almox-store-search"><span>Buscar material</span><input class="input" name="q" value="<%=filtros.q%>" placeholder="Nome ou código" /></label>
    <label><span>Categoria</span><select class="input" name="categoria_id"><option value="">Todas</option><% categorias.forEach(c=>{ %><option value="<%=c.id%>" <%=String(filtros.categoria_id)===String(c.id)?'selected':''%>><%=c.nome%></option><% }) %></select></label>
    <label><span>Setor</span><select class="input" name="setor_utilizacao"><option value="">Todos</option><% setoresEstoque.forEach(s=>{ %><option value="<%=s%>" <%=filtros.setor_utilizacao===s?'selected':''%>><%=s%></option><% }) %></select></label>
    <label><span>Tipo de estoque</span><select class="input" name="destino"><option value="">Todos</option><option value="GERAL" <%=filtros.destino==='GERAL'?'selected':''%>>Estoque geral</option><option value="EQUIPAMENTO" <%=filtros.destino==='EQUIPAMENTO'?'selected':''%>>Dedicado ao equipamento</option></select></label>
    <label><span>Equipamento</span><select class="input" name="equipamento_id"><option value="">Todos</option><% equipamentos.forEach(e=>{ %><option value="<%=e.id%>" <%=String(filtros.equipamento_id)===String(e.id)?'selected':''%>><%=e.nome%></option><% }) %></select></label>
    <div class="almox-actions"><button class="btn btn-green" type="submit">Filtrar</button><a class="btn btn-ghost" href="/almoxarifado/estoque">Limpar</a></div>
  </form>

  <% if(!itens.length){ %>
    <section class="almox-op-card"><div class="almox-empty"><strong>Nenhum material encontrado.</strong><div class="almox-subline">Revise os filtros ou classifique o material durante o próximo recebimento.</div></div></section>
  <% } else { %>
    <section class="almox-shelf">
      <% itens.forEach(item=>{ const livre=Number(item.saldo_disponivel||0), reservado=Number(item.saldo_reservado||0); %>
        <article class="almox-product">
          <div class="almox-product__top">
            <div><span class="almox-product__code"><%=item.codigo||'SEM CÓDIGO'%></span><h3><%=item.nome%></h3></div>
            <div class="almox-product__stock"><strong><%=livre%> <%=item.unidade||'UN'%></strong><small>livre para uso</small></div>
          </div>
          <div class="almox-product__meta">
            <div><span>Categoria</span><strong><%=item.categoria_nome||'Sem categoria'%></strong></div>
            <div><span>Local</span><strong><%=item.local_nome||'Não definido'%></strong></div>
            <div><span>Setor</span><strong><%=item.setor_utilizacao_exibicao||'COMUM'%></strong></div>
            <div><span>Destino</span><strong><%=item.equipamento_estoque_nome||'Estoque geral'%></strong></div>
            <div><span>Saldo físico</span><strong><%=Number(item.saldo_atual||0)%> <%=item.unidade||'UN'%></strong></div>
            <div><span>Reservado</span><strong><%=reservado%> <%=item.unidade||'UN'%></strong></div>
          </div>
          <div class="almox-product__actions">
            <a class="btn btn-ghost" href="/estoque/itens/<%=item.id%>">Detalhes</a>
            <% if(canWithdraw && livre>0){ %><a class="btn btn-green" href="/estoque/saidas/nova?contexto=almoxarifado&item=<%=item.id%>">Retirar</a><% } %>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</div>
