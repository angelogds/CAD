<% layout('layout');
const grupo=solicitacaoId?grupos.find(g=>Number(g.solicitacao_id)===Number(solicitacaoId)):null;
const pronta=modo==='ESTOQUE'||(modo==='CORREIAS'?Boolean(pedido):Boolean(solicitacaoId))||historico.length>0;
const disponiveis=modo==='ESTOQUE'?itens.map(i=>({...i,item_nome:i.nome,quantidade_disponivel:i.saldo_disponivel,saldo_fisico:i.saldo_atual})):
 modo==='CORREIAS'?(pedido?[{id:pedido.estoque_item_id,item_nome:pedido.material_nome,unidade:'UN',quantidade_disponivel:pedido.quantidade,saldo_fisico:pedido.quantidade}]:[]):
 (grupo?grupo.itens.filter(i=>Number(i.quantidade_disponivel)>0):[]);
const contextoPost={...contexto};delete contextoPost.equipamento_id;delete contextoPost.setor_consumidor;
%>
<div class="almox-central">
<header class="ac-header"><div><span class="ac-eyebrow">ALMOXARIFADO · ENTREGA IDENTIFICADA</span><h1>Retirada de materiais</h1><p>Identifique o funcionário, selecione os materiais e confirme a entrega uma única vez.</p><p class="ac-deliverer">Entrega registrada pelo perfil de <strong><%=entregador.name%></strong>.</p></div></header>
<%- include('_tabs',{tab:'retiradas'}) %>
<ol class="ac-steps" aria-label="Etapas da retirada"><li <%-!pronta?'aria-current="step"':''%>><span>1</span> Origem</li><li <%-pronta&&!pessoa?'aria-current="step"':''%>><span>2</span> QR do funcionário</li><li <%-pronta&&pessoa?'aria-current="step"':''%>><span>3</span> Materiais e OK</li></ol>
<section class="ac-card">
<h2>1. Escolha a origem dos materiais</h2>
<form method="get" action="/almoxarifado/retiradas/qr" class="ac-filters ac-request-select">
<label><span>Origem</span><select name="modo" data-withdraw-mode><% [['SOLICITACAO','Solicitação'],['ESTOQUE','Estoque disponível'],['CORREIAS','Pedido de correias']].forEach(([v,label])=>{ %><option value="<%=v%>" <%=modo===v?'selected':''%>><%=label%></option><% }) %></select></label>
<% if(modo==='SOLICITACAO'){ %>
<label class="ac-search"><span>Solicitação com materiais separados</span><select name="solicitacao_id" required><option value="">Escolha a solicitação</option>
<% if(solicitacaoId&&!solicitacoes.some(s=>s.solicitacao_id===solicitacaoId)){ %><option value="<%=solicitacaoId%>" selected>#<%=solicitacaoId%> · Consultar histórico</option><% } %>
<% solicitacoes.forEach(s=>{ %><option value="<%=s.solicitacao_id%>" <%=s.solicitacao_id===solicitacaoId?'selected':''%>><%=s.numero%> · <%=s.equipamento_nome||s.titulo%> · <%=s.setor_origem%></option><% }) %>
</select></label>
<% }else if(modo==='CORREIAS'){ %>
<label class="ac-search"><span>Correias reservadas para o mecânico</span><select name="pedido_correia_id" required><option value="">Selecione o pedido</option><% pedidosCorreias.forEach(p=>{ %><option value="<%=p.id%>" <%=pedido?.id===p.id?'selected':''%>>#<%=p.id%> · <%=p.equipamento_nome%> · <%=p.material_nome%> · <%=p.mecanico_nome%></option><% }) %></select></label>
<% }else{ %>
<label class="ac-search"><span>Buscar material no estoque livre</span><input type="search" name="q" value="<%=contexto.q||''%>" placeholder="Código ou nome do material"></label>
<% if(contexto.familia){ %><input type="hidden" name="familia" value="<%=contexto.familia%>"><% } %>
<% if(itemSelecionado){ %><input type="hidden" name="item" value="<%=itemSelecionado%>"><% } %>
<% } %><button class="ac-button" type="submit">Abrir</button>
</form>
<% if(modo==='SOLICITACAO'&&!solicitacoes.length&&!solicitacaoId){ %><p class="ac-empty">Nenhuma solicitação com material disponível para retirada. Materiais de prateleira estão em Estoque disponível.</p><% } %>
</section>
<% if(pronta){ %>
<div class="ac-withdraw-layout">
<%- include('_retirada-identidade') %>
<section class="ac-card" id="materiais-retirada">
<header class="ac-section-head"><div><h2>3. Selecione os materiais</h2><p><%=grupo?grupo.numero+' · '+(grupo.equipamento_nome||grupo.titulo):pedido?'Pedido de correias #'+pedido.id:'Materiais com saldo livre no estoque'%></p></div></header>
<% if(!pessoa){ %><p class="ac-empty">Identifique o funcionário para selecionar a entrega.</p>
<% }else if(!disponiveis.length){ %><p class="ac-empty">Nenhum material disponível nesta seleção.</p>
<% }else if(!canWithdraw){ %><p class="ac-empty">Seu perfil permite consultar a entrega.</p>
<% }else{ %>
<form method="post" action="<%=modo==='SOLICITACAO'?'/almoxarifado/solicitacoes/'+solicitacaoId+'/retirar-selecionados':'/estoque/saidas'%>" data-withdraw-batch>
<% Object.entries(contextoPost).forEach(([key,value])=>{ %><input type="hidden" name="<%=key%>" value="<%=value%>"><% }) %>
<input type="hidden" name="operacao_token" value="<%=operacaoToken%>"><input type="hidden" name="qr_code" value="<%=codigo%>"><input type="hidden" name="pessoa_tipo" value="<%=pessoaTipo%>"><input type="hidden" name="pessoa_id" value="<%=pessoaId%>">
<% if(!codigo){ %><label class="ac-manual-name">Confirme o nome completo de quem retira<input name="nome_retirante" required minlength="3" maxlength="120" autocomplete="off" placeholder="Digite conforme o cadastro selecionado"></label><% } %>
<div class="ac-destination-grid">
<label>Setor consumidor<select name="setor_consumidor" required><option value="">Selecione o setor</option><% setores.forEach(s=>{ %><option value="<%=s%>" <%=s===setorSelecionado?'selected':''%>><%=s%></option><% }) %></select></label>
<label>Equipamento<% if(equipamentoFixo){ %><input type="hidden" name="equipamento_id" value="<%=equipamentoFixo%>"><select disabled aria-label="Equipamento do pedido"><% equipamentos.filter(e=>e.id===equipamentoFixo).forEach(e=>{ %><option><%=e.codigo?e.codigo+' · ':''%><%=e.nome%></option><% }) %></select><% }else{ %><select name="equipamento_id"><option value="">Sem equipamento · consumo do setor</option><% equipamentos.forEach(e=>{ %><option value="<%=e.id%>" <%=e.id===equipamentoSelecionado?'selected':''%>><%=e.codigo?e.codigo+' · ':''%><%=e.nome%><%=e.setor?' · '+e.setor:''%></option><% }) %></select><% } %></label>
</div>
<% if(modo==='ESTOQUE'){ %><p class="ac-muted">Para correias, selecione o equipamento vinculado ao plano no PCM.</p><% } %>
<% if(modo==='ESTOQUE'){ %><label>Localizar material nesta lista<input type="search" data-material-search placeholder="Digite o nome ou código"></label><% } %>
<label class="ac-select-all"><input type="checkbox" data-select-all> Selecionar materiais exibidos</label>
<% disponiveis.forEach(i=>{ const max=Math.min(Number(i.quantidade_disponivel),Number(i.saldo_fisico)); %>
<article class="ac-pick-item"><label class="ac-pick-label"><input data-material-check type="checkbox" name="<%=modo==='SOLICITACAO'?'reserva_id':'item_id'%>" value="<%=i.id%>" <%=max<=0?'disabled':''%> <%=modo==='ESTOQUE'&&i.id===itemSelecionado?'checked':''%>><span><strong><%=i.item_nome%></strong><small><%=i.quantidade_disponivel%> <%=i.unidade||'UN'%> disponível(is)</small><% if(i.equipamento_estoque_nome){ %><small>Destinado a <%=i.equipamento_estoque_nome%></small><% } %></span></label>
<label class="ac-pick-quantity"><span>Quantidade</span><div class="ac-number-unit"><input type="number" inputmode="decimal" name="quantidade_<%=i.id%>" <%=max<=0?'disabled':''%> <%=modo==='CORREIAS'?'readonly':''%> min="0.001" step="any" max="<%=max%>" value="<%=modo==='ESTOQUE'?Math.min(1,max):max%>" aria-label="Quantidade a retirar de <%=i.item_nome%>"><span><%=i.unidade||'UN'%></span></div></label></article>
<% }) %>
<details class="ac-history"><summary>Adicionar observação</summary><label>Observação<input name="observacao" maxlength="500"></label></details>
<div class="ac-batch-footer"><strong data-selection-count>Materiais selecionados: 0</strong><button class="ac-button ac-primary" type="submit" data-batch-submit>OK</button></div>
</form>
<% } %>
</section></div>
<section class="ac-card" id="historico-retirada"><header class="ac-section-head"><div><h2>Histórico <%=solicitacaoId?'desta solicitação':'da entrega'%></h2><p>Materiais, quem retirou, quem entregou e data da entrega.</p></div></header>
<% if(!historico.length){ %><p class="ac-empty">Nenhuma retirada registrada nesta seleção.</p><% } %>
<div class="ac-history-list"><% historico.forEach(h=>{ %><article><div><strong><%=h.nome%></strong><span><%=h.quantidade%> <%=h.unidade||'UN'%> · <%=h.retirante_nome%></span><small>Entregue por <%=h.entregador_nome%></small></div><small><%=h.created_at%></small></article><% }) %></div></section>
<% } %>
</div>
<script src="/vendor/almox-qr/jsQR.js" defer></script>
<script src="/js/almox-retirada.js?v=20261102-v3" defer></script>
