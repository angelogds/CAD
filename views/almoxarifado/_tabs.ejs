<%
  const currentTab = typeof tab !== 'undefined' && tab ? tab : (typeof almoxTab !== 'undefined' ? almoxTab : '');
  const abasAlmox = [
    ['painel', 'Painel', '/almoxarifado'],
    ['compras', 'Compras a caminho', '/almoxarifado/recebimentos?status=EM_COTACAO'],
    ['recebimentos', 'Compras a receber', '/almoxarifado/recebimentos?status=COMPRADA'],
    ['separados', 'Para entregar', '/estoque/reservas'],
    ['estoque', 'Estoque', '/almoxarifado/estoque'],
    ['retiradas', 'Retirada', '/almoxarifado/retiradas/qr'],
    ['gerencial', 'Visão gerencial', '/almoxarifado/gerencial']
  ];
%>
<nav class="almox-tabs almox-tabs--operacional" aria-label="Navegação do Almoxarifado">
  <% abasAlmox.forEach(([id, titulo, url]) => { %>
    <a class="almox-tab <%= currentTab === id ? 'active' : '' %>" href="<%=url%>" <%- currentTab === id ? 'aria-current="page"' : '' %>><%= titulo %></a>
  <% }) %>
</nav>
