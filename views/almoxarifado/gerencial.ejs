<% layout("layout") %>
<link rel="stylesheet" href="/css/almoxarifado-modern.css?v=20261007-v3">
<style>
.gerencial{max-width:1400px;margin:auto;padding:18px}.gerencial h1{font-size:1.65rem;margin:4px 0 8px}.gerencial .box{background:#fff;border:1px solid #dee9e2;border-radius:15px;padding:20px;margin:16px 0}
.gerencial .totais{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:10px}
.gerencial .totais article{background:#f7faf7;border:1px solid #e2ebe4;border-radius:12px;padding:13px;min-width:0}
.gerencial .totais small{display:block;color:#61766b}.gerencial .totais strong{font-size:1.35rem;display:block;margin-top:7px}
.gerencial .duas{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:15px}.gerencial table{width:100%;border-collapse:collapse;font-size:.89rem}
.gerencial th,.gerencial td{padding:9px 6px;text-align:left;border-bottom:1px solid #e9eee9;vertical-align:top}.gerencial .scroll{overflow:auto}
.gerencial .form{display:flex;align-items:end;gap:12px;flex-wrap:wrap}.gerencial label{display:grid;gap:5px;font-size:.85rem}
.gerencial select,.gerencial input{padding:9px;border-radius:8px;border:1px solid #cbdacf}
.gerencial .bar{height:13px;background:#e9eeeb;border-radius:7px;overflow:hidden;min-width:90px}.gerencial .fill{height:100%;background:#278357}
.gerencial .val{font-variant-numeric:tabular-nums}.gerencial .muted{color:#607367}
@media(max-width:600px){.gerencial{padding:10px}.gerencial .box{padding:12px}.gerencial h1{font-size:1.35rem}}
</style>
<link rel="stylesheet" href="/css/almoxarifado-ux-v10.css?v=20261008-v1" />
<link rel="stylesheet" href="/css/almoxarifado-layout-v11.css?v=20261011-v1" />
<%
const moeda = c => (Number(c||0)/100).toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
const numero = n => Number(n||0).toLocaleString("pt-BR",{maximumFractionDigits:2});
const query = new URLSearchParams({periodo: dados.periodo.modo, inicio:dados.periodo.inicio, fim:dados.periodo.fim});
const r = dados.resumo;
const queryAtrasos = (mudancas = {}) => {
  const p = new URLSearchParams(query.toString());
  if (consultaAtrasos.filtros.tipo !== 'TODOS') p.set('tipo', consultaAtrasos.filtros.tipo);
  if (consultaAtrasos.filtros.fornecedor) p.set('fornecedor', consultaAtrasos.filtros.fornecedor);
  if (consultaAtrasos.filtros.busca) p.set('busca', consultaAtrasos.filtros.busca);
  if (consultaAtrasos.paginacao.pagina > 1) p.set('pagina', String(consultaAtrasos.paginacao.pagina));
  Object.entries(mudancas).forEach(([chave,valor]) => {
    if (valor === null || valor === undefined || valor === '') p.delete(chave);
    else p.set(chave, String(valor));
  });
  return p.toString();
};
const dataBR = iso => iso ? String(iso).slice(0,10).split('-').reverse().join('/') : 'Sem previsão';
const maior = Math.max(1,...dados.serie.map(s=>Math.max(s.entradas,s.saidas)));
%>
<div class="gerencial almox-v11 almox-v15">
  <header style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
    <div><span style="color:#16844d;font-size:.78rem;font-weight:700">ALMOXARIFADO • GESTÃO E RESULTADOS</span>
      <h1>Painel gerencial de materiais</h1>
      <p class="muted">Custos, movimentações e consumo com base nos registros reais do sistema.</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <a href="/almoxarifado" class="btn btn-ghost">Voltar à central</a>
      <a class="btn btn-green" href="/almoxarifado/gerencial/pdf?<%=queryAtrasos({pagina:''} )%>">Gerar relatório PDF</a>
    </div>
  </header>
  <%- include('_tabs', { tab: 'gerencial' }) %>
  <section class="box">
    <form method="get" action="/almoxarifado/gerencial" class="form">
      <label>Período<select name="periodo" id="periodo-gerencial">
        <% [['7d','Últimos 7 dias'],['30d','Últimos 30 dias'],['mes','Mês atual'],['ano','Ano atual'],['personalizado','Personalizado']].forEach(([v,n])=>{ %>
          <option value="<%=v%>" <%=dados.periodo.modo===v?'selected':''%>><%=n%></option><% }) %>
      </select></label>
      <label>Início<input type="date" name="inicio" value="<%=dados.periodo.inicio%>"></label>
      <label>Fim<input type="date" name="fim" value="<%=dados.periodo.fim%>"></label>
      <button type="submit" class="btn btn-green">Aplicar filtros</button>
      <small class="muted">Intervalo analisado: <%=dados.periodo.inicio%> a <%=dados.periodo.fim%></small>
    </form>
  </section>
  <section class="box"><h2>Resumo financeiro e operacional</h2>
    <div class="totais">
      <% [
        ['Valor em estoque',moeda(r.estoqueCentavos)],
        ['Entradas no período',moeda(r.valorEntradaCentavos)],
        ['Saídas no período',moeda(r.valorSaidaCentavos)],
        ['Materiais com saldo',numero(r.itensComSaldo)],
        ['Registros de entrada',numero(r.registrosEntrada)],
        ['Registros de retirada',numero(r.registrosSaida)]
      ].forEach(([nome,total])=>{ %>
        <article><small><%=nome%></small><strong class="val"><%=total%></strong></article>
      <% }) %>
    </div>
    <p class="muted" style="margin:13px 0 0;font-size:.82rem">Valores por custo de aquisição ou estimativa do estoque, não faturamento. <b><%=r.itensSemValor%></b> material(is) em saldo sem custo; <b><%=r.entradasSemPreco%></b> entrada(s) e <b><%=r.saidasSemPreco%></b> saída(s) sem preço; <b><%=r.valoresEstimados%></b> movimento(s) valorizados por estimativa. Esses valores são parciais enquanto houver custos ausentes.</p>
  </section>
  <section class="box"><h2>Gráfico de entradas e saídas</h2><p class="muted">Quantidade de registros por <%=dados.serie.some(s=>s.data.length===7)?'mês':'dia'%>; unidades diferentes não são somadas.</p>
    <div class="scroll"><table><thead><tr><th>Data</th><th>Entradas</th><th>Saídas</th></tr></thead><tbody>
      <% if(!dados.serie.length){ %><tr><td colspan="3">Sem movimentações no período.</td></tr><% } %>
      <% dados.serie.forEach(s=>{ %>
        <tr><td><%=s.data%></td>
          <td><%=s.entradas%><div class="bar"><div class="fill" style="width:<%=(s.entradas/maior*100).toFixed(1)%>%"></div></div></td>
          <td><%=s.saidas%><div class="bar"><div class="fill" style="width:<%=(s.saidas/maior*100).toFixed(1)%>%;background:#c08337"></div></div></td></tr>
      <% }) %>
    </tbody></table></div>
  </section>
  <section class="box"><h2>Movimentação por setor e categoria</h2><p class="muted">Entradas e saídas no período selecionado. Cada unidade aparece em linha separada; setor não informado segue identificado.</p>
    <div class="scroll"><table><thead><tr><th>Setor</th><th>Categoria</th><th>Unidade</th><th>Entradas</th><th>Saídas</th></tr></thead><tbody>
      <% if(!dados.movimentacaoPorSetorCategoria.length){ %><tr><td colspan="5">Sem movimentações no período.</td></tr><% } %>
      <% dados.movimentacaoPorSetorCategoria.forEach(g=>{ %><tr><td><%=g.setor%></td><td><%=g.categoria%></td><td><%=g.unidade%></td><td><%=numero(g.entradas)%></td><td><%=numero(g.saidas)%></td></tr><% }) %>
    </tbody></table></div>
  </section>
  <section class="box almox-v15-report" id="pendencias-fornecedores" aria-labelledby="relatorio-atrasos-titulo">
    <div class="almox-v15-section-head">
      <div>
        <span class="almox-v15-eyebrow">ACOMPANHAMENTO DE COMPRAS</span>
        <h2 id="relatorio-atrasos-titulo">Entregas e atrasos por fornecedor</h2>
        <p class="muted">Posição em <%=dataBR(pendencias.hoje)%>. Somente quantidades compradas ainda não recebidas. O vencimento é verificado pela data de hoje, independente do período financeiro acima.</p>
      </div>
      <a class="btn btn-ghost" href="/almoxarifado/gerencial/pdf?<%=queryAtrasos({pagina:''})%>">PDF desta pesquisa</a>
    </div>
    <div class="almox-v15-metrics" aria-label="Resumo de pendências">
      <a class="almox-v15-metric tone-red" href="/almoxarifado/gerencial?<%=queryAtrasos({tipo:'ATRASADOS',pagina:''})%>#pendencias-fornecedores">
        <span>Materiais atrasados</span><strong><%=numero(pendencias.resumo.itensAtrasados)%></strong><small>Abrir vencidos</small>
      </a>
      <a class="almox-v15-metric tone-orange" href="/almoxarifado/gerencial?<%=queryAtrasos({tipo:'SEM_PREVISAO',pagina:''})%>#pendencias-fornecedores">
        <span>Sem previsão</span><strong><%=numero(pendencias.resumo.semPrevisao)%></strong><small>Conferir datas ausentes</small>
      </a>
      <div class="almox-v15-metric tone-green"><span>Fornecedores em atraso</span><strong><%=numero(pendencias.resumo.fornecedoresAtrasados)%></strong><small>Com entrega vencida</small></div>
      <div class="almox-v15-metric tone-blue"><span>Pedidos atrasados</span><strong><%=numero(pendencias.resumo.pedidosAtrasados)%></strong><small>Solicitações distintas</small></div>
    </div>
    <form method="get" action="/almoxarifado/gerencial#pendencias-fornecedores" class="almox-v15-filters">
      <input type="hidden" name="periodo" value="<%=dados.periodo.modo%>">
      <input type="hidden" name="inicio" value="<%=dados.periodo.inicio%>">
      <input type="hidden" name="fim" value="<%=dados.periodo.fim%>">
      <label class="almox-v15-search"><span>Material ou solicitação</span><input type="search" name="busca" value="<%=consultaAtrasos.filtros.busca%>" placeholder="Buscar nome, número ou fornecedor"></label>
      <label><span>Situação</span><select name="tipo">
        <% [['TODOS','Todas as pendências'],['ATRASADOS','Somente atrasados'],['SEM_PREVISAO','Sem previsão']].forEach(([valor,rotulo])=>{ %>
          <option value="<%=valor%>" <%=consultaAtrasos.filtros.tipo===valor?'selected':''%>><%=rotulo%></option>
        <% }) %>
      </select></label>
      <label><span>Fornecedor</span><select name="fornecedor">
        <option value="">Todos os fornecedores</option>
        <% consultaAtrasos.fornecedores.forEach(nome=>{ %><option value="<%=nome%>" <%=consultaAtrasos.filtros.fornecedor===nome?'selected':''%>><%=nome%></option><% }) %>
      </select></label>
      <button type="submit" class="btn btn-green">Pesquisar</button>
      <a class="btn btn-ghost" href="/almoxarifado/gerencial?<%=queryAtrasos({tipo:'',fornecedor:'',busca:'',pagina:''})%>#pendencias-fornecedores">Limpar</a>
    </form>
    <div class="almox-v15-section-head almox-v15-result-head">
      <div><h3>Fila de acompanhamento</h3><p class="muted"><%=consultaAtrasos.resumo.itens%> material(is) encontrado(s): <%=consultaAtrasos.resumo.atrasados%> vencido(s) e <%=consultaAtrasos.resumo.semPrevisao%> sem data de entrega.</p></div>
      <span class="almox-v15-counter"><%=consultaAtrasos.paginacao.total ? ((consultaAtrasos.paginacao.pagina-1)*consultaAtrasos.paginacao.porPagina+1) : 0%>–<%=Math.min(consultaAtrasos.paginacao.total,consultaAtrasos.paginacao.pagina*consultaAtrasos.paginacao.porPagina)%> de <%=consultaAtrasos.paginacao.total%></span>
    </div>
    <div class="scroll almox-v15-table-wrap"><table class="almox-v15-table">
      <thead><tr><th>Situação</th><th>Fornecedor</th><th>Solicitação</th><th>Material</th><th>Falta receber</th><th>Data prevista</th><th>Ação</th></tr></thead>
      <tbody>
        <% if(!consultaAtrasos.itens.length){ %><tr><td colspan="7" class="almox-v15-empty">Nenhuma pendência encontrada para esses filtros. Altere a pesquisa ou limpe os filtros.</td></tr><% } %>
        <% consultaAtrasos.itens.forEach(item=>{ %>
          <tr class="<%=item.situacao==='ATRASADOS'?'almox-v15-overdue':'almox-v15-undated'%>">
            <td><span class="almox-v15-badge <%=item.situacao==='ATRASADOS'?'is-late':'is-undated'%>"><%=item.situacao==='ATRASADOS' ? 'Atrasado '+item.diasAtraso+'d' : 'Sem previsão'%></span></td>
            <td><%=item.fornecedor%></td>
            <td><strong><%=item.numero%></strong></td>
            <td><%=item.nome%></td>
            <td class="val"><%=numero(item.pendente)%> <%=item.unidade%></td>
            <td><%=dataBR(item.previsao)%></td>
            <td><a class="almox-v15-open" href="/almoxarifado/solicitacoes/<%=item.solicitacaoId%>/conferir">Abrir</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if(consultaAtrasos.paginacao.paginas>1){ %>
      <nav class="almox-v15-pagination" aria-label="Páginas das pendências">
        <% if(consultaAtrasos.paginacao.pagina>1){ %><a href="/almoxarifado/gerencial?<%=queryAtrasos({pagina:consultaAtrasos.paginacao.pagina-1})%>#pendencias-fornecedores">Anterior</a><% } %>
        <span>Página <%=consultaAtrasos.paginacao.pagina%> de <%=consultaAtrasos.paginacao.paginas%></span>
        <% if(consultaAtrasos.paginacao.pagina<consultaAtrasos.paginacao.paginas){ %><a href="/almoxarifado/gerencial?<%=queryAtrasos({pagina:consultaAtrasos.paginacao.pagina+1})%>#pendencias-fornecedores">Próxima</a><% } %>
      </nav>
    <% } %>
    <% if(consultaAtrasos.porFornecedor.length){ %>
      <details class="almox-v15-suppliers">
        <summary>Ver totais por fornecedor (<%=consultaAtrasos.porFornecedor.length%>)</summary>
        <div class="scroll"><table><thead><tr><th>Fornecedor</th><th>Materiais atrasados</th><th>Pedidos</th><th>Maior atraso</th></tr></thead><tbody>
        <% consultaAtrasos.porFornecedor.forEach(grupo=>{ %>
          <tr><td><%=grupo.nome%></td><td><%=grupo.itensAtrasados%></td><td><%=grupo.pedidosAtrasados%></td><td><%=grupo.maiorAtrasoDias%> dia(s)</td></tr>
        <% }) %>
        </tbody></table></div>
      </details>
    <% } %>
    <p class="muted almox-v15-note">O PDF exporta todos os resultados da pesquisa, não apenas a página exibida. Compras sem data válida são separadas dos atrasos.</p>
  </section>
  <div class="duas">
    <section class="box"><h2>Mais utilizados no período</h2><p class="muted">Ordenados pelo número de retiradas, com quantidade por unidade do material.</p>
      <div class="scroll"><table><thead><tr><th>Material</th><th>Retiradas</th><th>Quantidade</th></tr></thead><tbody>
      <% if(!dados.maisSaidos.length){ %><tr><td colspan="3">Sem retiradas no período.</td></tr><% } %>
      <% dados.maisSaidos.forEach(i=>{ %><tr><td><%=i.nome%></td><td><%=i.saidas%></td><td><%=numero(i.qtdSaida)%> <%=i.unidade%></td></tr><% }) %>
      </tbody></table></div>
    </section>
    <section class="box"><h2>Materiais parados há 90 dias</h2><p class="muted">Saldo disponível sem saída recente e cadastro com pelo menos 90 dias. Revisar a reserva estratégica antes de reduzir compras.</p>
      <div class="scroll"><table><thead><tr><th>Material</th><th>Saldo</th><th>Última saída</th></tr></thead><tbody>
      <% if(!dados.parados.length){ %><tr><td colspan="3">Nenhum item antigo parado identificado.</td></tr><% } %>
      <% dados.parados.forEach(i=>{ %><tr><td><%=i.nome%></td><td><%=numero(i.saldo)%> <%=i.unidade%></td><td><%=i.ultimaSaida||'Sem registro'%></td></tr><% }) %>
      </tbody></table></div>
    </section>
  </div>
  <section class="box"><h2>Materiais atualmente em estoque</h2><p class="muted">Valores calculados pelo custo unitário registrado. Lista completa no PDF.</p>
    <div class="scroll"><table><thead><tr><th>Material</th><th>Saldo</th><th>Custo unitário</th><th>Valor estimado</th></tr></thead><tbody>
    <% if(!dados.inventario.length){ %><tr><td colspan="4">Estoque sem saldo registrado.</td></tr><% } %>
    <% dados.inventario.slice(0,20).forEach(i=>{ %><tr><td><%=i.nome%></td><td><%=numero(i.saldo)%> <%=i.unidade%></td>
       <td><%=i.custoUnitario==null?'Sem custo':moeda(Math.round(i.custoUnitario*100))%></td>
       <td><%=i.valorSaldoCentavos==null?'Sem custo':moeda(i.valorSaldoCentavos)%></td></tr><% }) %>
    </tbody></table></div>
  </section>
</div>
<section class="gerencial box"><h2>Estoque próximo do mínimo e reposições</h2><p>Quantidades na unidade de controle de cada material. Saldo livre desconta reservas de solicitações e correias.</p><div class="scroll"><table><thead><tr><th>Material</th><th>Livre</th><th>Reserva mínima</th><th>Ponto de reposição</th><th>A receber</th><th>Acompanhamento</th></tr></thead><tbody><% (typeof reposicao==='undefined'?[]:reposicao).forEach(i=>{ %><tr><td><a href="/estoque/itens/<%=i.id%>"><%=i.nome%></a> (<%=i.unidade%>)</td><td><%=i.disponivel%></td><td><%=i.saldo_minimo%></td><td><%=i.ponto_calculado.toFixed(2)%></td><td><%=i.a_receber%></td><td><%=i.pedido?'Pré-solicitação '+i.pedido.numero:i.situacao==='RESERVA_MINIMA'?'Na reserva mínima':'No ponto de reposição'%></td></tr><% }) %></tbody></table></div></section>
