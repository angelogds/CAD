<% layout('layout') %>
<div class="almox-central">
<header class="ac-header">
<div>
<span class="ac-eyebrow">ALMOXARIFADO · <%=sol.numero||'#'+sol.id%>
</span>
<h1>
<%=sol.titulo%>
</h1>
<p>
<%=sol.setor_origem%> · <%=sol.equipamento_nome||'Materiais para prateleira'%>
</p>
</div>
<a class="ac-button" href="/almoxarifado/recebimentos?solicitacao_id=<%=sol.id%>#conferencia">Voltar às solicitações</a>
</header>
<%- include('_tabs',{tab:'recebimentos'}) %>
<div class="ac-conference-grid">
<section class="ac-card" id="materiais">
<h2>Conferência dos materiais</h2>
<p>Informe apenas o que chegou. O restante continua pendente.</p>
<%- include('_itens-recebimento',{sol,canManage,operacaoToken}) %>
</section>
<aside class="ac-card">
<h2>Resumo da solicitação</h2>
<dl class="ac-facts">
<div>
<dt>Solicitante</dt>
<dd>
<%=sol.solicitante_nome||'—'%>
</dd>
</div>
<div>
<dt>Fornecedor</dt>
<dd>
<%=sol.fornecedor||'Conforme os itens comprados'%>
</dd>
</div>
<div>
<dt>Situação</dt>
<dd>
<%=String(sol.status||'').replaceAll('_',' ')%>
</dd>
</div>
</dl>
<% if(canWithdraw){ %>
<a class="ac-button ac-primary" href="/almoxarifado/retiradas/qr?solicitacao_id=<%=sol.id%>">Retirar materiais</a>
<% } %>
<details class="ac-history" open>
<summary>Histórico de recebimento</summary>
<% if(!historico.length){ %>
<p>Nenhum recebimento registrado.</p>
<% } %>
<% historico.forEach(h=>{ %>
<article>
<strong>
<%=h.item_nome||h.estoque_item_nome||'Material'%>
</strong>
<span>
<%=h.quantidade%> · <%=h.usuario_nome||'Registro do sistema'%>
</span>
<small>
<%=h.created_at||''%>
</small>
</article>
<% }) %>
</details>
</aside>
</div>
</div>
