<% layout('layout'); const c=consulta; const url=(extra={})=>'/almoxarifado/recebimentos?'+new URLSearchParams({q:c.q,setor:c.setor,aba:c.aba,situacao:c.situacao,pagina:String(c.pagina),...extra}).toString(); %>
<div class="almox-central">
<header class="ac-header">
<div>
<span class="ac-eyebrow">ALMOXARIFADO · SOLICITAÇÕES</span>
<h1>Solicitações</h1>
<p>Abra a solicitação e confirme somente o material que chegou.</p>
</div>
</header>
<%- include('_tabs',{tab:'recebimentos'}) %>
<section class="ac-card">
<div class="ac-section-head">
<div class="ac-switch" aria-label="Situação das solicitações">
<a href="<%=url({aba:'ABERTAS',pagina:'1',situacao:''})%>" <%-c.aba==='ABERTAS'?'aria-current="page"':''%>>Abertas <span>
<%=c.resumo.abertas%>
</span>
</a>
<a href="<%=url({aba:'FECHADAS',pagina:'1',situacao:''})%>" <%-c.aba==='FECHADAS'?'aria-current="page"':''%>>Fechadas <span>
<%=c.resumo.fechadas%>
</span>
</a>
</div>
<span class="ac-muted">Fechadas: recebimento concluído. Entregas continuam em Estoque.</span>
</div>
<form class="ac-filters ac-queue-filters" method="get" action="/almoxarifado/recebimentos">
<input type="hidden" name="aba" value="<%=c.aba%>">
<label class="ac-search">
<span>Buscar solicitação ou material</span>
<input type="search" name="q" value="<%=c.q%>" placeholder="Número, equipamento, material ou fornecedor">
</label>
<label>
<span>Setor</span>
<select name="setor">
<option value="">Todos os setores</option>
<% setores.forEach(s=>{ %>
<option value="<%=s%>" <%=s===c.setor?'selected':''%>>
<%=s%>
</option>
<% }) %>
</select>
</label>
<label>
<span>Etapa</span>
<select name="situacao">
<option value="">Todas</option>
<% [['PENDENTES','Com itens a receber'],['PARCIAL','Recebimento parcial'],['AGUARDANDO_COMPRAS','Aguardando Compras']].forEach(([v,l])=>{ %>
<option value="<%=v%>" <%=c.situacao===v?'selected':''%>>
<%=l%>
</option>
<% }) %>
</select>
</label>
<button class="ac-button" type="submit">Filtrar</button>
</form>
</section>
<div class="ac-workspace <%=sol?'ac-has-selection':''%>">
<section class="ac-card ac-requests" id="solicitacoes">
<header class="ac-section-head">
<h2>
<%=c.total%> solicitação(ões)</h2>
</header>
<% if(!c.lista.length){ %>
<div class="ac-empty">
<strong>Nenhuma solicitação nesta pesquisa.</strong>
<p>Ajuste o setor, a busca ou consulte as fechadas.</p>
</div>
<% } %>
<% c.lista.forEach(s=>{ %>
<a class="ac-request-card <%=sol&&s.id===sol.id?'is-selected':''%>" href="<%=url({solicitacao_id:String(s.id)})%>#conferencia" <%-sol&&s.id===sol.id?'aria-current="true"':''%>>
<div class="ac-section-head">
<span class="ac-overline">
<%=s.numero||'#'+s.id%>
</span>
<span class="ac-badge <%=s.itens_a_receber&&!s.encerrada?'ac-ready':''%>">
<%=s.etapa_nome%>
</span>
</div>
<h3>
<%=s.titulo%>
</h3>
<p>
<%=s.equipamento_nome||'Materiais para prateleira'%>
</p>
<small>
<%=s.setor_exibicao%> · <%=s.itens_total%> material(is)</small>
<div class="ac-request-count">
<% if(s.itens_a_receber&&!s.encerrada){ %>
<strong>
<%=s.itens_a_receber%> a receber</strong>
<% } %>
<% if(s.itens_aguardando){ %>
<span>
<%=s.itens_aguardando%> aguardando Compras</span>
<% } %>
<% if(s.divergencia_fechada){ %>
<span>Fechada com divergência histórica — conferir documentos</span>
<% } %>
</div>
</a>
<% }) %>
<% if(c.paginas>1){ %>
<nav class="ac-pagination" aria-label="Paginação">
<% if(c.pagina>1){ %>
<a href="<%=url({pagina:String(c.pagina-1)})%>">← Anterior</a>
<% } %>
<span>Página <%=c.pagina%> de <%=c.paginas%>
</span>
<% if(c.pagina<c.paginas){ %>
<a href="<%=url({pagina:String(c.pagina+1)})%>">Próxima →</a>
<% } %>
</nav>
<% } %>
</section>
<section class="ac-card ac-detail" id="conferencia" aria-label="Conferência da solicitação">
<% if(sol){ %>
<header class="ac-section-head">
<div>
<span class="ac-overline">
<%=sol.numero||'#'+sol.id%>
</span>
<h2>
<%=sol.titulo%>
</h2>
<p>
<%=sol.setor_origem%> · <%=sol.equipamento_nome||'Prateleira'%>
</p>
</div>
<a href="/almoxarifado/solicitacoes/<%=sol.id%>/conferir">Ver histórico →</a>
</header>
<%- include('_itens-recebimento',{sol,canManage,operacaoToken,embedded:true}) %>
<% if(canWithdraw){ %>
<a class="ac-inline-link" href="/almoxarifado/retiradas/qr?solicitacao_id=<%=sol.id%>">Consultar retirada desta solicitação →</a>
<% } %>
<% }else{ %>
<div class="ac-empty ac-detail-placeholder">
<span class="ac-box-icon" aria-hidden="true">▤</span>
<h2>Selecione uma solicitação</h2>
<p>Confira os itens comprados e informe a quantidade que chegou. Um OK registra a entrada.</p>
</div>
<% } %>
</section>
</div>
</div>
