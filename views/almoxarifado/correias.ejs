<% layout('layout'); const manage=['ADMIN','ALMOXARIFADO'].includes(String(user?.role||'').toUpperCase()); %>
<div class="almox-central">
<header class="ac-header"><div><span class="ac-eyebrow">ALMOXARIFADO · CORREIAS</span><h1>Correias por equipamento</h1><p>O PCM cadastra a referência e o plano por equipamento. O almoxarifado separa e entrega pela retirada padrão.</p></div><% if(manage){ %><a class="ac-button ac-primary" href="/almoxarifado/retiradas/qr?modo=ESTOQUE&familia=CORREIAS">Retirar correias →</a><% } %></header>
<%- include('_tabs',{tab:'correias'}) %>
<% if(typeof canAccessModule==='function'&&canAccessModule(user?.role,'pcm_manage')){ %><section class="ac-card"><h2>Cadastro técnico no PCM</h2><p>Cadastre a referência, a quantidade por jogo e o equipamento no Plano de Correias.</p><a class="ac-inline-link" href="/pcm/correias">Abrir cadastro de correias no PCM →</a></section><% } %>
<section class="ac-card"><header class="ac-section-head"><div><h2>Pedidos para separar e histórico</h2><p>A identificação por QR e a confirmação da entrega são feitas na mesma tela dos demais materiais.</p></div></header>
<% if(!pedidos.length){ %><p class="ac-empty">Sem pedidos de correias. As referências e os equipamentos são cadastrados pelo PCM.</p><% } %>
<% pedidos.forEach(p=>{ %><article class="ac-belt-order"><div><span class="ac-overline">PEDIDO #<%=p.id%> · <%=p.setor_consumidor%></span><h3><%=p.equipamento_nome%> · <%=p.material_nome%></h3><p><%=p.quantidade%> correia(s) · <%=p.mecanico_nome%> · <%=p.status%><% if(p.preventiva_execucao_id){ %> · preventiva #<%=p.preventiva_execucao_id%><% } %></p>
<% if(p.troca_em){ %><p>Troca confirmada: <%=p.troca_em%>. A inspeção continua programada.</p><% } %></div>
<% if(manage&&['SOLICITADA','SEPARADA'].includes(p.status)){ %>
<a class="ac-button ac-primary" href="/almoxarifado/retiradas/qr?modo=CORREIAS&pedido_correia_id=<%=p.id%>">Identificar e entregar →</a>
<details class="ac-history"><summary>Organizar pedido</summary><form method="post" action="/almoxarifado/correias/<%=p.id%>" data-lock-submit><button name="acao" value="separar" class="ac-button">Marcar separado</button><button name="acao" value="cancelar" class="ac-button">Cancelar pedido</button></form></details>
<% } %>
<% if(manage&&p.status==='RETIRADA'&&p.quantidade>p.quantidade_devolvida){ %><details class="ac-history"><summary>Devolver material não utilizado</summary><form method="post" action="/almoxarifado/correias/<%=p.id%>" data-lock-submit><input type="hidden" name="acao" value="devolver"><label>Quantidade para devolver<input type="number" name="quantidade" min="1" max="<%=p.quantidade-p.quantidade_devolvida%>" step="1" required></label><button class="ac-button">Registrar devolução</button></form></details><% } %>
</article><% }) %>
</section></div>
