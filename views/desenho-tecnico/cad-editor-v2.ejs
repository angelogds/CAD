<% layout("layout") %>

<link rel="stylesheet" href="/css/cad-autocad.css">
<link rel="stylesheet" href="/css/cad-system-shell.css">
<link rel="stylesheet" href="/css/cad-solidworks-workbench.css?v=20261029-workspace-v1" data-cad-final2d-style="1">

<div class="cad-fullscreen cad-technical-shell cad-theme-dark">
  <div class="cad-toolbar">
    <header class="cad-appbar">
      <div class="cad-appbar-start">
        <a class="cad-icon-btn cad-back" href="/desenho-tecnico" aria-label="Voltar à central de desenhos" title="Central de desenhos">←</a>
        <span class="cad-brand-mark" aria-hidden="true">CG</span>
        <div class="cad-document-heading">
          <div class="cad-document-eyebrow">Campo do Gado · Desenho técnico</div>
          <div class="cad-document-title">
            <strong><%= desenho.codigo %></strong>
            <span><%= desenho.titulo %></span>
          </div>
        </div>
      </div>

      <div class="cad-save-summary" aria-live="polite">
        <span class="cad-save-dot"></span>
        <span id="cadSaveState" data-state="saved">Tudo salvo</span>
      </div>

      <div class="cad-appbar-actions">
        <button class="cad-icon-btn" data-action="undo" id="cadUndoBtn" type="button" title="Desfazer (Ctrl+Z)" aria-label="Desfazer">↶</button>
        <button class="cad-icon-btn" data-action="redo" id="cadRedoBtn" type="button" title="Refazer (Ctrl+Y)" aria-label="Refazer">↷</button>
        <button class="cad-btn cad-btn-secondary" data-action="view-3d-shaft" type="button" title="Abrir vistas isométrica, frontal, superior e lateral">Visualizar 3D</button>
        <button class="cad-btn cad-btn-primary" id="cadSaveBtn" data-action="save" type="button" title="Salvar (Ctrl+S)">Salvar desenho</button>
      </div>
    </header>

    <nav class="cad-ribbon" aria-label="Ferramentas principais">
      <div class="cad-ribbon-group cad-ribbon-featured">
        <span class="cad-ribbon-label">Início rápido</span>
        <button class="cad-ribbon-btn featured" data-action="tool-flange" data-tool="flange" type="button" title="Flange paramétrico (F)">
          <span class="cad-ribbon-icon">◎</span><span>Flange</span>
        </button>
        <button class="cad-ribbon-btn featured" data-action="tool-shaft" data-tool="shaft" type="button" title="Eixo paramétrico (X)">
          <span class="cad-ribbon-icon">⇥</span><span>Eixo</span>
        </button>
      </div>

      <div class="cad-ribbon-group">
        <span class="cad-ribbon-label">Desenhar</span>
        <button class="cad-ribbon-btn" data-action="tool-line" data-tool="line" type="button" title="Linha (L)">／ <span>Linha</span></button>
        <button class="cad-ribbon-btn" data-action="tool-polyline" data-tool="polyline" type="button" title="Polilinha (PL)">⌁ <span>Polilinha</span></button>
        <button class="cad-ribbon-btn" data-action="tool-circle" data-tool="circle" type="button" title="Círculo (C)">○ <span>Círculo</span></button>
        <button class="cad-ribbon-btn" data-action="tool-arc" data-tool="arc" type="button" title="Arco (A)">◜ <span>Arco</span></button>
        <button class="cad-ribbon-btn" data-action="tool-rect" data-tool="rect" type="button" title="Retângulo (REC)">□ <span>Retângulo</span></button>
      </div>

      <div class="cad-ribbon-group">
        <span class="cad-ribbon-label">Modificar</span>
        <button class="cad-ribbon-btn" data-action="tool-move" data-tool="move" type="button" title="Mover (M)">✥ <span>Mover</span></button>
        <button class="cad-ribbon-btn" data-action="tool-copy" data-tool="copy" type="button" title="Copiar (CO)">⧉ <span>Copiar</span></button>
        <button class="cad-ribbon-btn" data-action="tool-offset" data-tool="offset" type="button" title="Offset (O)">▱ <span>Offset</span></button>
        <button class="cad-ribbon-btn" data-action="tool-trim" data-tool="trim" type="button" title="Aparar (TR)">⌁ <span>Aparar</span></button>
        <button class="cad-ribbon-btn" data-action="tool-extend" data-tool="extend" type="button" title="Estender (EX)">⇢ <span>Estender</span></button>
        <button class="cad-ribbon-btn danger" id="cadDeleteBtn" data-action="delete-selection" type="button" title="Apagar seleção (Del)">⌫ <span>Apagar</span></button>
      </div>

      <div class="cad-ribbon-group cad-ribbon-annotation" data-cad-tabs="annotate">
        <span class="cad-ribbon-label">Cotas e anotação</span>
        <button class="cad-ribbon-btn" data-action="tool-dim-linear" data-tool="dim_linear" type="button" title="Cotar (D)">↔ <span>Cotar</span></button>
        <button class="cad-ribbon-btn" data-action="tool-dim-diameter" data-tool="dim_diameter" type="button" title="Cota de diâmetro (DD)">⌀ <span>Diâmetro</span></button>
        <button class="cad-ribbon-btn" data-action="tool-dim-angular" data-tool="dim_angular" type="button" title="Cota angular (DA)">∠ <span>Angular</span></button>
        <button class="cad-ribbon-btn" data-action="tool-centerline" data-tool="centerline" type="button" title="Linha de centro (CL)">╍ <span>Centro</span></button>
        <button class="cad-ribbon-btn" data-action="tool-text" data-tool="text" type="button" title="Texto (T)">T <span>Texto</span></button>
        <button class="cad-ribbon-btn" data-action="tool-measure" data-tool="measure" type="button" title="Medir (DI)">⌖ <span>Medir</span></button>
      </div>
      <div class="cad-ribbon-group cad-ribbon-file" data-cad-tabs="view">
        <span class="cad-ribbon-label">Documento</span>
        <a class="cad-ribbon-btn" data-action="export-pdf" data-pdf-url="/desenho-tecnico/cad/<%= desenho.id %>/pdf" href="/desenho-tecnico/cad/<%= desenho.id %>/pdf" title="Salvar e exportar PDF"><span class="cad-ribbon-icon">PDF</span><span>Exportar PDF</span></a>
        <button class="cad-ribbon-btn" data-action="export-step" type="button" title="Exportar STEP do eixo salvo"><span class="cad-ribbon-icon">3D</span><span>Exportar STEP</span></button>
        <button class="cad-ribbon-btn" data-action="toggle-theme" type="button" title="Alternar tema"><span class="cad-ribbon-icon">◐</span><span>Tema</span></button>
      </div>
      <div class="cad-ribbon-group cad-ribbon-precision">
        <span class="cad-ribbon-label">Precisão</span>
        <button class="cad-chip" id="cadGridToggle" data-action="toggle-grid" type="button">Grade</button>
        <button class="cad-chip" id="cadSnapToggle" data-action="toggle-snap" type="button">Snap</button>
        <button class="cad-chip" id="cadOrthoToggle" data-action="toggle-ortho" type="button">Ortho</button>
        <button class="cad-chip" id="cadPolarToggle" data-action="toggle-polar" type="button" title="Rastreamento polar (F10)">Polar</button>
        <button class="cad-chip" id="cadZoomExtentsBtn" data-action="zoom-extents" type="button">Enquadrar</button>
      </div>
    </nav>
  </div>

  <div class="cad-workspace" id="cadWorkspace">
    <aside class="cad-panel-left" id="cadLeftPanel" aria-label="Explorador do desenho">
      <details class="cad-inspector-section cad-layers-section">
        <summary>Camadas <span>Organização visual</span></summary>
        <div class="cad-panel-content">
          <label class="cad-field"><span>Camada ativa</span><select class="cad-select" id="cadLayerSelect"></select></label>
          <div class="cad-layer-create">
            <input class="cad-input" id="cadLayerNewName" placeholder="Nova camada">
            <button class="cad-btn cad-btn-secondary" id="cadLayerAddBtn" data-action="add-layer" type="button">Adicionar</button>
          </div>
          <div id="cadLayersList"></div>
        </div>
      </details>
      <div class="cad-feature-tree" aria-label="Objetos por camada"></div>
    </aside>
    <button class="cad-panel-handle cad-panel-handle-left" id="cadLeftToggle" data-action="toggle-left-panel" type="button" aria-label="Recolher painel esquerdo" aria-expanded="true" title="Recolher painel esquerdo">‹</button>

    <main class="cad-canvas-container">
      <div class="cad-canvas-context">
        <div><span class="cad-context-label">Plano</span><strong>Vista principal</strong></div>
        <div class="cad-context-meta"><span id="cadEntityCount">0 objetos</span><span>mm</span></div>
      </div>
      <svg id="cadCanvas" aria-label="Área de desenho técnico 2D"></svg>
      <div id="cadDynamicInput" class="cad-dynamic-input" aria-live="polite"></div>

      <section class="cad-empty-state" id="cadEmptyState" aria-label="Começar desenho">
        <button class="cad-empty-dismiss" data-action="dismiss-empty-state" type="button" aria-label="Fechar introdução e usar o canvas" title="Fechar">×</button>
        <span class="cad-empty-kicker">Novo desenho mecânico</span>
        <h2>Comece com precisão</h2>
        <p>Use um modelo paramétrico ou inicie o traçado livre. Todas as medidas são armazenadas em milímetros.</p>
        <div class="cad-empty-actions">
          <button class="cad-start-card" data-action="tool-flange" data-tool="flange" type="button"><span>◎</span><strong>Flange</strong><small>Furação circular automática</small></button>
          <button class="cad-start-card" data-action="tool-shaft" data-tool="shaft" type="button"><span>⇥</span><strong>Eixo</strong><small>Trechos e diâmetros</small></button>
          <button class="cad-start-card" data-action="tool-line" data-tool="line" type="button"><span>／</span><strong>Desenho livre</strong><small>Linhas e coordenadas</small></button>
        </div>
        <p class="cad-empty-tip"><kbd>L</kbd> linha <kbd>C</kbd> círculo <kbd>F</kbd> flange <kbd>X</kbd> eixo</p>
      </section>
    </main>

    <aside class="cad-panel-right" id="cadRightPanel" aria-label="Inspetor do desenho">
      <div class="cad-inspector-head">
        <div><span>Paleta</span><strong>Propriedades</strong></div>
        <button class="cad-icon-btn" data-action="toggle-right-panel" type="button" aria-label="Recolher painel direito" title="Recolher painel direito">→</button>
      </div>

      <details class="cad-inspector-section" open>
        <summary>Objeto selecionado <span>Medidas e estilo</span></summary>
        <div class="cad-panel-content" id="cadProperties">
          <p class="cad-muted">Selecione um objeto para editar suas medidas e posição.</p>
        </div>
      </details>

      <details class="cad-inspector-section">
        <summary>Precisão 2D <span>Grade e snap</span></summary>
        <div class="cad-panel-content">
          <label class="cad-field"><span>Passo da grade (mm)</span><input class="cad-input" id="cadGridStepInput" type="number" min="0.001" step="0.001" value="20"></label>
          <label class="cad-field"><span>Incremento polar (F10)</span><select class="cad-select" id="cadPolarAngleInput"><option value="15">15°</option><option value="30">30°</option><option value="45" selected>45°</option><option value="60">60°</option><option value="90">90°</option></select></label>
          <div class="cad-snap-options" aria-label="Modos de snap">
            <label><input type="checkbox" data-snap-option="grid"> Grade</label>
            <label><input type="checkbox" data-snap-option="endpoint"> Extremidade</label>
            <label><input type="checkbox" data-snap-option="midpoint"> Meio</label>
            <label><input type="checkbox" data-snap-option="intersection"> Interseção</label>
            <label><input type="checkbox" data-snap-option="center"> Centro</label>
            <label><input type="checkbox" data-snap-option="quadrant"> Quadrante</label>
            <label><input type="checkbox" data-snap-option="nearest"> Próximo</label>
          </div>
          <p class="cad-precision-help">Coordenadas: <code>X,Y</code>, <code>@ΔX,ΔY</code> ou <code>@distância&lt;ângulo</code>. Vírgula decimal: <code>@12,5;8,25</code>. F3: snap · F8: ortho · F10: polar. Polilinha: C fecha, U desfaz vértice.</p>
        </div>
      </details>



      <details class="cad-inspector-section">
        <summary>Arquivo técnico <span>Identificação</span></summary>
        <div class="cad-panel-content cad-props-grid">
          <label class="cad-field"><span>Código</span><input class="cad-input" id="cadMetaCodigo" value="<%= desenho.codigo %>"></label>
          <label class="cad-field"><span>Título</span><input class="cad-input" id="cadMetaTitulo" value="<%= desenho.titulo %>"></label>
          <label class="cad-field"><span>Material</span><input class="cad-input" id="cadMetaMaterial" value="<%= desenho.material || '' %>" placeholder="Ex.: Aço SAE 1020"></label>
          <label class="cad-field"><span>Equipamento</span>
            <select class="cad-select" id="cadMetaEquipamento">
              <option value="">Sem vínculo</option>
              <% (equipamentos || []).forEach(eq => { %>
                <option value="<%= eq.id %>" <%= Number(desenho.equipamento_id) === Number(eq.id) ? 'selected' : '' %>><%= eq.codigo || '#' + eq.id %> — <%= eq.nome %></option>
              <% }) %>
            </select>
          </label>
          <label class="cad-field"><span>Observações de fabricação</span><textarea class="cad-input" id="cadMetaObservacoes" rows="3"><%= desenho.observacoes || '' %></textarea></label>
          <button class="cad-btn cad-btn-secondary cad-btn-block" id="cadMetaSaveBtn" data-action="save-metadata" type="button">Atualizar arquivo técnico</button>
        </div>
      </details>
    </aside>
    <button class="cad-panel-handle cad-panel-handle-right" id="cadRightToggle" data-action="toggle-right-panel" type="button" aria-label="Recolher painel direito" aria-expanded="true" title="Recolher painel direito">→</button>
  </div>

  <footer class="cad-statusbar" id="cadStatusBar">
    <div class="cad-command-wrap">
      <label class="cad-command-symbol" for="cadCommandInput">Comando</label>
      <input id="cadCommandInput" class="cad-command-input" type="text" autocomplete="off" spellcheck="false" placeholder="Digite um comando ou coordenada — L, C, M, @50,0" aria-label="Linha de comando CAD">
    </div>
    <div class="cad-status-message"><span id="cadStatusMessage">Inicializando…</span><span id="cadStatusTool">Ferramenta: Selecionar</span></div>
    <div class="cad-status-coordinates"><span id="cadStatusX">X: 0.00</span><span id="cadStatusY">Y: 0.00</span><span id="cadStatusZoom">Zoom: 100%</span><span id="cadStatusSelected">Selecionado: —</span></div>
    <div class="cad-status-right">
      <button class="cad-status-toggle active" data-toggle="grid" data-action="toggle-grid" type="button">GRID</button>
      <button class="cad-status-toggle active" data-toggle="snap" data-action="toggle-snap" type="button">SNAP</button>
      <button class="cad-status-toggle" data-toggle="ortho" data-action="toggle-ortho" type="button">ORTHO</button>
      <button class="cad-status-toggle" data-toggle="polar" data-action="toggle-polar" type="button" title="Rastreamento polar (F10)">POLAR</button>
    </div>
  </footer>

  <div class="cad-modal-overlay" id="cadFlangeModal" hidden>
    <form class="cad-modal" id="cadFlangeForm">
      <div class="cad-modal-header"><div><span class="cad-modal-kicker">Modelo paramétrico</span><h2>Flange circular</h2></div><button class="cad-modal-close" data-flange-close type="button" aria-label="Fechar">×</button></div>
      <div class="cad-modal-body">
        <div class="cad-modal-intro"><span class="cad-part-preview">◎</span><p>Informe as medidas de fabricação. O editor cria o contorno, furo central, círculo de furação, furos e linhas de centro.</p></div>
        <div class="cad-form-grid">
          <label class="cad-field"><span>Diâmetro externo (mm)</span><input class="cad-input" name="outerDiameter" type="number" min="0.001" step="0.001" value="200" required></label>
          <label class="cad-field"><span>Furo central (mm)</span><input class="cad-input" name="boreDiameter" type="number" min="0" step="0.001" value="60" required></label>
          <label class="cad-field"><span>Círculo de furação — PCD (mm)</span><input class="cad-input" name="pitchDiameter" type="number" min="0.001" step="0.001" value="150" required></label>
          <label class="cad-field"><span>Diâmetro dos furos (mm)</span><input class="cad-input" name="holeDiameter" type="number" min="0.001" step="0.001" value="18" required></label>
          <label class="cad-field"><span>Quantidade de furos</span><input class="cad-input" name="holeCount" type="number" min="2" max="72" step="1" value="8" required></label>
          <label class="cad-field"><span>Rotação inicial (graus)</span><input class="cad-input" name="rotation" type="number" step="0.001" value="0"></label>
          <label class="cad-field"><span>Espessura para 3D (mm, opcional)</span><input class="cad-input" name="thickness" type="number" min="0.001" max="1000000" step="0.001" placeholder="Sem espessura: desenho 2D"></label>
        </div>
        <p class="cad-form-error" data-flange-error role="alert"></p>
      </div>
      <div class="cad-modal-footer"><button class="cad-btn cad-btn-secondary" data-flange-close type="button">Cancelar</button><button class="cad-btn cad-btn-primary" type="submit">Continuar e posicionar</button></div>
    </form>
  </div>

  <div class="cad-modal-overlay" id="cadShaftModal" hidden>
    <form class="cad-modal cad-modal-wide" id="cadShaftForm">
      <div class="cad-modal-header"><div><span class="cad-modal-kicker">Modelo paramétrico</span><h2>Eixo escalonado</h2></div><button class="cad-modal-close" data-shaft-close type="button" aria-label="Fechar">×</button></div>
      <div class="cad-modal-body">
        <label class="cad-field cad-orientation-field"><span>Orientação</span><select class="cad-select" name="orientation"><option value="horizontal">Horizontal</option><option value="vertical">Vertical</option></select></label>
        <table class="cad-shaft-segments"><thead><tr><th>Trecho</th><th>Comprimento (mm)</th><th>Diâmetro (mm)</th><th></th></tr></thead><tbody data-shaft-rows></tbody></table>
        <button class="cad-shaft-add" data-shaft-add type="button">+ Adicionar trecho</button>
        <p class="cad-shaft-hint" style="margin:12px 0 4px;color:#94a3b8;font-size:12px">Informe somente comprimentos e diâmetros. Chanfros de representação serão desenhados nas extremidades; detalhes de furação/alojamento podem ser acrescentados posteriormente à prancha.</p>
        <p class="cad-form-error" data-shaft-error role="alert"></p>
      </div>
      <div class="cad-modal-footer"><button class="cad-btn cad-btn-secondary" data-shaft-close type="button">Cancelar</button><button class="cad-btn cad-btn-primary" type="submit">Continuar e posicionar</button></div>
    </form>
  </div>
</div>

<script>
window.CAD_INITIAL = {
  desenhoId: <%= desenho.id %>,
  canManage: <%= !!canManage %>,
  data: <%- JSON.stringify(cadData || { objects: [], dimensions: [], layers: {}, activeLayer: 'geometria_principal' }) %>
};
document.body.classList.add('cad-editor-mode');
window.addEventListener('error', function () {
  var status = document.getElementById('cadStatusMessage');
  if (status) status.textContent = 'CAD carregado com limitações (ver console).';
});
</script>
<script type="module" src="/js/cad-engine-v2.js?v=20261029-workspace-v1" onerror="(function(){var s=document.getElementById('cadStatusMessage'); if(s) s.textContent='Falha ao carregar o motor CAD.';})()"></script>

<style>body.cad-editor-mode { overflow: hidden; }</style>
