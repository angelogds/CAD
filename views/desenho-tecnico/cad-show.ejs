<% layout("layout") %>
<section class="card" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
  <h1><%= (desenho && desenho.codigo) || 'Sem código' %> - <%= (desenho && desenho.titulo) || 'Sem título' %> <span class="badge badge-cad">CAD</span></h1>
  <div style="display:flex;gap:8px;">
    <a class="btn" href="/desenho-tecnico">Voltar à Central de Desenhos</a>
  </div>
</section>

<section class="dt-editor">
  <article class="card dt-col">
    <h3>Dados do desenho</h3>
    <p><b>Tipo:</b> CAD Mecânico 2D</p>
    <p><b>Revisão:</b> R<%= (desenho && desenho.revisao) || 0 %></p>
    <p><b>Equipamento:</b> <%= (desenho && desenho.equipamento_nome) || '-' %></p>
    <p><b>Material:</b> <%= (desenho && desenho.material) || '-' %></p>
    <p><b>Status:</b> <%= (desenho && desenho.status) || '-' %></p>
    <p class="muted">A edição gráfica é feita exclusivamente pelo editor MLightCAD para perfis autorizados.</p>
  </article>
  <article class="card dt-col">
    <h3>Revisões e arquivos</h3>
    <% if (!(revisoes || []).length) { %>
      <p>Nenhuma revisão ou arquivo técnico gerado.</p>
    <% } else { %>
      <ul>
        <% (revisoes || []).forEach((r)=>{ %>
          <li><b><%= r.tipo_arquivo %></b> • R<%= r.revisao %></li>
        <% }) %>
      </ul>
    <% } %>
  </article>
</section>
