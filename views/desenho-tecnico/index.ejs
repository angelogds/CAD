<% layout("layout") %>
<link rel="stylesheet" href="/css/desenho-tecnico-central.css?v=20260819a">
<link rel="stylesheet" href="/css/desenho-tecnico-central-stabilization.css?v=20260821-ui-v1">

<%
  const stats = resumo || { total: 0, vinculados: 0, semVinculo: 0, comPdf: 0, recentes: 0 };
  const listaSegura = Array.isArray(lista) ? lista : [];
  const equipamentosSeguros = Array.isArray(equipamentos) ? equipamentos : [];
  const canDeleteResolved = Boolean(typeof canDelete !== 'undefined' && canDelete);
  const formatDate = (value) => {
    const raw = String(value || '').slice(0, 10);
    if (!raw) return '—';
    const parts = raw.split('-');
    return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : raw;
  };
%>

<section class="dtc-page">
  <header class="dtc-hero">
    <div class="dtc-hero-copy">
      <span class="dtc-eyebrow">ENGENHARIA DE MANUTENÇÃO</span>
      <h1>Central de Desenhos Técnicos</h1>
      <p>Crie, abra e organize desenhos mecânicos 2D vinculados aos equipamentos da fábrica.</p>
    </div>
    <div class="dtc-hero-actions">
      <% if (canDeleteResolved) { %>
        <a class="dtc-btn dtc-hero-secondary" href="/desenho-tecnico?status=INATIVO">Arquivados</a>
      <% } %>
      <% if (canManage) { %>
        <a class="dtc-btn dtc-btn-primary" href="/desenho-tecnico/cad/novo">
          <span aria-hidden="true">＋</span> NOVO CAD
        </a>
      <% } %>
    </div>
  </header>

  <div class="dtc-kpis" aria-label="Resumo dos desenhos técnicos">
    <article class="dtc-kpi">
      <span class="dtc-kpi-icon">▱</span>
      <div><strong><%= stats.total %></strong><span>Desenhos exibidos</span></div>
    </article>
    <article class="dtc-kpi">
      <span class="dtc-kpi-icon">⚙</span>
      <div><strong><%= stats.vinculados %></strong><span>Vinculados a equipamentos</span></div>
    </article>
    <article class="dtc-kpi">
      <span class="dtc-kpi-icon">⌁</span>
      <div><strong><%= stats.semVinculo %></strong><span>Sem vínculo técnico</span></div>
    </article>
    <article class="dtc-kpi">
      <span class="dtc-kpi-icon">PDF</span>
      <div><strong><%= stats.comPdf %></strong><span>Com PDF gerado</span></div>
    </article>
    <article class="dtc-kpi">
      <span class="dtc-kpi-icon">↻</span>
      <div><strong><%= stats.recentes %></strong><span>Atualizados em 30 dias</span></div>
    </article>
  </div>

  <form class="dtc-filters" method="GET" action="/desenho-tecnico">
    <div class="dtc-filter-main">
      <label class="dtc-field dtc-search">
        <span>Buscar desenho</span>
        <input type="search" name="q" placeholder="Código ou título do desenho" value="<%= filtros.q || '' %>">
      </label>
      <label class="dtc-field">
        <span>Equipamento</span>
        <select name="equipamento_id">
          <option value="">Todos os equipamentos</option>
          <% equipamentosSeguros.forEach((eq) => { %>
            <option value="<%= eq.id %>" <%= String(filtros.equipamento_id || '') === String(eq.id) ? 'selected' : '' %>>
              <%= eq.codigo ? `${eq.codigo} — ` : '' %><%= eq.nome %>
            </option>
          <% }) %>
        </select>
      </label>
      <label class="dtc-field">
        <span>Status</span>
        <select name="status">
          <option value="" <%= !filtros.status ? 'selected' : '' %>>Todos</option>
          <option value="ATIVO" <%= filtros.status === 'ATIVO' ? 'selected' : '' %>>Ativos</option>
          <option value="INATIVO" <%= filtros.status === 'INATIVO' ? 'selected' : '' %>>Arquivados</option>
        </select>
      </label>
    </div>
    <div class="dtc-filter-actions">
      <a class="dtc-btn dtc-btn-ghost" href="/desenho-tecnico?status=ATIVO">Limpar</a>
      <button class="dtc-btn dtc-btn-secondary" type="submit">Aplicar filtros</button>
    </div>
  </form>

  <section class="dtc-list-card">
    <div class="dtc-section-head">
      <div>
        <span class="dtc-eyebrow">ARQUIVO TÉCNICO</span>
        <h2><%= filtros.status === 'INATIVO' ? 'Desenhos arquivados' : 'Desenhos cadastrados' %></h2>
      </div>
      <span class="dtc-count"><%= listaSegura.length %> registro<%= listaSegura.length === 1 ? '' : 's' %></span>
    </div>

    <% if (!listaSegura.length) { %>
      <div class="dtc-empty">
        <span class="dtc-empty-icon">⌑</span>
        <h3>Nenhum desenho encontrado</h3>
        <p>Ajuste os filtros ou crie um novo desenho técnico 2D.</p>
        <% if (canManage) { %><a class="dtc-btn dtc-btn-primary" href="/desenho-tecnico/cad/novo">Criar novo CAD</a><% } %>
      </div>
    <% } else { %>
      <div class="dtc-table-wrap">
        <table class="dtc-table">
          <thead>
            <tr>
              <th>Desenho</th>
              <th>Equipamento</th>
              <th>Material</th>
              <th>Revisão</th>
              <th>Atualização</th>
              <th>Status</th>
              <th class="dtc-actions-col">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% listaSegura.forEach((d) => { %>
              <tr>
                <td data-label="Desenho">
                  <div class="dtc-drawing-id">
                    <span class="dtc-drawing-icon">⌗</span>
                    <div>
                      <strong><%= d.codigo || `CAD-${d.id}` %></strong>
                      <span><%= d.titulo %></span>
                    </div>
                  </div>
                </td>
                <td data-label="Equipamento">
                  <% if (d.equipamento_nome) { %>
                    <span class="dtc-equipment">⚙ <%= d.equipamento_nome %></span>
                  <% } else { %>
                    <span class="dtc-muted">Sem vínculo</span>
                  <% } %>
                </td>
                <td data-label="Material"><%= d.material || '—' %></td>
                <td data-label="Revisão"><span class="dtc-revision">REV. <%= Number(d.revisao || 0) %></span></td>
                <td data-label="Atualização"><%= formatDate(d.atualizado_em) %></td>
                <td data-label="Status">
                  <span class="dtc-status <%= String(d.status || 'ATIVO').toUpperCase() === 'ATIVO' ? 'is-active' : 'is-inactive' %>"><%= String(d.status || 'ATIVO').toUpperCase() === 'INATIVO' ? 'ARQUIVADO' : (d.status || 'ATIVO') %></span>
                </td>
                <td data-label="Ações" class="dtc-actions-col">
                  <div class="dtc-row-actions">
                    <% if (canManage && String(d.status || 'ATIVO').toUpperCase() !== 'INATIVO') { %>
                      <a class="dtc-action dtc-action-primary" href="/desenho-tecnico/cad/<%= d.id %>/editor">Abrir CAD</a>
                      <a class="dtc-action" href="/desenho-tecnico/cad/<%= d.id %>/pdf" target="_blank" rel="noopener">PDF</a>
                    <% } else if (!canManage) { %>
                      <a class="dtc-action" href="/desenho-tecnico/cad/<%= d.id %>">Detalhes</a>
                    <% } %>
                    <% if (canDeleteResolved && String(d.status || 'ATIVO').toUpperCase() !== 'INATIVO') { %>
                      <form method="POST" action="/desenho-tecnico/cad/<%= d.id %>/arquivar" onsubmit="return confirm('Remover <%= d.codigo || `CAD-${d.id}` %> da lista principal? Os dados serão preservados como arquivados.');">
                        <button class="dtc-action dtc-action-danger dtc-action-button" type="submit">Excluir</button>
                      </form>
                    <% } %>
                    <% if (String(d.status || '').toUpperCase() === 'INATIVO') { %>
                      <span class="dtc-archive-note">Arquivado</span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</section>
