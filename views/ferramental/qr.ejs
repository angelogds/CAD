<% layout('layout') %>
<link rel="stylesheet" href="/css/ferramental.css?v=20261007-v14" />

<%
  const item = ferramenta || {};
  const responsaveis = item.responsaveis || [];
  const statusLabel = String(item.status || '-').replaceAll('_',' ');
  const condicaoLabel = String(item.condicao || '-').replaceAll('_',' ');
  const hist = historico || { movimentacoes: [], ocorrencias: [] };
  const formatDateTime = (value) => value ? new Date(value).toLocaleString('pt-BR') : '-';
  const ocorrenciaAtiva = hist.ocorrencias.find(function(o){ return ['ABERTA','EM_ANALISE','EM_ACOMPANHAMENTO'].includes(o.status); });
  const insp = inspecao || { situation: 'SEM_PLANO', block: null, next: null, last: null };
%>

<div class="tool-qr-page">
  <section class="tool-panel tool-qr-card">
    <div class="tool-qr-card__head">
      <div>
        <span class="tool-eyebrow">FERRAMENTAL • IDENTIFICAÇÃO QR</span>
        <h1><%= item.codigo_interno %></h1>
        <p><%= item.descricao %></p>
      </div>
      <img
        class="tool-qr-image"
        src="/ferramental/ferramentas/<%= item.id %>/qrcode.png"
        alt="QR Code da ferramenta <%= item.codigo_interno %>"
      />
    </div>

    <div class="tool-qr-grid">
      <article><span>Status</span><strong><%= statusLabel %></strong></article>
      <article><span>Condição</span><strong><%= condicaoLabel %></strong></article>
      <article><span>Série</span><strong><%= item.numero_serie || '-' %></strong></article>
      <article><span>Patrimônio</span><strong><%= item.patrimonio || '-' %></strong></article>
      <article><span>Marca / modelo</span><strong><%= [item.marca,item.modelo].filter(Boolean).join(' • ') || '-' %></strong></article>
      <article><span>Local de guarda</span><strong><%= item.armario_codigo ? item.armario_codigo + ' / C' + item.compartimento_numero : '-' %></strong></article>
    </div>

    <div class="tool-qr-inspection <%= insp.situation === 'BLOQUEADA' || insp.situation === 'VENCIDA' ? 'is-danger' : insp.situation === 'A_VENCER' ? 'is-warning' : 'is-ok' %>">
      <span>Inspeção de segurança</span>
      <strong><%= String(insp.situation || 'SEM_PLANO').replaceAll('_',' ') %></strong>
      <% if (insp.block) { %><small><%= insp.block.motivo %> • NÃO USAR</small><% } %>
      <% if (!insp.block && insp.next) { %><small>Próxima inspeção: <%= new Date(insp.next.data_programada + 'T12:00:00').toLocaleDateString('pt-BR') %></small><% } %>
      <% if (insp.last) { %><small>Última: <%= insp.last.codigo %> • <%= String(insp.last.status || '').replaceAll('_',' ') %></small><% } %>
    </div>

    <div class="tool-qr-responsibility">
      <span>Responsáveis atuais</span>
      <strong><%= responsaveis.length ? responsaveis.map(function(m){ return m.name; }).join(' + ') : 'Sem custódia ativa' %></strong>
      <% if (item.equipe_codigo) { %><small><%= item.equipe_codigo %> • <%= item.equipe_nome %></small><% } %>
    </div>

    <% if (ocorrenciaAtiva) { %>
      <div class="tool-qr-alert">
        <span>Ocorrência em andamento</span>
        <strong><%= ocorrenciaAtiva.codigo %> • <%= ocorrenciaAtiva.tipo.replaceAll('_',' ') %></strong>
        <small><%= ocorrenciaAtiva.status.replaceAll('_',' ') %> • <%= ocorrenciaAtiva.descricao %></small>
      </div>
    <% } %>

    <section class="tool-qr-history">
      <div class="tool-panel-head"><div><span>V1.3</span><h2>Últimas movimentações</h2></div></div>
      <% if (!hist.movimentacoes.length) { %>
        <div class="tool-empty">Nenhuma movimentação registrada.</div>
      <% } else { %>
        <div class="tool-mini-timeline">
          <% hist.movimentacoes.slice(0,8).forEach(function(move){ %>
            <div><span><%= formatDateTime(move.created_at) %></span><strong><%= String(move.tipo || '-').replaceAll('_',' ') %></strong><small><%= move.observacao || move.destino_descricao || '' %></small></div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <div class="tool-head-actions">
      <a class="ui-btn ui-btn--outline" href="/meu-portal/ferramental">Meu Ferramental</a>
      <a class="ui-btn ui-btn--outline" href="/pcm/ferramental">Gestão PCM</a>
    </div>
  </section>
</div>
