<% layout('layout') %>
<%- include('../pcm/partials/internal-styles') %>
<link rel="stylesheet" href="/css/ferramental.css?v=20261007-v13" />

<%
  const data = ferramental || { resumo: {}, usuarios: [], equipes: [], armarios: [], ferramentas: [] };
  const r = data.resumo || {};
  const aceiteData = data.aceites || { resumo: {}, porCustodia: [], recentes: [] };
  const inventarioData = data.inventarios || { resumo: {}, inventories: [], divergencias: [] };
  const inventarioResumo = inventarioData.resumo || {};
  const ocorrenciaData = data.ocorrencias || { resumo: {}, abertas: [], recentes: [] };
  const ocorrenciaResumo = ocorrenciaData.resumo || {};
  const aceiteResumo = aceiteData.resumo || {};
  const aceitePorCustodia = new Map((aceiteData.porCustodia || []).map(function(a){ return [Number(a.custodia_id), a]; }));
  const formatDateTime = (value) => value ? new Date(value).toLocaleString('pt-BR') : '-';
  const fmtStatus = (value) => ({
    DISPONIVEL: 'Disponível',
    EM_RESPONSABILIDADE: 'Em responsabilidade',
    EM_MANUTENCAO: 'Em manutenção',
    DANIFICADA: 'Danificada',
    EXTRAVIADA: 'Extraviada',
    BAIXADA: 'Baixada'
  }[String(value || '').toUpperCase()] || value || '-');
%>

<div class="tool-page">
  <header class="tool-head">
    <div>
      <span class="tool-eyebrow">PCM • CONTROLE DE CUSTÓDIA</span>
      <h1>Gestão de Ferramental</h1>
      <p>Cadastre ferramentas, defina um ou dois responsáveis e registre o armário onde cada item deve permanecer.</p>
    </div>
    <a class="ui-btn ui-btn--outline" href="/pcm">Voltar ao PCM</a>
  </header>

  <div class="pcm-shell">
    <%- include('../pcm/partials/internal-nav', { activePcmSection: 'ferramental' }) %>
    <main class="pcm-content tool-content">
      <section class="tool-kpis" aria-label="Resumo do ferramental">
        <article><span>Ferramentas</span><strong><%= r.ferramentas || 0 %></strong><small>Total cadastrado</small></article>
        <article><span>Sob responsabilidade</span><strong><%= r.sobResponsabilidade || 0 %></strong><small>Custódia ativa</small></article>
        <article><span>Disponíveis</span><strong><%= r.disponiveis || 0 %></strong><small>Sem custódia ativa</small></article>
        <article><span>Grupos</span><strong><%= r.equipes || 0 %></strong><small>1 ou 2 responsáveis</small></article>
        <article><span>Armários</span><strong><%= r.armarios || 0 %></strong><small>8 compartimentos cada</small></article>
        <article><span>Aceites pendentes</span><strong><%= aceiteResumo.pendentes || 0 %></strong><small>Aguardando responsáveis</small></article>
        <article><span>Divergências</span><strong><%= aceiteResumo.recusados || 0 %></strong><small>Revisar no PCM</small></article>
        <article><span>Conferências abertas</span><strong><%= inventarioResumo.abertos || 0 %></strong><small>Inventário periódico</small></article>
        <article><span>Ocorrências</span><strong><%= ocorrenciaResumo.pendentes || 0 %></strong><small>Aguardando PCM</small></article>
        <article><span>Em manutenção</span><strong><%= ocorrenciaResumo.acompanhamento || 0 %></strong><small>Ocorrências acompanhadas</small></article>
      </section>

      <section class="tool-grid">
        <article class="tool-panel" id="responsaveis">
          <div class="tool-panel-head"><div><span>01</span><h2>Responsáveis</h2></div><small>Um ou dois colaboradores</small></div>
          <form method="POST" action="/pcm/ferramental/equipes" class="tool-form">
            <label>Nome do grupo <input name="nome" maxlength="120" placeholder="Ex.: Equipe Diogo + Emanuel" /></label>
            <label>Responsável 1
              <select name="responsavel_1" required>
                <option value="">Selecione</option>
                <% data.usuarios.forEach(function(user){ %><option value="<%= user.id %>"><%= user.name %></option><% }) %>
              </select>
            </label>
            <label>Responsável 2
              <select name="responsavel_2">
                <option value="">Sem segundo responsável</option>
                <% data.usuarios.forEach(function(user){ %><option value="<%= user.id %>"><%= user.name %></option><% }) %>
              </select>
            </label>
            <button class="ui-btn ui-btn--primary" type="submit">Criar responsabilidade</button>
          </form>
        </article>

        <article class="tool-panel" id="armarios">
          <div class="tool-panel-head"><div><span>02</span><h2>Armários</h2></div><small>8 compartimentos</small></div>
          <form method="POST" action="/pcm/ferramental/armarios" class="tool-form">
            <label>Colaborador
              <select name="owner_user_id" required>
                <option value="">Selecione</option>
                <% data.usuarios.forEach(function(user){ %><option value="<%= user.id %>"><%= user.name %></option><% }) %>
              </select>
            </label>
            <label>Código <input name="codigo" maxlength="40" placeholder="Automático: ARM-001" /></label>
            <label>Nome <input name="nome" maxlength="120" placeholder="Ex.: Armário Diogo" /></label>
            <p class="tool-help">Compartimentos 1–4: pessoal. Compartimentos 5–8: ferramental.</p>
            <button class="ui-btn ui-btn--primary" type="submit">Cadastrar armário</button>
          </form>
        </article>
      </section>

      <section class="tool-grid">
        <article class="tool-panel" id="ferramentas">
          <div class="tool-panel-head"><div><span>03</span><h2>Nova ferramenta</h2></div><small>Identificação única</small></div>
          <form method="POST" action="/pcm/ferramental/ferramentas" class="tool-form tool-form--two">
            <label class="tool-span-2">Descrição <input name="descricao" maxlength="180" required placeholder="Ex.: Lixadeira 4½ pol." /></label>
            <label>Categoria <input name="categoria" maxlength="80" placeholder="Elétrica, manual..." /></label>
            <label>Código interno <input name="codigo_interno" maxlength="50" placeholder="Automático: MNT-FER-0001" /></label>
            <label>Marca <input name="marca" maxlength="80" /></label>
            <label>Modelo <input name="modelo" maxlength="100" /></label>
            <label>Nº de série <input name="numero_serie" maxlength="120" /></label>
            <label>Patrimônio <input name="patrimonio" maxlength="80" /></label>
            <label>Condição
              <select name="condicao">
                <option value="BOA">Boa</option>
                <option value="NOVA">Nova</option>
                <option value="USADA">Usada</option>
                <option value="COM_DESGASTE">Com desgaste</option>
                <option value="DANIFICADA">Danificada</option>
              </select>
            </label>
            <label class="tool-span-2">Observação <textarea name="observacao" maxlength="600" rows="3"></textarea></label>
            <button class="ui-btn ui-btn--primary tool-span-2" type="submit">Cadastrar ferramenta</button>
          </form>
        </article>

        <article class="tool-panel" id="custodia">
          <div class="tool-panel-head"><div><span>04</span><h2>Entregar / vincular</h2></div><small>Custódia + local</small></div>
          <form method="POST" action="/pcm/ferramental/custodias" class="tool-form">
            <label>Ferramenta
              <select name="ferramenta_id" required>
                <option value="">Selecione</option>
                <% data.ferramentas.forEach(function(item){ const aceite = aceitePorCustodia.get(Number(item.custodia_id)); %><option value="<%= item.id %>"><%= item.codigo_interno %> — <%= item.descricao %></option><% }) %>
              </select>
            </label>
            <label>Responsáveis
              <select name="equipe_id" required>
                <option value="">Selecione</option>
                <% data.equipes.forEach(function(team){ %><option value="<%= team.id %>"><%= team.codigo %> — <%= team.membros.map(function(m){return m.name;}).join(' + ') %></option><% }) %>
              </select>
            </label>
            <label>Armário / compartimento inferior
              <select name="compartimento_id" required>
                <option value="">Selecione</option>
                <% data.armarios.forEach(function(locker){ locker.compartimentos.filter(function(c){ return c.finalidade === 'FERRAMENTAL'; }).forEach(function(c){ %>
                  <option value="<%= c.id %>"><%= locker.codigo %> — <%= locker.responsavel_nome %> — Compartimento <%= c.numero %></option>
                <% }); }); %>
              </select>
            </label>
            <label>Observação <textarea name="observacao" maxlength="600" rows="3" placeholder="Estado da entrega ou referência adicional"></textarea></label>
            <p class="tool-help">Para ferramenta compartilhada, o armário escolhido precisa pertencer a um dos responsáveis do grupo.</p>
            <button class="ui-btn ui-btn--primary" type="submit">Registrar responsabilidade</button>
          </form>
        </article>
      </section>


      <section class="tool-panel" id="conferencias">
        <div class="tool-panel-head">
          <div><span>V1.2</span><h2>Conferência periódica</h2><p>Crie um ciclo para a equipe conferir individualmente todo o ferramental em custódia.</p></div>
          <small><%= inventarioResumo.abertos || 0 %> aberta(s)</small>
        </div>

        <div class="tool-grid tool-grid--inventory">
          <form method="POST" action="/pcm/ferramental/inventarios" class="tool-form tool-inventory-create">
            <label>Equipe
              <select name="equipe_id" required>
                <option value="">Selecione</option>
                <% data.equipes.forEach(function(team){ %>
                  <option value="<%= team.id %>"><%= team.codigo %> — <%= team.membros.map(function(m){return m.name;}).join(' + ') %></option>
                <% }) %>
              </select>
            </label>
            <label>Título
              <input name="titulo" maxlength="140" placeholder="Ex.: Conferência semanal do ferramental" />
            </label>
            <label>Data limite
              <input name="data_limite" type="date" />
            </label>
            <label>Orientação
              <textarea name="observacao" maxlength="800" rows="3" placeholder="Opcional: observação para a equipe"></textarea>
            </label>
            <button class="ui-btn ui-btn--primary" type="submit">Iniciar conferência</button>
          </form>

          <div class="tool-inventory-list">
            <% if (!(inventarioData.inventories || []).length) { %>
              <div class="tool-empty">Nenhuma conferência periódica criada.</div>
            <% } %>
            <% (inventarioData.inventories || []).forEach(function(inv){ const total=Number(inv.total_itens||0); const done=Number(inv.conferidos||0); const pct=total ? Math.round(done*100/total) : 0; %>
              <article class="tool-inventory-row">
                <div>
                  <strong><%= inv.codigo %> — <%= inv.titulo %></strong>
                  <span><%= inv.equipe_codigo %> • <%= inv.equipe_nome %></span>
                  <small><%= done %>/<%= total %> conferência(ões) • <%= inv.divergencias || 0 %> divergência(s)<%= inv.data_limite ? ' • Limite: ' + new Date(inv.data_limite + 'T12:00:00').toLocaleDateString('pt-BR') : '' %></small>
                </div>
                <div class="tool-inventory-progress">
                  <span><i style="width:<%= pct %>%"></i></span>
                  <strong><%= pct %>%</strong>
                  <em class="tool-badge <%= inv.status === 'ABERTO' ? 'tool-badge--pending' : 'tool-badge--accepted' %>"><%= inv.status %></em>
                </div>
              </article>
            <% }) %>
          </div>
        </div>

        <% if ((inventarioData.divergencias || []).length) { %>
          <div class="tool-inventory-alerts">
            <strong>Divergências encontradas nas conferências</strong>
            <% inventarioData.divergencias.forEach(function(item){ %>
              <div><span><%= item.inventario_codigo %> • <%= item.codigo_interno %> — <%= item.descricao %></span><b><%= item.situacao.replaceAll('_',' ') %></b><small><%= item.usuario_nome %><%= item.observacao ? ' • ' + item.observacao : '' %></small></div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="tool-panel">
        <div class="tool-panel-head"><div><span>GRUPOS</span><h2>Responsabilidades ativas</h2></div></div>
        <% if (!data.equipes.length) { %>
          <div class="tool-empty">Nenhum grupo de responsabilidade cadastrado.</div>
        <% } else { %>
          <div class="tool-team-grid">
            <% data.equipes.forEach(function(team){ %>
              <article class="tool-team-card">
                <div><strong><%= team.codigo %></strong><span><%= team.membros.map(function(m){return m.name;}).join(' + ') %></span><small><%= team.total_ferramentas || 0 %> ferramenta(s)</small></div>
                <a class="ui-btn ui-btn--outline ui-btn--compact" href="/pcm/ferramental/equipes/<%= team.id %>/pdf" target="_blank">Ficha PDF</a>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>


      <section class="tool-panel" id="aceites">
        <div class="tool-panel-head">
          <div><span>V1.1</span><h2>Aceites e divergências</h2><p>Acompanhamento individual por responsável.</p></div>
          <small><%= aceiteResumo.total || 0 %> registro(s) ativos</small>
        </div>
        <% if (!(aceiteData.recentes || []).length) { %>
          <div class="tool-empty">Nenhum aceite registrado para custódias ativas.</div>
        <% } else { %>
          <div class="tool-accept-admin-list">
            <% aceiteData.recentes.forEach(function(item){ %>
              <article class="tool-accept-admin-row">
                <div>
                  <strong><%= item.codigo_interno %> — <%= item.descricao %></strong>
                  <span><%= item.usuario_nome %></span>
                  <% if (item.observacao) { %><small><%= item.observacao %></small><% } %>
                </div>
                <div class="tool-accept-admin-status">
                  <span class="tool-badge <%= item.status === 'ACEITO' ? 'tool-badge--accepted' : item.status === 'RECUSADO' ? 'tool-badge--rejected' : 'tool-badge--pending' %>"><%= item.status %></span>
                  <small><%= formatDateTime(item.confirmado_em || item.recusado_em) %></small>
                  <% if (item.status === 'ACEITO') { %>
                    <div class="tool-evidence-links">
                      <a href="/pcm/ferramental/aceites/<%= item.id %>/evidencia/selfie" target="_blank">Selfie</a>
                      <a href="/pcm/ferramental/aceites/<%= item.id %>/evidencia/assinatura" target="_blank">Assinatura</a>
                    </div>
                  <% } %>
                  <% if (item.status === 'RECUSADO') { %>
                    <form class="tool-resolve-form" method="POST" action="/pcm/ferramental/aceites/<%= item.id %>/resolver">
                      <textarea name="observacao" maxlength="800" rows="2" required placeholder="Descreva a correção realizada"></textarea>
                      <button class="ui-btn ui-btn--outline ui-btn--compact" type="submit">Tratar e reabrir aceite</button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>


      <section class="tool-panel tool-occurrence-panel" id="ocorrencias">
        <div class="tool-panel-head">
          <div><span>V1.3</span><h2>Ocorrências e ciclo de vida</h2><p>Trate devoluções, manutenção, dano, extravio e transferência sem apagar a responsabilidade anterior.</p></div>
          <small><%= (ocorrenciaResumo.pendentes || 0) + (ocorrenciaResumo.acompanhamento || 0) %> em andamento</small>
        </div>

        <% if (!(ocorrenciaData.abertas || []).length) { %>
          <div class="tool-empty">Nenhuma ocorrência em andamento.</div>
        <% } else { %>
          <div class="tool-occurrence-list">
            <% ocorrenciaData.abertas.forEach(function(occ){ %>
              <article class="tool-occurrence-card">
                <div class="tool-occurrence-card__info">
                  <span><%= occ.codigo %> • <%= occ.tipo.replaceAll('_',' ') %></span>
                  <strong><%= occ.codigo_interno %> — <%= occ.ferramenta_descricao %></strong>
                  <small>Aberta por <%= occ.aberta_por_nome %> • <%= formatDateTime(occ.created_at) %><%= occ.equipe_codigo ? ' • ' + occ.equipe_codigo : '' %></small>
                  <p><%= occ.descricao %></p>
                  <% if (occ.status === 'EM_ACOMPANHAMENTO' && occ.resolucao) { %>
                    <em>Último tratamento: <%= occ.resolucao %></em>
                  <% } %>
                </div>

                <form method="POST" action="/pcm/ferramental/ocorrencias/<%= occ.id %>/resolver" class="tool-occurrence-resolve">
                  <label>Ação do PCM
                    <select name="acao" required>
                      <option value="">Selecione</option>
                      <% if (occ.status === 'EM_ACOMPANHAMENTO') { %>
                        <option value="RETORNAR_DISPONIVEL">Retornar da manutenção → disponível</option>
                        <option value="MARCAR_DANIFICADA">Retornar como danificada</option>
                        <option value="BAIXAR">Baixar ferramenta</option>
                      <% } else { %>
                        <option value="DEVOLVER_DISPONIVEL">Confirmar devolução → disponível</option>
                        <option value="ENVIAR_MANUTENCAO">Enviar para manutenção</option>
                        <option value="MARCAR_DANIFICADA">Marcar como danificada</option>
                        <option value="MARCAR_EXTRAVIADA">Marcar como extraviada</option>
                        <option value="TRANSFERIR">Transferir responsabilidade</option>
                        <option value="BAIXAR">Baixar ferramenta</option>
                        <option value="SEM_ACAO">Encerrar sem alterar custódia</option>
                        <option value="CANCELAR">Cancelar ocorrência</option>
                      <% } %>
                    </select>
                  </label>

                  <div class="tool-occurrence-transfer-fields">
                    <label>Equipe de destino
                      <select name="equipe_id">
                        <option value="">Somente para transferência</option>
                        <% data.equipes.forEach(function(team){ %>
                          <option value="<%= team.id %>"><%= team.codigo %> — <%= team.membros.map(function(m){ return m.name; }).join(' + ') %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label>Armário / compartimento
                      <select name="compartimento_id">
                        <option value="">Somente para transferência</option>
                        <% data.armarios.forEach(function(locker){ locker.compartimentos.filter(function(c){ return c.finalidade === 'FERRAMENTAL'; }).forEach(function(c){ %>
                          <option value="<%= c.id %>"><%= locker.codigo %> — <%= locker.responsavel_nome %> — C<%= c.numero %></option>
                        <% }); }); %>
                      </select>
                    </label>
                  </div>

                  <% if (occ.status === 'EM_ACOMPANHAMENTO') { %>
                    <label>Condição no retorno
                      <select name="condicao_retorno">
                        <option value="">Manter condição atual</option>
                        <option value="NOVA">Nova</option>
                        <option value="BOA">Boa</option>
                        <option value="USADA">Usada</option>
                        <option value="COM_DESGASTE">Com desgaste</option>
                        <option value="DANIFICADA">Danificada</option>
                      </select>
                    </label>
                  <% } %>
                  <label>Decisão / serviço executado
                    <textarea name="resolucao" maxlength="1000" rows="3" required placeholder="Descreva o que foi verificado e a decisão tomada"></textarea>
                  </label>
                  <button class="ui-btn ui-btn--primary" type="submit">Registrar tratamento</button>
                </form>
              </article>
            <% }) %>
          </div>
        <% } %>

        <% if ((ocorrenciaData.recentes || []).length) { %>
          <details class="tool-occurrence-history-summary">
            <summary>Ver ocorrências recentes</summary>
            <div>
              <% ocorrenciaData.recentes.slice(0,15).forEach(function(occ){ %>
                <span><strong><%= occ.codigo %></strong> • <%= occ.codigo_interno %> • <%= occ.tipo.replaceAll('_',' ') %> • <%= occ.status.replaceAll('_',' ') %> • <%= occ.aberta_por_nome %></span>
              <% }) %>
            </div>
          </details>
        <% } %>
      </section>

      <section class="tool-panel">
        <div class="tool-panel-head"><div><span>INVENTÁRIO</span><h2>Ferramentas cadastradas</h2></div><small>Uma ferramenta física = um cadastro</small></div>
        <div class="tool-table-wrap">
          <table class="tool-table">
            <thead><tr><th>ID interno</th><th>Ferramenta</th><th>Série / patrimônio</th><th>Condição</th><th>Status</th><th>Responsáveis</th><th>Local de guarda</th><th>Aceite</th><th>QR / histórico</th></tr></thead>
            <tbody>
              <% if (!data.ferramentas.length) { %><tr><td colspan="9" class="tool-empty">Nenhuma ferramenta cadastrada.</td></tr><% } %>
              <% data.ferramentas.forEach(function(item){ const aceite = aceitePorCustodia.get(Number(item.custodia_id)); %>
                <tr>
                  <td><strong><%= item.codigo_interno %></strong></td>
                  <td><strong><%= item.descricao %></strong><small><%= [item.marca,item.modelo].filter(Boolean).join(' • ') || item.categoria || '-' %></small></td>
                  <td><%= item.numero_serie || '-' %><small><%= item.patrimonio ? 'Patrimônio: ' + item.patrimonio : '' %></small></td>
                  <td><%= String(item.condicao || '').replaceAll('_',' ') %></td>
                  <td><span class="tool-badge"><%= fmtStatus(item.status) %></span></td>
                  <td><%= item.responsaveis.length ? item.responsaveis.map(function(m){return m.name;}).join(' + ') : 'Disponível' %></td>
                  <td><%= item.armario_codigo ? item.armario_codigo + ' / C' + item.compartimento_numero : '-' %><small><%= item.armario_responsavel || '' %></small></td>
                  <td>
                    <% if (!item.custodia_id) { %>
                      <span class="tool-badge">Sem custódia</span>
                    <% } else if (aceite && Number(aceite.recusados || 0) > 0) { %>
                      <span class="tool-badge tool-badge--rejected">DIVERGÊNCIA</span>
                      <small><%= aceite.aceitos || 0 %>/<%= aceite.total || 0 %> confirmado(s)</small>
                    <% } else if (aceite && Number(aceite.pendentes || 0) > 0) { %>
                      <span class="tool-badge tool-badge--pending">PENDENTE</span>
                      <small><%= aceite.aceitos || 0 %>/<%= aceite.total || 0 %> confirmado(s)</small>
                    <% } else if (aceite && Number(aceite.total || 0) > 0) { %>
                      <span class="tool-badge tool-badge--accepted">CONFIRMADO</span>
                      <small><%= aceite.aceitos || 0 %>/<%= aceite.total || 0 %> responsável(is)</small>
                    <% } else { %>
                      <span class="tool-badge">Sem aceite</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (item.qr_token) { %>
                      <a class="tool-qr-link" href="/ferramental/qr/<%= item.qr_token %>" target="_blank">Abrir QR</a>
                      <a class="tool-qr-link" href="/pcm/ferramental/ferramentas/<%= item.id %>/etiqueta-pdf" target="_blank">Etiqueta PDF</a>
                      <a class="tool-qr-link" href="/pcm/ferramental/ferramentas/<%= item.id %>/historico">Histórico</a>
                    <% } else { %>-<% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</div>
