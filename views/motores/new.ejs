<% layout('layout') %>
<link rel="stylesheet" href="/css/motores.css?v=20260919-motores-v2" />

<main class="mot-page">
  <header class="mot-hero">
    <div>
      <span class="mot-eyebrow">MOTORES • CADASTRO TÉCNICO</span>
      <h1>Cadastrar motor</h1>
      <p>Cadastre somente os dados essenciais agora. Local, situação e observações podem ser atualizados pelo fluxo operacional depois.</p>
    </div>
    <div class="mot-actions">
      <a class="ui-btn ui-btn--secondary" href="/motores">Voltar</a>
    </div>
  </header>

  <section class="mot-panel">
    <form method="POST" action="/motores" class="mot-form">
      <div class="mot-form-section">
        <h3>Identificação</h3>
        <p>Dados usados para localizar o motor no parque e no estoque de reserva.</p>
        <div class="mot-form-grid">
          <label>
            <span>Código / patrimônio</span>
            <input class="input" name="codigo" placeholder="Ex.: MTR-001">
          </label>
          <label>
            <span>Descrição *</span>
            <input class="input" name="descricao" required placeholder="Ex.: Motor 5 CV • 1700 RPM">
          </label>
          <label>
            <span>Origem</span>
            <select class="input" name="origem_unidade">
              <option value="RECICLAGEM">Reciclagem</option>
              <option value="FRIGORIFICO">Frigorífico</option>
            </select>
          </label>
          <label>
            <span>Status inicial</span>
            <select class="input" name="status">
              <option value="EM_USO">Em uso</option>
              <option value="RESERVA">Reserva</option>
              <option value="RETORNOU">Retornou do rebobinamento</option>
              <option value="ENVIADO_REBOB">Enviado para rebobinamento</option>
            </select>
          </label>
        </div>
      </div>

      <div class="mot-form-section">
        <h3>Especificação elétrica/mecânica</h3>
        <p>Informações básicas para identificação rápida e substituição do motor.</p>
        <div class="mot-form-grid">
          <label>
            <span>Potência (CV)</span>
            <input class="input" name="potencia_cv" type="number" min="0" step="0.1" placeholder="5">
          </label>
          <label>
            <span>RPM</span>
            <input class="input" name="rpm" type="number" min="0" step="1" placeholder="1700">
          </label>
          <label class="is-wide">
            <span>Local de instalação</span>
            <input class="input" name="local_instalacao" placeholder="Ex.: Rosca 02, Caldeira 1, Digestor 3...">
          </label>
        </div>
      </div>

      <div class="mot-form-section">
        <h3>Observações</h3>
        <p>Registre alguma condição relevante conhecida no momento do cadastro.</p>
        <div class="mot-form-grid">
          <label class="is-wide">
            <span>Observação</span>
            <textarea class="input" name="observacao" rows="4" placeholder="Detalhes adicionais do motor..."></textarea>
          </label>
        </div>
      </div>

      <div class="mot-form-actions">
        <a class="ui-btn ui-btn--secondary" href="/motores">Cancelar</a>
        <button class="ui-btn ui-btn--primary" type="submit">Salvar motor</button>
      </div>
    </form>
  </section>
</main>
