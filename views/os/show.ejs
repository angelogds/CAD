<% layout('layout') %>
<link rel="stylesheet" href="/css/os-detail.css" />
<%
  const rawStatus = String(os.status || '').trim().toUpperCase().replace(/[\s-]+/g, '_');
  const statusAliases = { EM_ANDAMENTO: 'ANDAMENTO', FINALIZADA: 'FECHADA', FINALIZADO: 'FECHADA', CONCLUIDA: 'FECHADA', CONCLUÍDA: 'FECHADA' };
  const statusKey = statusAliases[rawStatus] || rawStatus || 'ABERTA';
  const statusMetaMap = {
    ABERTA: { label: 'ABERTA', phase: 'open', action: 'Iniciar OS' },
    AGUARDANDO_EQUIPE: { label: 'AGUARDANDO EQUIPE', phase: 'open', action: 'Iniciar OS' },
    ANDAMENTO: { label: 'EM ANDAMENTO', phase: 'running', action: 'Pausar OS' },
    PAUSADA: { label: 'PAUSADA', phase: 'paused', action: 'Retomar OS' },
    AGUARDANDO_MATERIAL: { label: 'AGUARDANDO MATERIAL', phase: 'material', action: 'Registrar chegada do material' },
    FECHADA: { label: 'CONCLUÍDA', phase: 'closed', action: null }
  };
  const statusMeta = statusMetaMap[statusKey] || { label: statusKey.replace(/_/g, ' '), phase: 'open', action: 'Iniciar OS' };
  const isOSFechada = statusMeta.phase === 'closed';
  const canConcluir = ['running', 'paused', 'material'].includes(statusMeta.phase) && canExecuteOS;
  const osStatus = statusMeta.label;
  const osPrioridade = String(os.grau || '-').toUpperCase();
  const equipePrincipal = [os.executor_nome || os.execucao_ativa?.executor_nome, os.auxiliar_nome || os.execucao_ativa?.auxiliar_nome].filter(Boolean);
  const initials = (name) => { const parts = String(name || '').trim().split(/\s+/).filter(Boolean); return parts.length ? (parts[0][0] + (parts.length > 1 ? parts[1][0] : '')).toLocaleUpperCase('pt-BR') : '—'; };
  const linkedRequest = chatResumo && chatResumo.solicitacao && Number(chatResumo.solicitacao.id) > 0 ? chatResumo.solicitacao : null;
  const openedAt = os.opened_at || os.data_abertura || os.created_at || '';
  const startedAt = os.data_inicio || os.execucao_iniciada_em || '';
  const closedAt = os.data_conclusao || os.closed_at || os.data_fim || '';
%>
<section class="os-page" data-os-status="<%= statusKey %>">
  <header class="os-hero">
    <div class="os-heading">
      <div class="os-title-row"><h1>OS #<%= os.id %> <span aria-hidden="true">·</span> <%= os.equipamento_resolvido || 'Equipamento' %></h1><span class="os-badge os-badge-status status-<%= statusMeta.phase %>"><%= osStatus %></span><span class="os-badge os-badge-priority"><%= osPrioridade %></span><span class="os-badge os-badge-type"><%= String(os.tipo || 'Corretiva').toUpperCase() %></span></div>
      <p class="os-description" id="os-description"><%= os.descricao || 'Sem descrição informada.' %></p><button type="button" class="os-description-more" aria-controls="os-description" aria-expanded="false">Ver mais</button>
    </div>
    <div class="os-actions">
      <% if (canExecuteOS && statusMeta.phase === 'open') { %><form method="POST" action="/os/<%= os.id %>/iniciar"><button class="btn btn-primary" type="submit">Iniciar OS</button></form><% } %>
      <% if (canExecuteOS && statusMeta.phase === 'running') { %><form method="POST" action="/os/<%= os.id %>/pausar"><button class="btn btn-outline" type="submit">Pausar OS</button></form><% } %>
      <% if (canExecuteOS && statusMeta.phase === 'paused') { %><form method="POST" action="/os/<%= os.id %>/iniciar"><button class="btn btn-primary" type="submit">Retomar OS</button></form><% } %>
      <% if (canRegisterAndamento && statusMeta.phase === 'material') { %><form method="POST" action="/os/<%= os.id %>/material-chegou"><button class="btn btn-primary" type="submit">Registrar chegada do material</button></form><% } %>
      <a class="btn btn-outline" href="/chat-os/<%= os.id %>">Abrir conversa</a>
      <% if (canExecuteOS) { %><form method="POST" action="/os/<%= os.id %>/pdf-institucional"><button class="btn btn-outline" type="submit">PDF da OS</button></form><% } %>
      <div class="os-menu-wrap" id="os-menu-wrap"><button class="btn btn-outline os-menu-btn" type="button" id="os-menu-btn" aria-expanded="false" aria-controls="os-menu-panel">Mais ações</button><div class="os-menu-panel" id="os-menu-panel"><div class="os-menu-list"><% if (!isOSFechada && os.equipamento_id) { %><a class="btn btn-outline" href="/tracagem?os_id=<%= os.id %>&amp;equipamento_id=<%= os.equipamento_id %>">Criar traçagem vinculada</a><% } %><% if (canAutoAssign && !isOSFechada) { %><button class="btn btn-outline" type="button" data-os-module="redistribuicao-equipe">Redistribuição da equipe</button><% } %><% if (canSendWhatsappNotification) { %><button class="btn btn-outline" type="button" data-os-module="whatsapp-os">Diagnóstico da integração WhatsApp</button><% } %><% if (!isOSFechada) { %><button class="btn btn-outline" type="button" data-os-module="justificativa-andamento">Justificativa técnica</button><% } %><% if (documentoInstitucional && documentoInstitucional.pdf_url) { %><a class="btn btn-outline" href="<%= documentoInstitucional.pdf_url %>" target="_blank" rel="noopener">Baixar PDF OS</a><% } %></div></div></div>
      <a class="btn btn-outline" href="/os">Voltar</a>
    </div>
  </header>

  <div class="os-progress" aria-label="Progresso da ordem de serviço">
    <div class="os-step <%= statusMeta.phase === 'open' ? 'current' : 'complete' %>"><span class="os-step-dot">1</span><div><strong>Aberta</strong><small><%= openedAt ? fmtBR(openedAt) : 'Data não informada' %></small></div></div><span class="os-step-line <%= statusMeta.phase !== 'open' ? 'active' : '' %>"></span>
    <div class="os-step <%= ['running','paused','material'].includes(statusMeta.phase) ? 'current warning-' + statusMeta.phase : (isOSFechada ? 'complete' : '') %>"><span class="os-step-dot">2</span><div><strong>Em andamento<%= statusMeta.phase === 'paused' ? ' — pausada' : statusMeta.phase === 'material' ? ' — aguardando material' : '' %></strong><small><%= statusMeta.phase === 'open' ? 'Ainda não iniciada' : (startedAt ? ('Desde ' + fmtBR(startedAt)) : (isOSFechada ? 'Início não informado' : 'Início não informado')) %></small></div></div><span class="os-step-line <%= isOSFechada ? 'active' : '' %>"></span>
    <div class="os-step <%= isOSFechada ? 'current' : '' %>"><span class="os-step-dot">3</span><div><strong>Concluída</strong><small><%= isOSFechada ? (closedAt ? fmtBR(closedAt) : 'Data não informada') : 'Aguardando conclusão' %></small></div></div>
    <div class="os-open-time"><div><small><%= isOSFechada ? 'Tempo total' : 'Tempo em aberto' %></small><strong id="os-elapsed" data-start="<%= openedAt %>" data-end="<%= isOSFechada ? closedAt : '' %>"><%= metricasAndamento.dias_aberta %> dia(s)</strong></div></div>
  </div>

  <div class="os-kpis"><article class="os-kpi blue"><div><small>Equipamento</small><strong><%= os.equipamento_resolvido || '-' %></strong></div></article><article class="os-kpi cyan"><div><small>Status</small><strong class="os-inline-badge status-<%= statusMeta.phase %>"><%= osStatus %></strong></div></article><article class="os-kpi orange"><div><small>Prioridade</small><strong class="os-inline-badge priority"><%= osPrioridade %></strong></div></article><article class="os-kpi green"><div><small>Equipe</small><strong><%= equipePrincipal.join(' e ') || 'Não alocada' %></strong></div></article></div>

  <div class="os-summary-grid"><article class="os-panel service-panel"><h2>Serviço e ações técnicas</h2><div class="os-info-list"><div><p><strong>Descrição do problema</strong><small class="technical-text"><%= os.descricao || 'Sem descrição registrada.' %></small></p></div><div><p><strong>Ação corretiva</strong><small class="technical-text"><%= os.acao_corretiva || os.causa_diagnostico || 'Ação corretiva não registrada.' %></small></p></div><div><p><strong>Ação preventiva</strong><small class="technical-text"><%= os.acao_preventiva || os.resumo_tecnico || 'Ação preventiva não registrada.' %></small></p></div></div><p class="ai-disclaimer">Sugestão gerada por IA. Validar tecnicamente antes da execução.</p></article>
    <div class="os-side-stack"><article class="os-panel"><h2>Equipe e execução</h2><div class="os-team-grid"><p><strong>Responsável manutenção:</strong><span><b class="avatar green"><%= initials(os.responsavel_manutencao) %></b><%= os.responsavel_manutencao || '-' %></span></p><p><strong>Turno da alocação:</strong><span><%= os.turno_alocado || os.execucao_ativa?.turno_alocacao || '-' %></span></p><p><strong><%= isOSFechada ? 'Executor da OS:' : 'Executor:' %></strong><span><b class="avatar"><%= initials(os.executor_nome || os.execucao_ativa?.executor_nome) %></b><%= os.executor_nome || os.execucao_ativa?.executor_nome || '-' %></span></p><p><strong>Modo da alocação:</strong><span><%= os.alocacao_modo || '-' %></span></p><p><strong><%= isOSFechada ? 'Segundo mecânico:' : 'Segundo mecânico:' %></strong><span><b class="avatar"><%= initials(os.auxiliar_nome || os.execucao_ativa?.auxiliar_nome) %></b><%= os.auxiliar_nome || os.execucao_ativa?.auxiliar_nome || '-' %></span></p></div></article>
      <article class="os-panel communication"><h2>Solicitação e comunicação</h2><div class="communication-grid"><p><span>Solicitação de material vinculada<small><%= linkedRequest ? ((linkedRequest.numero || '#' + linkedRequest.id) + ' — ' + (linkedRequest.status || 'status não informado')) : 'Nenhuma solicitação vinculada' %></small></span></p><p><span>Mensagens não lidas<small><%= chatResumo ? chatResumo.naoLidas : 0 %> mensagens não lidas</small><% const ultimaMensagem = chatResumo?.mensagens?.length ? chatResumo.mensagens[chatResumo.mensagens.length - 1] : null; %><small>Última mensagem: <%= ultimaMensagem?.mensagem || 'Nenhuma mensagem' %></small><small><%= ultimaMensagem?.created_at ? fmtBR(ultimaMensagem.created_at) : 'Sem interação registrada' %></small></span></p></div><div class="actions"><a class="btn btn-green" href="/chat-os/<%= os.id %>">Abrir conversa</a><% if (linkedRequest) { %><a class="btn btn-outline" href="/solicitacoes/<%= linkedRequest.id %>">Abrir solicitação</a><% } else if (!isOSFechada && canExecuteOS) { %><a class="btn btn-outline" href="/solicitacoes/nova?os_id=<%= os.id %>">Criar solicitação</a><% } %></div></article></div>
  </div>

  <article class="os-panel os-evidence-card" aria-labelledby="evidence-title">
    <h2 id="evidence-title"><%= isOSFechada ? 'Evidências da OS' : 'Evidências e fechamento da OS' %></h2>
    <div class="os-media-grid">
      <section><div class="media-heading"><h3>Evidência de abertura</h3><span><%= (os.fotos_abertura || []).length %> arquivo(s)</span></div>
        <p><%= openedAt ? ('Registrada em ' + fmtBR(openedAt)) : 'Data não registrada' %><%= os.opened_by_nome ? (' por ' + os.opened_by_nome) : '' %></p>
        <div class="os-gallery"><% if (!(os.fotos_abertura || []).length) { %><span class="muted">Nenhuma mídia de abertura registrada.</span><% } %><% (os.fotos_abertura || []).forEach((f, idx) => { const src=f.pathPublic||f.path||f.filepath; if(src){ const video=/\.(mp4|mov|webm|ogg|m4v|avi)$/i.test(src); %><a href="<%= src %>" target="_blank" rel="noopener" aria-label="Abrir mídia de abertura <%= idx+1 %>"><% if(video){ %><video src="<%= src %>" muted playsinline preload="metadata"></video><% }else{ %><img src="<%= src %>" alt="Mídia de abertura <%= idx+1 %>"><% } %></a><% } }); %></div>
      </section>
      <section><div class="media-heading"><h3>Evidência de fechamento</h3><span><%= (os.fotos_fechamento || []).length %> arquivo(s)</span></div>
        <% if (canConcluir) { %><p>A evidência é obrigatória. Fotos ou vídeos de até 1 minuto; limite de <%= process.env.OS_UPLOAD_FILE_SIZE_MB || 200 %> MB por arquivo.</p><form method="POST" action="/os/<%= os.id %>/concluir" enctype="multipart/form-data" id="form-concluir"><label class="os-upload-zone" for="fechamento_fotos">Selecionar ou substituir foto/vídeo<small>Você poderá revisar e remover arquivos antes de concluir.</small></label><input id="fechamento_fotos" type="file" name="fechamento_fotos" accept="image/*,video/*" multiple required hidden><div id="upload-message" class="muted" aria-live="polite">Adicione uma foto ou vídeo de fechamento para concluir.</div><div class="thumbs" id="preview-fechamento"></div></form><div class="os-conclusion"><div><strong>Conclusão da OS</strong><small>A OS somente será concluída após o envio da mídia válida.</small></div><button id="btn-concluir-os" class="btn btn-green" type="submit" form="form-concluir" disabled>Concluir OS</button></div>
        <% } else { %><p><%= isOSFechada && closedAt ? ('Fechada em ' + fmtBR(closedAt) + (os.closed_by_nome ? ' por ' + os.closed_by_nome : '')) : 'O fechamento estará disponível quando a OS estiver em execução.' %></p><div class="os-gallery"><% if (!(os.fotos_fechamento || []).length) { %><span class="muted">Nenhuma mídia de fechamento registrada.</span><% } %><% (os.fotos_fechamento || []).forEach((f,idx)=>{ const src=f.pathPublic||f.path||f.filepath; if(src){ const video=/\.(mp4|mov|webm|ogg|m4v|avi)$/i.test(src); %><a href="<%= src %>" target="_blank" rel="noopener" download><% if(video){ %><video src="<%= src %>" muted controls preload="metadata"></video><% }else{ %><img src="<%= src %>" alt="Mídia de fechamento <%= idx+1 %>"><% } %></a><% } }); %></div><% } %>
      </section>
    </div>
  </article>

  <article class="os-panel os-workspace" data-default-tab="<%= isOSFechada ? 'historico' : 'justificativa' %>"><nav class="os-tabs" role="tablist" aria-label="Detalhes da OS"><button id="tab-justificativa" role="tab" aria-selected="<%= !isOSFechada %>" aria-controls="panel-justificativa" tabindex="0" data-tab="justificativa">Justificativa técnica</button><% if (canAutoAssign && !isOSFechada) { %><button id="tab-redistribuicao" role="tab" aria-selected="false" aria-controls="panel-redistribuicao" tabindex="-1" data-tab="redistribuicao">Redistribuição da equipe</button><% } %><button id="tab-materiais" role="tab" aria-selected="false" aria-controls="panel-materiais" tabindex="-1" data-tab="materiais">Materiais e compras</button><button id="tab-historico" role="tab" aria-selected="<%= isOSFechada %>" aria-controls="panel-historico" tabindex="-1" data-tab="historico">Histórico da OS</button></nav>
    <section id="panel-justificativa" class="os-tab-panel" role="tabpanel" aria-labelledby="tab-justificativa"><div data-module-slot="justificativa-andamento"></div></section>
    <% if (canAutoAssign && !isOSFechada) { %><section id="panel-redistribuicao" class="os-tab-panel" role="tabpanel" aria-labelledby="tab-redistribuicao" hidden><div data-module-slot="redistribuicao-equipe"></div></section><% } %>
    <section id="panel-materiais" class="os-tab-panel" role="tabpanel" aria-labelledby="tab-materiais" hidden>
      <% if (!isOSFechada && canRegisterAndamento && statusMeta.phase === 'material') { %><form method="POST" action="/os/<%= os.id %>/material-chegou" class="material-arrived"><button class="btn btn-green" type="submit">Material chegou</button></form><% } %><% if (!materialRequest) { %><div class="empty-state"><strong>Nenhuma solicitação de material vinculada a esta OS.</strong><% if (!isOSFechada && canExecuteOS) { %><a class="btn btn-green" href="/solicitacoes/nova?os_id=<%= os.id %>">Criar solicitação de material</a><% } %></div><% } else { const itensMaterial = materialRequest.itens || []; %>
      <div class="material-head"><div><h3>Solicitação <%= materialRequest.numero || '#' + materialRequest.id %></h3><p><%= materialRequest.descricao || materialRequest.justificativa || 'Não registrado' %></p></div><a class="btn btn-outline" href="/solicitacoes/<%= materialRequest.id %>">Abrir solicitação</a></div>
      <div class="material-meta"><span><b>Status</b><%= materialRequest.status || 'Não registrado' %></span><span><b>Data</b><%= materialRequest.created_at ? fmtBR(materialRequest.created_at) : 'Não registrado' %></span><span><b>Solicitante</b><%= materialRequest.solicitante_nome || 'Não registrado' %></span><span><b>Itens</b><%= itensMaterial.length %></span></div>
      <div class="material-table-wrap"><table class="tabela-compacta material-table"><thead><tr><th>Item / descrição</th><th>Un.</th><th>Solicitada</th><th>Cotada</th><th>Comprada</th><th>Recebida</th><th>Utilizada</th><th>Valor unit.</th><th>Valor total</th><th>Fornecedor</th><th>Situação</th></tr></thead><tbody><% itensMaterial.forEach((item)=>{ const hasPrice=item.valor_unitario_centavos!==null&&item.valor_unitario_centavos!==undefined; const qtd=Number(item.qtd_comprada ?? item.qtd_solicitada); %><tr><td data-label="Item"><b><%= item.item_nome || ('#'+item.id) %></b><br><small><%= item.item_descricao || 'Não registrado' %></small></td><td data-label="Un."><%= item.unidade || '—' %></td><td data-label="Solicitada"><%= item.qtd_solicitada ?? '—' %></td><td data-label="Cotada"><%= item.status_cotacao === 'COTADO' ? (item.qtd_solicitada ?? '—') : '—' %></td><td data-label="Comprada"><%= item.qtd_comprada ?? '—' %></td><td data-label="Recebida"><%= item.qtd_recebida_total ?? '—' %></td><td data-label="Utilizada"><%= item.qtd_utilizada ?? '—' %></td><td data-label="Valor unit."><%= hasPrice ? (Number(item.valor_unitario_centavos)/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) : '—' %></td><td data-label="Valor total"><%= hasPrice && Number.isFinite(qtd) ? (Number(item.valor_unitario_centavos)*qtd/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) : '—' %></td><td data-label="Fornecedor"><%= item.fornecedor_nome || '—' %></td><td data-label="Situação"><%= item.status_compra || item.status_cotacao || item.status_item || 'Não registrado' %></td></tr><% }) %></tbody></table></div><% } %>
    </section>
    <section id="panel-historico" class="os-tab-panel" role="tabpanel" aria-labelledby="tab-historico" hidden><h3>Histórico completo da OS</h3><p class="muted">Eventos operacionais em ordem do mais recente para o mais antigo.</p><ol class="os-timeline">
      <% if (isOSFechada) { %><li><time><%= closedAt ? fmtBR(closedAt) : 'Data não registrada' %></time><div><strong>OS concluída</strong><span><%= os.closed_by_nome ? ('Responsável: ' + os.closed_by_nome + '. ') : '' %>Status alterado para concluída.</span></div></li><% } %>
      <% if ((os.fotos_fechamento || []).length) { %><li><time><%= closedAt ? fmtBR(closedAt) : 'Data não registrada' %></time><div><strong>Mídia de fechamento registrada</strong><span><%= (os.fotos_fechamento || []).length %> arquivo(s) vinculados ao fechamento.</span></div></li><% } %>
      <% (whatsappLogs || []).forEach((log)=>{ %><li><time><%= log.enviado_em ? fmtBR(log.enviado_em) : 'Data não registrada' %></time><div><strong>Notificação da OS</strong><span><%= ['ERRO','SEM_TELEFONE'].includes(log.status) ? ('Falha ao enviar notificação' + (log.usuario_nome ? ' para '+log.usuario_nome : '') + (log.erro ? ': '+log.erro : '.')) : 'Notificação da OS enviada à equipe.' %></span></div></li><% }) %>
      <% (historicoAndamento || []).slice().reverse().forEach((item)=>{ %><li><time><%= item.registrado_em ? fmtBR(item.registrado_em) : 'Data não registrada' %></time><div><strong><%= item.motivo_nome || 'Registro da execução' %></strong><span><%= item.observacao_mecanico || item.texto_padrao || 'Registro operacional.' %></span></div></li><% }) %>
      <% (tracagens || []).forEach((t)=>{ %><li class="tracagem-history-event"><time><%= fmtBR(t.os_linked_at || t.created_at) %></time><div><strong>Traçagem #<%= t.id %> vinculada à OS #<%= os.id %>.</strong><span><%= t.vinculado_por_nome ? ('Responsável: '+t.vinculado_por_nome+'. ') : '' %><%= t.tipo %> — <%= t.equipamento_nome || os.equipamento_resolvido %></span><div class="actions"><a class="btn btn-outline" href="/tracagem/<%= t.id %>">Abrir traçagem</a><a class="btn btn-outline" href="/tracagem/<%= t.id %>/pdf">Gerar PDF</a></div></div></li><% }) %>
      <% if (startedAt) { %><li><time><%= fmtBR(startedAt) %></time><div><strong>OS iniciada</strong><span>Execução do serviço iniciada.</span></div></li><% } %>
      <% if ((os.fotos_abertura || []).length) { %><li><time><%= openedAt ? fmtBR(openedAt) : 'Data não registrada' %></time><div><strong>Mídia de abertura registrada</strong><span><%= (os.fotos_abertura || []).length %> arquivo(s) vinculados à abertura.</span></div></li><% } %>
      <li><time><%= openedAt ? fmtBR(openedAt) : 'Data não registrada' %></time><div><strong>OS criada</strong><span><%= os.opened_by_nome ? ('Responsável: '+os.opened_by_nome+'.') : 'Responsável não registrado.' %></span></div></li>
    </ol></section>
  </article>
<div class="card os-module os-detail-card" id="redistribuicao-equipe">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
      <h3 style="margin:0;">Equipe atual</h3>
    </div>
    <div class="muted">Consulte a alocação vigente e redistribua respeitando escala e disponibilidade.</div>
    <table class="tabela-compacta">
      <thead>
        <tr>
          <th>Equipe</th>
          <th>Executor</th>
          <th>Mecânico 2</th>
          <th>Turno</th>
          <th>Modo</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= (os.executor_nome || os.execucao_ativa?.executor_nome || os.executor_secundario_nome || os.auxiliar_nome || os.execucao_ativa?.auxiliar_nome || os.auxiliar_secundario_nome) ? 'Equipe alocada' : '-' %></td>
          <td><%= os.executor_nome || os.execucao_ativa?.executor_nome || '-' %></td>
          <td><%= os.auxiliar_nome || os.execucao_ativa?.auxiliar_nome || '-' %></td>
          <td><%= os.turno_alocado || os.execucao_ativa?.turno_alocacao || '-' %></td>
          <td><%= os.alocacao_modo || '-' %></td>
        </tr>
        <% if (os.executor_secundario_nome || os.auxiliar_secundario_nome) { %>
          <tr>
            <td>Complemento manual</td>
            <td><%= os.executor_secundario_nome || '-' %></td>
            <td><%= os.auxiliar_secundario_nome || '-' %></td>
            <td colspan="2">Mecânicos extras definidos manualmente</td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <% if (canAutoAssign && !isOSFechada) { %>
      <div style="margin-top:8px;display:flex;justify-content:flex-end;">
        <form method="POST" action="/os/<%= os.id %>/auto-alocar">
          <button class="btn btn-primary" type="submit" data-confirm-team>Redistribuir automaticamente</button>
        </form>
      </div>
    <% } %>
    <% if (canManualEditEquipe && !isOSFechada) { %>
      <% const mecanicosTurno = (equipeUsuarios || []).filter(u => String(u.funcao || '').toLowerCase() === 'mecanico'); %>
      <% const mecanicosTurnoExtras = (equipeUsuarios || []).filter(u => ['mecanico'].includes(String(u.funcao || '').toLowerCase())); %>
      <div id="equipe-os">
      <form method="POST" action="/os/<%= os.id %>/equipe" style="margin-top:10px;">
        <div class="grid2">
          <div>
            <label>Executor</label>
            <select class="input" name="executor_colaborador_id" required>
              <option value="">Selecione</option>
              <% if (mecanicosTurno.length) { %>
                <optgroup label="Mecânicos">
                  <% mecanicosTurno.forEach(function(u){ %>
                    <option value="<%= u.id %>" <%= Number(os.executor_colaborador_id)===Number(u.id) ? 'selected' : '' %>><%= u.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
              <% if (mecanicosTurnoExtras.length) { %>
                <optgroup label="Mecânicos Industriais">
                  <% mecanicosTurnoExtras.forEach(function(u){ %>
                    <option value="<%= u.id %>" <%= Number(os.executor_colaborador_id)===Number(u.id) ? 'selected' : '' %>><%= u.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
          </div>
          <div>
            <label>Mecânico 2</label>
            <select class="input" name="auxiliar_colaborador_id">
              <option value="">Sem mecânico 2</option>
              <% if (mecanicosTurno.length) { %>
                <optgroup label="Mecânicos">
                  <% mecanicosTurno.forEach(function(u){ %>
                    <option value="<%= u.id %>" <%= Number(os.auxiliar_colaborador_id)===Number(u.id) ? 'selected' : '' %>><%= u.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
              <% if (mecanicosTurnoExtras.length) { %>
                <optgroup label="Mecânicos Industriais">
                  <% mecanicosTurnoExtras.forEach(function(u){ %>
                    <option value="<%= u.id %>" <%= Number(os.auxiliar_colaborador_id)===Number(u.id) ? 'selected' : '' %>><%= u.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
          </div>
          <div>
            <label>2º mecânico (opcional)</label>
            <select class="input" name="executor_secundario_colaborador_id">
              <option value="">Sem 2º mecânico</option>
              <% if (mecanicosTurno.length) { %>
                <optgroup label="Mecânicos">
                  <% mecanicosTurno.forEach(function(u){ %>
                    <option value="<%= u.id %>" <%= Number(os.executor_secundario_colaborador_id)===Number(u.id) ? 'selected' : '' %>><%= u.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
          </div>
          <div>
            <label>Mecânico 4 (opcional)</label>
            <select class="input" name="auxiliar_secundario_colaborador_id">
              <option value="">Sem mecânico 4</option>
              <% if (mecanicosTurnoExtras.length) { %>
                <optgroup label="Mecânicos Industriais">
                  <% mecanicosTurnoExtras.forEach(function(u){ %>
                    <option value="<%= u.id %>" <%= Number(os.auxiliar_secundario_colaborador_id)===Number(u.id) ? 'selected' : '' %>><%= u.name %></option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
          </div>
        </div>
        <label style="display:block;margin-top:8px;">Observação da alteração<textarea class="input" name="observacao" rows="2" maxlength="500"></textarea></label><div style="margin-top:8px;"><button class="btn" type="submit">Salvar nova equipe</button></div>
      </form>
      <% if (canManageDisponibilidade) { %>
        <hr style="border:none;border-top:1px solid #e5e7eb;margin:14px 0"/>
        <div class="muted" style="font-weight:700;">Disponibilidade manual do mecânico</div>
        <form method="POST" action="/os/<%= os.id %>/disponibilidade-manual" style="margin-top:10px;display:grid;gap:8px;">
          <input class="input" name="motivo" required maxlength="180" placeholder="Motivo obrigatório da decisão manual">
          <textarea class="input" name="observacao" maxlength="500" rows="2" placeholder="Observação opcional"></textarea>
          <div class="actions">
            <button class="btn btn-outline" name="acao" value="liberar" type="submit">Liberar mecânico para novas OSs</button>
            <button class="btn" name="acao" value="manter" type="submit">Manter mecânico vinculado à execução</button>
          </div>
        </form>
      <% } %>
    </div>
    <% } %>
  </div>
</div>



<% const statusPermiteAndamento = ['ABERTA','ANDAMENTO','EM_ANDAMENTO','PAUSADA','AGUARDANDO_EQUIPE'].includes(String(os.status || '').toUpperCase()); %>
<div class="card os-module" id="justificativa-andamento" style="margin-top:12px;">
  <div class="card-head">
    <div>
      <h3 style="margin:0;">Justificativa técnica</h3>
      <div class="muted">Rastreabilidade diária da permanência da OS em aberto, preservada também após a finalização.</div>
    </div>
    <span class="badge-funcao <%= alertaJustificativaAndamento ? 'func-mec' : 'func-aux' %>"><%= metricasAndamento.dias_aberta %> dia(s) aberta</span>
  </div>

  <% if (alertaJustificativaAndamento) { %>
    <div class="alert alert-error" style="margin-bottom:12px;">Esta OS está aberta há mais de 1 dia. Registre o motivo da permanência em andamento para manter a rastreabilidade do equipamento.</div>
  <% } %>

  <div class="justification-summary">
    <div><b>Data de abertura:</b> <%= os.opened_at ? fmtBR(os.opened_at) : '-' %></div>
    <div><b>Data de início:</b> <%= os.data_inicio ? fmtBR(os.data_inicio) : (os.execucao_iniciada_em ? fmtBR(os.execucao_iniciada_em) : '-') %></div>
    <div><b>Responsável/mecânico:</b> <%= os.executor_nome || os.execucao_ativa?.executor_nome || '-' %></div>
    <div><b>Último motivo:</b> <%= os.ultimo_motivo_andamento || '-' %></div>
    <div><b>Data da última justificativa:</b> <%= os.ultimo_registro_andamento_em ? fmtBR(os.ultimo_registro_andamento_em) : 'Nenhuma' %></div>
    <div><b>Situação de hoje:</b> <%= isOSFechada ? 'OS concluída' : (ultimoRegistroHoje ? 'Justificativa registrada hoje' : (metricasAndamento.dias_aberta > 1 ? 'Justificativa pendente' : 'Ainda não é necessário justificar')) %></div>
  </div>

  <% const ultimaJustificativa = (historicoAndamento || [])[0]; %>
  <section class="latest-justification"><h4>Última justificativa</h4><% if (ultimaJustificativa) { %><p><b><%= fmtBR(ultimaJustificativa.registrado_em) %></b> — <%= ultimaJustificativa.registrado_por_nome || 'Responsável não informado' %></p><p><strong><%= ultimaJustificativa.motivo_nome %></strong></p><p><%= ultimaJustificativa.observacao_mecanico || 'Sem observação complementar.' %></p><small><%= metricasAndamento.dias_aberta %> dia(s) em aberto no registro.</small><% } else { %><p>Nenhuma justificativa técnica registrada.</p><% } %></section>

  <% if (statusPermiteAndamento && canRegisterAndamento) { %>
    <form method="POST" action="/os/<%= os.id %>/andamento/registrar" style="margin-top:14px;">
      <div class="muted" style="font-weight:700;margin-bottom:7px;">Selecione um motivo rápido:</div>
      <div class="justification-reasons">
        <% (motivosAndamento || []).forEach((motivo) => { %>
          <label style="display:flex;gap:8px;align-items:flex-start;border:1px solid #e2e8f0;border-radius:10px;padding:9px;cursor:pointer;">
            <input type="radio" name="motivo_codigo" value="<%= motivo.codigo %>" required>
            <span><b><%= motivo.nome %></b><% if (motivo.exige_observacao) { %><br><small class="muted">Exige observação curta</small><% } %></span>
          </label>
        <% }) %>
      </div>
      <label style="display:block;margin-top:10px;"><b>Observação complementar do mecânico</b>
        <textarea name="observacao_mecanico" maxlength="500" rows="3" placeholder="Opcional, exceto para Outro motivo" style="width:100%;margin-top:5px;border:1px solid #d1d5db;border-radius:10px;padding:9px;"></textarea>
      </label>
      <div class="actions" style="margin-top:10px;">
        <button class="btn btn-green" type="submit">Registrar justificativa</button>
        <button class="btn btn-outline" type="reset">Limpar formulário</button>
      </div>
    </form>
  <% } %>


  <% const horasExtrasDaOS = Array.isArray(horasExtrasOS) ? horasExtrasOS : []; %>
  <% if (horasExtrasDaOS.length) { const totalGeralHE = horasExtrasDaOS.reduce((sum, he) => sum + Number(he.total_minutos || 0), 0); const totaisPorColaboradorHE = horasExtrasDaOS.reduce((acc, he) => { const nome = he.colaborador_nome || 'Mecânico'; acc[nome] = (acc[nome] || 0) + Number(he.total_minutos || 0); return acc; }, {}); %>
    <h4 style="margin:16px 0 6px;">Horas extras vinculadas à OS</h4>
    <ol style="margin:0;padding-left:20px;">
      <% horasExtrasDaOS.forEach((he) => { %>
        <li style="margin-top:6px;">
          <b><%= he.colaborador_nome || 'Mecânico' %></b> — <%= he.data_servico || '-' %> — <%= he.inicio_extra || '-' %> até <%= he.fim_extra || '-' %> — <%= he.total_minutos || 0 %> min — <%= he.status || '-' %><br>
          <span class="muted"><%= he.descricao_servico || 'Sem descrição complementar.' %></span>
          <% if (he.foto_inicio_path || he.foto_fim_path) { %><br><span class="muted">Anexos: <%= he.foto_inicio_path ? 'foto inicial' : '' %><%= he.foto_inicio_path && he.foto_fim_path ? ' / ' : '' %><%= he.foto_fim_path ? 'foto final' : '' %></span><% } %>
        </li>
      <% }) %>
    </ol>
    <div class="muted" style="margin-top:8px;"><b>Total geral da OS:</b> <%= totalGeralHE %> min. <b>Total por colaborador:</b> <% Object.entries(totaisPorColaboradorHE).forEach(([nome,total],idx)=>{ %><%= idx ? ' • ' : '' %><%= nome %>: <%= total %> min<% }) %></div>
  <% } %>

</div>

<% if (canSendWhatsappNotification) { %>
<div class="card os-module" style="margin-top:12px;" id="whatsapp-os">
  <% const whatsappEquipe = whatsappDestinatarios || []; %>
  <% const whatsPhone = whatsappResponsavel ? (whatsappResponsavel.telefone_normalizado || whatsappResponsavel.colaborador_telefone_whatsapp || whatsappResponsavel.telefone_whatsapp || whatsappResponsavel.user_telefone_whatsapp || whatsappResponsavel.colaborador_telefone || whatsappResponsavel.telefone || '') : ''; %>
  <% const whatsappSemTelefone = whatsappEquipe.filter((p) => !(p.telefone_normalizado || p.colaborador_telefone_whatsapp || p.telefone_whatsapp || p.user_telefone_whatsapp || p.colaborador_telefone || p.telefone)); %>
  <% const whatsappMotivo = whatsappProvider === 'disabled' ? 'WhatsApp desativado. Configure WHATSAPP_PROVIDER=manual ou cloud_api.' : (!whatsPhone ? 'Telefone não encontrado nas tabelas de usuários/colaboradores/funcionários/equipe/mecânicos ou vínculo textual ambíguo.' : ''); %>
  <div class="card-head">
    <div>
      <h3 style="margin:0;">Notificação WhatsApp</h3>
      <div class="muted">Envio da OS ao executor e ao mecânicos industriais da equipe direcionada.</div>
    </div>
    <% if (canSendWhatsapp && (os.executor_nome || os.execucao_ativa?.executor_nome || whatsappResponsavel?.nome)) { %>
      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;">
        <a class="btn btn-green whatsapp-btn" href="/os/<%= os.id %>/whatsapp" target="_blank" rel="noopener"><span class="wa-icon" aria-hidden="true"></span> Reenviar template</a>
        <a class="btn btn-outline whatsapp-btn" href="/os/<%= os.id %>?whatsapp_historico=completo#whatsapp-eventos"><span class="wa-icon" aria-hidden="true"></span> Ver eventos do WhatsApp</a>
      </div>
    <% } %>
  </div>

  <div class="grid2">
    <div><b>Responsável:</b> <%= os.executor_nome || os.execucao_ativa?.executor_nome || whatsappResponsavel?.nome || '-' %></div>
    <div><b>ID responsável vinculado:</b> <%= whatsappResponsavel?.id || os.executor_colaborador_id || os.responsavel_user_id || os.mecanico_user_id || '-' %></div>
    <div><b>Origem:</b> <%= whatsappResponsavel?.origem || '-' %></div>
    <div><b>Telefone WhatsApp responsável:</b> <%= whatsPhone || '-' %></div>
    <div><b>Mecânico industrial:</b> <%= os.auxiliar_nome || os.execucao_ativa?.auxiliar_nome || '-' %></div>
    <div><b>Destinatários da equipe:</b> <%= whatsappEquipe.length || 0 %></div>
    <div><b>Provider atual:</b> <%= whatsappProvider || 'disabled' %></div>
    <div><b>Template usado:</b> <%= whatsappLast?.template_name || '-' %></div>
    <div><b>ID da mensagem Meta:</b> <%= whatsappLast?.whatsapp_message_id || '-' %></div>
    <div><b>Enviado em:</b> <%= whatsappLast?.enviado_em ? fmtBR(whatsappLast.enviado_em) : '-' %></div>
    <div><b>Entregue em:</b> <%= whatsappLast?.entregue_em ? fmtBR(whatsappLast.entregue_em) : '-' %></div>
    <div><b>Lido em:</b> <%= whatsappLast?.lido_em ? fmtBR(whatsappLast.lido_em) : '-' %></div>
    <div><b>Falha em:</b> <%= whatsappLast?.falhou_em ? fmtBR(whatsappLast.falhou_em) : '-' %></div>
    <div><b>Último erro:</b> <%= whatsappLast?.erro || '-' %></div>
    <div><b>Motivo/diagnóstico:</b> <%= whatsappMotivo || '-' %></div>
    <div>
      <b>Último acompanhamento:</b> <%= whatsappLast?.enviado_em ? fmtBR(whatsappLast.enviado_em) : '-' %>
      <% if (whatsappLast?.status) { %>
        <% const stW = String(whatsappLast.status || ''); %>
        <span class="whatsapp-status <%= stW === 'ERRO' || stW === 'SEM_TELEFONE' ? 'erro' : (stW === 'IGNORADO' || stW === 'SEM_PROVIDER' || stW === 'WHATSAPP_DESATIVADO' ? 'warn' : '') %>"><%= stW %></span>
      <% } %>
    </div>
  </div>

  <% if (whatsappResponsavel?.aviso_ambiguidade) { %>
    <div style="margin-top:10px;color:#92400e;font-weight:800;"><span class="wa-icon" aria-hidden="true"></span> <%= whatsappResponsavel.aviso_ambiguidade %></div>
  <% } %>
  <% if (whatsappProvider === 'disabled') { %>
    <div style="margin-top:10px;color:#92400e;font-weight:800;"><span class="wa-icon" aria-hidden="true"></span> WhatsApp desativado. Configure WHATSAPP_PROVIDER=manual ou cloud_api.</div>
  <% } else if (whatsappSemTelefone.length) { %>
    <div style="margin-top:10px;color:#b91c1c;font-weight:800;"><span class="wa-icon" aria-hidden="true"></span> <%= whatsappSemTelefone.length %> integrante(s) da equipe sem número de WhatsApp cadastrado no perfil.</div>
  <% } else if (whatsappProvider === 'cloud_api') { %>
    <div style="margin-top:10px;color:#166534;font-weight:800;"><span class="wa-icon" aria-hidden="true"></span> Envio automático ativo para os WhatsApps cadastrados no perfil do funcionário e do mecânicos industriais.</div>
  <% } else if (whatsappProvider === 'manual') { %>
    <div style="margin-top:10px;color:#166534;font-weight:800;"><span class="wa-icon" aria-hidden="true"></span> WhatsApp pronto para envio manual pela OS aberta. Para envio direto automático, configure WHATSAPP_PROVIDER=cloud_api.</div>
  <% } else { %>
    <div style="margin-top:10px;color:#92400e;font-weight:800;"><span class="wa-icon" aria-hidden="true"></span> Provider inválido ou não configurado.</div>
  <% } %>

  <% if (whatsappEquipe.length) { %>
    <h4 style="margin:14px 0 0;">Destinatários da equipe direcionada</h4>
    <table class="tabela-compacta">
      <thead><tr><th>Papel</th><th>ID</th><th>Nome</th><th>Origem</th><th>WhatsApp</th></tr></thead>
      <tbody>
        <% whatsappEquipe.forEach(function(p){ const tel = p.telefone_normalizado || p.colaborador_telefone_whatsapp || p.telefone_whatsapp || p.user_telefone_whatsapp || p.colaborador_telefone || p.telefone || ''; %>
          <tr>
            <td><%= p.papel || '-' %></td>
            <td><%= p.id || p.user_id || p.colaborador_id || '-' %></td>
            <td><%= p.nome || p.name || p.user_name || '-' %></td>
            <td><%= p.origem || '-' %></td>
            <td><%= tel || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
  <% if (whatsappLast?.erro) { %>
    <div style="margin-top:10px;color:#991b1b;"><b>Erro do último envio:</b> <%= whatsappLast.erro %></div>
  <% } %>

  <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:14px;">
    <h4 style="margin:0;">Histórico de envio na OS</h4>
    <% if (!whatsappHistoricoCompleto) { %>
      <a class="btn btn-sm btn-outline" href="/os/<%= os.id %>?whatsapp_historico=completo#whatsapp-historico">Ver histórico completo</a>
    <% } else { %>
      <a class="btn btn-sm btn-outline" href="/os/<%= os.id %>#whatsapp-historico">Mostrar últimos 10</a>
    <% } %>
  </div>
  <% if (!whatsappHistoricoCompleto) { %>
    <div class="muted" style="margin-top:6px;">Mostrando apenas os últimos 10 registros.</div>
  <% } %>
  <table class="tabela-compacta" id="whatsapp-historico">
    <thead>
      <tr>
        <th>Data/Hora</th>
        <th>Evento</th>
        <th>Responsável</th>
        <th>Telefone</th>
        <th>Status</th>
        <th>Template</th>
        <th>ID Meta</th>
        <th>Entregue</th>
        <th>Lido</th>
        <th>Falha</th>
        <th>Erro</th>
      </tr>
    </thead>
    <tbody>
      <% if (!(whatsappLogs || []).length) { %>
        <tr><td colspan="11" class="muted" style="text-align:center;">Nenhum envio registrado.</td></tr>
      <% } %>
      <% (whatsappLogs || []).forEach(function(log){ %>
        <tr>
          <td><%= log.enviado_em ? fmtBR(log.enviado_em) : '-' %></td>
          <td><%= log.tipo_evento || '-' %></td>
          <td><%= log.usuario_nome || os.executor_nome || '-' %></td>
          <td><%= log.telefone || '-' %></td>
          <td><span class="whatsapp-status <%= log.status === 'ERRO' || log.status === 'SEM_TELEFONE' ? 'erro' : (log.status === 'IGNORADO' || log.status === 'SEM_PROVIDER' ? 'warn' : '') %>"><%= log.status || '-' %></span></td>
          <td><%= log.template_name || '-' %></td>
          <td><%= log.whatsapp_message_id || '-' %></td>
          <td><%= log.entregue_em ? fmtBR(log.entregue_em) : '-' %></td>
          <td><%= log.lido_em ? fmtBR(log.lido_em) : '-' %></td>
          <td><%= log.falhou_em ? fmtBR(log.falhou_em) : '-' %></td>
          <td><%= log.erro || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:14px;" id="whatsapp-eventos">
    <h4 style="margin:0;">Eventos recebidos pelo webhook</h4>
  </div>
  <table class="tabela-compacta">
    <thead><tr><th>Recebido em</th><th>Status/evento</th><th>Telefone</th><th>ID Meta</th><th>Erro</th></tr></thead>
    <tbody>
      <% if (!(whatsappEventos || []).length) { %>
        <tr><td colspan="5" class="muted" style="text-align:center;">Nenhum evento recebido pelo webhook.</td></tr>
      <% } %>
      <% (whatsappEventos || []).forEach(function(ev){ %>
        <tr>
          <td><%= ev.recebido_em ? fmtBR(ev.recebido_em) : '-' %></td>
          <td><%= ev.status || '-' %></td>
          <td><%= ev.recipient_phone || '-' %></td>
          <td><%= ev.whatsapp_message_id || '-' %></td>
          <td><%= ev.erro || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</div>
<% } else { %>
  <div class="card os-module" style="margin-top:12px;" id="whatsapp-os">
    <div class="card-head">
      <div>
        <h3 style="margin:0;">Notificação WhatsApp</h3>
        <div class="muted">Notificações disponíveis apenas para Admin e Encarregado de Manutenção.</div>
      </div>
    </div>
    <p class="muted" style="margin-bottom:0;">Acesso restrito. Apenas Admin e Encarregado de Manutenção podem enviar notificações via WhatsApp ou visualizar dados de contato dos colaboradores.</p>
  </div>
<% } %>


<script src="/js/os-detalhe.js" defer></script>
