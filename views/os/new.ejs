<% layout('layout') %>
<link rel="stylesheet" href="/css/os-new.css?v=20260819-nova-os-mobile">

<section class="os-new-page" aria-labelledby="os-new-title">
  <header class="os-new-head">
    <div>
      <h1 id="os-new-title">Nova Não Conformidade / OS</h1>
      <p>Abertura rápida da ocorrência para geração automática da ordem de serviço.</p>
    </div>
    <span class="os-new-kicker">Abertura operacional</span>
  </header>

  <form method="POST" action="/os" enctype="multipart/form-data" id="os-form" class="os-new-form">
    <section class="os-new-card" aria-labelledby="os-new-identificacao">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-identificacao">1. Identificação</h2>
          <p class="os-new-card-help">Selecione o equipamento cadastrado ou informe manualmente quando ele ainda não existir no cadastro.</p>
        </div>
      </div>
      <div class="os-new-grid">
        <div class="os-new-field">
          <label class="label" for="equipamento_id">Equipamento cadastrado</label>
          <select name="equipamento_id" id="equipamento_id" class="input" aria-describedby="equipamento-ajuda">
            <option value="">Selecionar equipamento cadastrado</option>
            <% (equipamentos || []).forEach(e => { %>
              <option value="<%= e.id %>" <%= String(prefillEquipamentoId||'')===String(e.id)?'selected':'' %>><%= e.codigo ? e.codigo + ' - ' : '' %><%= e.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="os-new-field">
          <label class="label" for="equipamento_manual">Equipamento manual</label>
          <input class="input" type="text" name="equipamento_manual" id="equipamento_manual" placeholder="Ex.: Bomba de recirculação do setor de lavagem" aria-describedby="equipamento-ajuda" />
        </div>
        <div id="equipamento-ajuda" class="os-new-hint os-new-field--full">Preencha somente uma das opções acima.</div>
      </div>
    </section>

    <section class="os-new-card" aria-labelledby="os-new-solicitacao">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-solicitacao">2. Solicitação</h2>
          <p class="os-new-card-help">Identifique a origem da ocorrência e quem receberá o atendimento.</p>
        </div>
      </div>
      <div class="os-new-grid">
        <div class="os-new-field">
          <label class="label" for="setor_solicitante">Setor solicitante</label>
          <input class="input" type="text" name="setor_solicitante" id="setor_solicitante" placeholder="Ex.: Produção" />
        </div>
        <div class="os-new-field">
          <label class="label" for="setor_destinatario">Setor destinatário</label>
          <input class="input" type="text" name="setor_destinatario" id="setor_destinatario" value="Manutenção" />
        </div>
        <div class="os-new-field os-new-field--full">
          <label class="label" for="responsavel_manutencao">Responsável pela manutenção</label>
          <input class="input" type="text" name="responsavel_manutencao" id="responsavel_manutencao" value="Ângelo Gomes da Silva" />
        </div>
      </div>
    </section>

    <section class="os-new-card" aria-labelledby="os-new-ocorrencia">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-ocorrencia">3. Ocorrência</h2>
          <p class="os-new-card-help">Registre o sintoma percebido e descreva objetivamente a não conformidade.</p>
        </div>
      </div>
      <div class="os-new-grid">
        <div class="os-new-field os-new-field--full">
          <label class="label" for="sintoma_principal">Sintoma principal *</label>
          <select name="sintoma_principal" id="sintoma_principal" class="input" required>
            <option value="">Selecione...</option>
            <option value="equipamento_parado">Equipamento parado</option>
            <option value="vazamento">Vazamento</option>
            <option value="aquecimento">Aquecimento</option>
            <option value="vibracao">Vibração</option>
            <option value="ruido_anormal">Ruído anormal</option>
            <option value="travamento">Travamento</option>
            <option value="baixa_performance">Baixa performance</option>
            <option value="falha_eletrica">Falha elétrica</option>
            <option value="desalinhamento">Desalinhamento</option>
            <option value="folga_mecanica">Folga mecânica</option>
            <option value="material_acumulado">Material acumulado</option>
            <option value="outro">Outro</option>
          </select>
        </div>
        <div class="os-new-field os-new-field--full">
          <label class="label" for="nao_conformidade">Não conformidade do equipamento *</label>
          <textarea
            id="nao_conformidade"
            name="nao_conformidade"
            class="input"
            minlength="10"
            required
            placeholder="Ex.: Equipamento apresentando vibração forte, ruído e aquecimento durante operação."
          ></textarea>
          <div class="os-new-hint">Descreva o que está acontecendo. A assistência por voz abaixo pode preencher este campo e os dados técnicos automaticamente.</div>
        </div>
      </div>
    </section>

    <section class="os-new-card" aria-labelledby="os-new-assistencia">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-assistencia">4. Assistência técnica</h2>
          <p class="os-new-card-help">Use a voz para registrar a ocorrência e receber o preenchimento assistido pela IA. Revise o resultado antes de salvar.</p>
        </div>
      </div>
      <div class="os-new-assistant-panel">
        <button type="button" id="btn-converse-mecanico" class="btn-converse-mecanico" aria-label="Converse com o Mecânico">
          <span aria-hidden="true">🎤</span>
          <span id="btn-converse-label">Converse com o Mecânico</span>
        </button>
        <div id="status-converse" class="status-converse" role="status" aria-live="polite">Pronto para gravar.</div>
      </div>
    </section>

    <input type="hidden" name="criticidade" id="criticidade" value="MEDIA" />
    <input type="hidden" name="ai_tempo_estimado" id="ai_tempo_estimado" value="" />
    <input type="hidden" name="ai_diagnostico_inicial" id="ai_diagnostico_inicial" value="" />
    <input type="hidden" name="ai_causa" id="ai_causa" value="" />
    <input type="hidden" name="ai_acoes_iniciais" id="ai_acoes_iniciais" value="" />
    <input type="hidden" name="descricao" id="descricao_hidden" value="" />
    <input type="hidden" name="diagnostico_inicial" id="diagnostico_inicial_hidden" value="" />
    <input type="hidden" name="causa_mais_provavel" id="causa_mais_provavel_hidden" value="" />
    <input type="hidden" name="acoes_iniciais" id="acoes_iniciais_hidden" value="" />

    <section class="os-new-card" aria-labelledby="os-new-evidencias">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-evidencias">5. Evidências</h2>
          <p class="os-new-card-help">Adicione fotos ou vídeos do estado inicial para deixar o histórico da OS mais completo.</p>
        </div>
      </div>
      <div class="os-new-field">
        <label class="label" for="abertura_fotos">Mídias de abertura (opcional)</label>
        <input id="abertura_fotos" type="file" name="abertura_fotos" accept="image/*,video/*" capture="environment" multiple hidden />
        <button type="button" class="btn btn-outline os-new-media-button" id="btn-adicionar-midia">📎 Adicionar foto ou vídeo</button>
        <div id="preview-abertura" class="os-new-preview" aria-live="polite"></div>
        <div class="os-new-hint">Vídeos curtos: até 1 minuto. O fluxo e os limites atuais de upload permanecem inalterados.</div>
      </div>
    </section>

    <section class="os-new-actions-card" aria-labelledby="os-new-acoes">
      <div class="os-new-actions-copy">
        <h2 id="os-new-acoes">6. Ações da ordem de serviço</h2>
        <p>Revise as informações antes de gerar a OS. Durante o envio, aguarde a confirmação do sistema.</p>
      </div>
      <div class="os-new-actions">
        <a href="/os" class="btn btn-ghost os-new-cancel">Cancelar</a>
        <button type="submit" class="btn btn-primary os-new-submit" id="btn-salvar-os">Salvar e gerar OS</button>
      </div>
    </section>
  </form>
</section>

<script src="/js/os-new.js?v=20260819-nova-os-mobile" defer></script>
