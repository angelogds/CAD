<% layout('layout') %>
<link rel="stylesheet" href="/css/os-new.css?v=20260819-nova-os-escrita-v2">

<section class="os-new-page" aria-labelledby="os-new-title">
  <header class="os-new-head">
    <div>
      <h1 id="os-new-title">Nova Não Conformidade / OS</h1>
      <p>Abertura rápida por escrito, com identificação automática do solicitante e foto opcional.</p>
    </div>
    <span class="os-new-kicker">Abertura operacional</span>
  </header>

  <form method="POST" action="/os" enctype="multipart/form-data" id="os-form" class="os-new-form">
    <section class="os-new-card" aria-labelledby="os-new-identificacao">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-identificacao">1. Identificação</h2>
          <p class="os-new-card-help">Selecione o equipamento cadastrado ou informe manualmente quando ele ainda não existir no cadastro.</p>
        </div>
      </div>
      <div class="os-new-grid">
        <div class="os-new-field">
          <label class="label" for="equipamento_id">Equipamento cadastrado</label>
          <select name="equipamento_id" id="equipamento_id" class="input" aria-describedby="equipamento-ajuda">
            <option value="">Selecionar equipamento cadastrado</option>
            <% (equipamentos || []).forEach(e => { %>
              <option value="<%= e.id %>" <%= String(prefillEquipamentoId||'')===String(e.id)?'selected':'' %>><%= e.codigo ? e.codigo + ' - ' : '' %><%= e.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="os-new-field">
          <label class="label" for="equipamento_manual">Equipamento manual</label>
          <input class="input" type="text" name="equipamento_manual" id="equipamento_manual" placeholder="Ex.: Bomba de recirculação do setor de lavagem" aria-describedby="equipamento-ajuda" />
        </div>
        <div id="equipamento-ajuda" class="os-new-hint os-new-field--full">Preencha somente uma das opções acima.</div>
      </div>
    </section>

    <section class="os-new-card" aria-labelledby="os-new-solicitacao">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-solicitacao">2. Solicitação</h2>
          <p class="os-new-card-help">Os dados do solicitante são identificados automaticamente pelo usuário autenticado.</p>
        </div>
      </div>

      <input type="hidden" name="setor_solicitante" value="Manutenção" />
      <input type="hidden" name="setor_destinatario" value="Manutenção" />
      <input type="hidden" name="responsavel_manutencao" value="Ângelo Gomes da Silva" />

      <div class="os-new-auto-grid" aria-label="Dados automáticos da solicitação">
        <div class="os-new-auto-item">
          <span>Setor solicitante</span>
          <strong>Manutenção</strong>
        </div>
        <div class="os-new-auto-item">
          <span>Solicitante</span>
          <strong><%= user?.name || 'Usuário autenticado' %></strong>
        </div>
        <div class="os-new-auto-item">
          <span>Setor destinatário</span>
          <strong>Manutenção</strong>
        </div>
      </div>
    </section>

    <section class="os-new-card" aria-labelledby="os-new-ocorrencia">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-ocorrencia">3. Ocorrência</h2>
          <p class="os-new-card-help">Registre o sintoma percebido e descreva objetivamente a não conformidade.</p>
        </div>
      </div>
      <div class="os-new-grid">
        <div class="os-new-field os-new-field--full">
          <label class="label" for="sintoma_principal">Sintoma principal *</label>
          <select name="sintoma_principal" id="sintoma_principal" class="input" required>
            <option value="">Selecione...</option>
            <option value="equipamento_parado">Equipamento parado</option>
            <option value="vazamento">Vazamento</option>
            <option value="aquecimento">Aquecimento</option>
            <option value="vibracao">Vibração</option>
            <option value="ruido_anormal">Ruído anormal</option>
            <option value="travamento">Travamento</option>
            <option value="baixa_performance">Baixa performance</option>
            <option value="falha_eletrica">Falha elétrica</option>
            <option value="desalinhamento">Desalinhamento</option>
            <option value="folga_mecanica">Folga mecânica</option>
            <option value="material_acumulado">Material acumulado</option>
            <option value="outro">Outro</option>
          </select>
        </div>
        <div class="os-new-field os-new-field--full">
          <label class="label" for="nao_conformidade">Não conformidade do equipamento *</label>
          <textarea
            id="nao_conformidade"
            name="nao_conformidade"
            class="input"
            minlength="10"
            required
            placeholder="Ex.: Equipamento apresentando vibração forte, ruído e aquecimento durante operação."
          ></textarea>
          <div class="os-new-hint">Descreva por escrito o que está acontecendo de forma objetiva. Essa descrição ficará registrada no histórico da OS.</div>
        </div>
      </div>
    </section>

    <input type="hidden" name="criticidade" id="criticidade" value="MEDIA" />
    <input type="hidden" name="descricao" id="descricao_hidden" value="" />

    <section class="os-new-card" aria-labelledby="os-new-evidencias">
      <div class="os-new-card-head">
        <div>
          <h2 class="os-new-card-title" id="os-new-evidencias">4. Evidências</h2>
          <p class="os-new-card-help">A foto de abertura é opcional e pode ser adicionada quando ajudar a registrar o estado inicial do equipamento.</p>
        </div>
      </div>
      <div class="os-new-field">
        <label class="label" for="abertura_fotos">Foto de abertura (opcional)</label>
        <input id="abertura_fotos" type="file" name="abertura_fotos" accept="image/*" capture="environment" multiple hidden />
        <button type="button" class="btn btn-outline os-new-media-button" id="btn-adicionar-midia">📷 Adicionar foto</button>
        <div id="preview-abertura" class="os-new-preview" aria-live="polite"></div>
        <div class="os-new-hint">Você pode abrir a OS sem foto. Quando anexada, a imagem será preservada no histórico de abertura.</div>
      </div>
    </section>

    <section class="os-new-actions-card" aria-labelledby="os-new-acoes">
      <div class="os-new-actions-copy">
        <h2 id="os-new-acoes">5. Ações da ordem de serviço</h2>
        <p>Revise as informações escritas antes de gerar a OS. Durante o envio, aguarde a confirmação do sistema.</p>
      </div>
      <div class="os-new-actions">
        <a href="/os" class="btn btn-ghost os-new-cancel">Cancelar</a>
        <button type="submit" class="btn btn-primary os-new-submit" id="btn-salvar-os">Salvar e gerar OS</button>
      </div>
    </section>
  </form>
</section>

<script src="/js/os-new.js?v=20260819-nova-os-escrita-v2" defer></script>
