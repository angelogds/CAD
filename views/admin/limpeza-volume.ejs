<% layout('layout') %>
<link rel="stylesheet" href="/css/admin-console.css?v=20260919-p5" />

<main class="admin-console">
  <header class="admin-hero">
    <div>
      <span class="admin-eyebrow">ADMINISTRAÇÃO • MANUTENÇÃO DO VOLUME</span>
      <h1>Limpeza de volume</h1>
      <p>Ferramenta restrita para simular e remover somente imagens e vídeos. PDFs, textos e SQLite são preservados.</p>
    </div>
    <div class="admin-actions">
      <a class="ui-btn ui-btn--secondary" href="/admin/armazenamento">Voltar ao armazenamento</a>
    </div>
  </header>

  <section class="admin-metrics">
    <article class="admin-metric"><span>Total de mídia</span><strong><%= formatBytes(stats.totalBytes) %></strong></article>
    <article class="admin-metric"><span>Imagens</span><strong><%= stats.imageCount %></strong></article>
    <article class="admin-metric"><span>Vídeos</span><strong><%= stats.videoCount %></strong></article>
    <article class="admin-metric"><span>Filtro atual</span><strong><%= olderThanDays ? olderThanDays + ' dias' : 'Todos' %></strong></article>
  </section>

  <section class="admin-panel is-danger">
    <div class="admin-section-head">
      <div><h2>Simular ou apagar mídia</h2><p>Use a simulação antes da exclusão definitiva.</p></div>
      <span class="admin-badge danger">Ação irreversível</span>
    </div>

    <div class="admin-note danger">A exclusão definitiva exige a confirmação textual <strong>APAGAR ANEXOS</strong>. O processo não remove PDFs, textos nem o banco SQLite.</div>

    <form method="post" action="/admin/limpeza-volume" class="admin-danger-grid">
      <label class="admin-field">
        <span>Arquivos com mais de X dias</span>
        <input type="number" min="0" name="older_than_days" value="<%= olderThanDays || '' %>" placeholder="Ex.: 30">
      </label>
      <label class="admin-field">
        <span>Confirmação textual</span>
        <input name="confirm_text" placeholder="APAGAR ANEXOS" autocomplete="off">
      </label>
      <div class="admin-actions">
        <button class="ui-btn ui-btn--outline" name="action" value="dry-run" type="submit">Simular</button>
        <button class="ui-btn ui-btn--danger-soft" name="action" value="confirm" type="submit" onclick="return confirm('Confirma apagar imagens e vídeos selecionados? PDFs e banco não serão apagados.');">Apagar mídia</button>
      </div>
    </form>
  </section>

  <section class="admin-panel">
    <div class="admin-section-head">
      <div><h2>Maiores arquivos</h2><p>Itens que mais ocupam espaço dentro do escopo de mídia apagável.</p></div>
      <span class="admin-badge"><%= stats.topFiles.length %> item(ns)</span>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>Arquivo</th><th>Tipo</th><th>Tamanho</th><th>Modificado</th></tr></thead>
        <tbody>
          <% if (!stats.topFiles.length) { %><tr><td colspan="4" class="admin-empty">Nenhuma imagem ou vídeo encontrado.</td></tr><% } %>
          <% stats.topFiles.forEach(function(file){ %>
            <tr>
              <td data-label="Arquivo"><code><%= file.path %></code></td>
              <td data-label="Tipo"><span class="admin-badge"><%= file.kind === 'video' ? 'Vídeo' : 'Imagem' %></span></td>
              <td data-label="Tamanho"><%= formatBytes(file.size) %></td>
              <td data-label="Modificado"><%= file.mtime ? new Date(file.mtime).toLocaleString('pt-BR') : '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-section-head"><div><h2>Últimos logs</h2><p>Registro recente das operações de limpeza.</p></div></div>
    <pre class="admin-log"><%= logs || 'Nenhuma limpeza registrada ainda.' %></pre>
  </section>
</main>
