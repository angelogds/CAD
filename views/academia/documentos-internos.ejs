<% layout('layout') %>
<link rel="stylesheet" href="/css/academia.css?v=20260919-p4" />
<main class="academy-workspace">
  <header class="academy-hero"><div><span class="academy-eyebrow">ACADEMIA • DOCUMENTOS</span><h1>Documentos Internos</h1><p>Registros institucionais de participação e conclusão emitidos pela Academia da Manutenção.</p></div></header>
  <%- include(incluir('_menu')) %>
  <section class="academy-panel">
    <div class="academy-note">Estes documentos são <strong>institucionais internos</strong> de capacitação e uso corporativo.</div>
    <div class="academy-section-head"><div><h2>Documentos emitidos</h2><p>Consulte carga horária, código e arquivo vinculado.</p></div><span class="academy-badge"><%= documentos?.length || 0 %> documento(s)</span></div>
    <% if (!documentos?.length) { %><div class="academy-empty">Nenhum documento interno emitido até o momento.</div><% } %>
    <div class="academy-list">
      <% (documentos || []).forEach(function(doc){ %>
        <article class="academy-list-item">
          <div><strong><%= doc.tipo_documento %></strong><p><%= doc.curso_titulo %></p><div class="academy-doc-meta"><span class="academy-badge"><%= doc.carga_horaria_interna || 0 %>h</span><span class="academy-badge">Emissão: <%= doc.emitido_em %></span></div><div class="muted-xs">Código: <%= doc.codigo_validacao %></div></div>
          <% if (doc.arquivo_url) { %><a class="ui-btn ui-btn--outline ui-btn--compact" href="<%= doc.arquivo_url %>">Abrir</a><% } %>
        </article>
      <% }) %>
    </div>
  </section>
</main>
