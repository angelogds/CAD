<% layout('layout') %>
<link rel="stylesheet" href="/css/academia.css?v=20260919-p4" />
<main class="academy-workspace">
  <header class="academy-hero"><div><span class="academy-eyebrow">ACADEMIA • ETAPA EXTERNA</span><h1>Certificados Externos</h1><p>Envios e validações de etapas complementares externas, com rastreabilidade da conclusão.</p></div></header>
  <%- include(incluir('_menu')) %>
  <section class="academy-panel">
    <div class="academy-section-head"><div><h2>Comprovantes enviados</h2><p>Acompanhe plataforma, data e situação da validação.</p></div><span class="academy-badge"><%= etapasExternas?.length || 0 %> envio(s)</span></div>
    <% if (!etapasExternas?.length) { %><div class="academy-empty">Nenhum comprovante externo enviado.</div><% } %>
    <div class="academy-list">
      <% (etapasExternas || []).forEach(function(etapa){ %>
        <article class="academy-list-item">
          <div>
            <strong><%= etapa.curso_titulo %></strong>
            <p>Plataforma: <%= etapa.plataforma %> • Conclusão: <%= etapa.data_conclusao || '-' %> • Enviado em: <%= etapa.criado_em %></p>
            <div class="academy-course-meta"><span class="badge-status <%= etapa.status_validacao==='VALIDADO'?'CONCLUIDO':(etapa.status_validacao==='REPROVADO'?'REPROVADO':'PENDENTE') %>"><%= etapa.status_validacao %></span></div>
          </div>
          <div class="academia-actions">
            <% if (etapa.certificado_url) { %><a class="ui-btn ui-btn--outline ui-btn--compact" href="<%= etapa.certificado_url %>" target="_blank" rel="noopener">Ver comprovante</a><% } %>
            <% if (canAccessModule(normalizeRole(user?.role), 'academia_manage')) { %>
              <form method="POST" action="/academia/etapas-externas/<%= etapa.id %>/validar"><input type="hidden" name="status_validacao" value="VALIDADO"><button class="ui-btn ui-btn--primary ui-btn--compact" type="submit">Validar</button></form>
              <form method="POST" action="/academia/etapas-externas/<%= etapa.id %>/validar"><input type="hidden" name="status_validacao" value="REPROVADO"><button class="ui-btn ui-btn--danger-soft ui-btn--compact" type="submit">Reprovar</button></form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>
