<% layout('layout') %>
<link rel="stylesheet" href="/css/academia.css?v=20260919-p4" />
<main class="academy-workspace">
  <header class="academy-hero"><div><span class="academy-eyebrow">ACADEMIA • TRILHAS</span><h1>Trilhas de conhecimento</h1><p>Evolução técnica organizada por área, nível e sequência de cursos.</p></div></header>
  <%- include(incluir('_menu')) %>
  <section class="academy-course-grid">
    <% if (!trilhas.length) { %><div class="academy-empty">Nenhuma trilha disponível.</div><% } %>
    <% trilhas.forEach(function(t){ %>
      <article class="academy-course-card">
        <div class="academy-course-meta"><span class="academy-badge"><%= t.icone || '📘' %> <%= t.nivel || 'BÁSICO' %></span><span class="academy-badge"><%= t.total_cursos %> cursos</span></div>
        <h3><a href="/academia/trilha/<%= t.id %>"><%= t.nome %></a></h3>
        <p><%= t.descricao || 'Sem descrição.' %></p>
        <div class="progress"><span style="width:<%= t.progresso_percentual %>%"></span></div>
        <div class="academy-progress-meta"><span>Progresso</span><strong><%= t.progresso_percentual %>%</strong></div>
        <div class="academy-card-footer"><a class="ui-btn ui-btn--outline ui-btn--compact" href="/academia/trilha/<%= t.id %>">Abrir trilha</a></div>
      </article>
    <% }) %>
  </section>
</main>
