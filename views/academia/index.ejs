<% layout('layout') %>
<link rel="stylesheet" href="/css/academia.css?v=20260919-p4" />

<main class="academy-workspace">
  <header class="academy-hero">
    <div>
      <span class="academy-eyebrow">ACADEMIA DA MANUTENÇÃO</span>
      <h1>Centro de Capacitação Técnica</h1>
      <p>Acompanhe sua evolução, continue cursos, consulte trilhas, documentos e certificações em um único ambiente.</p>
    </div>
    <div class="academy-hero-actions">
      <a class="ui-btn ui-btn--primary" href="/academia/minhas-aulas">Continuar estudando</a>
      <a class="ui-btn ui-btn--outline" href="/academia/professor-ia">Professor IA</a>
    </div>
  </header>

  <%- include(incluir('_menu')) %>

  <section class="academia-kpis" aria-label="Indicadores da Academia">
    <article class="academia-kpi"><span class="academy-kpi-label">Em andamento</span><strong class="valor"><%= indicadores.cursos_em_andamento || 0 %></strong></article>
    <article class="academia-kpi"><span class="academy-kpi-label">Concluídos</span><strong class="valor"><%= indicadores.cursos_concluidos || 0 %></strong></article>
    <article class="academia-kpi"><span class="academy-kpi-label">Certificados</span><strong class="valor"><%= indicadores.certificados || 0 %></strong></article>
    <article class="academia-kpi"><span class="academy-kpi-label">Horas de treinamento</span><strong class="valor"><%= indicadores.horas_treinamento || 0 %>h</strong></article>
    <article class="academia-kpi"><span class="academy-kpi-label">Ranking</span><strong class="valor"><%= minhaPosicao ? `${minhaPosicao.posicao}º` : '-' %></strong></article>
    <article class="academia-kpi"><span class="academy-kpi-label">Próxima trilha</span><strong class="valor valor-sm"><%= trilhaRecomendada?.nome || 'Conhecimento da Fábrica' %></strong></article>
  </section>

  <section class="academia-grid academia-layout-2">
    <article class="academy-panel">
      <div class="academy-section-head"><div><h2>Continuar estudando</h2><p>Retome os cursos já iniciados.</p></div><a class="ui-btn ui-btn--outline ui-btn--compact" href="/academia/minhas-aulas">Ver minhas aulas</a></div>
      <% if (!continuarEstudando.length) { %><div class="academy-empty">Nenhum curso em andamento.</div><% } %>
      <div class="academy-list">
        <% continuarEstudando.forEach(function(c){ %>
          <a class="academy-row" href="/academia/curso/<%= c.id %>">
            <div><strong><%= c.titulo %></strong><div class="academy-progress-meta"><span>Progresso</span><span><%= c.progresso_percentual %>%</span></div></div>
            <span class="academy-badge"><%= c.progresso_percentual %>%</span>
          </a>
        <% }) %>
      </div>
    </article>

    <article class="academy-panel">
      <div class="academy-section-head"><div><h2>Avisos da Academia</h2><p>Comunicados sobre capacitação e conteúdo.</p></div></div>
      <% if (!avisosAcademia.length) { %><div class="academy-empty">Nenhum aviso disponível.</div><% } %>
      <div class="academy-list">
        <% avisosAcademia.forEach(function(a){ %>
          <div class="academy-list-item"><div><strong><%= a.titulo %></strong><p><%= a.descricao %></p></div></div>
        <% }) %>
      </div>
    </article>
  </section>

  <section class="academia-grid academia-layout-3">
    <article class="academy-panel">
      <div class="academy-section-head"><div><h3>Cursos em destaque</h3><p>Conteúdos para evolução técnica.</p></div><a class="ui-btn ui-btn--outline ui-btn--compact" href="/academia/cursos">Ver cursos</a></div>
      <% if (!cursosDestaque.length) { %><div class="academy-empty">Nenhum curso em destaque.</div><% } %>
      <% cursosDestaque.forEach(function(c){ %><a class="academy-row" href="/academia/curso/<%= c.id %>"><span><strong><%= c.titulo %></strong><small class="muted-xs"><%= c.trilha_nome || 'Sem trilha' %></small></span><span class="academy-badge"><%= c.carga_horaria %>h</span></a><% }) %>
    </article>

    <article class="academy-panel">
      <div class="academy-section-head"><div><h3>Trilhas disponíveis</h3><p>Organização do aprendizado por área.</p></div><a class="ui-btn ui-btn--outline ui-btn--compact" href="/academia/trilhas">Ver trilhas</a></div>
      <% if (!trilhas.length) { %><div class="academy-empty">Nenhuma trilha disponível.</div><% } %>
      <% trilhas.slice(0,7).forEach(function(t){ %><a class="academy-row" href="/academia/trilha/<%= t.id %>"><span><strong><%= t.nome %></strong><small class="muted-xs"><%= t.total_cursos %> cursos</small></span><span class="academy-badge"><%= t.progresso_percentual %>%</span></a><% }) %>
    </article>

    <article class="academy-panel">
      <div class="academy-section-head"><div><h3>Últimos certificados</h3><p>Conquistas recentes registradas.</p></div><a class="ui-btn ui-btn--outline ui-btn--compact" href="/academia/certificados">Ver certificados</a></div>
      <% if (!ultimosCertificados.length) { %><div class="academy-empty">Sem certificados ainda.</div><% } %>
      <% ultimosCertificados.forEach(function(c){ %><a class="academy-row" href="/academia/certificados"><span><strong><%= c.curso_titulo %></strong></span><span class="academy-badge"><%= c.tipo %></span></a><% }) %>
    </article>
  </section>

  <section class="academy-panel">
    <div class="academy-section-head"><div><h2>Recomendação da IA</h2><p>Próximo passo sugerido a partir do seu progresso atual.</p></div></div>
    <div class="academy-note"><%= recomendacaoIA %></div>
  </section>
</main>
<script src="/js/academia.js"></script>
