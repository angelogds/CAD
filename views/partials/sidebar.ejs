<%
  const role = (typeof normalizeRole === 'function')
    ? normalizeRole(user?.role || '')
    : String(user?.role || '').toUpperCase();

  const can = (moduleKey) => {
    if (typeof canAccessModule !== 'function') return false;
    return canAccessModule(role, moduleKey);
  };

  const canPainel = can('painel_operacional');
  const canPCM = can('pcm');
  const canEquipamentos = can('equipamentos');
  const canOS = can('os_view');
  const canOSChat = can('os_chat_read');
  const canPreventivas = can('preventivas_view');
  const canDemandas = can('demandas_view');
  const canSolicitacoes = can('solicitacoes_read');
  const canCompras = can('compras');
  const canFornecedores = can('fornecedores');
  const canAlmoxarifado = can('almoxarifado_read');
  const canEstoque = can('estoque_view');
  const canMotores = can('motores');
  const canAvisos = can('avisos_view');
  const canUsuarios = can('usuarios');
  const canArmazenamento = ['ADMIN','ENCARREGADO_MANUTENCAO','MANUTENCAO_SUPERVISOR','SUPERVISOR_MANUTENCAO'].includes(role);
  const canEscala = can('escala');
  const canInspecao = can('inspecao_view');
  const canTracagem = can('tracagem_view');
  const canDesenhoTecnico = can('desenho_tecnico_view');
  const canAcademia = can('academia_view');
  const canAI = role !== 'INSPECAO_QUALIDADE' && can('assistente_manutencao');
  const isCompras = role === 'COMPRAS';

  const currentPcmSection = (typeof activePcmSection !== 'undefined' ? activePcmSection : '');

  const counters = operationalCounters || { osAbertas: 0, osCriticas: 0, preventivasHoje: 0 };
  const badge = (value, kind = 'gray') => value > 0
    ? `<span class="pill-tag pill-${kind}" style="margin-left:auto; font-size:10px; padding:2px 7px;">${value}</span>`
    : '';
  const navItem = (href, label, isActive, extraClass = '', suffix = '') =>
    `<a class="nav-item ${extraClass} ${isActive ? 'active' : ''}" href="${href}"><span class="nav-label">${label}</span>${suffix}</a>`;

  const hasOperationGroup = canPainel || canEquipamentos || canOS || canOSChat || canPreventivas || canDemandas || canSolicitacoes || canCompras || canFornecedores || canAlmoxarifado || canEstoque || canMotores;
  const hasSupportGroup = canAvisos || canEscala || canInspecao || canTracagem || canDesenhoTecnico || canAcademia || canAI || canPCM;
%>

<aside class="sidebar">
  <div class="sidebar-title">
    <span class="sidebar-brand-title">Gestão Industrial</span>
    <small class="sidebar-brand-subtitle">Manutenção Integrada</small>
  </div>

  <nav class="nav" aria-label="Navegação principal">
    <% if (hasOperationGroup) { %><div class="nav-section nav-section-shell">OPERAÇÃO</div><% } %>
    <% if (canPainel) { %><%- navItem('/dashboard', 'Painel Principal', activeMenu === 'dashboard') %><% } %>
    <% if (canEquipamentos) { %><%- navItem('/equipamentos', 'Equipamentos', activeMenu === 'equipamentos') %><% } %>
    <% if (canOS) { %><%- navItem('/os', 'Ordens de Serviço', activeMenu === 'os', '', badge(counters.osAbertas, counters.osCriticas > 0 ? 'amber' : 'gray')) %><% } %>
    <% if (canOSChat) { %><%- navItem('/chat-os', 'Chat de OS', activeMenu === 'os-chat', '', badge(counters.osChatNaoLidas || 0, 'green')) %><% } %>
    <% if (canPreventivas) { %><%- navItem('/preventivas', 'Preventivas', activeMenu === 'preventivas', '', badge(counters.preventivasHoje, 'blue')) %><% } %>
    <% if (canDemandas) { %><%- navItem('/demandas', 'Demandas', activeMenu === 'demandas') %><% } %>
    <% if (canSolicitacoes && !isCompras) { %><%- navItem('/solicitacoes/minhas', 'Solicitações', activeMenu === 'solicitacoes') %><% } %>
    <% if (canCompras) { %><%- navItem('/compras/solicitacoes', 'Compras', activeMenu === 'compras') %><% } %>
    <% if (canFornecedores) { %><%- navItem('/fornecedores', 'Fornecedores', activeMenu === 'fornecedores') %><% } %>
    <% if (canAlmoxarifado) { %><%- navItem('/almoxarifado/recebimentos', 'Almoxarifado', activeMenu === 'almoxarifado') %><% } %>
    <% if (canEstoque) { %><%- navItem('/estoque', 'Estoque', activeMenu === 'estoque') %><% } %>
    <% if (canMotores) { %><%- navItem('/motores', 'Motores', activeMenu === 'motores') %><% } %>

    <% if (hasSupportGroup) { %>
      <div class="nav-divider nav-divider-soft"></div>
      <div class="nav-section nav-section-shell">GESTÃO E APOIO</div>
    <% } %>
    <% if (canAvisos) { %><%- navItem('/avisos', 'Avisos', activeMenu === 'avisos') %><% } %>
    <% if (canEscala) { %><%- navItem('/escala', 'Escala', activeMenu === 'escala') %><% } %>
    <% if (canInspecao) { %><%- navItem('/inspecao', 'Inspeção', activeMenu === 'inspecao') %><% } %>
    <% if (canTracagem) { %><%- navItem('/tracagem', 'Traçagem', activeMenu === 'tracagem') %><% } %>
    <% if (canDesenhoTecnico) { %><%- navItem('/desenho-tecnico', 'Desenho Técnico', activeMenu === 'desenho-tecnico') %><% } %>
    <% if (canAcademia) { %><%- navItem('/academia', 'Academia da Manutenção', activeMenu === 'academia') %><% } %>
    <% if (canAI) { %><%- navItem('/ai/chat', 'Assistente da Manutenção', activeMenu === 'ai') %><% } %>

    <% if (canPCM) { %>
      <%- navItem('/pcm', 'PCM – Planejamento', activeMenu === 'pcm') %>
      <% if (activeMenu === 'pcm') { %>
        <div class="nav-submenu">
          <a class="nav-item nav-subitem <%= currentPcmSection === 'visao-geral' ? 'active' : '' %>" href="/pcm"><span class="nav-label">Visão Geral</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'dashboard-gerencial' ? 'active' : '' %>" href="/pcm/dashboard-gerencial"><span class="nav-label">Painel da Diretoria</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'planejamento' ? 'active' : '' %>" href="/pcm/planejamento"><span class="nav-label">Plano Mestre</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'programacao-semanal' ? 'active' : '' %>" href="/pcm/programacao-semanal"><span class="nav-label">Programação Semanal</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'lubrificacao' ? 'active' : '' %>" href="/pcm/lubrificacao"><span class="nav-label">Plano de Lubrificação</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'engenharia' ? 'active' : '' %>" href="/pcm/engenharia"><span class="nav-label">Engenharia e Criticidade</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'falhas' ? 'active' : '' %>" href="/pcm/falhas"><span class="nav-label">Falhas e Confiabilidade</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'pecas-criticas' ? 'active' : '' %>" href="/pcm/pecas-criticas"><span class="nav-label">Peças Críticas</span></a>
          <a class="nav-item nav-subitem <%= currentPcmSection === 'relatorios-avancados' ? 'active' : '' %>" href="/pcm/relatorios-avancados"><span class="nav-label">Relatórios e Indicadores</span></a>
        </div>
      <% } %>
    <% } %>

    <% if (canUsuarios || canArmazenamento) { %>
      <div class="nav-divider"></div>
      <div class="nav-section">ADMIN</div>
      <% if (canUsuarios) { %><%- navItem('/usuarios', 'Gerenciar Usuários', activeMenu === 'usuarios') %><% } %>
      <% if (canArmazenamento) { %><%- navItem('/admin/armazenamento', 'Armazenamento', activeMenu === 'admin-armazenamento') %><%- navItem('/admin/limpeza-volume', 'Limpeza de volume', activeMenu === 'admin-limpeza-volume') %><% } %>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <a href="/tv" target="_blank" rel="noopener" class="nav-item sidebar-tv-link">
      <span class="nav-label">Modo TV</span>
    </a>
    <small>© <%= new Date().getFullYear() %> Campo do Gado</small>
  </div>
</aside>
