<style>
  .ai-voice-global{position:fixed;right:max(20px,env(safe-area-inset-right));bottom:max(20px,env(safe-area-inset-bottom));z-index:85;display:flex;flex-direction:column;align-items:flex-end;gap:10px;font-family:inherit}
  .ai-voice-global[hidden]{display:none!important}
  .ai-voice-bubble{width:min(270px,calc(100vw - 32px));box-sizing:border-box;padding:12px 14px;border:1px solid #d9e9df;border-radius:18px 18px 5px 18px;background:rgba(255,255,255,.98);box-shadow:0 14px 34px rgba(15,23,42,.16);opacity:0;transform:translateY(8px) scale(.97);pointer-events:none;transition:opacity .18s ease,transform .18s ease}
  .ai-voice-global:not([data-state="idle"]) .ai-voice-bubble{opacity:1;transform:translateY(0) scale(1)}
  .ai-voice-greeting{font-size:13px;line-height:1.25;color:#126b3f;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ai-voice-status-row{display:flex;align-items:center;gap:10px;margin-top:7px}
  .ai-voice-status{min-width:0;flex:1;font-size:11px;line-height:1.35;color:#667085}
  .ai-voice-wave{height:18px;display:flex;align-items:center;gap:2px;flex:0 0 auto}
  .ai-voice-wave span{display:block;width:2px;height:5px;border-radius:999px;background:#159455;animation:aiVoiceWave 1s ease-in-out infinite;animation-play-state:paused}
  .ai-voice-wave span:nth-child(2){animation-delay:.12s}.ai-voice-wave span:nth-child(3){animation-delay:.24s}.ai-voice-wave span:nth-child(4){animation-delay:.36s}.ai-voice-wave span:nth-child(5){animation-delay:.48s}
  .ai-voice-global[data-state="speaking"] .ai-voice-wave span,.ai-voice-global[data-state="listening"] .ai-voice-wave span{animation-play-state:running}
  .ai-voice-orb{position:relative;width:68px;height:68px;padding:0;border:0;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,#23b768,#087d43);box-shadow:0 13px 30px rgba(8,125,67,.30),inset 0 1px 0 rgba(255,255,255,.32);cursor:pointer;isolation:isolate;transition:transform .16s ease,box-shadow .16s ease,filter .16s ease}
  .ai-voice-orb::before,.ai-voice-orb::after{content:"";position:absolute;inset:-7px;border-radius:50%;border:2px solid rgba(34,197,94,.27);z-index:-1;animation:aiVoicePulse 2.1s ease-out infinite}
  .ai-voice-orb::after{inset:-14px;border-color:rgba(34,197,94,.13);animation-delay:1.05s}
  .ai-voice-orb:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(8,125,67,.36),inset 0 1px 0 rgba(255,255,255,.35)}
  .ai-voice-orb:focus-visible{outline:4px solid rgba(34,197,94,.22);outline-offset:5px}
  .ai-voice-orb:disabled{cursor:wait;filter:saturate(.72);opacity:.82}
  .ai-voice-orb svg{width:32px;height:32px;display:block;filter:drop-shadow(0 1px 2px rgba(0,0,0,.13))}
  .ai-voice-global[data-state="starting"] .ai-voice-orb,.ai-voice-global[data-state="thinking"] .ai-voice-orb{background:linear-gradient(145deg,#f5a623,#d97706);box-shadow:0 13px 30px rgba(217,119,6,.28)}
  .ai-voice-global[data-state="listening"] .ai-voice-orb{box-shadow:0 0 0 8px rgba(34,197,94,.12),0 15px 34px rgba(8,125,67,.34)}
  .ai-voice-global[data-state="speaking"] .ai-voice-orb{background:linear-gradient(145deg,#2dd47a,#07843f);box-shadow:0 0 0 10px rgba(34,197,94,.14),0 16px 38px rgba(8,125,67,.38);transform:scale(1.04)}
  .ai-voice-global[data-state="error"] .ai-voice-orb{background:linear-gradient(145deg,#ef5c5c,#c73535);box-shadow:0 13px 30px rgba(199,53,53,.27)}
  .ai-voice-global[data-state="error"] .ai-voice-bubble{border-color:#f3c2c2}.ai-voice-global[data-state="error"] .ai-voice-greeting{color:#b42318}
  .ai-voice-hint{position:absolute;right:78px;bottom:18px;padding:6px 9px;border-radius:999px;background:#fff;border:1px solid #d9e9df;color:#137a46;font-size:10px;font-weight:800;white-space:nowrap;box-shadow:0 8px 20px rgba(15,23,42,.10);opacity:0;transform:translateX(5px);transition:.15s;pointer-events:none}
  .ai-voice-orb:hover+.ai-voice-hint,.ai-voice-orb:focus-visible+.ai-voice-hint{opacity:1;transform:translateX(0)}
  @keyframes aiVoicePulse{0%{transform:scale(.88);opacity:.72}75%,100%{transform:scale(1.18);opacity:0}}
  @keyframes aiVoiceWave{0%,100%{height:5px;opacity:.55}50%{height:16px;opacity:1}}
  @media(max-width:620px){.ai-voice-global{right:max(14px,env(safe-area-inset-right));bottom:max(14px,env(safe-area-inset-bottom))}.ai-voice-orb{width:62px;height:62px}.ai-voice-orb svg{width:29px;height:29px}.ai-voice-hint{display:none}.ai-voice-bubble{width:min(250px,calc(100vw - 28px))}}
  @media(prefers-reduced-motion:reduce){.ai-voice-orb,.ai-voice-orb::before,.ai-voice-orb::after,.ai-voice-wave span,.ai-voice-bubble{animation:none!important;transition:none!important}}
</style>

<div id="aiGlobalVoice" class="ai-voice-global" data-state="idle" data-user-name="<%= user.name || 'Usuário' %>" data-user-role="<%= String(user.role || '').toUpperCase() %>">
  <div id="aiGlobalVoiceBubble" class="ai-voice-bubble" role="status" aria-live="polite" aria-atomic="true">
    <div id="aiGlobalVoiceGreeting" class="ai-voice-greeting">Assistente por voz</div>
    <div class="ai-voice-status-row">
      <div id="aiGlobalVoiceStatus" class="ai-voice-status">Pronto para conversar</div>
      <div class="ai-voice-wave" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    </div>
  </div>

  <div style="position:relative;">
    <button id="aiGlobalLauncher" class="ai-voice-orb" type="button" aria-label="Iniciar assistente por voz" aria-pressed="false" title="Assistente por voz">
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M16 4.5a4.5 4.5 0 0 0-4.5 4.5v6.2a4.5 4.5 0 0 0 9 0V9A4.5 4.5 0 0 0 16 4.5Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        <path d="M7.8 14.6v.7a8.2 8.2 0 0 0 16.4 0v-.7M16 23.5v4M12 27.5h8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        <path d="M24.3 6.2l.7 1.7 1.7.7-1.7.7-.7 1.7-.7-1.7-1.7-.7 1.7-.7.7-1.7Z" fill="currentColor" opacity=".92"/>
      </svg>
    </button>
    <span class="ai-voice-hint">Assistente por voz</span>
  </div>
  <audio id="aiGlobalVoiceAudio" autoplay playsinline></audio>
</div>
