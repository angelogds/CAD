<% layout('layout') %><link rel="stylesheet" href="/css/fornecedores.css"><script src="/js/fornecedores.js" defer></script>
<% const money=c=>(Number(c||0)/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});const canManage=canAccessModule(user?.role,'fornecedores_manage');const qs=new URLSearchParams();if(selectionContext){qs.set('solicitacao_id',selectionContext.solicitacaoId);if(selectionContext.itemId)qs.set('item_id',selectionContext.itemId)} %>
<div class="supplier-page"><header class="supplier-head"><div><h1>Fornecedores</h1><p>Cadastro, seleção e histórico dos parceiros de compra</p></div><% if(canManage){%><a class="ui-btn" href="/fornecedores/novo<%= qs.toString()?'?'+qs:'' %>">＋ Novo fornecedor</a><%}%></header>
<section class="supplier-metrics"><a href="?situacao=ATIVO"><small>Fornecedores ativos</small><strong><%=metrics.ativos||0%></strong></a><a href="#categorias"><small>Categorias</small><strong><%=metrics.categorias||0%></strong></a><a href="?situacao=ATIVO"><small>Cotações no período</small><strong><%=metrics.cotacoes||0%></strong></a><a href="#historico"><small>Compras concluídas</small><strong><%=metrics.compras||0%></strong></a></section>
<section class="supplier-card supplier-search"><h2>Localizar fornecedor</h2><form method="get"><input class="input search-main" name="q" value="<%=filters.q%>" placeholder="Nome, CNPJ, cidade, produto ou serviço"><select class="input" name="categoria"><option value="">Categoria</option><%categories.forEach(c=>{%><option value="<%=c.id%>" <%=String(filters.categoria)===String(c.id)?'selected':''%>><%=c.nome%></option><%})%></select><input class="input" name="local" value="<%=filters.local%>" placeholder="Cidade/UF"><select class="input" name="situacao"><option value="">Situação</option><option value="ATIVO" <%=filters.situacao==='ATIVO'?'selected':''%>>Ativos</option><option value="INATIVO" <%=filters.situacao==='INATIVO'?'selected':''%>>Inativos</option></select><label class="check-filter"><input type="checkbox" name="favorito" value="1" <%=filters.favorito==='1'?'checked':''%>> Favoritos</label><label class="check-filter"><input type="checkbox" name="pendencia" value="1" <%=filters.pendencia==='1'?'checked':''%>> Pendências</label><button class="ui-btn" type="submit">Filtrar</button><a class="ui-btn ghost" href="/fornecedores">Limpar filtros</a></form><div class="quick"><b>Busca rápida:</b><%quick.forEach(c=>{%><a href="?q=<%=encodeURIComponent(c.nome)%>"><%=c.nome%></a><%})%></div></section>
<section class="supplier-card supplier-list"><nav><a href="?situacao=ATIVO">Fornecedores ativos</a><a href="?favorito=1">Favoritos</a><a href="?situacao=INATIVO">Inativos</a><a href="?pendencia=1">Pendências cadastrais</a></nav>
<%if(!fornecedores.length){%><div class="supplier-empty"><h3><%=Object.values(filters).some(Boolean)?'Nenhum fornecedor encontrado para os filtros informados.':'Comece seu cadastro de parceiros'%></h3><p>Cadastre contatos, produtos e serviços para agilizar as próximas cotações.</p><a class="ui-btn ghost" href="/fornecedores">Limpar filtros</a> <%if(canManage){%><a class="ui-btn" href="/fornecedores/novo">Cadastrar <%=Object.values(filters).some(Boolean)?'novo fornecedor':'primeiro fornecedor'%></a><%}%></div><%}else{%><div class="supplier-table"><div class="supplier-row supplier-columns"><span>Fornecedor</span><span>Produtos e serviços</span><span>Local / Contato</span><span>Desempenho</span><span>Última compra</span><span>Ações</span></div><%fornecedores.forEach(f=>{const tags=[...f.categorias,...f.produtos_servicos.map(x=>x.nome),...(f.marcas?f.marcas.split(','):[])];%><article class="supplier-row"><div data-label="Fornecedor"><span class="status <%=f.situacao==='ATIVO'?'active':''%>"><%=f.situacao%></span><strong><%=f.nome_fantasia||f.nome%></strong><small><%=f.razao_social&&f.razao_social!==f.nome_fantasia?f.razao_social+' · ':''%><%=f.cnpj||'CNPJ não informado'%></small></div><div data-label="Produtos e serviços" class="tags"><%tags.slice(0,3).forEach(t=>{%><span><%=t%></span><%})%><%if(tags.length>3){%><details><summary>+<%=tags.length-3%> produtos</summary><p><%=tags.slice(3).join(' · ')%></p></details><%}%></div><div data-label="Local / Contato"><b><%=(f.cidade||'Local não informado')+(f.uf?' / '+f.uf:'')%></b><small><%=f.responsavel_comercial||'Contato não informado'%> · <%=f.whatsapp||f.telefone||'sem telefone'%></small><small><%=f.email||''%></small></div><div data-label="Desempenho"><%if(Number(f.total_cotacoes)+Number(f.total_compras)){%><b><%=f.total_cotacoes%> cotações · <%=f.total_compras%> compras</b><small><%=f.lead_time_medio_dias?`Prazo cadastrado: ${f.lead_time_medio_dias} dias`:'Prazo não informado'%></small><small>Total: <%=money(f.valor_total_centavos)%></small><%}else{%><span class="muted">Sem histórico suficiente</span><%}%></div><div data-label="Última compra"><b><%=f.ultima_compra_item||'Sem compras'%></b><small><%=f.ultima_compra_em?new Date(f.ultima_compra_em).toLocaleDateString('pt-BR'):'—'%></small></div><div data-label="Ações" class="actions"><%if(selectionContext){%><a class="ui-btn tiny" href="<%=selectionContext.returnTo%>?fornecedor_selecionado=<%=f.id%><%=selectionContext.itemId?'&item_id='+selectionContext.itemId:''%>">Selecionar</a><%}else{%><a class="ui-btn tiny" href="/fornecedores/<%=f.id%>">Ver perfil</a><%}%><%if(canManage){%><a class="ui-btn tiny ghost" href="/fornecedores/<%=f.id%>/editar">Editar</a><form method="post" action="/fornecedores/<%=f.id%>/favorito"><button title="Favoritar">★</button></form><%}%></div></article><%})%></div><%}%></section>
<div class="supplier-bottom"><section class="supplier-card" id="historico"><h2>Histórico recente de compras</h2><%if(!recent.length){%><p class="muted">Nenhuma compra concluída.</p><%}else{%><div class="history-list"><%recent.forEach(r=>{%><div><b><%=r.item_nome||'Item não informado'%></b><span><%=r.fornecedor_nome||'Fornecedor histórico'%></span><span><%=r.comprado_em?new Date(r.comprado_em).toLocaleDateString('pt-BR'):'—'%></span><span><%=r.qtd_comprada||r.qtd_solicitada%> <%=r.unidade||'UN'%></span><span><%=money(r.valor_unitario_centavos)%></span><span><%=r.solicitacao_numero||('OS '+(r.os_id||'—'))%></span></div><%})%></div><%}%></section><section class="supplier-card"><h2>Materiais mais comprados</h2><p class="muted">Métrica: quantidade de compras concluídas</p><%const max=Math.max(1,...popular.map(x=>x.total));popular.forEach(x=>{%><div class="bar"><span><%=x.nome%></span><i><b style="width:<%=x.total/max*100%>%"></b></i><strong><%=x.total%></strong></div><%})%></section></div></div>
