<% layout('layout') %>
<link rel="stylesheet" href="/css/fornecedores.css">
<script src="/js/fornecedores.js" defer></script>
<%
  const money = cents => (Number(cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const canManage = canAccessModule(user?.role, 'fornecedores_manage');
  const qs = new URLSearchParams();
  if (selectionContext) {
    qs.set('solicitacao_id', selectionContext.solicitacaoId);
    if (selectionContext.itemId) qs.set('item_id', selectionContext.itemId);
  }
  const hasFilters = Object.values(filters).some(Boolean);
  const withContext = href => qs.toString() ? `${href}${href.includes('?') ? '&' : '?'}${qs.toString()}` : href;
  const icon = (name, className = '') => {
    const paths = {
      plus: '<path d="M12 5v14M5 12h14"/>',
      building: '<path d="M3 21h18M6 21V5l6-2v18M18 21V9l-6-2M9 9h.01M9 13h.01M9 17h.01M15 13h.01M15 17h.01"/>',
      tag: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
      file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/>',
      cart: '<circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M3 4h2l2.4 10.4A2 2 0 0 0 9.35 16H18a2 2 0 0 0 1.9-1.37L21 8H6"/>',
      search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
      users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
      edit: '<path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"/>',
      star: '<path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>',
      arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>'
    };
    return `<svg class="supplier-icon ${className}" aria-hidden="true" viewBox="0 0 24 24">${paths[name] || ''}</svg>`;
  };
  const quickLabels = ['Automação', 'Caldeiraria', 'Correias', 'EPI', 'Hidráulica', 'Instrumentação', 'Material elétrico', 'Motores'];
%>
<div class="supplier-page">
  <header class="supplier-head">
    <div>
      <h1>Fornecedores</h1>
      <p>Cadastro, seleção e histórico dos parceiros de compra</p>
    </div>
    <% if (canManage) { %>
      <a class="supplier-btn supplier-btn-primary" href="/fornecedores/novo<%= qs.toString() ? '?' + qs : '' %>"><%- icon('plus') %> Novo fornecedor</a>
    <% } %>
  </header>

  <section class="supplier-metrics" aria-label="Indicadores de fornecedores">
    <a class="supplier-metric metric-green" href="?situacao=ATIVO"><span class="metric-icon"><%- icon('building') %></span><span><small>Fornecedores ativos</small><strong><%= metrics.ativos || 0 %></strong></span></a>
    <a class="supplier-metric metric-teal" href="#categorias"><span class="metric-icon"><%- icon('tag') %></span><span><small>Categorias</small><strong><%= metrics.categorias || 0 %></strong></span></a>
    <a class="supplier-metric metric-blue" href="?situacao=ATIVO"><span class="metric-icon"><%- icon('file') %></span><span><small>Cotações no período</small><strong><%= metrics.cotacoes || 0 %></strong></span></a>
    <a class="supplier-metric metric-orange" href="#historico"><span class="metric-icon"><%- icon('cart') %></span><span><small>Compras concluídas</small><strong><%= metrics.compras || 0 %></strong></span></a>
  </section>

  <section class="supplier-card supplier-search" id="categorias">
    <div class="card-heading"><div><h2>Localizar fornecedor</h2><p>Encontre parceiros por identificação, localização ou especialidade.</p></div></div>
    <form method="get" class="supplier-filter-form">
      <% if (selectionContext) { %><input type="hidden" name="solicitacao_id" value="<%= selectionContext.solicitacaoId %>"><input type="hidden" name="item_id" value="<%= selectionContext.itemId || '' %>"><% } %>
      <label class="filter-field filter-search"><span>Busca</span><span class="input-with-icon"><%- icon('search') %><input class="supplier-input" name="q" value="<%= filters.q %>" placeholder="Nome, CNPJ, cidade, produto ou serviço"></span></label>
      <label class="filter-field"><span>Categoria</span><select class="supplier-input" name="categoria"><option value="">Todas</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= String(filters.categoria) === String(c.id) ? 'selected' : '' %>><%= c.nome %></option><% }) %></select></label>
      <label class="filter-field"><span>Cidade / UF</span><input class="supplier-input" name="local" value="<%= filters.local %>" placeholder="Cidade ou UF"></label>
      <label class="filter-field"><span>Situação</span><select class="supplier-input" name="situacao"><option value="">Todas</option><option value="ATIVO" <%= filters.situacao === 'ATIVO' ? 'selected' : '' %>>Ativos</option><option value="INATIVO" <%= filters.situacao === 'INATIVO' ? 'selected' : '' %>>Inativos</option></select></label>
      <div class="filter-actions"><button class="supplier-btn supplier-btn-primary" type="submit">Filtrar</button><a class="supplier-btn supplier-btn-quiet" href="/fornecedores<%= qs.toString() ? '?' + qs : '' %>">Limpar filtros</a></div>
      <fieldset class="filter-secondary"><legend>Filtros adicionais</legend><label><input type="checkbox" name="favorito" value="1" <%= filters.favorito === '1' ? 'checked' : '' %>> Somente favoritos</label><label><input type="checkbox" name="pendencia" value="1" <%= filters.pendencia === '1' ? 'checked' : '' %>> Com pendências cadastrais</label></fieldset>
    </form>
    <div class="quick-filters"><strong>Busca rápida:</strong><div><% quickLabels.forEach(label => { const active = String(filters.q || '').toLocaleLowerCase('pt-BR') === label.toLocaleLowerCase('pt-BR'); %><a class="quick-chip <%= active ? 'is-selected' : '' %>" href="<%= withContext('?q=' + encodeURIComponent(label)) %>"><%= label %></a><% }) %></div></div>
  </section>

  <section class="supplier-card supplier-list">
    <nav class="supplier-tabs" aria-label="Visualizações da lista">
      <a class="<%= filters.situacao === 'ATIVO' && !filters.favorito && !filters.pendencia ? 'is-active' : '' %>" href="<%= withContext('?situacao=ATIVO') %>">Fornecedores ativos</a>
      <a class="<%= filters.favorito === '1' ? 'is-active' : '' %>" href="<%= withContext('?favorito=1') %>">Favoritos</a>
      <a class="<%= filters.situacao === 'INATIVO' ? 'is-active' : '' %>" href="<%= withContext('?situacao=INATIVO') %>">Inativos</a>
      <a class="<%= filters.pendencia === '1' ? 'is-active' : '' %>" href="<%= withContext('?pendencia=1') %>">Pendências cadastrais</a>
    </nav>
    <% if (!fornecedores.length) { %>
      <div class="supplier-empty"><span class="empty-icon"><%- icon('users') %></span><h3><%= hasFilters ? 'Nenhum fornecedor encontrado' : 'Comece seu cadastro de parceiros' %></h3><p><%= hasFilters ? 'Revise os critérios ou limpe os filtros para visualizar outros parceiros.' : 'Cadastre contatos, produtos e serviços para agilizar as próximas cotações.' %></p><div><% if (hasFilters) { %><a class="supplier-btn supplier-btn-secondary" href="/fornecedores<%= qs.toString() ? '?' + qs : '' %>">Limpar filtros</a><% } %><% if (canManage) { %><a class="supplier-btn supplier-btn-primary" href="/fornecedores/novo<%= qs.toString() ? '?' + qs : '' %>"><%- icon('plus') %> Cadastrar <%= hasFilters ? 'novo fornecedor' : 'primeiro fornecedor' %></a><% } %></div></div>
    <% } else { %>
      <div class="supplier-table">
        <div class="supplier-row supplier-columns"><span>Fornecedor</span><span>Produtos e serviços</span><span>Local / contato</span><span>Desempenho</span><span>Última compra</span><span>Ações</span></div>
        <% fornecedores.forEach(f => { const tags = [...new Set([...f.categorias, ...f.produtos_servicos.map(x => x.nome), ...(f.marcas ? f.marcas.split(',').map(x => x.trim()).filter(Boolean) : [])])]; %>
          <article class="supplier-row">
            <div data-label="Fornecedor" class="supplier-identity"><span class="status <%= f.situacao === 'ATIVO' ? 'active' : '' %>"><%= f.situacao %></span><strong><%= f.nome_fantasia || f.nome %></strong><small><%= f.razao_social && f.razao_social !== f.nome_fantasia ? f.razao_social : (f.cnpj || 'CNPJ não informado') %></small></div>
            <div data-label="Produtos e serviços" class="supplier-tags"><% tags.slice(0, 3).forEach(t => { %><span><%= t %></span><% }) %><% if (tags.length > 3) { %><details><summary>+<%= tags.length - 3 %> produtos</summary><p><%= tags.slice(3).join(' · ') %></p></details><% } %><% if (!tags.length) { %><small class="muted">Não informado</small><% } %></div>
            <div data-label="Local / contato"><b><%= f.cidade || 'Local não informado' %><%= f.uf ? ' • ' + f.uf : '' %></b><small><%= f.responsavel_comercial || 'Contato não informado' %><%= f.whatsapp ? ' • WhatsApp' : (f.telefone ? ' • Telefone' : '') %></small></div>
            <div data-label="Desempenho"><% if (Number(f.total_cotacoes) + Number(f.total_compras)) { %><b><%= f.total_cotacoes %> cotações • <%= f.total_compras %> compras</b><small><%= f.lead_time_medio_dias ? `Prazo cadastrado: ${f.lead_time_medio_dias} dias` : 'Prazo não informado' %></small><small>Total comprado: <%= money(f.valor_total_centavos) %></small><% } else { %><span class="muted">Sem histórico suficiente</span><% } %></div>
            <div data-label="Última compra"><b><%= f.ultima_compra_item || 'Sem compras' %></b><small><%= f.ultima_compra_em ? new Date(f.ultima_compra_em).toLocaleDateString('pt-BR') : '—' %></small></div>
            <div data-label="Ações" class="supplier-actions"><% if (selectionContext) { %><a class="supplier-btn supplier-btn-primary supplier-btn-small" href="<%= selectionContext.returnTo %>?fornecedor_selecionado=<%= f.id %><%= selectionContext.itemId ? '&item_id=' + selectionContext.itemId : '' %>">Selecionar</a><a class="supplier-link" href="/fornecedores/<%= f.id %>">Ver perfil</a><% } else { %><a class="supplier-btn supplier-btn-secondary supplier-btn-small" href="/fornecedores/<%= f.id %>">Ver perfil</a><% } %><% if (canManage) { %><div class="supplier-icon-actions"><a href="/fornecedores/<%= f.id %>/editar" title="Editar fornecedor" aria-label="Editar fornecedor"><%- icon('edit') %></a><form method="post" action="/fornecedores/<%= f.id %>/favorito"><button type="submit" title="Alternar favorito" aria-label="Alternar favorito"><%- icon('star', f.favorito ? 'is-filled' : '') %></button></form></div><% } %></div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <div class="supplier-bottom">
    <section class="supplier-card supplier-history" id="historico"><div class="card-heading"><div><h2>Histórico recente de compras</h2><p>Últimas movimentações concluídas</p></div><% if (recent.length) { %><a class="supplier-link" href="/fornecedores">Ver histórico completo <%- icon('arrow') %></a><% } %></div><% if (!recent.length) { %><p class="muted compact-empty">Nenhuma compra concluída.</p><% } else { %><div class="history-list"><div class="history-head"><b>Material</b><span>Fornecedor</span><span>Data</span><span>Quantidade</span><span>Valor unitário</span></div><% recent.forEach(r => { %><div><b data-label="Material"><%= r.item_nome || 'Item não informado' %></b><span data-label="Fornecedor"><%= r.fornecedor_nome || 'Fornecedor histórico' %></span><span data-label="Data"><%= r.comprado_em ? new Date(r.comprado_em).toLocaleDateString('pt-BR') : '—' %></span><span data-label="Quantidade"><%= r.qtd_comprada || r.qtd_solicitada %> <%= r.unidade || 'UN' %></span><span data-label="Valor unitário"><%= money(r.valor_unitario_centavos) %></span></div><% }) %></div><% } %></section>
    <section class="supplier-card supplier-popular"><div class="card-heading"><div><h2>Materiais mais comprados</h2><p>Quantidade de compras concluídas</p></div></div><% if (!popular.length) { %><p class="muted compact-empty">Ainda não há compras para comparar.</p><% } else { const max = Math.max(1, ...popular.map(x => x.total)); popular.forEach(x => { %><div class="supplier-bar"><div><span><%= x.nome %></span><strong><%= x.total %></strong></div><progress value="<%= x.total %>" max="<%= max %>" aria-label="<%= x.nome %>: <%= x.total %> compras"><%= x.total %></progress></div><% }) } %></section>
  </div>
</div>
