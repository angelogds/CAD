<% layout('layout') %>
<link rel="stylesheet" href="/css/fornecedores.css">
<%
  const money = cents => (Number(cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const icon = (name, className = '') => {
    const paths = {
      star: '<path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>',
      edit: '<path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4z"/>',
      file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>',
      cart: '<circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M3 4h2l2.4 10.4A2 2 0 0 0 9.35 16H18a2 2 0 0 0 1.9-1.37L21 8H6"/>',
      wallet: '<path d="M20 7V5a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h15v12H5a3 3 0 0 1-3-3V6M16 14h.01"/>',
      clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
      boxes: '<path d="m12 2 8 4-8 4-8-4 8-4zM4 10l8 4 8-4M4 14l8 4 8-4"/>'
    };
    return `<svg class="supplier-icon ${className}" aria-hidden="true" viewBox="0 0 24 24">${paths[name] || ''}</svg>`;
  };
%>
<div class="supplier-page">
  <header class="supplier-head profile-head">
    <div><span class="status <%= fornecedor.situacao === 'ATIVO' ? 'active' : '' %>"><%= fornecedor.situacao %></span><h1><%= fornecedor.nome_fantasia || fornecedor.nome %></h1><p><%= fornecedor.categorias.join(' • ') || 'Sem categoria' %> • <%= fornecedor.cidade || 'Local não informado' %><%= fornecedor.uf ? ' / ' + fornecedor.uf : '' %> • <%= fornecedor.responsavel_comercial || 'Contato não informado' %></p></div>
    <div><form method="post" action="/fornecedores/<%= fornecedor.id %>/favorito"><button class="supplier-btn supplier-btn-quiet"><%- icon('star', fornecedor.favorito ? 'is-filled' : '') %> <%= fornecedor.favorito ? 'Favorito' : 'Favoritar' %></button></form><a class="supplier-btn supplier-btn-secondary" href="/fornecedores/<%= fornecedor.id %>/editar"><%- icon('edit') %> Editar</a><form method="post" action="/fornecedores/<%= fornecedor.id %>/situacao"><button class="supplier-btn supplier-btn-primary"><%= fornecedor.situacao === 'ATIVO' ? 'Inativar' : 'Reativar' %></button></form></div>
  </header>
  <section class="supplier-metrics profile-metrics">
    <div class="supplier-metric metric-green"><span class="metric-icon"><%- icon('file') %></span><span><small>Cotações realizadas</small><strong><%= fornecedor.total_cotacoes || 0 %></strong></span></div>
    <div class="supplier-metric metric-teal"><span class="metric-icon"><%- icon('cart') %></span><span><small>Compras concluídas</small><strong><%= fornecedor.total_compras || 0 %></strong></span></div>
    <div class="supplier-metric metric-blue"><span class="metric-icon"><%- icon('wallet') %></span><span><small>Valor total comprado</small><strong class="metric-money"><%= money(fornecedor.valor_total_centavos) %></strong></span></div>
    <div class="supplier-metric metric-orange"><span class="metric-icon"><%- icon('clock') %></span><span><small>Prazo médio cadastrado</small><strong><%= fornecedor.lead_time_medio_dias ? fornecedor.lead_time_medio_dias + ' dias' : '—' %></strong></span></div>
    <div class="supplier-metric metric-green"><span class="metric-icon"><%- icon('boxes') %></span><span><small>Itens diferentes</small><strong><%= new Set(historico.map(x => x.item_nome)).size %></strong></span></div>
  </section>
  <section class="supplier-card profile-summary"><div class="card-heading"><div><h2>Resumo</h2><p>Dados cadastrais e comerciais do fornecedor</p></div></div><div><p><b>Identificação</b><br><%= fornecedor.razao_social || fornecedor.nome %><br><%= fornecedor.cnpj || 'CNPJ não informado' %></p><p><b>Contato</b><br><%= fornecedor.responsavel_comercial || '—' %><br><%= fornecedor.whatsapp || fornecedor.telefone || '—' %><br><%= fornecedor.email || '—' %></p><p><b>Produtos e serviços</b><br><%= fornecedor.categorias.join(', ') || '—' %><br><%= fornecedor.produtos_servicos.map(x => x.nome).join(', ') || '—' %><br>Marcas: <%= fornecedor.marcas || '—' %></p><p><b>Condições comerciais</b><br><%= fornecedor.condicao_pagamento || '—' %><br>Frete: <%= fornecedor.frete || '—' %><br>Região: <%= fornecedor.regiao_atendida || '—' %></p></div></section>
  <section class="supplier-card supplier-profile-history"><div class="card-heading"><div><h2>Cotações, compras e histórico de preços</h2><p>Consulte o relacionamento comercial registrado</p></div></div><form class="price-search"><input class="supplier-input" name="q" value="<%= q %>" placeholder="Pesquisar material, ex.: Válvula reguladora"><button class="supplier-btn supplier-btn-primary">Pesquisar</button></form><div class="history-list detailed"><div class="history-head"><b>Item</b><span>Solicitação / OS</span><span>Data</span><span>Quantidade</span><span>Preço unitário</span><span>Situação</span></div><% historico.forEach(h => { %><div><b data-label="Item"><%= h.item_nome || h.item_descricao || '—' %><small><%= h.unidade || 'UN' %> • <%= h.equipamento_nome || 'Equipamento não informado' %></small></b><span data-label="Solicitação / OS"><%= h.solicitacao_numero || '#' + h.solicitacao_id %> / <%= h.os_id || '—' %></span><span data-label="Data"><%= new Date(h.comprado_em || h.cotado_em).toLocaleDateString('pt-BR') %></span><span data-label="Quantidade"><%= h.qtd_comprada || h.qtd_solicitada %></span><span data-label="Preço unitário"><%= money(h.valor_unitario_centavos) %></span><span data-label="Situação"><%= h.status_compra === 'COMPRADO' ? 'Comprado' : 'Cotado' %></span></div><% }) %><% if (!historico.length) { %><p class="muted compact-empty">Sem histórico para o material pesquisado.</p><% } %></div></section>
</div>
