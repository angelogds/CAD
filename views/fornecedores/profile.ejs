<% layout('layout') %><link rel="stylesheet" href="/css/fornecedores.css"><%const money=c=>(Number(c||0)/100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});const purchases=historico.filter(x=>x.status_compra==='COMPRADO');%><div class="supplier-page"><header class="supplier-head profile-head"><div><span class="status active"><%=fornecedor.situacao%></span><h1><%=fornecedor.nome_fantasia||fornecedor.nome%></h1><p><%=fornecedor.categorias.join(' · ')%> · <%=(fornecedor.cidade||'Local não informado')+(fornecedor.uf?'/'+fornecedor.uf:'')%> · <%=fornecedor.responsavel_comercial||'Contato não informado'%></p></div><div><form method="post" action="/fornecedores/<%=fornecedor.id%>/favorito"><button class="ui-btn ghost">★ <%=fornecedor.favorito?'Favorito':'Favoritar'%></button></form><a class="ui-btn ghost" href="/fornecedores/<%=fornecedor.id%>/editar">Editar</a><form method="post" action="/fornecedores/<%=fornecedor.id%>/situacao"><button class="ui-btn"><%=fornecedor.situacao==='ATIVO'?'Inativar':'Reativar'%></button></form></div></header><section class="supplier-metrics profile-metrics"><div><small>Cotações realizadas</small><strong><%=fornecedor.total_cotacoes||0%></strong></div><div><small>Compras concluídas</small><strong><%=fornecedor.total_compras||0%></strong></div><div><small>Valor total comprado</small><strong><%=money(fornecedor.valor_total_centavos)%></strong></div><div><small>Prazo médio cadastrado</small><strong><%=fornecedor.lead_time_medio_dias?fornecedor.lead_time_medio_dias+' dias':'—'%></strong></div><div><small>Itens diferentes</small><strong><%=new Set(historico.map(x=>x.item_nome)).size%></strong></div></section><section class="supplier-card profile-summary"><h2>Resumo</h2><div><p><b>Identificação</b><br><%=fornecedor.razao_social||fornecedor.nome%><br><%=fornecedor.cnpj||'CNPJ não informado'%></p><p><b>Contato</b><br><%=fornecedor.responsavel_comercial||'—'%><br><%=fornecedor.whatsapp||fornecedor.telefone||'—'%><br><%=fornecedor.email||'—'%></p><p><b>Produtos e serviços</b><br><%=fornecedor.categorias.join(', ')||'—'%><br><%=fornecedor.produtos_servicos.map(x=>x.nome).join(', ')||'—'%><br>Marcas: <%=fornecedor.marcas||'—'%></p><p><b>Condições comerciais</b><br><%=fornecedor.condicao_pagamento||'—'%><br>Frete: <%=fornecedor.frete||'—'%><br>Região: <%=fornecedor.regiao_atendida||'—'%></p></div></section><section class="supplier-card"><h2>Cotações, compras e histórico de preços</h2><form class="price-search"><input class="input" name="q" value="<%=q%>" placeholder="Pesquisar material, ex.: Válvula reguladora"><button class="ui-btn">Pesquisar</button></form><div class="history-list detailed"><div><b>Item</b><span>Solicitação / OS</span><span>Data</span><span>Quantidade</span><span>Preço unitário</span><span>Situação</span></div><%historico.forEach(h=>{%><div><b><%=h.item_nome||h.item_descricao||'—'%><small><%=h.unidade||'UN'%> · <%=h.equipamento_nome||'Equipamento não informado'%></small></b><span><%=h.solicitacao_numero||'#'+h.solicitacao_id%> / <%=h.os_id||'—'%></span><span><%=new Date(h.comprado_em||h.cotado_em).toLocaleDateString('pt-BR')%></span><span><%=h.qtd_comprada||h.qtd_solicitada%></span><span><%=money(h.valor_unitario_centavos)%></span><span><%=h.status_compra==='COMPRADO'?'Comprado':'Cotado'%></span></div><%})%><%if(!historico.length){%><p class="muted">Sem histórico para o material pesquisado.</p><%}%></div></section></div>
