<%
  const currentTab = typeof tab !== 'undefined' && tab ? tab : (typeof estoqueTab !== 'undefined' ? estoqueTab : '');
  const isConfig = ['categorias', 'locais', 'cadastro'].includes(currentTab);
%>
<link rel="stylesheet" href="/css/estoque-nav-v12.css?v=20261013-v1" />
<nav class="subtabs stock-tabs--organized" aria-label="Navegação do estoque">
  <a class="subtab <%= currentTab === 'itens' ? 'active' : '' %>" href="/estoque" <%- currentTab === 'itens' ? 'aria-current="page"' : '' %>>Estoque</a>
  <a class="subtab <%= currentTab === 'reservas' ? 'active' : '' %>" href="/estoque/reservas" <%- currentTab === 'reservas' ? 'aria-current="page"' : '' %>>Para entregar</a>
  <a class="subtab <%= currentTab === 'movimentos' ? 'active' : '' %>" href="/estoque/movimentos" <%- currentTab === 'movimentos' ? 'aria-current="page"' : '' %>>Histórico de movimentações</a>
  <details class="stock-tabs-config" <%= isConfig ? 'open' : '' %>>
    <summary class="<%= isConfig ? 'is-current' : '' %>">Configurações do Almoxarifado</summary>
    <div class="stock-tabs-config__items">
      <a href="/estoque/itens/novo" <%- currentTab === 'cadastro' ? 'aria-current="page"' : '' %>>Cadastrar material</a>
      <a href="/estoque/categorias" <%- currentTab === 'categorias' ? 'aria-current="page"' : '' %>>Categorias</a>
      <a href="/estoque/locais" <%- currentTab === 'locais' ? 'aria-current="page"' : '' %>>Locais e prateleiras</a>
    </div>
  </details>
</nav>
