<% layout('layout') %>
<link rel="stylesheet" href="/css/almoxarifado-flow-v2.css?v=20260902-v1" />
<link rel="stylesheet" href="/css/almoxarifado-reservas-qr.css?v=20260902-v1" />
<link rel="stylesheet" href="/css/estoque-reservas.css?v=20260902-v1" />
<link rel="stylesheet" href="/css/estoque-setorial-v2.css?v=20260928-v1" />
<link rel="stylesheet" href="/css/estoque-compact-v6.css?v=20261007-v1" />
<%
  const dateBR = (v) => { if(!v)return ''; const d=String(v).slice(0,10).split('-'); return d.length===3?`${d[2]}/${d[1]}/${d[0]}`:String(v); };
  const reposicaoLabel = (s) => ({REPOR_URGENTE:'Urgente',REPOR:'Repor',PROGRAMAR_REPOSICAO:'Programar',OK:'Normal'})[s] || 'Normal';
  const reposicaoClass = (s) => s==='REPOR_URGENTE'?'is-danger':s==='REPOR'?'is-warning':s==='PROGRAMAR_REPOSICAO'?'is-info':'is-ok';
  const saldoDisponivelTotal = itens.reduce((s,i)=>s+Number(i.saldo_disponivel||0),0);
  const alertasReposicao = Number(inteligencia.criticos.length||0)+Number(inteligencia.programar.length||0);
  const hasAdvanced = Boolean(filtros.centro_custo || filtros.local_id);
%>

<div class="stock-v6-page">
  <header class="stock-v6-head" aria-label="ESTOQUE • ALMOXARIFADO DA MANUTENÇÃO">
    <div>
      <span class="stock-v6-eyebrow">ESTOQUE</span>
      <div class="stock-v6-titleline"><h1>Materiais em estoque</h1><span><%= itens.length %></span></div>
    </div>
    <div class="stock-v6-head-actions">
      <a class="btn btn-sm btn-ghost" href="/estoque/movimentos">Movimentos</a>
      <a class="btn btn-sm btn-green" href="/estoque/itens/novo">Novo item</a>
    </div>
  </header>

  <%- include('_tabs', { tab: 'itens' }) %>

  <section class="stock-v6-summary" aria-label="Resumo do estoque: Saldo físico, Reservado e Disponível livre">
    <div><span>Itens</span><strong><%= cards.itens %></strong></div>
    <div><span>Saldo livre</span><strong><%= saldoDisponivelTotal %></strong></div>
    <div><span>Reservado</span><strong><%= Number(cards.reservado||0) %></strong></div>
    <div class="<%=alertasReposicao?'has-alert':''%>"><span>Reposição</span><strong><%= alertasReposicao %></strong></div>
  </section>

  <section class="stock-v6-toolbar">
    <form class="stock-v6-filter-form" method="GET" action="/estoque">
      <label class="stock-v6-search"><span>Buscar</span><input class="input" name="q" value="<%= filtros.q %>" placeholder="Código ou nome do material" /></label>
      <label><span>Setor</span><select class="input" name="setor_utilizacao"><option value="">Todos</option><% setoresEstoque.forEach(s=>{ %><option value="<%=s%>" <%=filtros.setor_utilizacao===s?'selected':''%>><%=s%></option><% }) %></select></label>
      <label><span>Categoria</span><select class="input" name="categoria_id"><option value="">Todas</option><% categorias.forEach(c=>{ %><option value="<%=c.id%>" <%=String(filtros.categoria_id)===String(c.id)?'selected':''%>><%=c.nome%></option><% }) %></select></label>
      <label><span>Situação</span><select class="input" name="situacao"><option value="">Todas</option><option value="ok" <%=filtros.situacao==='ok'?'selected':''%>>Disponível</option><option value="baixo" <%=filtros.situacao==='baixo'?'selected':''%>>Abaixo do mínimo</option><option value="zerado" aria-label="Estoque zerado" <%=filtros.situacao==='zerado'?'selected':''%>>Zerado</option></select></label>
      <button class="btn btn-sm btn-green" type="submit">Filtrar</button>
      <a class="btn btn-sm btn-ghost" href="/estoque">Limpar</a>

      <details class="stock-v6-more" <%=hasAdvanced?'open':''%>>
        <summary>Mais filtros</summary>
        <div class="stock-v6-more-grid">
          <label><span>Centro de custo / subárea</span><input class="input" name="centro_custo" value="<%= filtros.centro_custo %>" list="centrosCusto" placeholder="Ex.: Caldeira / Frota" /><datalist id="centrosCusto"><% centrosCusto.forEach(c=>{ %><option value="<%=c.nome%>"><% }) %></datalist></label>
          <label><span>Local</span><select class="input" name="local_id"><option value="">Todos</option><% locais.forEach(l=>{ %><option value="<%=l.id%>" <%=String(filtros.local_id)===String(l.id)?'selected':''%>><%=l.nome%></option><% }) %></select></label>
        </div>
      </details>
    </form>
  </section>

  <details class="stock-v6-intelligence">
    <summary>
      <span><strong>Inteligência de reposição</strong><small>Consumo real, cobertura e materiais mais rotacionados</small></span>
      <b class="<%=alertasReposicao?'has-alert':''%>"><%=alertasReposicao%> alerta(s)</b>
    </summary>
    <div class="stock-v6-intelligence-grid">
      <article>
        <h3>Materiais mais rotacionados</h3>
        <div class="stock-v6-intel-list">
          <% inteligencia.maisRotacionados.slice(0,8).forEach((i,idx)=>{ %>
            <div><span>#<%=idx+1%></span><strong><%=i.nome%></strong><small><%=Number(i.consumo_90d||0).toFixed(2)%> <%=i.unidade||'UN'%> / 90d</small></div>
          <% }) %>
        </div>
      </article>
      <article>
        <h3>Reposição</h3>
        <div class="stock-v6-intel-list">
          <% [...inteligencia.criticos,...inteligencia.programar].slice(0,8).forEach(i=>{ %>
            <div><span class="stock-v6-badge <%=reposicaoClass(i.reposicao_status)%>"><%=reposicaoLabel(i.reposicao_status)%></span><strong><%=i.nome%></strong><small>Livre <%=Number(i.saldo_disponivel||i.saldo_atual||0).toFixed(2)%> • mínimo <%=Number(i.saldo_minimo||0).toFixed(2)%></small></div>
          <% }) %>
          <% if(!alertasReposicao){ %><div class="stock-v6-empty-inline">Nenhum alerta de reposição.</div><% } %>
        </div>
      </article>
    </div>
  </details>

  <section class="stock-v6-list card">
    <% if(!itens.length){ %>
      <div class="almox-empty"><strong>Nenhum material encontrado.</strong><div class="almox-subline">Revise os filtros ou cadastre um novo item.</div></div>
    <% } else { %>
      <div class="stock-v6-columns" aria-hidden="true">
        <span>Material</span><span>Organização</span><span>Saldo</span><span>Consumo</span><span>Reposição</span><span>Ação</span>
      </div>
      <% itens.forEach(item=>{ %>
        <article class="stock-v6-row">
          <div data-label="Material" class="stock-v6-material">
            <small><%=item.codigo||''%></small>
            <strong><%=item.nome%></strong>
            <span><%=item.unidade||'UN'%></span>
          </div>
          <div data-label="Organização">
            <strong><%=item.setor_utilizacao_exibicao||'COMUM'%></strong>
            <small><%=item.categoria_nome||'Sem categoria'%><% if(item.local_nome){%> • <%=item.local_nome%><%}%></small>
          </div>
          <div data-label="Saldo">
            <strong class="stock-v6-balance"><%=Number(item.saldo_disponivel||0)%> <%=item.unidade||'UN'%></strong>
            <small>físico <%=Number(item.saldo_atual||0)%> • reservado <%=Number(item.saldo_reservado||0)%> • mín. <%=Number(item.saldo_minimo||0)%></small>
          </div>
          <div data-label="Consumo">
            <strong><%=Number(item.consumo_90d||0).toFixed(2)%> / 90d</strong>
            <small><%=item.rotacao==='SEM_CONSUMO'?'Sem consumo':('Rotação '+String(item.rotacao||'').toLowerCase())%></small>
          </div>
          <div data-label="Reposição">
            <span class="stock-v6-badge <%=reposicaoClass(item.reposicao_status)%>"><%=reposicaoLabel(item.reposicao_status)%></span>
            <% if(item.ultima_movimentacao){%><small title="Último movimento"><%=dateBR(item.ultima_movimentacao)%></small><%}%>
          </div>
          <div data-label="Ação" class="stock-v6-actions">
            <a class="stock-v6-open" href="/estoque/itens/<%=item.id%>">Abrir →</a>
            <% if(Number(item.saldo_disponivel||0)>0){ %><a class="btn btn-sm btn-ghost" href="/estoque/saidas/nova?item=<%=item.id%>">Retirar</a><% } %>
          </div>
        </article>
      <% }) %>
    <% } %>
  </section>
</div>
