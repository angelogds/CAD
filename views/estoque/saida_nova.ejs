<% layout('layout') %>
<link rel="stylesheet" href="/css/almoxarifado-modern.css?v=20260824-v1" />
<%
  const isAlmoxContext = typeof contextoAlmox !== 'undefined' && contextoAlmox;
  const showAlmoxTabs = isAlmoxContext && typeof canAlmoxRead !== 'undefined' && canAlmoxRead;
%>

<div class="almox-page">
  <header class="almox-hero">
    <div>
      <span class="almox-hero__eyebrow"><%= isAlmoxContext ? 'ALMOXARIFADO • SAÍDA DE MATERIAIS' : 'ESTOQUE • MOVIMENTAÇÃO' %></span>
      <h1>Retirada de Materiais</h1>
      <p class="muted">Baixa controlada do estoque vinculada obrigatoriamente a uma OS ativa, mantendo o consumo associado ao equipamento.</p>
    </div>
    <div class="almox-hero__actions">
      <a class="btn btn-ghost" href="/estoque">Consultar estoque</a>
      <a class="btn btn-ghost" href="/estoque/movimentos">Ver movimentos</a>
    </div>
  </header>

  <% if (showAlmoxTabs) { %>
    <%- include('../almoxarifado/_tabs', { tab: 'retiradas' }) %>
  <% } else { %>
    <%- include('_tabs', { tab: 'saida' }) %>
  <% } %>

  <section class="almox-kpis">
    <article class="almox-kpi">
      <span class="almox-kpi__label">Itens disponíveis</span>
      <strong class="almox-kpi__value"><%= itens.length %></strong>
      <span class="almox-kpi__meta">Materiais ativos no estoque</span>
    </article>
    <article class="almox-kpi almox-kpi--blue">
      <span class="almox-kpi__label">OS ativas</span>
      <strong class="almox-kpi__value"><%= ordens.length %></strong>
      <span class="almox-kpi__meta">Destinos válidos para retirada</span>
    </article>
    <article class="almox-kpi almox-kpi--amber">
      <span class="almox-kpi__label">Regra de baixa</span>
      <strong class="almox-kpi__value" style="font-size:1.05rem;">OS obrigatória</strong>
      <span class="almox-kpi__meta">Evita consumo sem rastreabilidade</span>
    </article>
    <article class="almox-kpi almox-kpi--slate">
      <span class="almox-kpi__label">Origem</span>
      <strong class="almox-kpi__value" style="font-size:1.05rem;"><%= origem === 'QR_CODE' ? 'QR Code' : 'Manual' %></strong>
      <span class="almox-kpi__meta">Movimento registrado no histórico</span>
    </article>
  </section>

  <section class="card almox-withdraw-card">
    <div class="almox-summary-card__head" style="margin-bottom:16px;">
      <div>
        <div class="almox-summary-card__title">Registrar retirada</div>
        <div class="almox-subline">Selecione o material, confira o saldo e informe a OS que receberá o custo/consumo.</div>
      </div>
      <span class="almox-status almox-status--recebimento">Baixa automática</span>
    </div>

    <form method="POST" action="/estoque/saidas" class="almox-withdraw-grid" data-lock-submit>
      <% if (isAlmoxContext) { %><input type="hidden" name="contexto" value="almoxarifado" /><% } %>
      <input type="hidden" name="origem" value="<%= origem %>" />

      <div class="almox-field almox-field--full">
        <label for="almoxStockItem">Item do estoque</label>
        <select id="almoxStockItem" class="input" name="item_id" required data-stock-item-select>
          <option value="">Selecione o material</option>
          <% itens.forEach((item) => { %>
            <option
              value="<%= item.id %>"
              data-balance="<%= Number(item.saldo_atual || 0) %>"
              data-unit="<%= item.unidade || 'UN' %>"
              <%= Number(itemSelecionado) === Number(item.id) ? 'selected' : '' %>>
              <%= item.codigo ? (item.codigo + ' • ') : '' %><%= item.nome %> — saldo <%= Number(item.saldo_atual || 0) %> <%= item.unidade || 'UN' %>
            </option>
          <% }) %>
        </select>
        <div class="almox-stock-hint" data-stock-hint>Selecione um item para consultar o saldo disponível.</div>
      </div>

      <div class="almox-field">
        <label for="almoxQtdSaida">Quantidade</label>
        <input id="almoxQtdSaida" class="input" type="number" step="0.01" min="0.01" name="quantidade" placeholder="0,00" data-stock-quantity required />
      </div>

      <div class="almox-field">
        <label for="almoxOsSaida">OS ativa</label>
        <select id="almoxOsSaida" class="input" name="os_id" required>
          <option value="">Selecione a OS</option>
          <% ordens.forEach((os) => { %>
            <option value="<%= os.id %>">OS #<%= os.id %> — <%= os.equipamento_nome || 'Equipamento não informado' %></option>
          <% }) %>
        </select>
        <div class="almox-stock-hint">A retirada será vinculada ao equipamento da OS para manter o histórico de consumo.</div>
      </div>

      <div class="almox-field almox-field--full">
        <label for="almoxObsSaida">Destino / finalidade / observação</label>
        <textarea id="almoxObsSaida" class="input" name="observacao" rows="3" placeholder="Ex.: troca de rolamento do mancal dianteiro, manutenção corretiva..."></textarea>
      </div>

      <div class="almox-field almox-field--full">
        <div class="almox-warning">Antes de confirmar, confira material, quantidade e OS. A saída reduz o saldo imediatamente e gera movimentação no histórico do estoque.</div>
      </div>

      <div class="almox-actions almox-field--full">
        <button class="btn btn-green" type="submit" data-pending-text="Registrando...">Registrar saída</button>
        <a class="btn btn-ghost" href="<%= isAlmoxContext ? '/almoxarifado/recebimentos' : '/estoque' %>">Cancelar</a>
      </div>
    </form>
  </section>
</div>

<script src="/js/almoxarifado-modern.js?v=20260824-v1" defer></script>
