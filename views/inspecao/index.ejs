<% layout('layout') %>
<link rel="stylesheet" href="/css/inspecao.css?v=20260819" />
<script src="/js/inspecao.js?v=20260819" defer></script>
<%
  const prevMes = mes === 1 ? 12 : mes - 1; const prevAno = mes === 1 ? ano - 1 : ano;
  const nextMes = mes === 12 ? 1 : mes + 1; const nextAno = mes === 12 ? ano + 1 : ano;
  const canEdit = canAccessModule(normalizeRole(user?.role), 'inspecao_edit');
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const periodoLabel = `${meses[mes-1]} ${ano}`;
%>
<div class="inspection-page">
  <header class="inspection-header">
    <div><h1>PAC 01 – Inspeção</h1><p>Acompanhamento mensal de equipamentos, não conformidades, OS e preventivas.</p></div>
    <div class="top-actions"><a class="btn btn-outline action-btn" href="/inspecao/<%= prevAno %>/<%= prevMes %>">Mês anterior</a><span class="inspection-period"><%= periodoLabel %></span><a class="btn btn-outline action-btn" href="/inspecao/<%= nextAno %>/<%= nextMes %>">Próximo mês</a><a class="btn btn-outline action-btn" href="/inspecao/<%= ano %>/<%= mes %>/pdf?<%= preventivasQuery %>">Exportar PDF</a><a class="btn btn-outline action-btn" href="/inspecao/<%= ano %>/<%= mes %>/export/csv?<%= preventivasQuery %>">Exportar CSV</a><a class="btn btn-outline action-btn" href="/inspecao/<%= ano %>/<%= mes %>/export/xls?<%= preventivasQuery %>">Exportar XLS</a><% if (canEdit) { %><form method="POST" action="/inspecao/<%= ano %>/<%= mes %>/recalcular"><input type="hidden" name="monitor_nome" value="<%= inspecao.monitor_nome || '' %>"><input type="hidden" name="verificador_nome" value="<%= inspecao.verificador_nome || '' %>"><input type="hidden" name="frequencia" value="<%= inspecao.frequencia || 'Diária' %>"><button class="btn btn-primary action-btn" type="submit">Atualizar Sistema</button></form><% } %></div>
  </header>
  <nav class="inspection-tabs" aria-label="Navegação interna"><a href="#visao-geral">Visão geral</a><a href="#matriz">Matriz mensal</a><a href="#preventivas">Preventivas executadas</a><a href="#nao-conformidades">Não conformidades</a><a href="/inspecao/<%= ano %>/<%= mes %>/os-em-andamento">OS em andamento</a></nav>

  <section id="visao-geral" class="inspection-kpis" aria-label="Indicadores principais">
    <article class="inspection-kpi blue"><small>OS registradas</small><strong><%= indicadoresOS.registradas_no_mes || 0 %></strong></article>
    <article class="inspection-kpi orange"><small>OS em andamento</small><strong><%= indicadoresOS.abertas_ou_em_andamento || 0 %></strong></article>
    <article class="inspection-kpi red"><small>Não conformidades</small><strong><%= indicadoresOS.com_nao_conformidade_no_mes || 0 %></strong></article>
    <article class="inspection-kpi blue"><small>Preventivas programadas</small><strong><%= indicadoresPreventivas.programadas || 0 %></strong></article>
    <article class="inspection-kpi green"><small>Preventivas executadas</small><strong><%= indicadoresPreventivas.executadas || 0 %></strong></article>
    <article class="inspection-kpi red"><small>Preventivas atrasadas</small><strong><%= indicadoresPreventivas.atrasadas || 0 %></strong></article>
  </section>

  <section class="inspection-card"><div class="inspection-section-head"><div><h3>Cabeçalho técnico da inspeção</h3><p>Responsáveis e frequência do PAC 01 no período.</p></div><a class="btn btn-ghost btn-sm" href="<%= backUrl %>">← Voltar</a></div>
    <form method="POST" action="/inspecao/<%= ano %>/<%= mes %>/recalcular" class="inspecao-header-form"><label>Monitor<input type="text" name="monitor_nome" value="<%= inspecao.monitor_nome || '' %>" <%= canEdit ? '' : 'readonly' %>></label><label>Verificador<input type="text" name="verificador_nome" value="<%= inspecao.verificador_nome || '' %>" <%= canEdit ? '' : 'readonly' %>></label><label>Frequência<input type="text" name="frequencia" value="<%= inspecao.frequencia || 'Diária' %>" <%= canEdit ? '' : 'readonly' %>></label><% if (canEdit) { %><button type="submit" class="btn btn-outline">Salvar informações</button><% } %></form>
  </section>

  <section class="inspection-card"><div class="inspection-section-head"><div><h3>Filtros das preventivas</h3><p>Refine a visão do período sem alterar os dados da inspeção.</p></div></div><form method="GET" class="inspection-filters">
    <label>Data inicial<input class="input" type="date" name="data_inicio" value="<%= filtrosPreventivas.data_inicio %>"></label><label>Data final<input class="input" type="date" name="data_fim" value="<%= filtrosPreventivas.data_fim %>"></label><label>Equipamento<select name="equipamento_id"><option value="">Todos</option><% equipamentos.forEach(eq => { %><option value="<%= eq.id %>" <%= String(filtrosPreventivas.equipamento_id)===String(eq.id)?'selected':'' %>><%= eq.nome %></option><% }) %></select></label><label>Setor<input class="input" name="setor" value="<%= filtrosPreventivas.setor %>" placeholder="Todos os setores"></label><label>Responsável<input class="input" name="responsavel" value="<%= filtrosPreventivas.responsavel %>" placeholder="Todos"></label><label>Status<input class="input" name="status" value="<%= filtrosPreventivas.status %>" placeholder="Todos"></label><label>Não conformidade<select name="nao_conformidade"><option value="">Todas</option><option value="SIM" <%= filtrosPreventivas.nao_conformidade==='SIM'?'selected':'' %>>Com NC</option><option value="NAO" <%= filtrosPreventivas.nao_conformidade==='NAO'?'selected':'' %>>Sem NC</option></select></label><label>Gerou OS<select name="gerou_os"><option value="">Todas</option><option value="SIM" <%= filtrosPreventivas.gerou_os==='SIM'?'selected':'' %>>Sim</option><option value="NAO" <%= filtrosPreventivas.gerou_os==='NAO'?'selected':'' %>>Não</option></select></label><label>Tipo de atividade<input class="input" name="tipo_atividade" value="<%= filtrosPreventivas.tipo_atividade %>" placeholder="Todos"></label><button class="btn btn-green" type="submit">Aplicar filtros</button>
  </form></section>

  <details class="inspection-card inspection-more-metrics"><summary>Indicadores de OS e preventivas — Mais indicadores</summary><section class="inspecao-indicadores-section"><h4>Ordens de serviço</h4><div class="inspecao-indicadores-grid"><% [['Registradas no mês',indicadoresOS.registradas_no_mes],['Abertas ou em andamento',indicadoresOS.abertas_ou_em_andamento],['Concluídas no mês',indicadoresOS.concluidas_no_mes],['Com não conformidade',indicadoresOS.com_nao_conformidade_no_mes],['Sem justificativa',indicadoresOS.sem_justificativa],['Aguardando material',indicadoresOS.aguardando_material],['Equipamentos impactados',indicadoresOS.equipamentos_impactados]].forEach(([label,value])=> { %><div class="inspecao-indicador inspecao-indicador-os"><div class="inspecao-indicador-label"><%= label %></div><strong><%= value || 0 %></strong></div><% }) %></div></section><section class="inspecao-indicadores-section"><h4>Preventivas</h4><div class="inspecao-indicadores-grid"><% [['Programadas',indicadoresPreventivas.programadas],['Executadas',indicadoresPreventivas.executadas],['Pendentes',indicadoresPreventivas.pendentes],['Atrasadas',indicadoresPreventivas.atrasadas],['Com NC',indicadoresPreventivas.com_nao_conformidade],['Sem NC',indicadoresPreventivas.sem_nao_conformidade],['OS corretivas',indicadoresPreventivas.os_corretivas],['Cumprimento',`${indicadoresPreventivas.cumprimento_percentual || 0}%`]].forEach(([label,value])=> { %><div class="inspecao-indicador inspecao-indicador-preventiva"><div class="inspecao-indicador-label"><%= label %></div><strong><%= value || 0 %></strong></div><% }) %></div></section><% if ((indicadoresPreventivas.equipamentos_com_mais_nc || []).length) { %><div class="inspecao-indicadores-alerta"><strong>Equipamentos com maior número de NC preventivas:</strong> <%= indicadoresPreventivas.equipamentos_com_mais_nc.map(item => `${item.equipamento} (${item.total})`).join(' • ') %></div><% } %></details>

  <section id="matriz" class="inspection-matrix-card"><div class="inspection-section-head"><div><h2>Matriz mensal de inspeção</h2><p>Status diário consolidado por equipamento. Clique em uma célula para visualizar os registros do dia.</p></div><div class="legend"><span><b class="status-badge C">C</b> Conforme</span><span><b class="status-badge NC">NC</b> Não conformidade</span><span><b class="status-badge EA">EA</b> Em acompanhamento</span><span><b class="status-badge SP">SP</b> Sem preenchimento</span></div></div><div class="inspection-matrix-scroll"><table class="inspecao-grid"><thead><tr><th class="equip-col">Equipamento</th><% for (let d=1; d<=diasMes; d++) { %><th><%= d %></th><% } %></tr></thead><tbody><% for (const eq of equipamentos) { const line=matrix.get(eq.id)||[]; %><tr><td class="equip-col"><strong><%= eq.nome %></strong><small>Item <%= eq.item %></small></td><% for(let i=0;i<diasMes;i++){ const day=i+1; const cell=line[i]||{status:'-'}; const detailsKey=`${eq.id}-${day}`; %><td class="status-cell <%= cell.status==='-'?'disabled':'' %>"><button type="button" class="status-badge status-badge-btn <%= cell.status %>" data-eq="<%= eq.nome %>" data-item="<%= eq.item %>" data-day="<%= day %>" data-key="<%= detailsKey %>"><%= cell.status %></button></td><% } %></tr><% } %></tbody></table></div></section>

  <section id="preventivas" class="inspection-card"><div class="inspection-section-head"><div><h3>Preventivas Executadas no Período</h3><p>Registros rastreáveis de inspeção preventiva, incluindo atividades sem não conformidade.</p></div></div><div class="inspection-table-wrap"><table class="inspection-table"><thead><tr><th>Código</th><th>Equipamento / setor</th><th>Datas</th><th>Responsável</th><th>Descrição e itens</th><th>Não conformidade</th><th>Ações</th><th>Situação final</th><th>OS</th></tr></thead><tbody><% if (!(preventivasExecutadas||[]).length) { %><tr><td class="inspection-empty" colspan="9">Nenhuma preventiva executada no período filtrado.</td></tr><% } %><% (preventivasExecutadas||[]).forEach(p=> { %><tr><td><a href="/preventivas/<%= p.plano_id %>">PREV-<%= p.id %></a></td><td><strong><%= p.equipamento_nome||'-' %></strong><br><span class="muted"><%= p.setor||'-' %></span></td><td>Programada: <%= p.data_prevista||'-' %><br>Executada: <%= p.data_executada||'-' %></td><td><%= p.responsavel_exibicao||'-' %></td><td><%= p.descricao_preventiva||p.titulo||'-' %><br><span class="muted"><%= p.itens_verificados||'-' %></span></td><td><span class="<%= Number(p.tem_nao_conformidade)?'nc-positive':'nc-clear' %>"><%= p.nao_conformidade||'-' %></span></td><td>Corretiva: <%= p.acao_corretiva||'-' %><br>Preventiva: <%= p.acao_preventiva||'-' %></td><td><%= String(p.situacao_final||'-').replaceAll('_',' ') %></td><td><% if(p.os_corretiva_id){ %><a href="/os/<%= p.os_corretiva_id %>">OS #<%= p.os_corretiva_id %></a><% } else { %>-<% } %></td></tr><% }) %></tbody></table></div></section>

  <section id="os-em-andamento" class="inspection-card"><div class="inspection-section-head"><div><h3>OS em andamento — rastreabilidade</h3><p>Equipamentos com OS aberta, motivo atual e ação necessária.</p></div><a class="btn btn-outline btn-sm" href="/inspecao/<%= ano %>/<%= mes %>/os-em-andamento">Abrir relatório detalhado</a></div><div class="inspection-table-wrap"><table class="inspection-table"><thead><tr><th>OS</th><th>Equipamento</th><th>Dias em aberto</th><th>Status</th><th>Motivo atual</th><th>Última atualização</th><th>Ação necessária</th></tr></thead><tbody><% if (!(osEmAndamento||[]).length) { %><tr><td colspan="7" class="inspection-empty">Nenhuma OS aberta ou em andamento no período.</td></tr><% } %><% (osEmAndamento||[]).forEach(ordem=> { %><tr><td><a class="btn btn-outline btn-sm" href="/os/<%= ordem.id %>#justificativa-andamento">#<%= ordem.id %></a></td><td><%= ordem.equipamento||'-' %></td><td><%= ordem.dias_aberta %></td><td><%= ordem.status||'-' %></td><td><%= ordem.motivo_atual||'Justificativa pendente' %></td><td><%= ordem.ultima_atualizacao?fmtBR(ordem.ultima_atualizacao):'-' %></td><td><%= ordem.acao_necessaria %></td></tr><% }) %></tbody></table></div></section>

  <section id="nao-conformidades" class="inspection-card"><div class="inspection-section-head"><div><h3>Não conformidades automáticas via OS</h3><p>Ocorrências consolidadas sem alterar as regras de geração do PAC 01.</p></div></div><div class="inspection-table-wrap"><table class="inspection-table"><thead><tr><th>Item</th><th>Data ocorrência</th><th>Não Conformidade</th><th>Ação preventiva</th><th>Ação corretiva</th><th>Data correção</th><th>OS ID</th></tr></thead><tbody><% if (!ncList.length) { %><tr><td colspan="7" class="inspection-empty">Nenhuma não conformidade detectada no mês.</td></tr><% } %><% for (const nc of ncList) { %><tr><td><%= nc.item %></td><td><%= nc.data_ocorrencia %></td><td><%= nc.nao_conformidade %></td><td><%= nc.acao_preventiva || '-' %></td><td><%= nc.acao_corretiva || '-' %></td><td><%= nc.data_correcao||'-' %></td><td><% if(nc.os_id){ %><a class="btn btn-outline btn-sm" href="/os/<%= nc.os_id %>">OS #<%= nc.os_id %></a><% } else { %>-<% } %></td></tr><% } %></tbody></table></div></section>

  <section class="inspection-summary-grid" aria-label="Resumos rápidos"><article class="inspection-summary-card"><h3>Preventivas executadas</h3><div class="inspection-summary-list"><% (preventivasExecutadas||[]).slice(0,3).forEach(p=> { %><div class="inspection-summary-item"><strong>PREV-<%= p.id %></strong> • <%= p.equipamento_nome||'-' %></div><% }) %><% if (!(preventivasExecutadas||[]).length){ %><div class="muted">Nenhum registro.</div><% } %></div></article><article class="inspection-summary-card"><h3>Não conformidades</h3><div class="inspection-summary-list"><% (ncList||[]).slice(0,3).forEach(nc=> { %><div class="inspection-summary-item"><strong><%= nc.item %></strong> • <%= nc.nao_conformidade||'-' %></div><% }) %><% if (!(ncList||[]).length){ %><div class="muted">Nenhuma NC.</div><% } %></div></article><article class="inspection-summary-card"><h3>OS em andamento</h3><div class="inspection-summary-list"><% (osEmAndamento||[]).slice(0,3).forEach(os=> { %><div class="inspection-summary-item"><strong>OS #<%= os.id %></strong> • <%= os.equipamento||'-' %></div><% }) %><% if (!(osEmAndamento||[]).length){ %><div class="muted">Nenhuma OS.</div><% } %></div></article></section>

  <div id="dayModal" class="inspecao-modal" style="display:none" aria-hidden="true"><div class="inspecao-modal-content"><div class="inspecao-modal-head"><h3 id="dayModalTitle">Detalhes da inspeção</h3><button class="btn btn-ghost btn-sm" type="button" id="closeDayModal">Fechar</button></div><ul id="dayModalList" class="modal-os-list"></ul></div></div>
  <script type="application/json" id="inspecao-details-data"><%- JSON.stringify(osDetailsByCell || {}) %></script>
</div>
