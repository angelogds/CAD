<% layout('layout') %>
<link rel="stylesheet" href="/css/inspecao.css?v=20260819" />
<script src="/js/inspecao.js?v=20260819" defer></script>
<%
  const ordens = osEmAndamento || [];
  const normalizarStatus = (status, motivo) => { const textoStatus=String(status||'').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[\s-]+/g,'_'); const textoMotivo=String(motivo||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); if(textoMotivo.includes('material')||textoMotivo.includes('compra')||textoMotivo.includes('peca')||textoMotivo.includes('tornearia')) return 'AGUARDANDO_MATERIAL'; if(textoStatus.includes('FINALIZ')||textoStatus.includes('CONCLUID')||textoStatus.includes('FECHAD')) return 'FINALIZADA'; if(textoStatus.includes('PAUS')||textoStatus.includes('PARAD')) return 'PAUSADA'; if(textoStatus.includes('ANDAMENTO')||textoStatus==='ANDAMENTO') return 'EM_ANDAMENTO'; return 'ABERTA'; };
  const rotuloStatus = (status) => ({ABERTA:'ABERTA',EM_ANDAMENTO:'EM ANDAMENTO',PAUSADA:'PAUSADA',AGUARDANDO_MATERIAL:'AGUARDANDO MATERIAL',FINALIZADA:'FINALIZADA'}[status]||'ABERTA');
  const statusClasse = (status) => ({ABERTA:'status-aberta',EM_ANDAMENTO:'status-em-andamento',PAUSADA:'status-pausada',AGUARDANDO_MATERIAL:'status-aguardando-material',FINALIZADA:'status-finalizada'}[status]||'status-aberta');
  const materialPendente = (os) => normalizarStatus(os.status,os.motivo_atual)==='AGUARDANDO_MATERIAL' && !os.material_chegou_em;
  const resumo = ordens.reduce((acc,os)=>{ const status=normalizarStatus(os.status,os.motivo_atual); const dias=Number(os.dias_aberta||0); acc.total++; acc.dias+=dias; if(status==='PAUSADA')acc.pausada++; if(status==='AGUARDANDO_MATERIAL')acc.aguardandoMaterial++; if(dias>30||status==='AGUARDANDO_MATERIAL')acc.critica++; return acc; },{total:0,pausada:0,aguardandoMaterial:0,critica:0,dias:0});
  const mediaDias=resumo.total?Math.round(resumo.dias/resumo.total):0;
%>
<div class="os-rastreio-page">
  <div class="page-head"><div><h1>OS em andamento — Rastreabilidade</h1><p class="muted">PAC 01 • <%= String(mes).padStart(2,'0') %>/<%= ano %> • acompanhamento técnico das ordens abertas vinculadas aos equipamentos.</p></div><div class="os-rastreio-actions"><a class="btn btn-outline" href="/inspecao/<%= ano %>/<%= mes %>/pdf" target="_blank">Exportar PDF</a><a class="btn btn-outline" href="/inspecao/<%= ano %>/<%= mes %>">← Voltar à inspeção</a></div></div>
  <section class="os-summary-grid" aria-label="Resumo executivo"><div class="os-summary-card"><span>Total em andamento</span><strong><%= resumo.total %></strong></div><div class="os-summary-card"><span>Pausadas</span><strong><%= resumo.pausada %></strong></div><div class="os-summary-card"><span>Aguardando material</span><strong><%= resumo.aguardandoMaterial %></strong></div><div class="os-summary-card"><span>Críticas</span><strong><%= resumo.critica %></strong></div><div class="os-summary-card"><span>Média em aberto</span><strong><%= mediaDias %>d</strong></div></section>
  <section class="inspection-card"><strong>Filtros rápidos</strong><div class="os-filter-bar" role="group" aria-label="Filtrar ordens de serviço"><button class="os-filter-btn active" type="button" data-filter="todos">Todos</button><button class="os-filter-btn" type="button" data-filter="abertas">Abertas</button><button class="os-filter-btn" type="button" data-filter="em_andamento">Em andamento</button><button class="os-filter-btn" type="button" data-filter="pausadas">Pausadas</button><button class="os-filter-btn" type="button" data-filter="aguardando_material">Aguardando material</button><button class="os-filter-btn" type="button" data-filter="dias_7">Mais de 7 dias</button><button class="os-filter-btn" type="button" data-filter="dias_15">Mais de 15 dias</button><button class="os-filter-btn" type="button" data-filter="dias_30">Mais de 30 dias</button><button class="os-filter-btn" type="button" data-filter="dias_45">Mais de 45 dias</button></div><span class="muted" id="filter-count"><%= resumo.total %> OS exibidas</span></section>
  <section class="os-cards-grid" aria-live="polite"><% if (!ordens.length) { %><div class="os-empty-state">Nenhuma OS aberta ou em andamento no período.</div><% } %><% ordens.forEach(os=> { const statusNormalizado=normalizarStatus(os.status,os.motivo_atual); const dias=Number(os.dias_aberta||0); const historico=os.historico_resumido||[]; const pendenteMaterial=materialPendente(os); %>
    <article class="os-tech-card" data-os-card data-status="<%= statusNormalizado %>" data-days="<%= dias %>"><div class="os-card-summary"><div><small>OS</small><a class="os-id-link" href="/os/<%= os.id %>#justificativa-andamento">#<%= os.id %></a></div><div class="equipment-cell"><small>Equipamento</small><strong><%= os.equipamento||'-' %></strong></div><div><small>Status</small><span class="os-status-pill <%= statusClasse(statusNormalizado) %>"><%= rotuloStatus(statusNormalizado) %></span></div><div><small>Dias em aberto</small><strong class="os-days"><%= dias %></strong></div><div><small>Responsável</small><strong><%= os.responsavel||'-' %></strong></div><div><small>Motivo atual</small><strong><%= os.motivo_atual||'Justificativa pendente' %></strong></div><div class="os-open-action"><a class="btn btn-outline btn-sm" href="/os/<%= os.id %>">Abrir OS</a></div></div>
      <details class="os-details"><summary>Ver Histórico e detalhes técnicos</summary><div class="os-details-grid"><section class="os-section"><h3>Não conformidade</h3><p><%= os.nao_conformidade||'-' %></p></section><section class="os-section"><h3>Ação necessária</h3><p><%= os.acao_necessaria||'Registrar e acompanhar ação necessária' %></p></section><section class="os-section"><h3>Justificativa técnica</h3><p><%= os.ultima_justificativa||'-' %></p></section><section class="os-section"><h3>Datas</h3><p>Abertura: <%= os.opened_at?fmtBR(os.opened_at):'-' %><br>Última atualização: <%= os.ultima_atualizacao?fmtBR(os.ultima_atualizacao):'-' %></p></section><section class="os-section"><h3>Chat da OS</h3><p>Última interação: <%= os.chat_ultima_interacao?fmtBR(os.chat_ultima_interacao.created_at):'Sem interação no chat' %><% if(os.chat_ultima_interacao&&os.chat_participantes){ %><br>Participantes: <%= os.chat_participantes %><% } %></p><div class="os-inline-actions"><a class="btn btn-outline btn-sm" href="/chat-os/<%= os.id %>">Abrir conversa</a></div></section><section class="os-section"><h3>Material</h3><span class="os-material <%= pendenteMaterial?'pending':'ok' %>"><%= pendenteMaterial?'Material pendente':'Material disponível' %><% if(os.material_chegou_em){ %> • <%= fmtBR(os.material_chegou_em) %><% } %></span></section><section class="os-section"><h3>Histórico</h3><div class="os-history"><% if(!historico.length){ %><p class="muted">Nenhum histórico registrado para esta OS.</p><% } %><% historico.forEach(item=> { %><div class="os-history-item"><span class="os-history-date"><%= item.registrado_em?fmtBR(item.registrado_em):'-' %></span><p><strong><%= item.motivo_nome||'Atualização' %></strong><% if(item.texto_ia||item.texto_padrao){ %><br><%= item.texto_ia||item.texto_padrao %><% } %></p></div><% }) %></div></section></div></details>
    </article><% }) %><div class="os-empty-state os-filter-empty" id="os-filter-empty">Nenhuma OS encontrada para o filtro selecionado.</div></section>
</div>
