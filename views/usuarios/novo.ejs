<% layout('layout') %>
<link rel="stylesheet" href="/css/admin-console.css?v=20260919-p5" />

<main class="admin-console">
  <header class="admin-hero">
    <div>
      <span class="admin-eyebrow">ADMINISTRAÇÃO • NOVO ACESSO</span>
      <h1>Novo usuário</h1>
      <p>Cadastre o acesso com perfil, contato e foto. Função e setor são derivados automaticamente do perfil selecionado.</p>
    </div>
    <div class="admin-actions">
      <a class="ui-btn ui-btn--secondary" href="/usuarios">Voltar</a>
    </div>
  </header>

  <section class="admin-panel">
    <div class="admin-section-head">
      <div><h2>Dados do acesso</h2><p>Use o e-mail pessoal ou corporativo do colaborador.</p></div>
    </div>

    <form method="POST" action="/usuarios" enctype="multipart/form-data" class="admin-form" data-user-form>
      <div class="admin-form-grid">
        <label class="admin-field">
          <span>Nome *</span>
          <input name="name" required autocomplete="name">
        </label>

        <label class="admin-field">
          <span>E-mail *</span>
          <input name="email" type="email" required autocomplete="email">
        </label>

        <label class="admin-field">
          <span>Perfil *</span>
          <select name="role" required>
            <option value="">Selecione</option>
            <% (ROLES || []).forEach(r => { %>
              <option value="<%= r.key %>" data-funcao="<%= r.funcao || '' %>" data-setor="<%= r.setor || '' %>"><%= r.label %></option>
            <% }) %>
          </select>
        </label>

        <label class="admin-field">
          <span>Senha inicial *</span>
          <input name="password" type="password" required autocomplete="new-password">
        </label>

        <label class="admin-field">
          <span>Função</span>
          <input id="roleFunction" data-role-function value="" placeholder="Definida pelo perfil" readonly>
          <small class="muted-xs">Preenchida automaticamente.</small>
        </label>

        <label class="admin-field">
          <span>Setor</span>
          <input id="roleSector" data-role-sector value="" placeholder="Definido pelo perfil" readonly>
          <small class="muted-xs">Identidade operacional derivada do perfil.</small>
        </label>

        <label class="admin-field">
          <span>WhatsApp</span>
          <input name="telefone_whatsapp" inputmode="numeric" data-whatsapp-input placeholder="5575999999999">
          <small class="muted-xs">DDI + DDD + número. Se ficar vazio, não receberá notificações.</small>
        </label>

        <label class="admin-field">
          <span>Foto do rosto</span>
          <input name="photo" type="file" accept="image/*" capture="user">
          <small class="muted-xs">Opcional. Usada na identificação visual do usuário.</small>
        </label>
      </div>

      <div class="admin-note">O cadastro de usuário controla <strong>acesso ao sistema</strong>. Informações de jornada, banco de horas, treinamentos e documentos pessoais permanecem na ficha canônica do colaborador/RH.</div>

      <div class="admin-form-actions">
        <a class="ui-btn ui-btn--secondary" href="/usuarios">Cancelar</a>
        <button class="ui-btn ui-btn--primary" type="submit">Salvar usuário</button>
      </div>
    </form>
  </section>
</main>

<script src="/js/usuarios-form.js?v=20260919-p5"></script>
