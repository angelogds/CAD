<% layout('layout') %>
<link rel="stylesheet" href="/css/admin-console.css?v=20260919-p5" />
<%
  const kpi = indicadores || {};
  const statusAtual = String(status || 'ativos');
%>

<main class="admin-console">
  <header class="admin-hero">
    <div>
      <span class="admin-eyebrow">ADMINISTRAÇÃO • ACESSOS</span>
      <h1>Usuários do sistema</h1>
      <p>Gerencie acessos por perfil e setor. Usuários com histórico vinculado são arquivados para preservar rastreabilidade.</p>
    </div>
    <div class="admin-actions">
      <a class="ui-btn ui-btn--primary" href="/usuarios/novo">+ Novo usuário</a>
    </div>
  </header>

  <section class="admin-kpis" aria-label="Indicadores de usuários">
    <article class="admin-kpi"><span>Usuários ativos</span><strong><%= kpi.ativos || 0 %></strong><small>Acesso liberado ao sistema</small></article>
    <article class="admin-kpi"><span>Arquivados</span><strong><%= kpi.arquivados || 0 %></strong><small>Histórico preservado</small></article>
    <article class="admin-kpi"><span>Com WhatsApp</span><strong><%= kpi.comWhatsapp || 0 %></strong><small>Podem receber notificações</small></article>
    <article class="admin-kpi <%= Number(kpi.semWhatsapp || 0) > 0 ? 'is-alert' : '' %>"><span>Sem WhatsApp</span><strong><%= kpi.semWhatsapp || 0 %></strong><small>Sem canal de notificação</small></article>
    <article class="admin-kpi"><span>Perfis ativos</span><strong><%= kpi.perfisAtivos || 0 %></strong><small>Tipos de acesso em uso</small></article>
  </section>

  <section class="admin-panel">
    <div class="admin-section-head">
      <div><h2>Localizar usuários</h2><p>Filtre por nome, e-mail, perfil ou situação do acesso.</p></div>
      <span class="admin-badge"><%= lista?.length || 0 %> resultado(s)</span>
    </div>

    <form method="GET" action="/usuarios" class="admin-filter">
      <label class="admin-field">
        <span>Buscar</span>
        <input name="q" value="<%= q || '' %>" placeholder="Nome ou e-mail">
      </label>
      <label class="admin-field">
        <span>Perfil</span>
        <select name="role">
          <option value="">Todos os perfis</option>
          <% (ROLES || []).forEach(r => { %>
            <option value="<%= r.key %>" <%= (role === r.key) ? "selected" : "" %>><%= r.label %></option>
          <% }) %>
        </select>
      </label>
      <label class="admin-field">
        <span>Situação</span>
        <select name="status">
          <option value="ativos" <%= statusAtual !== 'arquivados' ? 'selected' : '' %>>Usuários ativos</option>
          <option value="arquivados" <%= statusAtual === 'arquivados' ? 'selected' : '' %>>Usuários arquivados</option>
        </select>
      </label>
      <div class="admin-actions">
        <button class="ui-btn ui-btn--primary" type="submit">Filtrar</button>
        <a class="ui-btn ui-btn--secondary" href="/usuarios">Limpar</a>
      </div>
    </form>
  </section>

  <section class="admin-panel">
    <div class="admin-section-head">
      <div>
        <h2><%= statusAtual === 'arquivados' ? 'Usuários arquivados' : 'Usuários ativos' %></h2>
        <p><%= statusAtual === 'arquivados' ? 'Cadastros preservados por vínculo histórico.' : 'Cadastros com acesso ativo ao sistema.' %></p>
      </div>
      <div class="admin-actions">
        <a class="ui-btn ui-btn--soft ui-btn--compact" href="/usuarios">Ativos</a>
        <a class="ui-btn ui-btn--outline ui-btn--compact" href="/usuarios?status=arquivados">Arquivados</a>
      </div>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Usuário</th>
            <th>E-mail</th>
            <th>Perfil</th>
            <th>Situação</th>
            <th>WhatsApp</th>
            <th>Criado</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (!lista || !lista.length) { %>
            <tr><td colspan="7" class="admin-empty">Nenhum usuário encontrado.</td></tr>
          <% } else { %>
            <% (lista || []).forEach(u => { %>
              <% const arquivado = Number(u.ativo ?? 1) === 0 || !!u.deleted_at; %>
              <tr>
                <td data-label="Usuário">
                  <div class="admin-user-cell">
                    <div class="admin-user-avatar">
                      <% if (u.photo_path && (typeof attachmentExists !== "function" || attachmentExists(u.photo_path))) { %>
                        <img src="<%= u.photo_path %>" alt="">
                      <% } else { %>
                        <span><%= String(u.name || '?').trim().slice(0,1).toUpperCase() %></span>
                      <% } %>
                    </div>
                    <div><strong><%= u.name %></strong><small>#<%= u.id %></small></div>
                  </div>
                </td>
                <td data-label="E-mail"><%= u.email %></td>
                <td data-label="Perfil"><span class="admin-badge info"><%= (u.role || '').toUpperCase() %></span></td>
                <td data-label="Situação"><span class="admin-badge <%= arquivado ? '' : 'good' %>"><%= arquivado ? 'Arquivado' : 'Ativo' %></span></td>
                <td data-label="WhatsApp">
                  <% if (u.telefone_whatsapp) { %><span class="admin-badge good">Configurado</span><small><%= u.telefone_whatsapp %></small><% } else { %><span class="admin-badge warn">Não informado</span><% } %>
                </td>
                <td data-label="Criado"><%= u.created_at ? fmtBR(u.created_at) : '-' %></td>
                <td data-label="Ações">
                  <div class="admin-user-actions">
                    <a class="ui-btn ui-btn--outline ui-btn--compact" href="/usuarios/<%= u.id %>/editar">Editar</a>
                    <% if (isAdmin) { %>
                      <% if (arquivado) { %>
                        <form method="POST" action="/usuarios/<%= u.id %>/restaurar" onsubmit="return confirm('Restaurar o acesso de <%= u.name %>?');">
                          <button class="ui-btn ui-btn--soft ui-btn--compact" type="submit">Restaurar</button>
                        </form>
                      <% } else { %>
                        <form method="POST" action="/usuarios/<%= u.id %>/excluir" onsubmit="return confirm('Remover o usuário <%= u.name %>? Se houver histórico vinculado, ele será arquivado para preservar os registros.');">
                          <button class="ui-btn ui-btn--danger-soft ui-btn--compact" type="submit">Remover</button>
                        </form>
                      <% } %>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>
