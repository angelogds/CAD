<% layout('layout') %>
<link rel="stylesheet" href="/css/admin-console.css?v=20260919-p5" />

<main class="admin-console">
  <header class="admin-hero">
    <div class="admin-identity">
      <% if (user.photo_path && (typeof attachmentExists !== "function" || attachmentExists(user.photo_path))) { %>
        <img class="admin-photo" src="<%= user.photo_path %>" alt="Foto de <%= user.name %>">
      <% } else { %>
        <div class="admin-user-avatar admin-photo"><span><%= String(user.name || '?').trim().slice(0,1).toUpperCase() %></span></div>
      <% } %>
      <div>
        <span class="admin-eyebrow">ADMINISTRAÇÃO • USUÁRIO #<%= user.id %></span>
        <h1>Editar acesso</h1>
        <p><%= user.name %> • <%= user.email %></p>
      </div>
    </div>
    <div class="admin-actions">
      <a class="ui-btn ui-btn--secondary" href="/usuarios">Voltar</a>
    </div>
  </header>

  <section class="admin-panel">
    <div class="admin-section-head">
      <div><h2>Dados do usuário</h2><p>Atualize perfil, contato e foto sem alterar o histórico já vinculado.</p></div>
      <span class="admin-badge good">Acesso cadastrado</span>
    </div>

    <form method="POST" action="/usuarios/<%= user.id %>" enctype="multipart/form-data" class="admin-form" data-user-form>
      <div class="admin-form-grid">
        <label class="admin-field">
          <span>Nome *</span>
          <input name="name" value="<%= user.name %>" required autocomplete="name">
        </label>

        <label class="admin-field">
          <span>E-mail *</span>
          <input name="email" type="email" value="<%= user.email %>" required autocomplete="email">
        </label>

        <label class="admin-field">
          <span>Perfil *</span>
          <select name="role" required>
            <% ROLES.forEach(r => { %>
              <option value="<%= r.key %>" data-funcao="<%= r.funcao || '' %>" data-setor="<%= r.setor || '' %>" <%= (String(user.role||'').toUpperCase() === r.key) ? "selected" : "" %>><%= r.label %></option>
            <% }) %>
          </select>
        </label>

        <label class="admin-field">
          <span>Criado em</span>
          <input value="<%= user.created_at ? fmtBR(user.created_at) : '-' %>" disabled>
        </label>

        <label class="admin-field">
          <span>Função</span>
          <input data-role-function value="<%= user.funcao || '' %>" readonly>
          <small class="muted-xs">Derivada automaticamente do perfil.</small>
        </label>

        <label class="admin-field">
          <span>Setor</span>
          <input data-role-sector value="<%= user.setor || '' %>" readonly>
          <small class="muted-xs">Identidade operacional derivada do perfil.</small>
        </label>

        <label class="admin-field">
          <span>WhatsApp</span>
          <input name="telefone_whatsapp" inputmode="numeric" data-whatsapp-input value="<%= user.telefone_whatsapp || '' %>" placeholder="5575999999999">
          <small class="muted-xs">Se ficar vazio, o usuário não receberá notificações de OS.</small>
        </label>

        <label class="admin-field">
          <span>Nova foto</span>
          <input name="photo" type="file" accept="image/*" capture="user">
          <small class="muted-xs">Deixe vazio para manter a foto atual.</small>
        </label>
      </div>

      <div class="admin-form-actions">
        <button class="ui-btn ui-btn--primary" type="submit">Salvar alterações</button>
      </div>
    </form>
  </section>

  <section class="admin-panel is-warning">
    <div class="admin-section-head">
      <div><h2>Resetar senha</h2><p>Defina uma nova senha para este usuário. A alteração é imediata.</p></div>
    </div>

    <form method="POST" action="/usuarios/<%= user.id %>/reset-senha" class="admin-form">
      <div class="admin-form-grid">
        <label class="admin-field">
          <span>Nova senha *</span>
          <input name="password" type="password" required autocomplete="new-password">
        </label>
      </div>
      <div class="admin-form-actions">
        <button class="ui-btn ui-btn--outline" type="submit" onclick="return confirm('Confirmar redefinição da senha deste usuário?');">Resetar senha</button>
      </div>
    </form>
  </section>
</main>

<script src="/js/usuarios-form.js?v=20260919-p5"></script>
