<link rel="stylesheet" href="/css/tracagem.css?v=20260819">
<script src="/js/tracagem.js?v=20260819" defer></script>
<div class="tracagem-page">
  <%- include('partials/calculadora-header', { titulo, tipo }) %>
  <section class="tr-card">
    <form class="tracagem-calculator-form" method="POST" action="<%= action %>">
      <div class="tr-grid"><% campos.forEach((campo)=> { %><div><label><%= campo.label %></label><input class="input" name="<%= campo.name %>" type="<%= campo.type %>" step="<%= campo.step %>" value="<%= calculo?.parametros?.[campo.name] || '' %>" required></div><% }) %></div>
      <div class="tracagem-technical-view"><strong><%= desenho %></strong></div>
      <div><button class="btn btn-green" type="submit">CALCULAR</button></div>
    </form>
  </section>
  <% if (!calculo) { %><div class="tracagem-result-empty">Preencha os parâmetros e clique em Calcular.</div><% } else { const baseResult = calculo.resultado?.resultado || calculo.resultado || {}; const primitives = Object.entries(baseResult).filter(([,v]) => ['string','number','boolean'].includes(typeof v)); %>
    <section class="tr-card"><h3>Resultados principais</h3><div class="resultado"><% primitives.slice(0,8).forEach(([k,v])=> { %><div><%= k %> = <%= typeof v === 'number' ? v.toFixed(2) : v %></div><% }) %></div></section>
    <% if (calculo.resultado?.observacoes?.length || calculo.resultado?.observacao_tecnica) { %><section class="tracagem-note"><strong>Observações técnicas</strong><ul><% (calculo.resultado.observacoes || [calculo.resultado.observacao_tecnica]).filter(Boolean).forEach((obs)=> { %><li><%= obs %></li><% }) %></ul></section><% } %>
    <section class="tr-card"><%- include('partials/relacionar-equipamento', { tipo, calculo, equipamentos, ordensServico, tituloPadrao: titulo }) %></section>
  <% } %>
</div>
