<% layout('layout') %>
<link rel="stylesheet" href="/css/tracagem.css?v=20260923b">
<script src="/js/tracagem.js?v=20260819" defer></script>
<%
  const entrada = calculo?.resultado?.entrada || {};
  const resultado = calculo?.resultado?.resultado || {};
  const palhetas = resultado.palhetas || [];
  const maxRaio = resultado.raioExterno || ((entrada.D || 660) / 2);
  const escala = maxRaio > 0 ? 205 / maxRaio : 1;
  const cx = 255, cy = 235;
%>
<div class="tr-page">
  <%- include('partials/calculadora-header', { titulo: 'Traçagem do rotor radial', tipo: 'exaustor-radial' }) %>

  <div class="tracagem-note">
    <strong>Traçagem simples para fabricação do rotor</strong><br>
    Informe somente o diâmetro externo, o diâmetro interno e a quantidade de palhetas. O sistema calcula a divisão uniforme e as distâncias de marcação.
  </div>

  <div class="tr-card">
    <form class="exaustor-layout" method="POST" action="/tracagem/rotor-radial/calcular">
      <section class="exaustor-form">
        <h3>Medidas do rotor</h3>
        <div class="tr-grid">
          <div>
            <label>Diâmetro externo (mm)</label>
            <input class="input" name="D" type="number" min="0.01" step="0.01" required value="<%= calculo?.parametros?.D || '' %>" placeholder="Ex.: 660">
          </div>
          <div>
            <label>Diâmetro interno (mm)</label>
            <input class="input" name="dInterno" type="number" min="0.01" step="0.01" required value="<%= calculo?.parametros?.dInterno || calculo?.parametros?.dCubo || '' %>" placeholder="Ex.: 200">
          </div>
          <div>
            <label>Quantidade de palhetas</label>
            <input class="input" name="N" type="number" min="3" step="1" required value="<%= calculo?.parametros?.N || 12 %>" placeholder="Ex.: 12">
          </div>
        </div>

        <div class="tr-actions" style="margin-top:14px">
          <button class="btn btn-green" type="submit">CALCULAR</button>
        </div>

        <% if (calculo?.resultado) { %>
          <div class="rotor-medida-principal">
            <small>MEDIDA PRINCIPAL PARA MARCAÇÃO</small>
            <strong><%= resultado.distanciaEntrePalhetas.toFixed(2) %> mm</strong>
            <span>distância reta (corda) entre uma palheta e outra no diâmetro externo</span>
          </div>
        <% } %>
      </section>

      <section class="exaustor-preview">
        <h3>Desenho de traçagem</h3>
        <% if (calculo?.resultado) { %>
        <svg viewBox="0 0 560 500" class="exaustor-svg" role="img" aria-label="Traçagem do rotor radial">
          <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= (resultado.raioExterno * escala).toFixed(1) %>" fill="none" stroke="#15803d" stroke-width="3"/>
          <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= (resultado.raioInterno * escala).toFixed(1) %>" fill="#f8fafc" stroke="#64748b" stroke-width="3"/>
          <% palhetas.forEach((p) => { %>
            <line
              x1="<%= (cx + p.xInterno * escala).toFixed(1) %>"
              y1="<%= (cy - p.yInterno * escala).toFixed(1) %>"
              x2="<%= (cx + p.xExterno * escala).toFixed(1) %>"
              y2="<%= (cy - p.yExterno * escala).toFixed(1) %>"
              stroke="#0f172a"
              stroke-width="3"
            />
            <circle cx="<%= (cx + p.xExterno * escala).toFixed(1) %>" cy="<%= (cy - p.yExterno * escala).toFixed(1) %>" r="4" fill="#15803d"/>
            <circle cx="<%= (cx + p.xInterno * escala).toFixed(1) %>" cy="<%= (cy - p.yInterno * escala).toFixed(1) %>" r="3.5" fill="#64748b"/>
          <% }) %>
          <text x="280" y="472" text-anchor="middle" fill="#475569" font-size="14">Rotor radial • palhetas igualmente espaçadas • marcação por corda</text>
        </svg>
        <% } else { %>
          <div class="tracagem-result-empty">
            Exemplo: Ø externo <strong>660 mm</strong>, Ø interno <strong>200 mm</strong> e <strong>12 palhetas</strong>.
          </div>
        <% } %>
      </section>
    </form>
  </div>

  <% if (calculo?.resultado) { %>
    <div class="tr-card">
      <h3>Medidas para o mecânico</h3>
      <div class="resultado">
        <div><strong>Distância externa</strong><br><%= resultado.cordaExterna.toFixed(2) %> mm</div>
        <div><strong>Distância interna</strong><br><%= resultado.cordaInterna.toFixed(2) %> mm</div>
        <div><strong>Divisão angular</strong><br><%= resultado.passoAngular.toFixed(2) %>°</div>
        <div><strong>Comprimento radial</strong><br><%= resultado.comprimentoRadialPalheta.toFixed(2) %> mm</div>
        <div><strong>Passo no arco externo</strong><br><%= resultado.passoArcoExterno.toFixed(2) %> mm</div>
        <div><strong>Passo no arco interno</strong><br><%= resultado.passoArcoInterno.toFixed(2) %> mm</div>
      </div>
      <p class="hint" style="margin-top:10px">
        Para marcação prática na chapa, use principalmente as <strong>distâncias retas (cordas)</strong>. Marque os pontos no círculo externo e no interno e ligue os pontos correspondentes.
      </p>
    </div>

    <div class="tr-card">
      <h3>Sequência de marcação das palhetas</h3>
      <div class="table-wrap">
        <table class="tr-table">
          <thead><tr><th>Palheta</th><th>Ângulo</th><th>Distância externa</th><th>Distância interna</th></tr></thead>
          <tbody>
            <% palhetas.forEach((p) => { %>
              <tr>
                <td>P<%= p.indice %></td>
                <td><%= p.angulo.toFixed(2) %>°</td>
                <td><%= resultado.cordaExterna.toFixed(2) %> mm</td>
                <td><%= resultado.cordaInterna.toFixed(2) %> mm</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="tr-card">
      <%- include('partials/relacionar-equipamento', { tipo: 'exaustor-radial', calculo, equipamentos, tituloPadrao: 'Traçagem do rotor radial' }) %>
    </div>
  <% } %>
</div>
