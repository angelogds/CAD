<% layout('layout') %>
<link rel="stylesheet" href="/css/tracagem.css?v=20260819">
<script src="/js/tracagem.js?v=20260819" defer></script>
<%
  const ferramentas = [
    ['rosca-helicoidal','Rosca helicoidal','/tracagem/rosca-helicoidal','/img/tracagem/capas/rosca-helicoidal.png'],
    ['furacao-flange','Furação de flange','/tracagem/furacao-flange','/img/tracagem/capas/furacao-flange.png'],
    ['cilindro','Cilindro','/tracagem/cilindro','/img/tracagem/capas/cilindro.png'],
    ['curva-gomos','Curva de gomos','/tracagem/curva-gomos','/img/tracagem/capas/curva-gomos.png'],
    ['quadrado-para-redondo','Quadrado para redondo','/tracagem/quadrado-para-redondo','/img/tracagem/capas/quadrado-para-redondo.png'],
    ['reducao-concentrica','Redução concêntrica','/tracagem/reducao-concentrica','/img/tracagem/capas/reducao-concentrica.png'],
    ['semi-cilindro','Semicílindro','/tracagem/semi-cilindro','/img/tracagem/capas/semicilindro.png.png'],
    ['boca-de-lobo-excentrica','Boca de lobo excêntrica','/tracagem/boca-de-lobo-excentrica','/img/tracagem/capas/boca-de-lobo-excentrica.png.png'],
    ['boca-de-lobo-45','Boca de lobo 45°','/tracagem/boca-de-lobo-45-graus','/img/tracagem/capas/boca-de-lobo-45.png.png'],
    ['boca-de-lobo-90','Boca de lobo 90°','/tracagem/boca-de-lobo-90-graus','/img/tracagem/capas/boca-de-lobo-90.png.png'],
    ['mao-francesa','Mão francesa','/tracagem/mao-francesa','/img/tracagem/capas/mao-francesa.png.png'],
  ];
  const osSuffix = osContext ? ('?os_id='+osContext.id+'&equipamento_id='+osContext.equipamento_id) : '';
%>
<div class="tracagem-page">
  <nav class="tracagem-breadcrumb"><strong>Traçagem / Caldeiraria</strong></nav>
  <header class="tracagem-header">
    <div><h1>Traçagem / Caldeiraria</h1><p>Ferramentas de desenvolvimento e planificação para fabricação industrial</p></div>
    <div class="tracagem-header-actions"><a class="btn btn-outline" href="/tracagem/lista">Histórico</a><a class="btn btn-green" href="#ferramentas">Novo cálculo</a></div>
  </header>
  <% if (osContext) { %><div class="tracagem-note"><strong>Contexto da OS #<%= osContext.id %> — <%= osContext.equipamento_nome %></strong><br><small>O vínculo definitivo será confirmado depois que a traçagem for salva.</small></div><% } %>
  <section class="tracagem-summary-grid" aria-label="Resumo do módulo">
    <article class="tracagem-summary-card"><small>Ferramentas</small><strong>11</strong><span>calculadoras disponíveis</span></article>
    <article class="tracagem-summary-card"><small>Histórico</small><strong>Registros salvos</strong><span>consulta por tipo, equipamento, OS e período</span></article>
    <article class="tracagem-summary-card"><small>Favoritos</small><strong data-tr-favorite-count>0</strong><span>atalhos salvos neste dispositivo</span></article>
    <article class="tracagem-summary-card"><small>Integrações</small><strong>OS + Equipamentos</strong><span>PDF e arquivo técnico preservados</span></article>
  </section>
  <section id="ferramentas">
    <div class="tracagem-history-head"><div><h2>Central de cálculos e planificação</h2><p class="muted">Selecione a ferramenta técnica para iniciar o desenvolvimento.</p></div></div>
    <div class="tracagem-tool-grid">
      <% ferramentas.forEach((f) => { %><article class="tracagem-tool-card">
        <div class="tracagem-tool-visual"><img src="<%= f[3] %>" alt="<%= f[1] %>"></div>
        <h3><%= f[1] %></h3><p>Planificação e medidas para fabricação.</p>
        <div class="tracagem-tool-actions"><a class="btn btn-green" href="<%= f[2] %><%= f[0] === 'rosca-helicoidal' ? osSuffix : '' %>">Abrir</a><button class="tr-favorite" type="button" data-tr-favorite="<%= f[0] %>" aria-pressed="false">Favoritar</button></div>
      </article><% }) %>
    </div>
  </section>
</div>
