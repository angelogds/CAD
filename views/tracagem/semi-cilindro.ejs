<% layout('layout') %>
<link rel="stylesheet" href="/css/tracagem.css?v=20260819">
<script src="/js/tracagem.js?v=20260819" defer></script>
<div class="tr-page">
  <%- include('partials/calculadora-header', { titulo: 'Semicílindro', tipo: 'semi-cilindro' }) %>
  <div class="tr-card"><form class="tracagem-calculator-form" method="POST" action="/tracagem/semi-cilindro/calcular"><div class="tr-grid"><div><label>D (diâmetro)</label><input class="input" name="D" type="number" step="0.01" required value="<%= calculo?.parametros?.D || '' %>"></div><div><label>H (comprimento)</label><input class="input" name="H" type="number" step="0.01" required value="<%= calculo?.parametros?.H || '' %>"></div><div><label>E (espessura)</label><input class="input" name="E" type="number" step="0.01" required value="<%= calculo?.parametros?.E || '' %>"></div></div><div class="tr-grid"><div><label>Unidade</label><select class="input" name="unidade"><option value="mm" <%= (calculo?.parametros?.unidade || "mm") === "mm" ? "selected" : "" %>>mm</option><option value="cm" <%= calculo?.parametros?.unidade === "cm" ? "selected" : "" %>>cm</option></select></div></div><img src="/img/tracagem/planificacoes/semicilindro-peca.png.JPG" class="img-tecnica" alt="Semicílindro - peça"><div><button class="btn btn-green" type="submit">CALCULAR</button></div></form></div>
  <% if (calculo?.resultado) { const resultado = calculo.resultado.resultado; %><div class="tr-card"><h3>Planificação</h3><img src="/img/tracagem/planificacoes/semicilindro-planificacao.png.JPG" class="img-tecnica img-planificacao" alt="Semicílindro - planificação"></div><div class="tr-card"><h3>Resultados</h3><div class="resultado"><div>Meia circunferência = <%= resultado.meiaCircunferencia.toFixed(2) %> mm</div><div>Área = <%= resultado.area.toFixed(2) %> mm²</div></div></div><div class="tr-card"><%- include('partials/relacionar-equipamento', { tipo: 'semi-cilindro', calculo, equipamentos, tituloPadrao: 'Semi-cilindro' }) %></div><% } %>
</div>
