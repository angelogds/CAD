<% layout('layout') %>
<link rel="stylesheet" href="/css/tracagem.css?v=20260819">
<script src="/js/tracagem.js?v=20260819" defer></script>
<div class="tr-page">
  <%- include('partials/calculadora-header', { titulo: 'Mão francesa', tipo: 'mao-francesa' }) %>
  <div class="tr-card"><form class="tracagem-calculator-form" method="POST" action="/tracagem/mao-francesa/calcular"><div class="tr-grid"><div><label>A (base)</label><input class="input" name="A" type="number" step="0.01" required value="<%= calculo?.parametros?.A || '' %>"></div><div><label>h (altura)</label><input class="input" name="h" type="number" step="0.01" required value="<%= calculo?.parametros?.h || '' %>"></div><div><label>E (espessura)</label><input class="input" name="E" type="number" step="0.01" required value="<%= calculo?.parametros?.E || '' %>"></div></div><div class="tr-grid"><div><label>Unidade</label><select class="input" name="unidade"><option value="mm" <%= (calculo?.parametros?.unidade || "mm") === "mm" ? "selected" : "" %>>mm</option><option value="cm" <%= calculo?.parametros?.unidade === "cm" ? "selected" : "" %>>cm</option></select></div></div><img src="/img/tracagem/planificacoes/mao-francesa-peca.png" class="img-tecnica" alt="Mão francesa - peça"><div><button class="btn btn-green" type="submit">CALCULAR</button></div></form></div>
  <% if (calculo?.resultado) { const resultado = calculo.resultado.resultado; %><div class="tr-card"><h3>Planificação</h3><img src="/img/tracagem/planificacoes/mao-francesa-planificacao.png" class="img-tecnica img-planificacao" alt="Mão francesa - planificação"></div><div class="tr-card"><h3>Resultados</h3><div class="resultado"><div>C = <%= resultado.C.toFixed(2) %> mm</div><div>α = <%= resultado.alpha.toFixed(2) %>°</div><div>B = <%= resultado.B.toFixed(2) %> mm</div><div>D = <%= resultado.D.toFixed(2) %> mm</div></div></div><div class="tr-card"><%- include('partials/relacionar-equipamento', { tipo: 'mao-francesa', calculo, equipamentos, tituloPadrao: 'Mão francesa' }) %></div><% } %>
</div>
