<% layout('layout') %>
<link rel="stylesheet" href="/css/demandas.css">
<link rel="stylesheet" href="/css/demandas-planejamento.css?v=20260903-v3">
<%
  const statusLabel = value => ({
    NOVA: 'Nova', EM_ANALISE: 'Em análise', PLANEJAMENTO: 'Planejamento',
    AGUARDANDO_APROVACAO: 'Aguardando aprovação', EM_ANDAMENTO: 'Em andamento',
    PARADA: 'Parada', CONCLUIDA: 'Concluída', CANCELADA: 'Cancelada'
  }[value] || value || 'Não informado');
  const priorityLabel = value => ({ BAIXA: 'Baixa', NORMAL: 'Média', ALTA: 'Alta', URGENTE: 'Crítica' }[value] || value || 'Média');
  const categoryLabel = value => ({
    MANUTENCAO: 'Manutenção', PRODUCAO: 'Produção', NR: 'NR', SEGURANCA: 'Segurança',
    AUDITORIA: 'Auditoria', MELHORIA: 'Melhoria', PROJETO: 'Projeto', DIRETORIA: 'Diretoria'
  }[value] || value || 'Manutenção');
  const approvalLabel = value => ({ PENDENTE: 'Pendente', APROVADA: 'Aprovada', REPROVADA: 'Reprovada' }[value] || value || 'Pendente');
  const slug = value => String(value || '').toLowerCase().replace(/_/g, '-');
  const isFinished = ['CONCLUIDA', 'CANCELADA'].includes(demanda.status);
  const canOpen = canAccessModule(normalizeRole(user?.role), 'demandas_open');
  const canManage = canAccessModule(normalizeRole(user?.role), 'demandas_manage');
  const canMaterials = canAccessModule(normalizeRole(user?.role), 'demandas_materials');
  const canConvert = canAccessModule(normalizeRole(user?.role), 'demandas_convert');
  const canApprove = canAccessModule(normalizeRole(user?.role), 'demandas_approve');
  const elapsed = (() => {
    const start = new Date(demanda.created_at);
    const end = demanda.finished_at ? new Date(demanda.finished_at) : new Date();
    if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return 'Não disponível';
    const hours = Math.max(0, Math.floor((end - start) / 3600000));
    const days = Math.floor(hours / 24);
    return days ? `${days}d ${hours % 24}h` : `${hours}h`;
  })();
  const materialRequests = Array.isArray(demanda.solicitacoes) ? demanda.solicitacoes : [];
  const linkedOrders = Array.isArray(demanda.ordens) ? demanda.ordens : [];
  const children = Array.isArray(demanda.subdemandas) ? demanda.subdemandas : [];
  const money = value => Number(value || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const approvalReady = String(demanda.aprovacao_status || 'PENDENTE').toUpperCase() === 'APROVADA';
  const canPlanMaterials = canMaterials && !isFinished && !linkedOrders.length;
%>

<div class="demand-page demand-detail-page">
  <header class="demand-detail-head demand-detail-head-compact">
    <div>
      <a class="demand-back-link" href="/demandas">← Voltar para demandas</a>
      <div class="detail-title-line">
        <h1>Demanda #<%= demanda.id %></h1>
        <span class="demand-badge status-<%= slug(demanda.status) %>"><%= statusLabel(demanda.status) %></span>
        <span class="demand-badge priority-<%= slug(demanda.prioridade) %>"><%= priorityLabel(demanda.prioridade) %></span>
      </div>
      <p><%= demanda.titulo %></p>
      <% if (demanda.demanda_pai_id) { %>
        <a class="planning-parent-link" href="/demandas/<%= demanda.demanda_pai_id %>">↳ Subdemanda de #<%= demanda.demanda_pai_id %> — <%= demanda.demanda_pai_titulo || 'demanda principal' %></a>
      <% } %>
    </div>
    <div class="detail-head-actions planning-head-actions">
      <% if (!isFinished && canOpen) { %><a class="demand-btn demand-btn-secondary" href="/demandas/new?parent_id=<%= demanda.id %>">+ Subdemanda</a><% } %>
      <% if (linkedOrders.length) { %>
        <a class="demand-btn demand-btn-primary" href="/os/<%= linkedOrders[0].id %>">Abrir OS #<%= linkedOrders[0].id %></a>
      <% } else if (canConvert && !isFinished && approvalReady) { %>
        <form method="POST" action="/demandas/<%= demanda.id %>/convert-to-os" onsubmit="return confirm('Gerar a Ordem de Serviço desta demanda? As solicitações de materiais existentes serão reaproveitadas sem duplicação.')">
          <button class="demand-btn demand-btn-primary" type="submit">Gerar OS</button>
        </form>
      <% } else if (canConvert && !isFinished) { %>
        <button class="demand-btn demand-btn-muted" type="button" disabled title="A demanda precisa ser aprovada antes de gerar a OS.">Aguardando aprovação</button>
      <% } %>
    </div>
  </header>

  <section class="demand-detail-metrics planning-metrics demand-summary-metrics">
    <article class="detail-metric metric-blue"><small>Status</small><strong><%= statusLabel(demanda.status) %></strong></article>
    <article class="detail-metric metric-orange"><small>Prioridade</small><strong><%= priorityLabel(demanda.prioridade) %></strong></article>
    <article class="detail-metric metric-green"><small>Responsável</small><strong><%= demanda.responsavel_nome || 'A definir' %></strong></article>
    <article class="detail-metric metric-slate"><small>Aprovação</small><strong><%= approvalLabel(demanda.aprovacao_status) %></strong></article>
  </section>

  <nav class="demand-workspace-tabs" aria-label="Áreas da demanda" data-demand-tabs>
    <button type="button" data-tab="resumo" class="active">Resumo</button>
    <button type="button" data-tab="planejamento">Planejamento</button>
    <button type="button" data-tab="materiais">Materiais <span><%= materialRequests.length %></span></button>
    <button type="button" data-tab="subdemandas">Subdemandas <span><%= children.length %></span></button>
    <button type="button" data-tab="os">OS vinculadas <span><%= linkedOrders.length %></span></button>
    <button type="button" data-tab="historico">Histórico <span><%= demanda.logs?.length || 0 %></span></button>
  </nav>

  <div class="demand-workspace">
    <section class="demand-workspace-panel" data-panel="resumo">
      <section class="demand-card demand-overview-card">
        <div class="section-heading">
          <div><h2>Visão rápida</h2><p>Informações essenciais para decidir, planejar e acompanhar sem excesso de campos na tela.</p></div>
          <span class="section-total"><%= elapsed %> em aberto</span>
        </div>
        <div class="demand-overview-grid">
          <div><small>Categoria</small><strong><%= categoryLabel(demanda.categoria) %></strong></div>
          <div><small>Setor</small><strong><%= demanda.setor_origem || 'Não informado' %></strong></div>
          <div><small>Equipamento</small><strong><%= demanda.equipamento_nome || 'Sem equipamento específico' %></strong></div>
          <div><small>Prazo</small><strong><%= demanda.prazo_previsto ? fmtBR(demanda.prazo_previsto) : 'A definir' %></strong></div>
        </div>
      </section>

      <div class="demand-detail-grid demand-detail-grid-clean">
        <section class="demand-card demand-description-card">
          <div class="section-heading"><div><h2>Descrição da demanda</h2><p>Escopo registrado para execução futura.</p></div></div>
          <div class="demand-description"><%= demanda.descricao || 'Nenhuma descrição informada.' %></div>
          <% if (demanda.ultima_atualizacao) { %><div class="latest-update"><span>Última atualização</span><p><%= demanda.ultima_atualizacao %></p></div><% } %>
        </section>

        <section class="demand-card demand-control-card">
          <div class="section-heading"><div><h2>Controle rápido</h2><p>Atualize apenas o necessário para manter a fila organizada.</p></div></div>
          <% if (canManage) { %>
            <form method="POST" action="/demandas/<%= demanda.id %>/status" class="demand-control-form">
              <label><span>Status</span><select name="status"><% ['NOVA','EM_ANALISE','PLANEJAMENTO','AGUARDANDO_APROVACAO','EM_ANDAMENTO','PARADA','CONCLUIDA','CANCELADA'].forEach(st => { %><option value="<%= st %>" <%= demanda.status === st ? 'selected' : '' %>><%= statusLabel(st) %></option><% }) %></select></label>
              <label><span>Responsável</span><select name="responsavel_user_id"><option value="">A definir</option><% (responsaveis || []).forEach(person => { %><option value="<%= person.id %>" <%= Number(demanda.responsavel_user_id || 0) === Number(person.id) ? 'selected' : '' %>><%= person.name %></option><% }) %></select></label>
              <button class="demand-btn demand-btn-primary" type="submit">Salvar controle</button>
            </form>
          <% } else { %>
            <div class="planning-empty">Consulta liberada. Alterações de controle ficam restritas aos perfis autorizados.</div>
          <% } %>
        </section>
      </div>
    </section>

    <section class="demand-workspace-panel" data-panel="planejamento" hidden>
      <div class="demand-section-title">
        <div><h2>Planejamento</h2><p>Concentre contexto, aprovação e situação do serviço antes da execução.</p></div>
      </div>

      <section class="demand-card planning-context-card planning-context-card-clean">
        <div class="planning-context-grid">
          <div><small>Categoria</small><strong><%= categoryLabel(demanda.categoria) %></strong></div>
          <div><small>Setor de origem</small><strong><%= demanda.setor_origem || 'Não informado' %></strong></div>
          <div><small>Equipamento</small><strong><%= demanda.equipamento_nome || 'Sem equipamento específico' %></strong></div>
          <div><small>NR relacionada</small><strong><%= demanda.nr_referencia || 'Não se aplica' %></strong></div>
          <div><small>Prazo previsto</small><strong><%= demanda.prazo_previsto ? fmtBR(demanda.prazo_previsto) : 'A definir' %></strong></div>
          <div><small>Serviços estimados</small><strong><%= money(demanda.custo_servicos_estimado) %></strong></div>
        </div>
        <% if (canApprove && !isFinished) { %>
          <form class="planning-approval-form" method="POST" action="/demandas/<%= demanda.id %>/aprovacao">
            <label><span>Aprovação / priorização</span><select name="aprovacao_status"><% ['PENDENTE','APROVADA','REPROVADA'].forEach(st => { %><option value="<%= st %>" <%= String(demanda.aprovacao_status || 'PENDENTE') === st ? 'selected' : '' %>><%= approvalLabel(st) %></option><% }) %></select></label>
            <button class="demand-btn demand-btn-secondary" type="submit">Salvar aprovação</button>
          </form>
        <% } %>
      </section>

      <section class="demand-card demand-progress-card">
        <div class="section-heading"><div><h2>Fluxo da demanda</h2><p>Da necessidade registrada até a conclusão do serviço.</p></div></div>
        <div class="demand-progress demand-progress-four demand-progress-inline" aria-label="Andamento da demanda">
          <div class="progress-step done"><span>1</span><div><strong>Registrada</strong><small><%= fmtBR(demanda.created_at) %></small></div></div>
          <i class="<%= ['PLANEJAMENTO','AGUARDANDO_APROVACAO','EM_ANDAMENTO','PARADA','CONCLUIDA'].includes(demanda.status) ? 'done' : '' %>"></i>
          <div class="progress-step <%= ['PLANEJAMENTO','AGUARDANDO_APROVACAO','EM_ANDAMENTO','PARADA','CONCLUIDA'].includes(demanda.status) ? 'done' : '' %>"><span>2</span><div><strong>Planejamento</strong><small><%= materialRequests.length ? materialRequests.length + ' solicitação(ões)' : 'Sem materiais' %></small></div></div>
          <i class="<%= approvalReady || linkedOrders.length ? 'done' : '' %>"></i>
          <div class="progress-step <%= approvalReady || linkedOrders.length ? 'done' : '' %>"><span>3</span><div><strong>Aprovação</strong><small><%= approvalLabel(demanda.aprovacao_status) %></small></div></div>
          <i class="<%= linkedOrders.length || demanda.started_at || isFinished ? 'done' : '' %>"></i>
          <div class="progress-step <%= linkedOrders.length || demanda.started_at || isFinished ? 'done' : '' %>"><span>4</span><div><strong>OS / execução</strong><small><%= linkedOrders.length ? linkedOrders.length + ' OS' : 'Aguardando' %></small></div></div>
        </div>
      </section>
    </section>

    <section class="demand-workspace-panel" data-panel="materiais" hidden>
      <div class="demand-section-title demand-section-title-actions">
        <div><h2>Materiais e pré-cotações</h2><p>Lista técnica enxuta, integrada a Solicitações e Compras sem duplicar cadastro.</p></div>
        <% if (canPlanMaterials) { %><button class="demand-btn demand-btn-primary" type="button" data-new-material-request>+ Planejar materiais</button><% } %>
      </div>

      <% if (linkedOrders.length) { %>
        <div class="demand-material-lock-note"><strong>Edição encerrada pela OS.</strong><span>Depois da geração da Ordem de Serviço, novos materiais urgentes devem ser incluídos pelo fluxo já existente da própria OS.</span></div>
      <% } %>

      <section class="demand-card demand-data-card">
        <% if (!materialRequests.length) { %>
          <div class="demand-empty demand-empty-compact"><span class="empty-icon">+</span><h3>Nenhum material planejado</h3><p>Adicione somente o que for necessário. A solicitação seguirá para pré-cotação e a compra continuará bloqueada até existir OS.</p></div>
        <% } else { %>
          <div class="demand-data-table demand-material-table" role="table" aria-label="Materiais e pré-cotações">
            <div class="demand-data-row demand-data-head" role="row"><span>Solicitação</span><span>Status</span><span>Cotação</span><span>Vínculo</span><span>Ação</span></div>
            <% materialRequests.forEach(sol => { const total = Number(sol.itens_count || 0); const quoted = Number(sol.itens_cotados || 0); const pct = total ? Math.round(quoted / total * 100) : 0; %>
              <div class="demand-data-row" role="row">
                <div data-label="Solicitação"><strong><%= sol.numero || '#'+sol.id %></strong><small><%= sol.titulo %></small></div>
                <div data-label="Status"><span class="demand-badge status-<%= slug(sol.status) %>"><%= sol.status %></span></div>
                <div data-label="Cotação" class="material-progress"><span><%= quoted %> de <%= total %> item(ns)</span><i><b style="width:<%= pct %>%"></b></i></div>
                <div data-label="Vínculo"><strong><%= sol.os_id ? 'OS #' + sol.os_id : 'Pré-cotação' %></strong><small><%= sol.os_id ? 'Compra liberada pelo fluxo normal' : 'Compra aguardando OS' %></small></div>
                <div data-label="Ação" class="demand-row-action demand-material-actions">
                  <a class="demand-btn demand-btn-secondary demand-btn-small" href="/compras/solicitacoes/<%= sol.id %>">Abrir</a>
                  <% if (canMaterials && sol.pode_editar_materiais_demanda) { %>
                    <button class="demand-btn demand-btn-secondary demand-btn-small" type="button" data-edit-material-request data-solicitacao-id="<%= sol.id %>" data-solicitacao-numero="<%= sol.numero || '#'+sol.id %>">Editar</button>
                  <% } else if (sol.os_id || linkedOrders.length) { %>
                    <small class="demand-edit-locked">Edição encerrada</small>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <% if (canPlanMaterials) { %>
        <section class="demand-card demand-material-editor" data-material-form hidden>
          <div class="section-heading">
            <div><h2 data-material-editor-title>Planejar nova solicitação de materiais</h2><p data-material-editor-help>Cadastre apenas nome, quantidade e o detalhe técnico necessário. Os demais dados seguem o fluxo de Compras.</p></div>
            <button type="button" class="demand-btn demand-btn-secondary demand-btn-small" data-close-material-form>Fechar</button>
          </div>
          <form method="POST" action="/demandas/<%= demanda.id %>/materiais" data-create-action="/demandas/<%= demanda.id %>/materiais" class="planning-material-form" id="demandMaterialsForm">
            <div id="materialRows">
              <div class="material-input-row material-input-row-light">
                <label><span>Material *</span><input name="itens_nome[]" required placeholder="Ex.: Rolamento 22218"></label>
                <label><span>Quantidade *</span><input type="number" name="itens_qtd[]" min="0.001" step="0.001" required value="1"></label>
                <label><span>Unidade</span><input name="itens_un[]" value="UN" maxlength="10"></label>
                <label><span>Especificação</span><input name="itens_especificacao[]" placeholder="Medida, marca ou norma, se necessário"></label>
                <label><span>Estoque</span><select name="itens_item_id[]"><option value="">Não vincular</option><% (estoqueItens || []).forEach(item => { %><option value="<%= item.id %>"><%= item.codigo ? item.codigo + ' — ' : '' %><%= item.nome %></option><% }) %></select></label>
                <button class="material-remove" type="button" aria-label="Remover material">×</button>
              </div>
            </div>
            <div class="material-form-actions"><button class="demand-btn demand-btn-secondary" type="button" id="addMaterialRow">+ Outro material</button><button class="demand-btn demand-btn-primary" type="submit" data-material-submit>Criar solicitação e enviar para pré-cotação</button></div>
          </form>
        </section>
      <% } %>
    </section>

    <section class="demand-workspace-panel" data-panel="subdemandas" hidden>
      <div class="demand-section-title demand-section-title-actions">
        <div><h2>Subdemandas</h2><p>Divida projetos grandes em serviços executáveis sem perder o vínculo com a demanda principal.</p></div>
        <% if (!isFinished && canOpen) { %><a class="demand-btn demand-btn-primary" href="/demandas/new?parent_id=<%= demanda.id %>">+ Nova subdemanda</a><% } %>
      </div>

      <section class="demand-card demand-data-card">
        <% if (!children.length) { %>
          <div class="demand-empty demand-empty-compact"><span class="empty-icon">+</span><h3>Nenhuma subdemanda</h3><p>Use subdemandas somente quando o serviço realmente precisar ser dividido em etapas ou frentes independentes.</p></div>
        <% } else { %>
          <div class="demand-data-table demand-subdemand-table" role="table" aria-label="Subdemandas">
            <div class="demand-data-row demand-data-head" role="row"><span>Serviço</span><span>Equipamento</span><span>Status</span><span>Prioridade</span><span>Responsável</span><span>Ação</span></div>
            <% children.forEach(child => { %>
              <div class="demand-data-row" role="row">
                <div data-label="Serviço"><strong>#<%= child.id %> — <%= child.titulo %></strong><small><%= categoryLabel(child.categoria) %></small></div>
                <div data-label="Equipamento"><strong><%= child.equipamento_nome || 'Sem equipamento' %></strong></div>
                <div data-label="Status"><span class="demand-badge status-<%= slug(child.status) %>"><%= statusLabel(child.status) %></span></div>
                <div data-label="Prioridade"><span class="demand-badge priority-<%= slug(child.prioridade) %>"><%= priorityLabel(child.prioridade) %></span></div>
                <div data-label="Responsável"><strong><%= child.responsavel_nome || 'A definir' %></strong></div>
                <div data-label="Ação" class="demand-row-action"><a class="demand-btn demand-btn-secondary demand-btn-small" href="/demandas/<%= child.id %>">Abrir</a></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </section>

    <section class="demand-workspace-panel" data-panel="os" hidden>
      <div class="demand-section-title"><div><h2>Ordens de Serviço vinculadas</h2><p>A OS representa a execução; o planejamento e as cotações anteriores continuam ligados à mesma demanda.</p></div></div>
      <section class="demand-card demand-data-card">
        <% if (!linkedOrders.length) { %>
          <div class="demand-empty demand-empty-compact"><span class="empty-icon">OS</span><h3>Nenhuma OS vinculada</h3><p>Pré-cotações podem ser feitas antes. A OS será gerada somente após a aprovação da demanda.</p></div>
        <% } else { %>
          <div class="demand-data-table demand-os-table" role="table" aria-label="Ordens de Serviço">
            <div class="demand-data-row demand-data-head" role="row"><span>OS</span><span>Status</span><span>Tipo</span><span>Abertura</span><span>Descrição</span><span>Ação</span></div>
            <% linkedOrders.forEach(order => { %>
              <div class="demand-data-row" role="row">
                <div data-label="OS"><strong>#<%= order.id %></strong></div>
                <div data-label="Status"><span class="demand-badge status-<%= slug(order.status) %>"><%= order.status %></span></div>
                <div data-label="Tipo"><strong><%= order.tipo || 'OUTROS' %></strong></div>
                <div data-label="Abertura"><strong><%= order.opened_at ? fmtBR(order.opened_at) : 'Não informado' %></strong></div>
                <div data-label="Descrição"><small><%= String(order.descricao || '').slice(0, 140) || 'Sem descrição' %></small></div>
                <div data-label="Ação" class="demand-row-action"><a class="demand-btn demand-btn-secondary demand-btn-small" href="/os/<%= order.id %>">Abrir OS</a></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </section>

    <section class="demand-workspace-panel" data-panel="historico" hidden>
      <div class="demand-activity-grid demand-history-layout">
        <% if (canManage) { %>
          <section class="demand-card demand-update-card">
            <div class="section-heading"><div><h2>Registrar atualização</h2><p>Registre somente decisões, impedimentos ou próximos passos relevantes.</p></div></div>
            <form method="POST" action="/demandas/<%= demanda.id %>/update">
              <textarea name="texto" rows="5" required placeholder="Ex.: aguardando material, serviço programado para segunda-feira, cotação aprovada..."></textarea>
              <div class="update-actions"><small>Data e usuário são registrados automaticamente.</small><button class="demand-btn demand-btn-secondary" type="submit">Salvar atualização</button></div>
            </form>
          </section>
        <% } %>
        <section class="demand-card demand-history-card">
          <div class="section-heading"><div><h2>Histórico e rastreabilidade</h2><p>Movimentações registradas nesta demanda.</p></div><span class="section-total"><%= demanda.logs?.length || 0 %> evento(s)</span></div>
          <% if (!demanda.logs?.length) { %><div class="history-empty">Nenhuma atualização registrada.</div><% } else { %>
            <ol class="demand-timeline"><% demanda.logs.forEach(log => { %><li><span class="timeline-dot"></span><div><p><%= log.texto %></p><small><%= fmtBR(log.created_at) %> · <%= log.user_nome || 'Sistema' %></small></div></li><% }) %></ol>
          <% } %>
        </section>
      </div>
    </section>
  </div>
</div>

<script>
(() => {
  const tabs = Array.from(document.querySelectorAll('[data-demand-tabs] [data-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-panel]'));
  const allowed = new Set(tabs.map(tab => tab.dataset.tab));
  const activate = (name, updateHash = true) => {
    const target = allowed.has(name) ? name : 'resumo';
    tabs.forEach(tab => tab.classList.toggle('active', tab.dataset.tab === target));
    panels.forEach(panel => { panel.hidden = panel.dataset.panel !== target; });
    if (updateHash) history.replaceState(null, '', `#${target}`);
  };
  tabs.forEach(tab => tab.addEventListener('click', () => activate(tab.dataset.tab)));
  activate(String(location.hash || '').replace('#', ''), false);

  const editor = document.querySelector('[data-material-form]');
  const form = document.getElementById('demandMaterialsForm');
  const editorTitle = document.querySelector('[data-material-editor-title]');
  const editorHelp = document.querySelector('[data-material-editor-help]');
  const submit = document.querySelector('[data-material-submit]');
  const root = document.getElementById('materialRows');
  const add = document.getElementById('addMaterialRow');

  const clearRow = (row) => {
    row.querySelectorAll('input').forEach(input => {
      if (input.name === 'itens_un[]') input.value = 'UN';
      else if (input.name === 'itens_qtd[]') input.value = '1';
      else input.value = '';
    });
    row.querySelectorAll('select').forEach(select => { select.selectedIndex = 0; });
  };

  const resetRows = () => {
    if (!root) return;
    const rows = Array.from(root.querySelectorAll('.material-input-row'));
    rows.slice(1).forEach(row => row.remove());
    if (rows[0]) clearRow(rows[0]);
  };

  const openEditor = ({ solicitacaoId = null, numero = null } = {}) => {
    if (!editor || !form) return;
    resetRows();
    if (solicitacaoId) {
      form.action = `/demandas/<%= demanda.id %>/solicitacoes/${Number(solicitacaoId)}/materiais`;
      if (editorTitle) editorTitle.textContent = `Adicionar itens à ${numero || 'solicitação'}`;
      if (editorHelp) editorHelp.textContent = 'Somente os novos itens serão acrescentados. Itens, cotações, fornecedores e valores já registrados serão preservados.';
      if (submit) submit.textContent = 'Adicionar itens à solicitação';
    } else {
      form.action = form.dataset.createAction;
      if (editorTitle) editorTitle.textContent = 'Planejar nova solicitação de materiais';
      if (editorHelp) editorHelp.textContent = 'Cadastre apenas nome, quantidade e o detalhe técnico necessário. Os demais dados seguem o fluxo de Compras.';
      if (submit) submit.textContent = 'Criar solicitação e enviar para pré-cotação';
    }
    editor.hidden = false;
    editor.scrollIntoView({ behavior: 'smooth', block: 'start' });
    root?.querySelector('input')?.focus();
  };

  document.querySelectorAll('[data-new-material-request]').forEach(button => {
    button.addEventListener('click', () => openEditor());
  });
  document.querySelectorAll('[data-edit-material-request]').forEach(button => {
    button.addEventListener('click', () => openEditor({
      solicitacaoId: button.dataset.solicitacaoId,
      numero: button.dataset.solicitacaoNumero,
    }));
  });
  document.querySelectorAll('[data-close-material-form]').forEach(button => {
    button.addEventListener('click', () => { if (editor) editor.hidden = true; });
  });

  if (!root || !add) return;
  const wireRemove = (row) => {
    const button = row.querySelector('.material-remove');
    if (!button) return;
    button.onclick = () => {
      if (root.querySelectorAll('.material-input-row').length > 1) row.remove();
      else clearRow(row);
    };
  };
  root.querySelectorAll('.material-input-row').forEach(wireRemove);
  add.addEventListener('click', () => {
    const template = root.querySelector('.material-input-row');
    if (!template) return;
    const row = template.cloneNode(true);
    clearRow(row);
    wireRemove(row);
    root.appendChild(row);
    row.querySelector('input')?.focus();
  });
})();
</script>