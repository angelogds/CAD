<% layout('layout') %>
<link rel="stylesheet" href="/css/demandas.css">
<link rel="stylesheet" href="/css/demandas-planejamento.css?v=20260903-v2">
<%
  const currentRole = normalizeRole(user?.role || '');
  const categoryLabels = {
    MANUTENCAO: 'Manutenção', PRODUCAO: 'Produção', NR: 'Norma Regulamentadora (NR)',
    SEGURANCA: 'Segurança', AUDITORIA: 'Auditoria', MELHORIA: 'Melhoria',
    PROJETO: 'Projeto', DIRETORIA: 'Diretoria'
  };
  const allowedCategories = currentRole === 'RH'
    ? (categorias || []).filter(cat => ['NR','SEGURANCA','AUDITORIA'].includes(cat))
    : (categorias || []);
  const selectedParent = parentId ? (parentCandidates || []).find(parent => Number(parent.id) === Number(parentId)) : null;
%>

<div class="demand-page demand-form-page">
  <header class="demand-head demand-form-head">
    <div>
      <a class="demand-back-link" href="<%= parentId ? '/demandas/' + parentId : '/demandas' %>">← Voltar para demandas</a>
      <h1><%= parentId ? 'Nova subdemanda' : 'Nova demanda' %></h1>
      <p>Cadastro rápido: registre o essencial agora e complemente o planejamento somente quando necessário.</p>
    </div>
  </header>

  <div class="demand-form-layout demand-form-layout-light">
    <section class="demand-card demand-form-card">
      <div class="section-heading">
        <div><h2>Cadastro essencial</h2><p>Título, prioridade e descrição são suficientes para colocar a demanda no fluxo.</p></div>
        <span class="form-step"><%= parentId ? 'Subdemanda' : 'Demanda' %></span>
      </div>

      <form method="POST" action="/demandas" class="modern-demand-form demand-quick-form">
        <% if (parentId) { %>
          <input type="hidden" name="demanda_pai_id" value="<%= parentId %>">
          <div class="form-wide demand-parent-banner">
            <span>Vinculada à demanda principal</span>
            <strong>#<%= parentId %> — <%= selectedParent?.titulo || 'Demanda principal' %></strong>
          </div>
        <% } %>

        <label class="form-wide">
          <span>Título *</span>
          <input name="titulo" maxlength="160" required autofocus placeholder="Ex.: Reforma do cilindro do triturador FAST">
          <small>Use um título curto e fácil de localizar.</small>
        </label>

        <label>
          <span>Prioridade *</span>
          <select name="prioridade" required>
            <option value="NORMAL" selected>Média — fluxo normal</option>
            <option value="BAIXA">Baixa — pode ser programada</option>
            <option value="ALTA">Alta — requer prioridade</option>
            <option value="URGENTE">Crítica — ação imediata</option>
          </select>
        </label>

        <label>
          <span>Categoria</span>
          <select name="categoria">
            <% allowedCategories.forEach(cat => { %><option value="<%= cat %>" <%= cat === 'MANUTENCAO' ? 'selected' : '' %>><%= categoryLabels[cat] || cat %></option><% }) %>
          </select>
        </label>

        <label class="form-wide">
          <span>Descrição *</span>
          <textarea name="descricao" rows="5" required placeholder="Descreva o que precisa ser feito e o resultado esperado."></textarea>
          <small>Evite burocracia: informe apenas o suficiente para a equipe entender a necessidade.</small>
        </label>

        <details class="form-wide demand-advanced-fields">
          <summary>+ Adicionar informações de planejamento</summary>
          <div class="demand-advanced-grid">
            <% if (!parentId) { %>
              <label>
                <span>Demanda principal</span>
                <select name="demanda_pai_id">
                  <option value="">Sem vínculo</option>
                  <% (parentCandidates || []).forEach(parent => { %><option value="<%= parent.id %>">#<%= parent.id %> — <%= parent.titulo %></option><% }) %>
                </select>
              </label>
            <% } %>

            <label>
              <span>Equipamento</span>
              <select name="equipamento_id">
                <option value="">Sem equipamento específico</option>
                <% (equipamentos || []).forEach(eq => { %><option value="<%= eq.id %>"><%= eq.nome %></option><% }) %>
              </select>
            </label>

            <label>
              <span>Setor de origem</span>
              <input name="setor_origem" maxlength="100" placeholder="Ex.: Manutenção, Produção, Caldeira">
            </label>

            <label>
              <span>Prazo previsto</span>
              <input type="date" name="prazo_previsto">
            </label>

            <label>
              <span>NR relacionada</span>
              <input name="nr_referencia" maxlength="60" placeholder="Ex.: NR-12, NR-13">
            </label>

            <label>
              <span>Custo estimado de serviços</span>
              <input type="number" name="custo_servicos_estimado" min="0" step="0.01" placeholder="0,00">
            </label>
          </div>
        </details>

        <div class="form-actions form-wide demand-form-actions-sticky">
          <a class="demand-btn demand-btn-secondary" href="<%= parentId ? '/demandas/' + parentId : '/demandas' %>">Cancelar</a>
          <button class="demand-btn demand-btn-primary" type="submit"><%= parentId ? 'Criar subdemanda' : 'Criar demanda' %></button>
        </div>
      </form>
    </section>

    <aside class="demand-card demand-form-help demand-form-help-light">
      <span class="help-icon" aria-hidden="true">i</span>
      <h2>Cadastro leve</h2>
      <p>O objetivo é registrar a necessidade rápido. Materiais, cotações, aprovação e OS entram depois, conforme a demanda avança.</p>
      <div class="quick-flow-list">
        <div><span>1</span><strong>Registrar necessidade</strong></div>
        <div><span>2</span><strong>Planejar se necessário</strong></div>
        <div><span>3</span><strong>Pré-cotar materiais</strong></div>
        <div><span>4</span><strong>Aprovar e gerar OS</strong></div>
      </div>
      <div class="help-note">Quanto menos campos obrigatórios, mais rápido o time registra as demandas sem perder rastreabilidade.</div>
    </aside>
  </div>
</div>
