<% layout('layout') %>
<link rel="stylesheet" href="/css/demandas.css">
<link rel="stylesheet" href="/css/demandas-planejamento.css?v=20260903-v2">
<%
  const statusLabel = value => ({
    NOVA: 'Nova', EM_ANALISE: 'Em análise', PLANEJAMENTO: 'Planejamento',
    AGUARDANDO_APROVACAO: 'Aguardando aprovação', EM_ANDAMENTO: 'Em andamento',
    PARADA: 'Parada', CONCLUIDA: 'Concluída', CANCELADA: 'Cancelada'
  }[value] || value || 'Não informado');
  const priorityLabel = value => ({ BAIXA: 'Baixa', NORMAL: 'Média', ALTA: 'Alta', URGENTE: 'Crítica' }[value] || value || 'Média');
  const categoryLabel = value => ({ MANUTENCAO:'Manutenção', PRODUCAO:'Produção', NR:'NR', SEGURANCA:'Segurança', AUDITORIA:'Auditoria', MELHORIA:'Melhoria', PROJETO:'Projeto', DIRETORIA:'Diretoria' }[value] || value || 'Manutenção');
  const slug = value => String(value || '').toLowerCase().replace(/_/g, '-');
  const canManageDemand = canAccessModule(normalizeRole(user?.role), 'demandas_manage');
  const canDeleteDemand = canAccessModule(normalizeRole(user?.role), 'demandas_delete');
  const query = changes => {
    const values = { ...filters, ...changes };
    const params = new URLSearchParams();
    Object.entries(values).forEach(([key, value]) => {
      if (value !== '' && value !== null && value !== undefined) params.set(key, value);
    });
    return params.toString();
  };
  const groups = [
    { key: 'critica', title: 'Demandas críticas', note: 'Tratamento imediato e acompanhamento próximo', items: lista.filter(d => d.prioridade === 'URGENTE') },
    { key: 'alta', title: 'Prioridade alta', note: 'Demandas importantes que exigem resposta rápida', items: lista.filter(d => d.prioridade === 'ALTA') },
    { key: 'media', title: 'Prioridade média', note: 'Demandas do fluxo operacional', items: lista.filter(d => d.prioridade === 'NORMAL') },
    { key: 'baixa', title: 'Prioridade baixa', note: 'Demandas programáveis', items: lista.filter(d => d.prioridade === 'BAIXA') },
  ];
  const metrics = [
    { label: 'Demandas ativas', value: painel.ativas, note: 'Fila operacional', tone: 'green', href: query({ tab: 'ATIVAS', status: '', prioridade: '' }) },
    { label: 'Novas', value: painel.novas, note: 'Aguardando análise', tone: 'blue', href: query({ tab: 'ATIVAS', status: 'NOVA' }) },
    { label: 'Em análise', value: painel.em_analise, note: painel.planejamento ? `${painel.planejamento} em planejamento` : 'Em avaliação', tone: 'violet', href: query({ tab: 'ATIVAS', status: 'EM_ANALISE' }) },
    { label: 'Em andamento', value: painel.em_andamento, note: 'Execução ativa', tone: 'teal', href: query({ tab: 'ATIVAS', status: 'EM_ANDAMENTO' }) },
    { label: 'Paradas', value: painel.paradas, note: painel.paradas ? 'Requer atenção' : 'Nenhuma no momento', tone: 'red', href: query({ tab: 'ATIVAS', status: 'PARADA' }) },
    { label: 'Críticas', value: painel.criticas, note: 'Ação imediata', tone: 'red', href: query({ tab: 'ATIVAS', status: '', prioridade: 'URGENTE' }) },
    { label: 'Altas', value: painel.altas, note: 'Resposta rápida', tone: 'orange', href: query({ tab: 'ATIVAS', status: '', prioridade: 'ALTA' }) },
    { label: 'Prazo vencido', value: painel.prazos_atrasados, note: 'Demandas fora do prazo', tone: 'red', href: query({ tab: 'ATIVAS', status: '', prioridade: '' }) },
  ];
%>

<div class="demand-page">
  <header class="demand-head">
    <div>
      <h1>Demandas</h1>
      <p>Banco de serviços planejados para registrar necessidades rápido, priorizar e preparar a futura execução em OS.</p>
    </div>
    <% if (canAccessModule(normalizeRole(user?.role), 'demandas_open')) { %>
      <a class="demand-btn demand-btn-primary ui-btn ui-btn--primary" href="/demandas/new"><span aria-hidden="true">＋</span> Nova demanda</a>
    <% } %>
  </header>

  <section class="demand-metrics" aria-label="Indicadores das demandas">
    <% metrics.forEach(metric => { %>
      <a class="demand-metric tone-<%= metric.tone %>" href="/demandas?<%= metric.href %>">
        <span class="metric-mark" aria-hidden="true"></span>
        <span class="metric-label"><%= metric.label %></span>
        <strong><%= metric.value || 0 %></strong>
        <small><%= metric.note %></small>
      </a>
    <% }) %>
  </section>

  <% if (painel.paradas || painel.criticas || painel.prazos_atrasados || painel.sem_atualizacao) { %>
    <section class="demand-attention" aria-label="Atenções da fila">
      <span class="attention-icon" aria-hidden="true">!</span>
      <div>
        <strong>Atenção à fila operacional</strong>
        <p>
          <% const alerts = []; %>
          <% if (painel.paradas) alerts.push(`${painel.paradas} parada(s)`); %>
          <% if (painel.criticas) alerts.push(`${painel.criticas} crítica(s)`); %>
          <% if (painel.prazos_atrasados) alerts.push(`${painel.prazos_atrasados} com prazo vencido`); %>
          <% if (painel.sem_atualizacao) alerts.push(`${painel.sem_atualizacao} sem movimentação há 7 dias ou mais`); %>
          <%= alerts.join(' · ') %>.
        </p>
      </div>
      <a href="/demandas?<%= query({ tab: 'ATIVAS', status: '', prioridade: '' }) %>">Ver fila</a>
    </section>
  <% } %>

  <section class="demand-card demand-filter-card">
    <nav class="demand-tabs" aria-label="Visualização das demandas">
      <a class="<%= filters.tab === 'ATIVAS' ? 'active' : '' %>" href="/demandas?<%= query({ tab: 'ATIVAS', status: '' }) %>">Ativas <span><%= painel.ativas || 0 %></span></a>
      <a class="<%= filters.tab === 'HISTORICO' ? 'active' : '' %>" href="/demandas?<%= query({ tab: 'HISTORICO', status: '' }) %>">Concluídas e histórico <span><%= painel.concluidas || 0 %></span></a>
      <a class="<%= filters.tab === 'TODAS' ? 'active' : '' %>" href="/demandas?<%= query({ tab: 'TODAS', status: '' }) %>">Todas</a>
    </nav>

    <form class="demand-filters" method="GET" action="/demandas">
      <input type="hidden" name="tab" value="<%= filters.tab %>">
      <label class="filter-search"><span>Buscar</span><input name="q" value="<%= filters.q %>" placeholder="Número, título, equipamento, NR ou pessoa"></label>
      <label><span>Status</span><select name="status"><option value="">Todos</option><% ['NOVA','EM_ANALISE','PLANEJAMENTO','AGUARDANDO_APROVACAO','EM_ANDAMENTO','PARADA','CONCLUIDA','CANCELADA'].forEach(st => { %><option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= statusLabel(st) %></option><% }) %></select></label>
      <label><span>Prioridade</span><select name="prioridade"><option value="">Todas</option><% ['URGENTE','ALTA','NORMAL','BAIXA'].forEach(pr => { %><option value="<%= pr %>" <%= filters.prioridade === pr ? 'selected' : '' %>><%= priorityLabel(pr) %></option><% }) %></select></label>
      <label><span>Responsável</span><select name="responsavel_user_id"><option value="">Todos</option><% (responsaveis || []).forEach(person => { %><option value="<%= person.id %>" <%= String(filters.responsavel_user_id) === String(person.id) ? 'selected' : '' %>><%= person.name %></option><% }) %></select></label>
      <label class="filter-limit"><span>Exibir</span><select name="limit"><% [10,20,50].forEach(value => { %><option value="<%= value %>" <%= Number(filters.limit) === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
      <div class="filter-actions"><button class="demand-btn demand-btn-primary ui-btn ui-btn--primary" type="submit">Aplicar filtros</button><a class="demand-btn demand-btn-secondary ui-btn ui-btn--secondary" href="/demandas?tab=<%= filters.tab %>">Limpar</a></div>
    </form>
  </section>

  <section class="demand-card demand-list-card">
    <div class="section-heading">
      <div><h2><%= filters.tab === 'HISTORICO' ? 'Histórico de demandas' : filters.tab === 'TODAS' ? 'Todas as demandas' : 'Demandas ativas' %></h2><p><strong><%= lista.length %></strong> registro(s), ordenados por prioridade e última movimentação.</p></div>
      <span class="section-total"><%= painel.ativas || 0 %> ativa(s)</span>
    </div>

    <% if (!lista.length) { %>
      <div class="demand-empty"><span class="empty-icon" aria-hidden="true">✓</span><h3>Nenhuma demanda encontrada</h3><p><%= Object.values(filters).some(value => value && value !== 'ATIVAS' && value !== 20) ? 'Ajuste os filtros para ampliar a pesquisa.' : 'A fila está livre. Novas demandas aparecerão aqui para acompanhamento.' %></p><% if (canAccessModule(normalizeRole(user?.role), 'demandas_open')) { %><a class="demand-btn demand-btn-secondary ui-btn ui-btn--secondary" href="/demandas/new">Criar demanda</a><% } %></div>
    <% } else { %>
      <% groups.forEach(group => { if (group.items.length) { %>
        <section class="priority-group priority-<%= group.key %>">
          <div class="priority-heading"><div><h3><%= group.title %> <span><%= group.items.length %></span></h3><p><%= group.note %></p></div></div>
          <div class="demand-table" role="table" aria-label="<%= group.title %>">
            <div class="demand-row demand-columns demand-columns-v2" role="row"><span>Demanda</span><span>Status</span><span>Planejamento</span><span>Responsável</span><span>Tempo / atualização</span><span>Ação</span></div>
            <% group.items.forEach(d => { %>
              <% const staleDays = Number(d.dias_sem_movimento || 0); %>
              <% const ageDays = Number(d.dias_aberta || 0); %>
              <% const overdueDays = Number(d.dias_atraso || 0); %>
              <% const rowAlertClass = Number(d.prazo_atrasado || 0) ? 'is-overdue' : staleDays >= 7 ? 'is-stale' : staleDays >= 3 ? 'is-aging' : ''; %>
              <article class="demand-row demand-row-v2 demand-priority-<%= slug(d.prioridade) %> <%= rowAlertClass %>" role="row">
                <div class="demand-identity" data-label="Demanda">
                  <strong>#<%= d.id %> · <%= d.titulo %></strong>
                  <p><%= d.descricao || 'Descrição não informada.' %></p>
                  <small><%= categoryLabel(d.categoria) %><%= d.equipamento_nome ? ' · ' + d.equipamento_nome : '' %></small>
                </div>
                <div class="demand-badges" data-label="Status">
                  <span class="demand-badge status-<%= slug(d.status) %>"><%= statusLabel(d.status) %></span>
                  <span class="demand-badge priority-<%= slug(d.prioridade) %>"><%= priorityLabel(d.prioridade) %></span>
                </div>
                <div class="demand-plan-summary" data-label="Planejamento">
                  <span class="demand-plan-chip"><strong><%= Number(d.subdemandas_count || 0) %></strong> sub</span>
                  <span class="demand-plan-chip"><strong><%= Number(d.solicitacoes_count || 0) %></strong> solic.</span>
                  <span class="demand-plan-chip"><strong><%= Number(d.os_count || 0) %></strong> OS</span>
                </div>
                <div class="demand-people" data-label="Responsável"><strong><%= d.responsavel_nome || 'A definir' %></strong><small>Criada por <%= d.created_by_nome || 'Não informado' %></small></div>
                <div class="demand-update" data-label="Tempo / atualização">
                  <strong><%= fmtBR(d.ultima_movimentacao_em || d.updated_at || d.created_at) %></strong>
                  <small><%= d.ultima_atualizacao || 'Sem atualização textual registrada' %></small>
                  <div class="demand-time-flags">
                    <span class="demand-time-chip age">Aberta há <%= ageDays %> dia(s)</span>
                    <% if (Number(d.prazo_atrasado || 0)) { %>
                      <span class="demand-time-chip danger">Prazo vencido há <%= overdueDays %> dia(s)</span>
                    <% } else if (staleDays >= 7) { %>
                      <span class="demand-time-chip danger">Sem atualização há <%= staleDays %> dia(s)</span>
                    <% } else if (staleDays >= 3) { %>
                      <span class="demand-time-chip warning">Atenção: <%= staleDays %> dia(s) sem movimentação</span>
                    <% } else if (staleDays === 0) { %>
                      <span class="demand-time-chip ok">Atualizada hoje</span>
                    <% } else { %>
                      <span class="demand-time-chip ok">Atualizada há <%= staleDays %> dia(s)</span>
                    <% } %>
                  </div>
                </div>
                <div class="demand-row-action demand-row-actions" data-label="Ação">
                  <a class="demand-btn demand-btn-secondary demand-btn-small ui-btn ui-btn--secondary ui-btn--compact" href="/demandas/<%= d.id %>">Abrir</a>
                  <% if (canManageDemand && !['CONCLUIDA','CANCELADA'].includes(d.status)) { %>
                    <a class="demand-btn demand-btn-secondary demand-btn-small ui-btn ui-btn--secondary ui-btn--compact" href="/demandas/<%= d.id %>/edit">Editar</a>
                  <% } %>
                  <% if (canDeleteDemand) { %>
                    <form method="POST" action="/demandas/<%= d.id %>/delete" onsubmit="return confirm('Excluir a Demanda #<%= d.id %>? Esta ação só será concluída se não houver OS, solicitação de material ou subdemanda vinculada.')">
                      <button class="demand-btn demand-btn-small ui-btn ui-btn--danger ui-btn--compact" type="submit">Excluir</button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      <% } }) %>
    <% } %>
  </section>

  <div class="demand-bottom-grid">
    <section class="demand-card compact-card">
      <div class="section-heading"><div><h2>Distribuição por status</h2><p>Visão rápida da situação atual.</p></div></div>
      <% const maxStatus = Math.max(1, ...(painel.distribution || []).map(item => Number(item.total || 0))); %>
      <% if (!(painel.distribution || []).length) { %><p class="compact-empty">Sem dados para comparar.</p><% } %>
      <% (painel.distribution || []).forEach(item => { %><div class="status-bar"><span><%= statusLabel(item.status) %></span><div><i style="width:<%= (Number(item.total || 0) / maxStatus) * 100 %>%"></i></div><strong><%= item.total %></strong></div><% }) %>
    </section>
    <section class="demand-card compact-card workflow-card">
      <div class="section-heading"><div><h2>Fluxo da demanda</h2><p>Cadastro simples, planejamento sob demanda e execução rastreável.</p></div></div>
      <ol>
        <li><span>1</span><div><strong>Registrar</strong><small>Necessidade e prioridade</small></div></li>
        <li><span>2</span><div><strong>Planejar</strong><small>Materiais e subdemandas</small></div></li>
        <li><span>3</span><div><strong>Aprovar</strong><small>Priorizar a execução</small></div></li>
        <li><span>4</span><div><strong>Executar</strong><small>OS e histórico</small></div></li>
      </ol>
    </section>
  </div>
</div>
