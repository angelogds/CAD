<% layout('layout') %>
<link rel="stylesheet" href="/css/almoxarifado-reservas-qr.css?v=20260902-v1" />
<link rel="stylesheet" href="/css/meu-portal.css?v=20260910-v3" />

<%
  const pessoa = identidade || colaborador;
  const temIdentidade = Boolean(pessoa);
  const ativo = temIdentidade && String(pessoa.status || '').toUpperCase() === 'ATIVO';
  const cartaoAtivo = temIdentidade && Number(pessoa.qr_ativo || 0) === 1 && Boolean(pessoa.qr_token) && Boolean(cardQr);
  const cartaoRevogado = temIdentidade && Boolean(pessoa.qr_token) && Number(pessoa.qr_ativo || 0) !== 1;
%>

<div class="qr-card-page my-own-card-page my-personal-page">
  <header class="qr-card-toolbar no-print">
    <div>
      <span class="eyebrow">MEU PORTAL • ALMOXARIFADO</span>
      <h1>Identificação do Almoxarifado</h1>
      <p>Seu cartão virtual e o QR de identificação ficam concentrados nesta área.</p>
    </div>
    <div class="qr-card-actions">
      <a class="btn btn-ghost" href="/meu-portal">Voltar ao Meu Portal</a>
      <% if (cartaoAtivo) { %><button class="btn btn-green" type="button" onclick="window.print()">Imprimir / salvar PDF</button><% } %>
    </div>
  </header>

  <% if (!temIdentidade) { %>
    <section class="card my-card-guidance no-print">
      <strong>Identidade indisponível</strong>
      <p>Não foi possível carregar a identidade necessária para o cartão do Almoxarifado.</p>
    </section>
  <% } else if (cartaoRevogado) { %>
    <section class="card my-card-guidance no-print">
      <strong>Cartão revogado</strong>
      <p>Por segurança, um cartão revogado não pode ser reativado pelo próprio usuário. Procure o RH para uma nova emissão.</p>
    </section>
  <% } else if (!ativo) { %>
    <section class="card my-card-guidance no-print">
      <strong>Cartão indisponível</strong>
      <p>O cartão é liberado somente para identidades ativas no sistema.</p>
    </section>
  <% } else if (!cartaoAtivo) { %>
    <section class="card my-card-guidance no-print">
      <strong>Seu cartão ainda não foi emitido</strong>
      <p>O QR utiliza um token seguro e será aceito pelo fluxo existente de retirada de materiais no Almoxarifado.</p>
      <form method="POST" action="/meu-portal/cartao/emitir">
        <button class="btn btn-green" type="submit">Gerar meu cartão</button>
      </form>
    </section>
  <% } else { %>
    <section class="employee-id-card">
      <div class="employee-id-card__brand">
        <strong>Campo do Gado</strong>
        <span>Gestão Industrial • Manutenção Integrada</span>
      </div>
      <div class="employee-id-card__body">
        <img class="employee-id-card__photo" src="<%= pessoa.foto_url || user.photo_path || '/IMG/logo_menu.png.png' %>" alt="Foto de <%= pessoa.nome %>" />
        <div class="employee-id-card__identity">
          <small><%= pessoa.identity_type === 'USUARIO' ? 'USUÁRIO RESPONSÁVEL' : 'COLABORADOR' %></small>
          <h2><%= pessoa.nome %></h2>
          <p><%= pessoa.funcao || 'Função não informada' %></p>
          <p><%= pessoa.setor || 'Setor não informado' %></p>
          <span class="employee-id-card__status"><%= pessoa.status || 'ATIVO' %></span>
        </div>
        <div class="employee-id-card__qr">
          <img src="<%= cardQr %>" alt="QR de identificação" />
          <small>Apresente no Almoxarifado</small>
        </div>
      </div>
      <div class="employee-id-card__footer">Uso interno • QR sem dados pessoais • Retiradas registradas pelo sistema</div>
    </section>

    <section class="card my-card-guidance no-print">
      <strong>Cartão virtual e físico usam o mesmo QR</strong>
      <p>Para o cartão físico, use “Imprimir / salvar PDF” e selecione impressão em tamanho real. Em caso de perda ou exposição do QR, solicite ao RH a revogação e uma nova emissão.</p>
    </section>
  <% } %>
</div>
