<% layout('layout') %>
<link rel="stylesheet" href="/css/meu-portal.css?v=20260914-v4" />
<link rel="stylesheet" href="/css/ferramental.css?v=20261007-review1" />

<%
  const data = ferramental || { usuario: {}, resumo: {}, equipes: [], ferramentas: [], aceites: [] };
  const aceites = data.aceites || [];
  const inventarios = data.inventarios || [];
  const usosV2 = data.usosV2 || [];
  const usosAbertosV2 = usosV2.filter(function(u){ return u.status === 'EM_USO'; });
  const inspecoes = data.inspecoes || [];
  const inspecaoPorFerramenta = new Map(inspecoes.map(function(t){ return [Number(t.id), t.inspecao]; }));
  const inspecoesCriticas = inspecoes.filter(function(t){ return ['BLOQUEADA','VENCIDA','A_VENCER'].includes(t.inspecao?.situation); });
  const ocorrencias = data.ocorrencias || [];
  const ocorrenciasAbertas = ocorrencias.filter(function(o){ return ['ABERTA','EM_ANALISE','EM_ACOMPANHAMENTO'].includes(o.status); });
  const ocorrenciaPorFerramenta = new Map(ocorrenciasAbertas.map(function(o){ return [Number(o.ferramenta_id), o]; }));
  const inventariosPendentes = inventarios.filter(function(i){ return i.situacao === 'PENDENTE'; });
  const pendentes = aceites.filter(function(a){ return a.status === 'PENDENTE'; });
  const aceitos = aceites.filter(function(a){ return a.status === 'ACEITO'; });
  const recusados = aceites.filter(function(a){ return a.status === 'RECUSADO'; });
  const formatDateTime = (value) => value ? new Date(value).toLocaleString('pt-BR') : '-';
  const aceitePorCustodia = new Map(aceites.map(function(a){ return [Number(a.custodia_id), a]; }));
%>

<div class="my-portal-page tool-self-page">
  <header class="my-section-head">
    <div>
      <span class="eyebrow">MEU PORTAL • RESPONSABILIDADE</span>
      <h1>Meu Ferramental</h1>
      <p>Consulte, confirme ou informe divergência nas ferramentas registradas sob sua responsabilidade.</p>
    </div>
    <div class="tool-head-actions">
      <a class="btn btn-outline" href="/meu-portal">Voltar</a>
      <a class="btn btn-primary" href="/meu-portal/ferramental/pdf" target="_blank">Baixar ficha PDF</a>
    </div>
  </header>

  <section class="tool-kpis tool-kpis--self">
    <article><span>Ferramentas</span><strong><%= data.resumo.total || 0 %></strong><small>Sob sua responsabilidade</small></article>
    <article><span>Pendentes</span><strong><%= pendentes.length %></strong><small>Aguardando seu aceite</small></article>
    <article><span>Confirmadas</span><strong><%= aceitos.length %></strong><small>Selfie + assinatura</small></article>
    <article><span>Divergências</span><strong><%= recusados.length %></strong><small>Aguardando revisão do PCM</small></article>
    <article><span>Conferências</span><strong><%= inventariosPendentes.length %></strong><small>Pendentes no inventário</small></article>
    <article><span>Ocorrências</span><strong><%= ocorrenciasAbertas.length %></strong><small>Em tratamento pelo PCM</small></article>
    <article><span>Inspeções</span><strong><%= inspecoesCriticas.length %></strong><small>Alertas de segurança</small></article>
    <article><span>Em uso comigo</span><strong><%= usosAbertosV2.length %></strong><small>Retiradas registradas por QR</small></article>
  </section>

  <% if (pendentes.length) { %>
    <section class="tool-panel tool-accept-section">
      <div class="tool-panel-head">
        <div>
          <span>RESPONSABILIDADE</span>
          <h2>Confirme o recebimento do seu ferramental</h2>
          <p>Confira primeiro a ferramenta e as regras de guarda. Depois registre sua evidência de recebimento.</p>
        </div>
        <small><%= pendentes.length %> pendente(s)</small>
      </div>

      <div class="tool-responsibility-notice">
        <div>
          <strong>O que você está confirmando</strong>
          <ul>
            <li>Recebeu e conferiu a identificação e a condição da ferramenta.</li>
            <li>Vai utilizar corretamente, guardar no local definido e evitar acesso por pessoa não autorizada.</li>
            <li>Vai comunicar imediatamente dano, perda, extravio, furto/roubo ou qualquer divergência ao responsável/PCM.</li>
            <li>Em item compartilhado, os responsáveis devem colaborar na guarda, organização e comunicação das ocorrências.</li>
          </ul>
        </div>
        <div class="tool-responsibility-legal">
          <strong>Importante</strong>
          <span>Este aceite registra ciência e responsabilidade de guarda e uso. Ele não representa desconto salarial automático. Eventual ressarcimento depende da apuração do caso concreto e dos requisitos legais aplicáveis.</span>
        </div>
      </div>

      <div class="tool-accept-grid tool-accept-grid--guided">
        <% pendentes.forEach(function(item){ const compartilhada = Number(item.total_responsaveis || 0) > 1; %>
          <article class="tool-accept-card tool-accept-card--guided">
            <div class="tool-accept-card__head">
              <div>
                <span><%= item.codigo_interno %></span>
                <h3><%= item.descricao %></h3>
                <small><%= item.equipe_codigo %> • <%= item.armario_codigo %> / C<%= item.compartimento_numero %></small>
              </div>
              <span class="tool-badge tool-badge--pending">AGUARDA ACEITE</span>
            </div>

            <div class="tool-receipt-overview">
              <div><span>Condição</span><strong><%= String(item.condicao || '-').replaceAll('_',' ') %></strong></div>
              <div><span>Série / patrimônio</span><strong><%= item.numero_serie || item.patrimonio || '-' %></strong></div>
              <div><span>Responsabilidade</span><strong><%= compartilhada ? 'Compartilhada' : 'Individual' %></strong></div>
            </div>

            <% if (compartilhada) { %>
              <div class="tool-shared-responsibility">
                <strong>Ferramenta compartilhada</strong>
                <span>Responsáveis: <%= item.responsaveis_nomes || item.equipe_nome %>. Cada pessoa confirma seu próprio recebimento e deve colaborar na guarda e na comunicação de qualquer ocorrência.</span>
              </div>
            <% } %>

            <form
              method="POST"
              action="/meu-portal/ferramental/custodias/<%= item.custodia_id %>/aceitar"
              enctype="multipart/form-data"
              class="tool-accept-form tool-accept-form--guided"
              data-tool-accept-form
            >
              <div class="tool-accept-step">
                <span class="tool-accept-step__number">1</span>
                <div>
                  <strong>Confira a ferramenta</strong>
                  <small>Verifique código, condição, série/patrimônio e local de guarda. Se houver divergência, não confirme: informe o problema no final deste card.</small>
                </div>
              </div>

              <div class="tool-accept-step">
                <span class="tool-accept-step__number">2</span>
                <div class="tool-accept-step__content">
                  <strong>Registre sua selfie</strong>
                  <label class="tool-selfie-field">
                    <span>Foto de confirmação</span>
                    <input type="file" name="selfie" accept="image/jpeg,image/png,image/webp" capture="user" required data-selfie-input />
                    <small>Tire a foto no momento do aceite. A imagem fica vinculada à evidência deste recebimento; não há reconhecimento facial automatizado.</small>
                  </label>
                  <div class="tool-selfie-preview" data-selfie-preview-wrap hidden>
                    <img alt="Prévia da selfie de confirmação" data-selfie-preview />
                    <span>Prévia da selfie selecionada</span>
                  </div>
                </div>
              </div>

              <div class="tool-accept-step">
                <span class="tool-accept-step__number">3</span>
                <div class="tool-accept-step__content">
                  <strong>Assine o recebimento</strong>
                  <div class="tool-signature-box">
                    <canvas class="tool-signature-canvas" width="520" height="150" tabindex="0" data-signature-canvas></canvas>
                    <input type="hidden" name="assinatura_data" data-signature-data />
                  </div>
                  <div class="tool-signature-actions">
                    <small data-signature-status>Assine com o dedo ou mouse no quadro acima</small>
                    <button class="btn btn-outline btn-sm" type="button" data-signature-clear>Limpar assinatura</button>
                  </div>
                </div>
              </div>

              <div class="tool-accept-step">
                <span class="tool-accept-step__number">4</span>
                <div class="tool-accept-step__content">
                  <strong>Confirme sua ciência</strong>
                  <label class="tool-term-check tool-term-check--legal">
                    <input type="checkbox" name="termo_aceito" value="1" required />
                    <span>Declaro que conferi o item acima, estou ciente da minha responsabilidade de uso, guarda, conservação e comunicação imediata de qualquer dano, perda, extravio, furto/roubo ou irregularidade. Em caso de responsabilidade compartilhada, comprometo-me a cooperar com o(s) outro(s) responsável(is) na guarda e controle do equipamento.</span>
                  </label>
                  <small class="tool-legal-footnote">O aceite não significa concordância com desconto automático em salário. Qualquer apuração de prejuízo deve observar a legislação aplicável e as circunstâncias comprovadas do caso.</small>
                </div>
              </div>

              <label class="tool-accept-note">
                Observação no recebimento
                <textarea name="observacao" maxlength="800" rows="2" placeholder="Opcional: registre marca, detalhe de conservação, acessório, risco ou observação relevante"></textarea>
              </label>

              <button class="btn btn-primary tool-accept-submit" type="submit">Confirmar recebimento e responsabilidade</button>
            </form>

            <details class="tool-divergence tool-divergence--guided">
              <summary>Não posso confirmar — existe divergência</summary>
              <form method="POST" action="/meu-portal/ferramental/custodias/<%= item.custodia_id %>/divergencia">
                <label>
                  Informe o problema
                  <textarea name="motivo" maxlength="800" rows="3" required placeholder="Ex.: ferramenta não recebida, código diferente, dano já existente, acessório faltando..."></textarea>
                </label>
                <button class="btn btn-outline" type="submit">Registrar divergência para o PCM</button>
              </form>
            </details>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (inventarios.length) { %>
    <section class="tool-panel tool-inventory-self" id="conferencias">
      <div class="tool-panel-head">
        <div><span>V1.2</span><h2>Conferência do meu ferramental</h2><p>Confira cada item e informe imediatamente qualquer divergência.</p></div>
        <small><%= inventariosPendentes.length %> pendente(s)</small>
      </div>
      <div class="tool-inventory-self-list">
        <% inventarios.forEach(function(item){ %>
          <article class="tool-inventory-self-row <%= item.situacao !== 'PENDENTE' ? 'is-done' : '' %>">
            <div class="tool-inventory-self-info">
              <span><%= item.inventario_codigo %></span>
              <strong><%= item.codigo_interno %> — <%= item.descricao %></strong>
              <small><%= item.armario_codigo %> / C<%= item.compartimento_numero %> • Armário de <%= item.armario_responsavel %><%= item.data_limite ? ' • Prazo: ' + new Date(item.data_limite + 'T12:00:00').toLocaleDateString('pt-BR') : '' %></small>
              <% if (item.inventario_observacao) { %><em><%= item.inventario_observacao %></em><% } %>
            </div>
            <% if (item.situacao === 'PENDENTE') { %>
              <form method="POST" action="/meu-portal/ferramental/inventario-itens/<%= item.id %>" class="tool-inventory-self-form">
                <select name="situacao" required>
                  <option value="">Selecione a situação</option>
                  <option value="CONFIRMADO">Conferido — está comigo</option>
                  <option value="DANIFICADO">Danificado</option>
                  <option value="NAO_LOCALIZADO">Não localizado</option>
                  <option value="EM_MANUTENCAO">Em manutenção</option>
                </select>
                <input name="observacao" maxlength="800" placeholder="Observação, se necessário" />
                <button class="btn btn-primary" type="submit">Registrar conferência</button>
              </form>
            <% } else { %>
              <div class="tool-inventory-self-result">
                <span class="tool-badge <%= item.situacao === 'CONFIRMADO' ? 'tool-badge--accepted' : 'tool-badge--rejected' %>"><%= item.situacao.replaceAll('_',' ') %></span>
                <small><%= formatDateTime(item.conferido_em) %></small>
                <% if (item.observacao) { %><em><%= item.observacao %></em><% } %>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>


  <% if (ocorrencias.length) { %>
    <section class="tool-panel tool-self-occurrences" id="ocorrencias">
      <div class="tool-panel-head">
        <div><span>V1.3</span><h2>Minhas ocorrências</h2><p>Acompanhe devoluções, manutenção, dano ou extravio já comunicados ao PCM.</p></div>
        <small><%= ocorrenciasAbertas.length %> em andamento</small>
      </div>
      <div class="tool-self-occurrence-list">
        <% ocorrencias.slice(0,20).forEach(function(occ){ %>
          <article>
            <div>
              <span><%= occ.codigo %> • <%= occ.tipo.replaceAll('_',' ') %></span>
              <strong><%= occ.codigo_interno %> — <%= occ.ferramenta_descricao %></strong>
              <small>Aberta por <%= occ.aberta_por_nome %> • <%= formatDateTime(occ.created_at) %></small>
              <p><%= occ.descricao %></p>
              <% if (occ.resolucao) { %><em>PCM: <%= occ.resolucao %></em><% } %>
            </div>
            <span class="tool-badge <%= ['ABERTA','EM_ANALISE'].includes(occ.status) ? 'tool-badge--pending' : occ.status === 'EM_ACOMPANHAMENTO' ? 'tool-badge--pending' : occ.status === 'RESOLVIDA' ? 'tool-badge--accepted' : 'tool-badge--rejected' %>"><%= occ.status.replaceAll('_',' ') %></span>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>


  <% if (inspecoesCriticas.length) { %>
    <section class="tool-panel tool-self-inspection-alerts" id="inspecoes">
      <div class="tool-panel-head">
        <div><span>V1.4</span><h2>Alertas de inspeção</h2><p>Ferramentas bloqueadas ou com inspeção vencida não devem ser utilizadas.</p></div>
        <small><%= inspecoesCriticas.length %> alerta(s)</small>
      </div>
      <div class="tool-self-inspection-list">
        <% inspecoesCriticas.forEach(function(t){ %>
          <article class="is-<%= String(t.inspecao.situation || '').toLowerCase().replaceAll('_','-') %>">
            <div>
              <span><%= String(t.inspecao.situation || '-').replaceAll('_',' ') %></span>
              <strong><%= t.codigo_interno %> — <%= t.descricao %></strong>
              <small><%= t.inspecao.block ? t.inspecao.block.motivo : (t.inspecao.next ? 'Próxima inspeção: ' + new Date(t.inspecao.next.data_programada + 'T12:00:00').toLocaleDateString('pt-BR') : 'Sem agendamento') %></small>
            </div>
            <% if (t.inspecao.situation === 'BLOQUEADA') { %><b>NÃO USAR</b><% } %>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (usosV2.length) { %>
    <section class="tool-panel tool-self-v2-usage" id="uso-operacional">
      <div class="tool-panel-head">
        <div><span>V2</span><h2>Meu uso operacional</h2><p>Retiradas e devoluções registradas pelo QR sem alterar a custódia da equipe.</p></div>
        <small><%= usosAbertosV2.length %> em uso</small>
      </div>
      <div class="tool-self-v2-usage-list">
        <% usosV2.slice(0,20).forEach(function(uso){ const overdue = Boolean(uso.atrasado); %>
          <article class="<%= overdue ? 'is-overdue' : uso.status === 'EM_USO' ? 'is-active' : 'is-returned' %>">
            <div>
              <span><%= uso.codigo %> • <%= uso.status.replaceAll('_',' ') %></span>
              <strong><%= uso.codigo_interno %> — <%= uso.descricao %></strong>
              <small>Retirada: <%= formatDateTime(uso.retirada_em) %><%= uso.previsao_devolucao ? ' • Previsão: ' + formatDateTime(uso.previsao_devolucao) : '' %><%= uso.devolvido_em ? ' • Devolvida: ' + formatDateTime(uso.devolvido_em) : '' %></small>
              <% if (uso.local_uso) { %><small>Local: <%= uso.local_uso %></small><% } %>
            </div>
            <div>
              <span class="tool-badge <%= overdue ? 'tool-badge--rejected' : uso.status === 'EM_USO' ? 'tool-badge--pending' : 'tool-badge--accepted' %>"><%= overdue ? 'ATRASADA' : uso.status.replaceAll('_',' ') %></span>
              <% if (uso.qr_token) { %><a class="tool-qr-link" href="/ferramental/qr/<%= uso.qr_token %>"><%= uso.status === 'EM_USO' ? 'Abrir para devolver' : 'Abrir QR' %></a><% } %>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (!data.equipes.length) { %>
    <section class="my-material-empty card">
      <strong>Nenhuma ferramenta vinculada no momento.</strong>
      <p>Quando o PCM registrar uma ferramenta sob sua responsabilidade, ela aparecerá aqui automaticamente.</p>
    </section>
  <% } %>

  <% data.equipes.forEach(function(team){ %>
    <section class="tool-panel tool-self-group">
      <div class="tool-panel-head">
        <div>
          <span><%= team.codigo %></span>
          <h2><%= team.nome %></h2>
          <p>Responsáveis: <strong><%= team.membros.map(function(m){return m.name;}).join(' + ') %></strong></p>
        </div>
        <small><%= team.ferramentas.length %> ferramenta(s)</small>
      </div>
      <div class="tool-table-wrap">
        <table class="tool-table">
          <thead><tr><th>Ferramenta</th><th>ID</th><th>Condição</th><th>Inspeção</th><th>Local de guarda</th><th>Meu aceite</th><th>QR</th><th>Ocorrência</th></tr></thead>
          <tbody>
            <% team.ferramentas.forEach(function(item){ const aceite = aceitePorCustodia.get(Number(item.custodia_id)); const ocorrencia = ocorrenciaPorFerramenta.get(Number(item.id)); const inspecao = inspecaoPorFerramenta.get(Number(item.id)); %>
              <tr>
                <td><strong><%= item.descricao %></strong><small><%= [item.marca,item.modelo].filter(Boolean).join(' • ') || item.categoria || '-' %></small></td>
                <td><%= item.codigo_interno %><small><%= item.numero_serie ? 'Série: ' + item.numero_serie : (item.patrimonio ? 'Patrimônio: ' + item.patrimonio : '') %></small></td>
                <td><%= String(item.condicao || '').replaceAll('_',' ') %></td>
                <td>
                  <% if (!inspecao) { %><span class="tool-badge">SEM PLANO</span>
                  <% } else { %>
                    <span class="tool-badge <%= inspecao.situation === 'BLOQUEADA' || inspecao.situation === 'VENCIDA' ? 'tool-badge--rejected' : inspecao.situation === 'A_VENCER' ? 'tool-badge--pending' : inspecao.situation === 'EM_DIA' ? 'tool-badge--accepted' : '' %>"><%= String(inspecao.situation || '-').replaceAll('_',' ') %></span>
                    <% if (inspecao.next) { %><small><%= new Date(inspecao.next.data_programada + 'T12:00:00').toLocaleDateString('pt-BR') %></small><% } %>
                  <% } %>
                </td>
                <td><strong><%= item.armario_codigo %> / C<%= item.compartimento_numero %></strong><small>Armário de <%= item.armario_responsavel %></small></td>
                <td>
                  <% if (!aceite) { %>
                    <span class="tool-badge">Sem registro</span>
                  <% } else if (aceite.status === 'ACEITO') { %>
                    <span class="tool-badge tool-badge--accepted">CONFIRMADO</span>
                    <small><%= formatDateTime(aceite.confirmado_em) %></small>
                    <div class="tool-evidence-links">
                      <a href="/meu-portal/ferramental/aceites/<%= aceite.id %>/evidencia/selfie" target="_blank">Selfie</a>
                      <a href="/meu-portal/ferramental/aceites/<%= aceite.id %>/evidencia/assinatura" target="_blank">Assinatura</a>
                    </div>
                  <% } else if (aceite.status === 'RECUSADO') { %>
                    <span class="tool-badge tool-badge--rejected">DIVERGÊNCIA</span>
                    <small><%= aceite.observacao || 'Aguardando revisão do PCM.' %></small>
                  <% } else { %>
                    <span class="tool-badge tool-badge--pending">PENDENTE</span>
                  <% } %>
                </td>
                <td>
                  <% if (item.qr_token) { %><a class="tool-qr-link" href="/ferramental/qr/<%= item.qr_token %>">Identificar</a><% } else { %>-<% } %>
                </td>
                <td>
                  <% if (ocorrencia) { %>
                    <span class="tool-badge tool-badge--pending"><%= ocorrencia.codigo %></span>
                    <small><%= ocorrencia.tipo.replaceAll('_',' ') %> • <%= ocorrencia.status.replaceAll('_',' ') %></small>
                  <% } else { %>
                    <details class="tool-own-occurrence-form">
                      <summary>Informar problema</summary>
                      <form method="POST" action="/meu-portal/ferramental/ferramentas/<%= item.id %>/ocorrencias">
                        <select name="tipo" required>
                          <option value="">Tipo</option>
                          <option value="DEVOLUCAO">Solicitar devolução</option>
                          <option value="MANUTENCAO">Necessita manutenção</option>
                          <option value="DANO">Ferramenta danificada</option>
                          <option value="EXTRAVIO">Não localizada / extravio</option>
                          <option value="OUTRO">Outro</option>
                        </select>
                        <textarea name="descricao" maxlength="1000" rows="3" required placeholder="Explique o ocorrido"></textarea>
                        <button class="btn btn-outline btn-sm" type="submit">Enviar ao PCM</button>
                      </form>
                    </details>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% }) %>

  <section class="tool-self-note">
    <strong>V2 — uso operacional e inventário por QR</strong>
    <span>A custódia continua vinculada à equipe, enquanto cada retirada e devolução registra quem utilizou a ferramenta. O QR também alimenta os inventários físicos do PCM e a rastreabilidade de uso.</span>
  </section>
</div>

<script src="/js/ferramental-aceite.js?v=20261006-v11" defer></script>
