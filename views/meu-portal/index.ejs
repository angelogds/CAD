<% layout('layout') %>
<link rel="stylesheet" href="/css/meu-portal.css?v=20260914-v4" />
<link rel="stylesheet" href="/css/meu-portal-fase2b.css?v=20260910-v1" />

<%
  const conta = portal.user;
  const colaborador = portal.colaborador;
  const identidade = portal.identidade || colaborador;
  const identidadeDireta = Boolean(portal.directUserIdentity);
  const temVinculo = Boolean(colaborador);
  const temIdentidade = Boolean(identidade);
  const ativo = temIdentidade && String(identidade.status || '').toUpperCase() === 'ATIVO';
  const acessoManutencao = typeof maintenanceSelfService !== 'undefined' && Boolean(maintenanceSelfService);
  const acessoMateriais = typeof materialSelfService !== 'undefined' && Boolean(materialSelfService);
  const cartaoAtivo = temIdentidade && Number(identidade.qr_ativo || 0) === 1 && Boolean(identidade.qr_token);
  const cartaoRevogado = temIdentidade && Boolean(identidade.qr_token) && !cartaoAtivo;
  const foto = identidade?.foto_url || conta.photo_path || '/IMG/logo_menu.png.png';
  const cartaoStatus = !temIdentidade
    ? 'IDENTIDADE PENDENTE'
    : cartaoAtivo
      ? 'ATIVO'
      : cartaoRevogado
        ? 'REVOGADO'
        : ativo
          ? 'PRONTO PARA EMITIR'
          : 'INDISPONÍVEL';
%>

<div class="my-portal-page my-portal-hub">
  <header class="my-portal-hero my-portal-hero--compact">
    <div class="my-portal-hero__content">
      <div class="my-portal-hero__identity">
        <img src="<%= foto %>" alt="Foto de <%= identidade?.nome || conta.name %>" />
        <div>
          <span class="eyebrow">MEU PORTAL</span>
          <h1>Olá, <%= identidade?.apelido || identidade?.nome || conta.name %></h1>
          <% if (acessoManutencao) { %>
            <p>Seu perfil da Manutenção está integrado à ficha de colaborador, jornada, materiais e RH.</p>
          <% } else if (acessoMateriais) { %>
            <p>Seu perfil possui acesso à identificação do Almoxarifado e ao histórico das retiradas registradas em seu nome.</p>
          <% } else { %>
            <p>Gerencie sua identidade de acesso, foto e segurança da conta.</p>
          <% } %>
          <div class="my-portal-tags">
            <span><%= identidade?.funcao || conta.funcao || conta.role || 'Perfil do sistema' %></span>
            <% if (acessoManutencao || acessoMateriais) { %>
              <span><%= identidade?.setor || conta.setor || (acessoManutencao ? 'Manutenção' : 'Setor do perfil') %></span>
              <span class="<%= ativo ? 'is-ok' : 'is-warn' %>"><%= identidade?.status || 'IDENTIDADE PENDENTE' %></span>
            <% } else { %>
              <span class="is-ok">CONTA ATIVA</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </header>

  <% if (acessoMateriais && !temIdentidade) { %>
    <section class="my-portal-notice my-portal-panel--compact my-card-state--compact">
      <div>
        <strong>Identidade profissional indisponível</strong>
        <p>Não foi possível carregar a identidade necessária para o Almoxarifado.</p>
        <small>Perfis encarregados usam o próprio cadastro de usuário; somente o perfil operacional de mecânico utiliza ficha de colaborador.</small>
      </div>
    </section>
  <% } %>

  <section class="my-portal-services my-portal-services--primary" aria-labelledby="acessos-pessoais">
    <div class="my-portal-panel__head">
      <div><span class="eyebrow">MEU ACESSO</span><h2 id="acessos-pessoais">Identidade e conta</h2></div>
      <span class="my-status"><%= acessoMateriais ? '3 ÁREAS' : '2 ÁREAS' %></span>
    </div>
    <div class="my-access-grid">
      <a class="my-service-card my-service-card--primary is-available" href="/meu-portal/perfil">
        <div class="my-service-card__icon" aria-hidden="true">ID</div>
        <strong>Minha identidade</strong>
        <span>Foto, nome e informações básicas do seu acesso.</span>
        <small>ABRIR MEU PERFIL →</small>
      </a>

      <% if (acessoMateriais) { %>
        <a class="my-service-card my-service-card--primary is-available" href="/meu-portal/cartao">
          <div class="my-service-card__icon" aria-hidden="true">QR</div>
          <strong>Identificação do Almoxarifado</strong>
          <span>Cartão virtual, QR e identificação para retirada de materiais.</span>
          <small><%= cartaoStatus %> • ABRIR →</small>
        </a>
      <% } %>

      <a class="my-service-card my-service-card--primary is-available" href="/meu-portal/conta">
        <div class="my-service-card__icon" aria-hidden="true">•••</div>
        <strong>Minha conta</strong>
        <span>Segurança da conta e alteração de senha.</span>
        <small>SEGURANÇA • ABRIR →</small>
      </a>
    </div>
  </section>

  <% if (acessoManutencao) { %>
    <section class="my-portal-services" aria-labelledby="servicos-colaborador">
      <div class="my-portal-panel__head">
        <div><span class="eyebrow">MANUTENÇÃO</span><h2 id="servicos-colaborador">Serviços do colaborador</h2></div>
        <span class="my-status is-ok">6 SERVIÇOS</span>
      </div>
      <div class="my-roadmap-grid">
        <a class="my-service-card is-available" href="/meu-portal/dados-profissionais">
          <strong>Dados profissionais</strong>
          <span>Admissão, função, setor, liderança e situação.</span>
          <small>DISPONÍVEL • ABRIR →</small>
        </a>
        <a class="my-service-card is-available" href="/escala/meu-painel">
          <strong>Jornada</strong>
          <span>Escala, horas extras e banco de horas.</span>
          <small>DISPONÍVEL • ABRIR →</small>
        </a>
        <a class="my-service-card is-available" href="/meu-portal/materiais">
          <strong>Materiais</strong>
          <span>Histórico das minhas retiradas no Almoxarifado.</span>
          <small>DISPONÍVEL • ABRIR →</small>
        </a>
        <a class="my-service-card is-available" href="/meu-portal/treinamentos">
          <strong>Treinamentos</strong>
          <span>Cursos, NRs, certificados e vencimentos.</span>
          <small>DISPONÍVEL • ABRIR →</small>
        </a>
        <a class="my-service-card is-available" href="/meu-portal/servicos">
          <strong>Meus serviços</strong>
          <span>Histórico das minhas participações em Ordens de Serviço.</span>
          <small>DISPONÍVEL • ABRIR →</small>
        </a>
        <a class="my-service-card is-available" href="/meu-portal/rh">
          <strong>Meu RH</strong>
          <span>Exames, documentos, folgas e banco de horas.</span>
          <small>DISPONÍVEL • ABRIR →</small>
        </a>
      </div>
    </section>
  <% } %>

  <% if (acessoMateriais && !acessoManutencao) { %>
    <section class="my-portal-services" aria-labelledby="servicos-almoxarifado">
      <div class="my-portal-panel__head">
        <div><span class="eyebrow">ALMOXARIFADO</span><h2 id="servicos-almoxarifado">Retiradas e rastreabilidade</h2></div>
        <span class="my-status is-ok">1 SERVIÇO</span>
      </div>
      <div class="my-roadmap-grid">
        <a class="my-service-card is-available" href="/meu-portal/materiais">
          <strong>Retiradas de material</strong>
          <span>Consulte o histórico das baixas registradas pelo Almoxarifado em seu nome.</span>
          <small>HISTÓRICO • AUDITORIA • ABRIR →</small>
        </a>
      </div>
    </section>
  <% } %>
</div>
