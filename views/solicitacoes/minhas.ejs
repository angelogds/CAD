<% layout('layout') %><link rel="stylesheet" href="/css/solicitacoes-lista.css">
<%
const labels={ABERTA:'Aberta',EM_COTACAO:'Em cotação',COMPRADA:'Comprada',EM_RECEBIMENTO:'Em recebimento',RECEBIDA_PARCIAL:'Recebida parcial',RECEBIDA_TOTAL:'Recebida total',FECHADA:'Fechada',REABERTA:'Reaberta',CANCELADA:'Cancelada'};
const normalizePriority=(value='')=>String(value||'').trim().normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase();
const groups=[
  {key:'critical',title:'CRÍTICAS',items:lista.filter(s=>['URGENTE','CRITICA','EMERGENCIAL'].includes(normalizePriority(s.prioridade)))} ,
  {key:'high',title:'ALTA PRIORIDADE',items:lista.filter(s=>normalizePriority(s.prioridade)==='ALTA')} ,
  {key:'medium',title:'PRIORIDADE MÉDIA',items:lista.filter(s=>normalizePriority(s.prioridade)==='MEDIA')} ,
  {key:'low',title:'PRIORIDADE BAIXA',items:lista.filter(s=>normalizePriority(s.prioridade)==='BAIXA')} ,
  {key:'neutral',title:'SEM PRIORIDADE DEFINIDA',items:lista.filter(s=>!normalizePriority(s.prioridade))}
].filter(g=>g.items.length);
const qs=o=>{const x=new URLSearchParams();Object.entries({...filters,...o}).forEach(([k,v])=>{const n={query:'q',date:'date',prioridade:'prioridade',status:'status'}[k];if(n&&v)x.set(n,v)});return x.toString()};
%>
<div class="sol-list-page"><header class="sol-list-head"><div><h1>Solicitações de Material</h1><p>Controle rastreável do fluxo solicitação → compras → almoxarifado → OS.</p></div><div><% if(canAccessModule(user?.role,'compras_read')){ %><a class="btn btn-ghost" href="/solicitacoes/acompanhamento-compras">▦ Acompanhar compras</a><% } %><a class="btn btn-green" href="/solicitacoes/nova">+ Nova Solicitação</a></div></header>
<section class="sol-filter-box"><nav><a class="<%= !filters.status&&!filters.vinculadasOs&&!filters.urgentes?'active':'' %>" href="/solicitacoes/minhas">Todas ativas</a><% statuses.forEach(st=>{ %><a class="<%= filters.status===st?'active':'' %>" href="?status=<%= st %>"><%= labels[st]||st %></a><% }) %><a href="?vinculadas_os=1">Vinculadas à OS</a><a href="?urgentes=1">Críticas</a></nav><form method="get"><label>BUSCAR<input name="q" value="<%= filters.query %>" placeholder="Número, título, setor ou solicitante"></label><label>STATUS<select name="status"><option value="">Todos</option><% statuses.forEach(st=>{ %><option value="<%= st %>" <%= filters.status===st?'selected':'' %>><%= labels[st]||st %></option><% }) %></select></label><label>PRIORIDADE<select name="prioridade"><option value="">Todas</option><% [['CRITICA','Crítica'],['ALTA','Alta'],['MEDIA','Média'],['BAIXA','Baixa']].forEach(x=>{ %><option value="<%= x[0] %>" <%= filters.prioridade===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></label><label>DATA<input type="date" name="date" value="<%= filters.date %>"></label><button class="btn">Filtrar</button><a class="btn btn-ghost" href="/solicitacoes/minhas">Limpar</a></form></section><p class="auto-buy">ⓘ Ao fechar a solicitação, ela é disponibilizada automaticamente para o setor de Compras.</p>
<% if(!lista.length){ %><div class="card">Nenhuma solicitação encontrada.</div><% } %><% groups.forEach(g=>{ %><section class="priority-group <%= g.key %>"><h2><%= g.title %> <span><%= g.items.length %></span></h2><div class="sol-rows"><% g.items.forEach(s=>{const pc=String(s.prioridade||'Não definida').toUpperCase();const flow=!s.disponivel_compras?'Aguardando fechamento':s.status==='EM_COTACAO'?'Em cotação':s.status==='RECEBIDA_PARCIAL'?'Recebimento parcial':['RECEBIDA_TOTAL','FECHADA'].includes(s.status)?'Processo concluído':'Disponível em Compras'; %><article class="sol-row" data-href="/solicitacoes/<%= s.id %>" tabindex="0" role="link" aria-label="Abrir solicitação <%= s.numero||s.id %>"><div><b><%= s.numero||'#'+s.id %></b><span><%= s.titulo||'Solicitação de material' %></span><small><%= labels[s.status]||s.status %></small></div><div><small>OS / EQUIPAMENTO</small><b><%= s.os_id?'OS '+s.os_id+' — '+(s.equipamento_nome||'Equipamento não informado'):'Sem OS vinculada' %></b></div><div><span>Setor: <b><%= s.setor_origem||'-' %></b></span><span>Solicitante: <b><%= s.solicitante_nome||'-' %></b></span><span><%= s.itens_count||0 %> itens · <%= fmtBR(s.created_at) %></span></div><div><small class="priority-badge"><%= pc %></small><span><%= flow %></span></div><div class="row-actions" onclick="event.stopPropagation()"><a class="btn btn-sm btn-ghost" href="/solicitacoes/<%= s.id %>">Abrir</a><details><summary class="btn btn-sm">Mais ações</summary><div><% if(['ABERTA','DEVOLVIDA_REVISAO'].includes(s.status)){ %><a href="/solicitacoes/<%= s.id %>/editar">Editar</a><% } %><a href="/solicitacoes/<%= s.id %>/pdf" target="_blank">Gerar PDF</a><% if(canAccessModule(user?.role,'solicitacoes_delete')&&!['CANCELADA','FECHADA'].includes(s.status)){ %><form method="post" action="/solicitacoes/<%= s.id %>/cancelar"><button>Cancelar</button></form><% } %><% if(canAccessModule(user?.role,'solicitacoes_delete')&&s.podeExcluir){ %><form method="post" action="/solicitacoes/<%= s.id %>/excluir"><button>Excluir</button></form><% } %></div></details></div></article><% }) %></div></section><% }) %></div>
<script>document.querySelectorAll('.sol-row').forEach(c=>{const open=()=>location.href=c.dataset.href;c.addEventListener('click',e=>{if(!e.target.closest('a,button,details,form'))open()});c.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.target.closest('a,button,details'))open()})});</script>
