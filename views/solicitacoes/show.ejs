<% layout('layout') %>
<%
const statusLabels = {
  ABERTA: 'Aberta',
  EM_COTACAO: 'Em cotação',
  COMPRADA: 'Comprada',
  EM_RECEBIMENTO: 'Em recebimento',
  RECEBIDA_PARCIAL: 'Recebida parcial',
  RECEBIDA_TOTAL: 'Recebida total',
  SEPARADA_PARA_RETIRADA: 'Separada para retirada',
  ENTREGUE_SOLICITANTE: 'Entregue ao solicitante',
  FECHADA: 'Fechada',
  REABERTA: 'Reaberta',
  CANCELADA: 'Cancelada'
};
const statusKey = String(solicitacao.status || 'ABERTA').trim().toUpperCase();
const statusClass = statusKey.toLowerCase().replace(/_/g, '-');
const normalizePriority = (value) => String(value || '').trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase();
const priorityKey = normalizePriority(solicitacao.prioridade);
const priorityClass = ['CRITICA','URGENTE','EMERGENCIAL'].includes(priorityKey) ? 'is-critical'
  : priorityKey === 'ALTA' ? 'is-high'
  : priorityKey === 'MEDIA' ? 'is-medium'
  : priorityKey === 'BAIXA' ? 'is-low' : '';
const stageIndexByStatus = {
  ABERTA: 0, REABERTA: 0, EM_COTACAO: 1, COMPRADA: 2, EM_RECEBIMENTO: 3,
  RECEBIDA_PARCIAL: 3, RECEBIDA_TOTAL: 3, SEPARADA_PARA_RETIRADA: 3,
  ENTREGUE_SOLICITANTE: 4, FECHADA: 4, CANCELADA: 0
};
const currentStage = stageIndexByStatus[statusKey] ?? 0;
const stages = [
  { label: 'ABERTA', date: solicitacao.created_at },
  { label: 'EM COTAÇÃO', date: solicitacao.cotacao_inicio_em },
  { label: 'COMPRADA', date: solicitacao.comprada_em },
  { label: 'RECEBIMENTO', date: solicitacao.recebida_em },
  { label: 'FECHADA', date: solicitacao.fechada_em }
];
const anexosSeguros = Array.isArray(anexos) ? anexos : [];
const allItems = Array.isArray(itens) ? itens : [];
const activeItems = allItems.filter((item) => String(item.status_compra || '').toUpperCase() !== 'CANCELADO');
const cancelledItems = allItems.filter((item) => String(item.status_compra || '').toUpperCase() === 'CANCELADO');
const pendingExclusions = activeItems.filter((item) => String(item.exclusao_status || '').toUpperCase() === 'PENDENTE');
const requesterCanAnswer = typeof isRequester !== 'undefined' && isRequester;
const exclusionHistory = Array.isArray(historicoExclusoes) ? historicoExclusoes : [];
const itemChanges = Array.isArray(alteracoes) ? alteracoes : [];
const pendingChanges = itemChanges.filter((row) => String(row.status || '').toUpperCase() === 'PENDENTE');
const pendingChangeByItem = new Map(pendingChanges.map((row) => [Number(row.solicitacao_item_id), row]));
const terminalForItems = ['RECEBIDA_TOTAL','SEPARADA_PARA_RETIRADA','ENTREGUE_SOLICITANTE','FECHADA','CANCELADA'].includes(statusKey);
%>
<link rel="stylesheet" href="/css/solicitacao-detail-modern.css?v=20260819">
<link rel="stylesheet" href="/css/solicitacao-itens-consenso.css?v=20260911-v2">
<style>
.sol-material-tools{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap}.sol-inline-details{border:1px solid #dfe8e2;border-radius:10px;padding:.6rem .75rem;background:#fff}.sol-inline-details>summary{cursor:pointer;font-weight:700;color:#146c43}.sol-item-form-grid{display:grid;grid-template-columns:2fr .7fr .7fr;gap:.65rem;margin-top:.75rem}.sol-item-form-grid .wide{grid-column:1/-1}.sol-item-form-grid input,.sol-item-form-grid textarea,.sol-item-form-grid select,.sol-consensus-form input{width:100%;border:1px solid #d6dfda;border-radius:8px;padding:.62rem .7rem;background:#fff}.sol-item-actions{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.45rem}.sol-item-actions button,.sol-item-actions summary,.sol-add-material button{border:0;border-radius:8px;padding:.5rem .75rem;font-weight:700;cursor:pointer}.sol-item-actions .edit{background:#e8f5ee;color:#146c43}.sol-item-actions .danger{background:#fff0f0;color:#a42828}.sol-add-material{margin-top:.8rem;padding:1rem;border:1px dashed #9fcbb2;border-radius:12px;background:#f7fcf9}.sol-add-material h3{margin:0 0 .35rem}.sol-change-oldnew{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.sol-change-oldnew>div{padding:.65rem;border-radius:9px;background:#f7f9f8}.sol-change-history{margin-top:.8rem}.sol-origin-badge.requester{background:#eef7ff;color:#1d5f91}.sol-consensus-card+.sol-consensus-card{margin-top:.75rem}@media(max-width:760px){.sol-item-form-grid,.sol-change-oldnew{grid-template-columns:1fr}.sol-item-form-grid .wide{grid-column:auto}.sol-material-table th:last-child,.sol-material-table td:last-child{min-width:220px}}
</style>

<div class="sol-detail-page">
  <header class="sol-detail-hero">
    <div class="sol-detail-heading">
      <span class="sol-detail-eyebrow">Solicitação de material</span>
      <h1><%= solicitacao.numero || ('#' + solicitacao.id) %></h1>
      <p>Resumo rastreável da solicitação, materiais, responsável, vínculo com OS e andamento do processo.</p>
      <div class="sol-detail-badges">
        <span class="sol-status status-<%= statusClass %>"><%= statusLabels[statusKey] || solicitacao.status || 'Não informado' %></span>
        <span class="sol-priority <%= priorityClass %>">Prioridade: <%= solicitacao.prioridade || 'Não informada' %></span>
        <% if (activeItems.some((item) => ['SOLICITANTE_EXTRA','COMPRAS_EXTRA'].includes(String(item.origem_item || '').toUpperCase()) && String(item.status_cotacao || '').toUpperCase() === 'PENDENTE')) { %>
          <span class="sol-item-state pending">Complemento em cotação</span>
        <% } %>
      </div>
    </div>
    <div class="sol-detail-actions" aria-label="Ações da solicitação">
      <% if (canEdit) { %><a class="btn btn-primary" href="/solicitacoes/<%= solicitacao.id %>/editar">Editar</a><% } %>
      <a class="btn btn-ghost" href="/solicitacoes/<%= solicitacao.id %>/pdf" target="_blank" rel="noopener">Gerar PDF</a>
      <a class="btn btn-ghost" href="<%= backUrl %>">Voltar</a>
    </div>
  </header>

  <% if (solicitacao.os_id) { %>
    <section class="sol-linked-os" aria-label="Ordem de serviço vinculada">
      <div class="meta"><small>ORDEM DE SERVIÇO VINCULADA</small><strong>OS <%= solicitacao.os_id %> — <%= solicitacao.equipamento_nome || solicitacao.aplicacao || 'Equipamento não informado' %></strong></div>
      <div class="sol-detail-actions"><a class="btn btn-ghost" href="/os/<%= solicitacao.os_id %>">Abrir OS</a><a class="btn btn-ghost" href="/chat-os/<%= solicitacao.os_id %>">Conversa da OS</a></div>
    </section>
  <% } %>

  <% if (pendingChanges.length) { %>
    <section id="consenso-itens" class="sol-card sol-consensus-card" aria-label="Alterações de itens aguardando confirmação">
      <div class="sol-card-head"><div><h2>Alterações aguardando consenso</h2><small>O valor atual continua valendo até a outra parte aprovar.</small></div><span class="sol-item-state pending"><%= pendingChanges.length %> pendente(s)</span></div>
      <div class="sol-consensus-list">
        <% pendingChanges.forEach((row) => { const canAnswer = Number(row.solicitada_por_user_id) !== Number(currentUserId) && canManageItems; %>
          <div class="sol-consensus-item">
            <div><strong><%= row.item_nome || 'Item' %></strong><small>Proposto por <%= row.solicitada_por_nome || 'usuário' %></small></div>
            <div class="sol-change-oldnew">
              <div><small>Atual</small><strong><%= row.snapshot?.qtd_solicitada ?? '-' %> <%= row.snapshot?.unidade || '' %></strong></div>
              <div><small>Proposto</small><strong><%= row.proposta?.qtd_solicitada ?? '-' %> <%= row.proposta?.unidade || '' %></strong></div>
            </div>
            <div><small>Motivo</small><span class="reason"><%= row.motivo || 'Não informado' %></span></div>
            <% if (canAnswer) { %>
              <form class="sol-consensus-form" method="POST" action="/solicitacoes/<%=solicitacao.id%>/itens/<%=row.solicitacao_item_id%>/alteracao/aprovar">
                <input name="observacao" maxlength="1200" placeholder="Observação da decisão (opcional)">
                <div class="sol-consensus-actions">
                  <button class="reject" type="submit" formaction="/solicitacoes/<%=solicitacao.id%>/itens/<%=row.solicitacao_item_id%>/alteracao/recusar">Recusar</button>
                  <button class="approve" type="submit" onclick="return confirm('Aprovar e aplicar esta alteração?')">Aprovar alteração</button>
                </div>
              </form>
            <% } else { %><div class="sol-consensus-wait">Aguardando confirmação da outra parte.</div><% } %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (pendingExclusions.length) { %>
    <section class="sol-card sol-consensus-card" aria-label="Pedidos de exclusão aguardando confirmação">
      <div class="sol-card-head"><div><h2>Exclusões aguardando consenso</h2><small>Nenhum item é removido sem confirmação da outra parte.</small></div><span class="sol-item-state pending"><%= pendingExclusions.length %> pendente(s)</span></div>
      <div class="sol-consensus-list">
        <% pendingExclusions.forEach((item) => { const canAnswer = Number(item.exclusao_solicitada_por_user_id) !== Number(currentUserId) && canManageItems; %>
          <div class="sol-consensus-item">
            <div><strong><%= item.item_nome || 'Item sem nome' %></strong><small><%= item.qtd_solicitada ?? item.quantidade ?? 0 %> <%= item.unidade || 'UN' %></small></div>
            <div><small>Motivo informado</small><span class="reason"><%= item.exclusao_motivo || 'Motivo não informado' %></span></div>
            <% if (canAnswer) { %>
              <form class="sol-consensus-form" method="POST" action="/solicitacoes/<%=solicitacao.id%>/itens/<%=item.id%>/exclusao/aprovar">
                <input name="observacao" maxlength="1000" placeholder="Observação da decisão (opcional)">
                <div class="sol-consensus-actions"><button class="reject" type="submit" formaction="/solicitacoes/<%=solicitacao.id%>/itens/<%=item.id%>/exclusao/recusar">Manter item</button><button class="approve" type="submit" onclick="return confirm('Confirmar a exclusão deste item? O histórico será preservado.')">Confirmar exclusão</button></div>
              </form>
            <% } else { %><div class="sol-consensus-wait">Aguardando confirmação da outra parte.</div><% } %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="sol-card">
    <div class="sol-card-head"><h2>Dados principais</h2><small>Informações essenciais para acompanhamento</small></div>
    <div class="sol-info-grid">
      <div class="sol-info-item"><small>Data da solicitação</small><strong><%= solicitacao.created_at ? fmtBR(solicitacao.created_at) : 'Não informado' %></strong></div>
      <div class="sol-info-item"><small>Solicitante</small><strong><%= solicitacao.solicitante_nome || '-' %></strong></div>
      <div class="sol-info-item"><small>Setor</small><strong><%= solicitacao.setor_origem || 'Não informado' %></strong></div>
      <div class="sol-info-item"><small>Responsável atual</small><strong><%= solicitacao.responsavel_nome || 'Pendente de definição' %></strong></div>
      <div class="sol-info-item"><small>Equipamento / aplicação</small><strong><%= solicitacao.equipamento_nome || solicitacao.aplicacao || 'Não informado' %></strong></div>
      <div class="sol-info-item"><small>Destino</small><strong><%= solicitacao.setor_destino || 'Setor de Compras' %></strong></div>
      <div class="sol-info-item"><small>Fornecedor / compras</small><strong><%= solicitacao.fornecedor || 'Não informado' %></strong></div>
      <div class="sol-info-item"><small>Previsão de entrega</small><strong><%= solicitacao.previsao_entrega ? fmtBR(solicitacao.previsao_entrega) : 'Não informada' %></strong></div>
    </div>
  </section>

  <section id="materiais-solicitacao" class="sol-card">
    <div class="sol-card-head">
      <div><h2>Materiais da solicitação</h2><small><%= activeItems.length %> ativo(s)<%= cancelledItems.length ? ` · ${cancelledItems.length} removido(s) com histórico` : '' %></small></div>
      <% if (canManageItems && !terminalForItems) { %><span class="sol-origin-badge">Inclusão liberada para solicitante e Compras</span><% } %>
    </div>

    <% if (canManageItems && !terminalForItems) { %>
      <details class="sol-add-material sol-inline-details">
        <summary>+ Adicionar material nesta solicitação</summary>
        <form method="POST" action="/solicitacoes/<%=solicitacao.id%>/itens/adicionar">
          <div class="sol-item-form-grid">
            <input name="item_nome" maxlength="180" required placeholder="Material / serviço">
            <input name="qtd_solicitada" inputmode="decimal" required placeholder="Quantidade">
            <input name="unidade" maxlength="20" value="UN" placeholder="Unidade">
            <textarea class="wide" name="item_descricao" maxlength="1200" rows="2" placeholder="Descrição / especificação"></textarea>
            <textarea class="wide" name="adicao_justificativa" maxlength="1200" rows="2" required placeholder="Motivo da inclusão (ex.: complemento necessário para a mesma OS/equipamento)"></textarea>
          </div>
          <div class="sol-item-actions"><button class="edit" type="submit">Adicionar sem criar nova solicitação</button></div>
        </form>
      </details>
    <% } %>

    <div class="sol-material-table-wrap">
      <table class="sol-material-table">
        <thead><tr><th>Descrição do material</th><th>Quantidade</th><th>Unidade</th><th>Motivo / observação</th><th>Origem / situação / ações</th></tr></thead>
        <tbody>
          <% if (!allItems.length) { %><tr><td colspan="5" class="sol-muted">Sem itens cadastrados.</td></tr><% } %>
          <% allItems.forEach((item) => {
            const cancelled=String(item.status_compra||'').toUpperCase()==='CANCELADO';
            const pending=String(item.exclusao_status||'').toUpperCase()==='PENDENTE';
            const origin=String(item.origem_item||'').toUpperCase();
            const extraCompras=origin==='COMPRAS_EXTRA';
            const extraRequester=origin==='SOLICITANTE_EXTRA';
            const pendingChange=pendingChangeByItem.get(Number(item.id));
          %>
            <tr class="<%=cancelled?'is-cancelled':pending?'is-pending-delete':''%>">
              <td data-label="Material"><%= item.item_nome || 'Não informado' %><div class="sol-item-meta"><% if(extraCompras){%><span class="sol-origin-badge">Adicionado por Compras</span><%}else if(extraRequester){%><span class="sol-origin-badge requester">Complemento do solicitante</span><%}%><% if(extraCompras||extraRequester){%><small><%=item.adicao_justificativa||'Complemento registrado nesta solicitação.'%></small><%}%></div></td>
              <td data-label="Quantidade"><%= item.qtd_solicitada ?? item.quantidade ?? 0 %></td>
              <td data-label="Unidade"><%= item.unidade || 'UN' %></td>
              <td data-label="Observação"><%= item.item_descricao || item.observacao_item || solicitacao.motivo || 'Não informado' %></td>
              <td data-label="Situação">
                <% if(cancelled){%><span class="sol-item-state cancelled">Removido por consenso</span><small><%=item.exclusao_motivo||''%></small>
                <%}else if(pending){%><span class="sol-item-state pending">Exclusão aguardando consenso</span>
                <%}else if(pendingChange){%><span class="sol-item-state pending">Alteração aguardando consenso</span>
                <%}else if(extraCompras||extraRequester){%><span class="sol-origin-badge">Complemento</span>
                <%}else{%><small>Solicitação original</small><%}%>

                <% if (canManageItems && !terminalForItems && !cancelled && !pending && !pendingChange) { %>
                  <div class="sol-item-actions">
                    <details class="sol-inline-details"><summary class="edit">Editar / propor alteração</summary>
                      <form method="POST" action="/solicitacoes/<%=solicitacao.id%>/itens/<%=item.id%>/alteracao">
                        <div class="sol-item-form-grid">
                          <input name="item_nome" maxlength="180" required value="<%= item.item_nome || '' %>">
                          <input name="qtd_solicitada" inputmode="decimal" required value="<%= item.qtd_solicitada ?? item.quantidade ?? 0 %>">
                          <input name="unidade" maxlength="20" required value="<%= item.unidade || 'UN' %>">
                          <textarea class="wide" name="item_descricao" maxlength="1200" rows="2"><%= item.item_descricao || item.observacao_item || '' %></textarea>
                          <textarea class="wide" name="motivo" maxlength="1200" required rows="2" placeholder="Motivo da alteração. A outra parte precisará aprovar."></textarea>
                        </div>
                        <div class="sol-item-actions"><button class="edit" type="submit">Enviar para confirmação</button></div>
                      </form>
                    </details>
                    <details class="sol-inline-details"><summary class="danger">Solicitar exclusão</summary>
                      <form method="POST" action="/solicitacoes/<%=solicitacao.id%>/itens/<%=item.id%>/exclusao/solicitar">
                        <textarea name="motivo" maxlength="1200" required rows="2" placeholder="Motivo da exclusão. A outra parte precisará aprovar."></textarea>
                        <div class="sol-item-actions"><button class="danger" type="submit" onclick="return confirm('Enviar pedido de exclusão para a outra parte?')">Enviar pedido</button></div>
                      </form>
                    </details>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <% if (itemChanges.length || exclusionHistory.length) { %>
    <details class="sol-card sol-consensus-history sol-change-history">
      <summary>Histórico de acordos sobre materiais</summary>
      <div class="sol-consensus-history-list">
        <% itemChanges.forEach((row) => { %><div><span><strong><%=row.item_nome||'Item'%> — alteração</strong><small><%=row.motivo%></small></span><span><strong><%=row.status%></strong><small>Solicitado por <%=row.solicitada_por_nome||'-'%><%=row.respondida_por_nome?' · respondido por '+row.respondida_por_nome:''%></small></span></div><% }) %>
        <% exclusionHistory.forEach((row) => { %><div><span><strong><%=row.item_nome||'Item'%> — exclusão</strong><small><%=row.motivo%></small></span><span><strong><%=row.status%></strong><small>Solicitado por <%=row.solicitada_por_nome||'-'%><%=row.respondida_por_nome?' · respondido por '+row.respondida_por_nome:''%></small></span></div><% }) %>
      </div>
    </details>
  <% } %>

  <div class="sol-two-column">
    <section class="sol-card">
      <div class="sol-card-head"><h2>Motivo e observações</h2><small>Contexto técnico da solicitação</small></div>
      <div class="sol-note-box"><small>Motivo da solicitação</small><%= solicitacao.motivo || 'Informação pendente de confirmação' %></div>
      <% if (solicitacao.observacoes) { %><div class="sol-note-box"><small>Observações</small><%= solicitacao.observacoes %></div><% } %>
    </section>
    <section class="sol-card">
      <div class="sol-card-head"><h2>Situação atual</h2><small>Leitura rápida do processo</small></div>
      <div class="sol-process-summary">
        <div class="sol-info-item"><small>Status atual</small><strong><%= statusLabels[statusKey] || solicitacao.status || 'Não informado' %></strong></div>
        <div class="sol-info-item"><small>Prioridade</small><strong><%= solicitacao.prioridade || 'Não informada' %></strong></div>
        <div class="sol-info-item"><small>Itens ativos</small><strong><%= activeItems.length %></strong></div>
        <div class="sol-info-item"><small>OS vinculada</small><strong><%= solicitacao.os_id ? ('OS ' + solicitacao.os_id) : 'Sem OS vinculada' %></strong></div>
      </div>
    </section>
  </div>

  <section class="sol-card sol-progress-card">
    <div class="sol-card-head"><h2>Andamento da solicitação</h2><small>Fluxo Solicitação → Compras → Recebimento → Fechamento</small></div>
    <div class="sol-progress" aria-label="Progresso da solicitação">
      <% stages.forEach((stage, index) => { const complete = index < currentStage || (statusKey === 'FECHADA' && index <= currentStage); const current = index === currentStage && statusKey !== 'FECHADA'; %>
        <div class="sol-progress-step <%= complete ? 'is-complete' : '' %> <%= current ? 'is-current' : '' %>"><span class="sol-progress-dot"><%= complete ? '✓' : (index + 1) %></span><div class="sol-progress-copy"><strong><%= stage.label %></strong><small><%= stage.date ? fmtBR(stage.date) : (index < currentStage ? 'Etapa concluída' : index === currentStage ? 'Etapa atual' : 'Aguardando') %></small></div></div>
      <% }) %>
    </div>
    <% if (statusKey === 'CANCELADA') { %><p class="sol-progress-legend">Esta solicitação foi cancelada. O histórico permanece disponível para rastreabilidade.</p><% } %>
  </section>

  <section class="sol-card">
    <div class="sol-card-head"><h2>Anexos</h2><small><%= anexosSeguros.length %> arquivo(s)</small></div>
    <% if (!anexosSeguros.length) { %><p class="sol-attachments-empty">Sem fotos ou anexos cadastrados.</p><% } else { %>
      <div class="sol-attachments-list"><% anexosSeguros.forEach((anexo) => { %><div class="sol-attachment-row"><span><strong><%= anexo.original_name || anexo.filename || 'Anexo sem nome informado' %></strong></span><span><small>Tipo</small><br><%= anexo.tipo || '-' %></span><span><small>Data</small><br><%= anexo.created_at ? fmtBR(anexo.created_at) : '-' %></span></div><% }) %></div>
    <% } %>
  </section>
</div>
