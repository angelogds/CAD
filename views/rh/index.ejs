<%- layout('layout') -%>
<link rel="stylesheet" href="/css/rh-portal.css?v=20260910-rh-modular" />
<%
  const d = dashboard || {};
  const i = d.indicadores || {};
  const pendencias = Array.isArray(d.pendencias) ? d.pendencias : [];
%>
<div class="rh-page">
  <%- include('_header', { title, dashboard: d, activeRhSection }) %>

  <section class="rh-kpis" aria-label="Indicadores do RH">
    <article class="card rh-kpi"><span>Colaboradores ativos</span><strong><%= Number(i.colaboradoresAtivos || 0) %></strong><small>Ficha profissional ativa</small></article>
    <article class="card rh-kpi"><span>Folgas pendentes</span><strong><%= Number(i.folgasPendentes || 0) %></strong><small>Aguardando fluxo operacional</small></article>
    <article class="card rh-kpi"><span>HE no mês</span><strong><%= formatMinutes(i.horasExtrasMesMinutos || 0) %></strong><small>Fonte: Escala</small></article>
    <article class="card rh-kpi"><span>Banco de horas</span><strong><%= formatMinutes(i.bancoHorasMinutos || 0) %></strong><small>Saldo consolidado</small></article>
    <article class="card rh-kpi"><span>Exames vencidos</span><strong><%= Number(i.examesVencidos || 0) %></strong><small>Requer acompanhamento</small></article>
    <article class="card rh-kpi"><span>Exames vencendo</span><strong><%= Number(i.examesVencendo || 0) %></strong><small>Próximos 30 dias</small></article>
    <article class="card rh-kpi"><span>Treinamentos</span><strong><%= Number(i.treinamentosPendentes || 0) %></strong><small>Vencidos, vencendo ou pendentes</small></article>
  </section>

  <section class="rh-module-grid" aria-label="Módulos do RH">
    <a class="card rh-module-card" href="/rh/colaboradores">
      <span class="rh-module-icon">👥</span><div><strong>Colaboradores</strong><small>Cadastro mestre, função, setor e ficha consolidada.</small></div><span aria-hidden="true">→</span>
    </a>
    <a class="card rh-module-card" href="/rh/jornada">
      <span class="rh-module-icon">⏱</span><div><strong>Jornada e Banco de Horas</strong><small>Turnos, HE e saldos vindos da Escala.</small></div><span aria-hidden="true">→</span>
    </a>
    <% if (d.canManage) { %>
      <a class="card rh-module-card" href="/rh/folgas">
        <span class="rh-module-icon">📅</span><div><strong>Folgas e solicitações</strong><small>Acompanhamento do fluxo sem duplicar a aprovação operacional.</small></div><span aria-hidden="true">→</span>
      </a>
      <a class="card rh-module-card" href="/rh/exames">
        <span class="rh-module-icon">🩺</span><div><strong>Exames ocupacionais</strong><small>ASO, validade e anexos protegidos.</small></div><span aria-hidden="true">→</span>
      </a>
      <a class="card rh-module-card" href="/rh/documentos">
        <span class="rh-module-icon">📄</span><div><strong>Documentos</strong><small>Documentação individual com armazenamento privado.</small></div><span aria-hidden="true">→</span>
      </a>
      <a class="card rh-module-card" href="/rh/treinamentos">
        <span class="rh-module-icon">🎓</span><div><strong>Treinamentos e certificados</strong><small>NRs, cursos, certificados e vencimentos.</small></div><span aria-hidden="true">→</span>
      </a>
    <% } %>
  </section>

  <section class="card rh-section">
    <div class="rh-section-head">
      <div><span class="rh-eyebrow">ACOMPANHAMENTO</span><h2>Pendências do RH</h2></div>
      <% if (d.canManage) { %><span class="rh-badge"><%= pendencias.length %> item<%= pendencias.length === 1 ? '' : 's' %></span><% } %>
    </div>
    <% if (!d.canManage) { %>
      <div class="rh-empty">A Diretoria visualiza indicadores consolidados e dados operacionais não sensíveis. Pendências nominais, exames e documentos permanecem restritos ao RH/ADMIN.</div>
    <% } else if (!pendencias.length) { %>
      <div class="rh-empty">Nenhuma pendência crítica encontrada nas fontes integradas.</div>
    <% } else { %>
      <div class="rh-pending-list">
        <% pendencias.slice(0, 30).forEach((p) => { %>
          <article class="rh-pending <%= p.nivel === 'critico' ? 'is-critical' : '' %>">
            <span class="rh-pending-type"><%= p.tipo %></span>
            <div><strong><%= p.colaborador || '-' %> • <%= p.titulo || '-' %></strong><small><%= p.detalhe || '' %></small></div>
            <small><%= p.data ? dateBr.formatDateBR(String(p.data).slice(0, 10)) : '' %></small>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <div class="rh-privacy">Dados de saúde e anexos pessoais permanecem protegidos. Não registrar CID, diagnóstico ou resultado clínico detalhado no módulo.</div>
</div>
