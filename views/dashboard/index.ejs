<% layout('layout') %>
<link rel="stylesheet" href="/css/operational-dashboard.css">
<%
const op = operational || { os:{items:[],counts:{},distribution:[]}, preventivas:{items:[],deadlines:{}}, alerts:[], indicators:{}, critical:[], period:{} };
const osCounts = op.os.counts || {};
const demandas = demandasResumo || {};
const prev = op.preventivas || {items:[],deadlines:{}};
const criticalCount = (op.critical || []).filter(i => ['CRITICO','CRÍTICO','ALTO'].includes(String(i.nivel || i.situacao_atual || '').toUpperCase()) || Number(i.reincidencias || 0) > 0).length;
const activeDemands = Number(demandas.novas || 0) + Number(demandas.em_andamento || 0) + Number(demandas.paradas || 0);
const role = typeof normalizeRole === 'function' ? normalizeRole(user?.role || '') : String(user?.role || '').toUpperCase();
const roleNorm = role;
if (typeof canAccessModule !== 'function') { var canAccessModule = function(){ return true; }; }
const showPreventivasCard = canAccessModule(roleNorm, 'preventivas_view');
const canPreventivas = showPreventivasCard;
const canOperatePreventivas = roleNorm !== 'INSPECAO_QUALIDADE';
const fmtHours = value => value == null ? 'Sem dados' : value < 24 ? `${Math.floor(value)} h` : `${Math.floor(value/24)} d`;
const qs = new URLSearchParams({periodo: op.period.key || '30d', ...(op.sector ? {setor:op.sector}:{}), ...(tvMode ? {tv:'1'}:{})}).toString();
%>
<div class="operational-dashboard <%= tvMode ? 'tv-mode' : '' %>" data-tv-mode="<%= tvMode ? 'true' : 'false' %>">
<header class="op-head">
  <div><h1>Painel Operacional Reciclagem</h1><p>Decisões de manutenção baseadas em OS, falhas, preventivas e equipe.</p></div>
  <div class="op-head-actions"><a class="op-button ghost" href="<%= tvMode ? '/dashboard?' + qs.replace(/(^|&)tv=1(&|$)/,'$1').replace(/&$/,'') : '/dashboard?' + qs + '&tv=1' %>"><%= tvMode ? 'Sair do Modo TV' : 'Modo TV' %></a><button class="op-button" id="opRefresh" type="button">Atualizar</button></div>
</header>
<form class="op-filters" method="get" action="/dashboard">
  <label>Período<select name="periodo" id="periodSelect"><option value="hoje" <%= op.period.key==='hoje'?'selected':'' %>>Hoje</option><option value="7d" <%= op.period.key==='7d'?'selected':'' %>>Últimos 7 dias</option><option value="30d" <%= op.period.key==='30d'?'selected':'' %>>Últimos 30 dias</option><option value="mes" <%= op.period.key==='mes'?'selected':'' %>>Mês atual</option><option value="personalizado" <%= op.period.key==='personalizado'?'selected':'' %>>Período personalizado</option></select></label>
  <label class="custom-date">Início<input type="date" name="inicio" value="<%= op.period.start || '' %>"></label><label class="custom-date">Fim<input type="date" name="fim" value="<%= op.period.end || '' %>"></label>
  <label>Setor<select name="setor"><option value="">Todos os setores</option><% const sectors=[...new Set((op.os.items||[]).map(i=>i.setor).filter(s=>s&&s!=='-'))]; sectors.forEach(s=>{ %><option value="<%= s %>" <%= op.sector===s?'selected':'' %>><%= s %></option><% }) %></select></label>
  <% if(tvMode){ %><input type="hidden" name="tv" value="1"><% } %><button class="op-button" type="submit">Aplicar</button><span class="last-update">Última atualização: <strong><%= op.updatedAt %></strong> • <%= op.timezone %></span>
</form>

<section class="metric-grid" aria-label="Indicadores gerais">
  <% const metrics=[
    ['abertas','OS abertas',osCounts.abertas,'Aguardando início','os','abertas'],['progress','Em andamento',osCounts.andamento,'Equipe em atividade','os','andamento'],['danger','OS atrasadas',osCounts.atrasadas,'Requer ação','os','atrasadas'],['warning','Preventivas pendentes',(prev.items||[]).filter(i=>!['CONCLUIDA','FINALIZADA','FECHADA'].includes(String(i.status).toUpperCase())).length,'Programadas no painel','preventivas',''],['danger','Equipamentos críticos',criticalCount,'Falhas e reincidências','criticidade',''],['neutral','Demandas ativas',activeDemands,'Novas, em curso ou paradas','demandas','']]; %>
  <% metrics.forEach(m=>{ %><button class="metric-card <%= m[0] %>" type="button" data-target="<%= m[4] %>" data-filter="<%= m[5] %>"><span><%= m[1] %></span><strong><%= m[2] || 0 %></strong><small><%= m[3] %> • <%= op.period.label %></small></button><% }) %>
</section>

<section class="attention-card <%= op.alerts.length ? '' : 'compact-empty' %>"><h2>ATENÇÃO IMEDIATA</h2><% if(!op.alerts.length){ %><p>Nenhuma situação crítica no momento.</p><% } else { %><div class="attention-list"><% op.alerts.forEach(a=>{ %><button type="button" data-target="<%= a.target || 'os' %>" data-filter="<%= a.filter || '' %>"><strong><%= a.count %></strong><span><%= a.text %></span><em>Aplicar filtro</em></button><% }) %></div><% } %></section>

<div class="op-layout"><main class="op-main">
<section class="op-card" id="os"><div class="card-heading"><div><h2>ORDENS DE SERVIÇO</h2><p>OS ativas; fechadas são apresentadas separadamente no período.</p></div><a href="/os?<%= qs %>">Ver todas as OS</a></div>
  <div class="status-summary"><span>Abertas <strong><%= osCounts.abertas||0 %></strong></span><span>Em andamento <strong><%= osCounts.andamento||0 %></strong></span><span>Pausadas <strong><%= osCounts.pausadas||0 %></strong></span><span class="red">Atrasadas <strong><%= osCounts.atrasadas||0 %></strong></span><span>Fechadas no período <strong><%= op.os.closedInPeriod == null ? 'Sem dados' : op.os.closedInPeriod %></strong></span></div>
  <div class="os-chart" aria-label="Distribuição das OS ativas"><% op.os.distribution.forEach(d=>{ %><button type="button" data-filter="<%= d.key %>"><span><%= d.key %></span><i><b style="width:<%= d.percent %>%"></b></i><strong><%= d.value %> • <%= d.percent %>%</strong></button><% }) %></div><div class="active-filter" hidden>Filtro ativo: <strong></strong> <button type="button">Limpar filtro</button></div>
  <div class="responsive-table"><table class="op-table"><thead><tr><th>Número</th><th>Equipamento</th><th>Responsáveis</th><th>Prioridade</th><th>Criticidade</th><th>Status</th><th>Abertura</th><th>Prazo</th><th>Tempo aberto</th><th>Última atualização</th><th>Ação</th></tr></thead><tbody><% if(!op.os.items.length){ %><tr class="empty"><td colspan="11">Nenhuma OS ativa para os filtros selecionados.</td></tr><% } op.os.items.forEach(o=>{ const status=o.status_normalizado; %><tr data-status="<%= status %>" data-overdue="<%= o.atrasada %>" data-critical="<%= o.critica %>" class="<%= o.atrasada?'is-overdue':o.critica?'is-critical':'' %>"><td data-label="Número">#<%= o.id %></td><td data-label="Equipamento"><strong><%= o.equipamento||'-' %></strong></td><td data-label="Responsáveis"><%= o.responsavel_exibicao||'-' %></td><td data-label="Prioridade"><%= o.prioridade||'-' %></td><td data-label="Criticidade"><span class="tag <%= o.critica?'danger':'neutral' %>"><%= o.grau||o.criticidade||'-' %></span></td><td data-label="Status"><span class="tag status"><%= status.replaceAll('_',' ') %><%= o.atrasada?' • ATRASADA':'' %></span><% if(status==='PAUSADA'){ %><small><%= o.motivo_pausa||'Motivo não informado' %> • <%= fmtHours(o.tempo_pausado_horas) %></small><% } %></td><td data-label="Abertura"><%= o.abertura||o.opened_at ? fmtBR(o.abertura||o.opened_at) : '-' %></td><td data-label="Prazo"><%= o.prazo ? fmtBR(o.prazo) : 'Sem prazo' %></td><td data-label="Tempo aberto"><%= fmtHours(o.tempo_aberto_horas) %></td><td data-label="Atualização"><%= o.ultima_atualizacao ? fmtBR(o.ultima_atualizacao) : '-' %></td><td data-label="Ação"><% if(status==='ABERTA'){ %><form method="post" action="/os/<%= o.id %>/status"><input type="hidden" name="status" value="ANDAMENTO"><button class="table-action" type="submit">Iniciar</button></form><% } else { %><a class="table-action" href="/os/<%= o.id %>"><%= status==='PAUSADA'?'Ver motivo':(['ANDAMENTO','EM_ANDAMENTO'].includes(status)?'Continuar':'Abrir') %></a><% } %></td></tr><% }) %></tbody></table></div>
</section>

<section class="op-card" id="criticidade"><div class="card-heading"><div><h2>CRITICIDADE DOS EQUIPAMENTOS</h2><p>Equipamentos com maior frequência e reincidência de falhas</p></div><a href="/dashboard/criticidade?<%= qs %>">Abrir painel completo</a></div><p class="formula-note">A pontuação considera falhas, reincidências, criticidade do equipamento e tempo médio entre falhas.</p>
  <% if(!op.critical.length){ %><p class="empty-state">Dados insuficientes no período selecionado.</p><% } else { %><div class="critical-list"><% op.critical.forEach((i,index)=>{ const score=Number(i.pontuacao_risco ?? i.risco ?? i.total_falhas*2+i.reincidencias*3); %><a href="<%= i.historico_url||'/dashboard/criticidade/equipamentos/'+i.equipamento_id %>"><b><%= index+1 %></b><span><strong><%= i.equipamento_nome||'-' %></strong><small><%= i.setor||'-' %> • <%= i.total_falhas||0 %> falhas • <%= i.reincidencias||0 %> reincidências • MTBF: <%= i.frequencia_media||'Dados insuficientes' %></small></span><em><%= i.intervalo?.tendencia||'estável' %><small>Risco <%= score %></small></em></a><% }) %></div><% } %>
  <div class="trend-panel"><h3>FALHAS — <%= op.period.label %></h3><p><%= safeCriticidadeOperacional?.tendencia?.resumo || 'Dados insuficientes para comparação com o período anterior.' %></p></div>
</section>

<section class="op-card" id="performance"><div class="card-heading"><div><h2>INDICADORES DE DESEMPENHO DA MANUTENÇÃO</h2><p>Período: <%= op.period.label %></p></div></div><div class="performance-grid"><% const perf=[['MTTR',op.indicators.mttr,'h','Tempo total de reparo ÷ reparos concluídos'],['MTBF',op.indicators.mtbf,'h','Tempo operacional acumulado ÷ falhas'],['Preventivas no prazo',op.indicators.preventiveCompliance,'%','Concluídas no prazo ÷ previstas × 100'],['Preventivas × corretivas',op.indicators.preventiveCorrective,'','Relação entre manutenções no período'],['Reincidência',op.indicators.recurrenceRate,'%','Falhas reincidentes ÷ total de falhas × 100'],['Disponibilidade',op.indicators.availability,'%','Exige tempo operacional e indisponibilidade confiáveis']]; perf.forEach(i=>{ %><article title="<%= i[3] %>"><span><%= i[0] %></span><strong><%= i[1]==null?'Sem dados suficientes':Number(i[1]).toFixed(1)+' '+i[2] %></strong><small><%= i[3] %></small></article><% }) %></div></section>

<% if(canPreventivas){ %><section class="op-card" id="preventivas"><div class="card-heading"><div><h2>PREVENTIVAS PROGRAMADAS</h2><p>Vencimentos calculados pela data prevista real.</p></div><a href="/preventivas?<%= qs %>">Ver todas as preventivas</a></div><div class="status-summary"><span class="red">Vencidas <strong><%= prev.deadlines.vencidas||0 %></strong></span><span>Vencendo hoje <strong><%= prev.deadlines.hoje||0 %></strong></span><span>Nesta semana <strong><%= prev.deadlines.semana||0 %></strong></span><span>Sem responsável <strong><%= prev.deadlines.semResponsavel||0 %></strong></span></div><div class="crit-summary"><% ['BAIXA','MEDIA','ALTA','CRITICA'].forEach(c=>{ %><span class="<%= Number(prev.criticidade?.[c]||0)===0?'zero':'' %>"><%= c %> <strong><%= prev.criticidade?.[c]||0 %></strong></span><% }) %></div>
<div class="responsive-table"><table class="op-table"><thead><tr><th>Número</th><th>Equipamento</th><th>Responsáveis</th><th>Data prevista</th><th>Situação</th><th>Criticidade</th><th>Status</th><th>Ação</th></tr></thead><tbody><% if(!prev.items.length){ %><tr class="empty"><td colspan="8">Nenhuma preventiva programada no período.</td></tr><% } prev.items.forEach(p=>{ %><tr class="<%= p.vencida?'is-overdue':'' %>"><td>#<%= p.id %></td><td><%= p.equipamento_nome||'-' %></td><td><%= p.responsavel_exibicao||'-' %></td><td><%= p.data_prevista?fmtBR(p.data_prevista):'-' %></td><td><span class="tag <%= p.vencida?'danger':p.vence_hoje||p.vence_semana?'warning':'success' %>"><%= p.vencida?'Vencida':p.vence_hoje?'Vence hoje':p.vence_semana?'Vence na semana':'No prazo' %></span></td><td><%= p.criticidade||'-' %></td><td><%= p.status||'-' %></td><td><% if(canOperatePreventivas && String(p.status).toUpperCase()==='PENDENTE'){ %><form method="post" action="/dashboard/preventivas/<%= p.id %>/iniciar"><button class="table-action" type="submit">Iniciar</button></form><% } else { %><a class="table-action" href="/preventivas">Ver</a><% } %></td></tr><% }) %></tbody></table></div></section><% } %>

<section class="op-card compact-card" id="demandas"><div class="card-heading"><div><h2>DEMANDAS</h2><p>Novas <strong><%= demandas.novas||0 %></strong> • Em andamento <strong><%= demandas.em_andamento||0 %></strong> • Paradas <strong><%= demandas.paradas||0 %></strong></p></div><a href="/demandas">Abrir demandas</a></div><% if(!activeDemands){ %><p class="empty-state">Nenhuma demanda em andamento.</p><% } %></section>
</main>
<aside class="op-side">
<section class="op-card"><h2>ESCALA DA SEMANA</h2><p class="subtle">Período semanal próprio</p><% const day=(escala?.diurno_mecanicos||[]), night=(escala?.noturno||[]), weekend=(escala?.final_semana_responsavel||night); [['Equipe do dia',day],['Equipe da noite',night],['Fim de semana',weekend]].forEach(group=>{ %><div class="team-row"><span class="avatar"><%= group[1].map(p=>String(p.nome||'?')[0]).join('').slice(0,2)||'–' %></span><div><strong><%= group[0] %></strong><small><%= group[1].map(p=>p.nome).join(', ')||'Não informado' %></small></div></div><% }) %><p class="subtle"><strong>Folgas e atestados:</strong> <%= (escala?.folgas_afastamentos||[]).map(i=>i.nome).join(', ')||'Nenhum registro' %></p></section>
<section class="op-card"><h2>DESEMPENHO DA EQUIPE</h2><p class="subtle">Ranking mensal • pesos por criticidade e participação</p><% const ranking=rankingMecanicos?.itemsMecanicos||rankingMecanicos?.items||[]; if(!ranking.length){ %><p class="empty-state">Dados insuficientes para o ranking.</p><% } ranking.slice(0,5).forEach((i,index)=>{ %><div class="rank-row"><b><%= index+1 %></b><span><strong><%= i.nome %></strong><small><%= i.os_total||0 %> OS • <%= i.os_criticas||0 %> críticas</small></span><em><%= Number(i.score||0).toFixed(1) %></em></div><% }) %><a class="download-link" href="/dashboard/ranking/relatorios/ultimo/pdf">Baixar PDF mensal</a></section>
<section class="op-card compact-card"><h2>AVISOS</h2><% if(!(avisos||[]).length){ %><p class="empty-state">Nenhum aviso ativo no momento.</p><% } else (avisos||[]).slice(0,3).forEach(a=>{ %><p><strong><%= a.titulo||'Aviso' %></strong><br><small><%= a.mensagem||'-' %></small></p><% }) %></section>
<section class="op-card compact-card"><h2>MOTORES</h2><div class="motor-grid"><span>Funcionando <strong><%= motoresResumo?.em_funcionamento||0 %></strong></span><span>Estoque <strong><%= motoresResumo?.em_estoque||0 %></strong></span><span>Em conserto <strong><%= motoresResumo?.em_conserto||0 %></strong></span></div></section>
</aside></div></div>
<script src="/js/operational-dashboard.js" defer></script>
