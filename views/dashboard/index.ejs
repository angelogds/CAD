<% layout('layout') %>
<link rel="stylesheet" href="/css/operational-dashboard.css">
<%
const op = operational || { os:{items:[],counts:{},distribution:[]}, preventivas:{items:[],deadlines:{}}, critical:[], period:{} };
const osCounts = op.os.counts || {}, demandas = demandasResumo || {}, prev = op.preventivas || {items:[],deadlines:{}};
const activeDemands = Number(demandas.novas||0)+Number(demandas.em_andamento||0)+Number(demandas.paradas||0);
const criticalCount = (op.critical||[]).filter(i=>['CRITICO','CRÍTICO','ALTO'].includes(String(i.nivel||i.situacao_atual||'').toUpperCase()) || Number(i.reincidencias||0)>0).length;
const roleNorm = typeof normalizeRole==='function' ? normalizeRole(user?.role||'') : String(user?.role||'').toUpperCase();
if(typeof canAccessModule!=='function'){ var canAccessModule=()=>true; }
const canPreventivas=canAccessModule(roleNorm,'preventivas_view'), canOperatePreventivas=roleNorm!=='INSPECAO_QUALIDADE';
const qs=new URLSearchParams({periodo:op.period.key||'30d',...(op.sector?{setor:op.sector}:{}),...(tvMode?{tv:'1'}:{})}).toString();
const statusNorm=v=>String(v||'').toUpperCase();
const prevCounts={ abertas:(prev.items||[]).filter(p=>['PENDENTE','ABERTA'].includes(statusNorm(p.status))).length, andamento:(prev.items||[]).filter(p=>['ANDAMENTO','EM_ANDAMENTO'].includes(statusNorm(p.status))).length, concluidas:(prev.items||[]).filter(p=>['CONCLUIDA','FINALIZADA','FECHADA'].includes(statusNorm(p.status))).length };
const dist=op.os.distribution||[], distColors=['#149557','#149ca0','#f2a11f']; let distCursor=0;
const donutStops=dist.map((d,i)=>{const start=distCursor;distCursor+=Number(d.percent||0);return `${distColors[i]} ${start}% ${distCursor}%`;}).join(',');
const scores=(op.critical||[]).map(i=>Number(i.pontuacao_risco??i.risco??(i.total_falhas||0)*2+(i.reincidencias||0)*3)); const maxScore=Math.max(1,...scores);
%>
<div class="operational-dashboard <%= tvMode?'tv-mode':'' %>" data-tv-mode="<%= tvMode?'true':'false' %>">
<header class="op-head"><div class="op-title"><h1>Painel Operacional Reciclagem</h1><p>Visão em tempo real da manutenção, OS, preventivas, equipe e equipamentos</p><small>Olá, <%= user?.name||user?.nome||'equipe' %>. Acompanhe as prioridades da operação.</small></div>
  <form class="op-controls" method="get" action="/dashboard"><select name="periodo" id="periodSelect" aria-label="Período"><option value="hoje" <%= op.period.key==='hoje'?'selected':'' %>>Hoje</option><option value="7d" <%= op.period.key==='7d'?'selected':'' %>>Últimos 7 dias</option><option value="30d" <%= op.period.key==='30d'?'selected':'' %>>Últimos 30 dias</option><option value="mes" <%= op.period.key==='mes'?'selected':'' %>>Mês atual</option><option value="personalizado" <%= op.period.key==='personalizado'?'selected':'' %>>Personalizado</option></select><span class="custom-date"><input type="date" name="inicio" value="<%= op.period.start||'' %>" aria-label="Início"><input type="date" name="fim" value="<%= op.period.end||'' %>" aria-label="Fim"></span><select name="setor" aria-label="Setor"><option value="">Todos os setores</option><% [...new Set((op.os.items||[]).map(i=>i.setor).filter(s=>s&&s!=='-'))].forEach(s=>{ %><option value="<%= s %>" <%= op.sector===s?'selected':'' %>><%= s %></option><% }) %></select><button class="op-button" type="submit">↻ Atualizar</button><a class="op-button ghost" href="<%= tvMode?'/dashboard?'+qs.replace(/(^|&)tv=1(&|$)/,'$1').replace(/&$/,''):'/dashboard?'+qs+'&tv=1' %>">▣ <%= tvMode?'Sair do modo TV':'Modo TV' %></a><small class="last-update">Atualizado <strong><%= op.updatedAt %></strong></small></form>
</header>
<section class="metric-grid" aria-label="Indicadores gerais"><% const metrics=[['open','OS abertas',osCounts.abertas,'Aguardando início','○','os','abertas'],['progress','Em andamento',osCounts.andamento,'Equipe em atividade','▶','os','andamento'],['danger','OS atrasadas',osCounts.atrasadas,'Requer atenção','!','os','atrasadas'],['warning','Preventivas pendentes',prevCounts.abertas,'Aguardando execução','◇','preventivas',''],['danger','Equipamentos críticos',criticalCount,'Maior risco operacional','⚙','criticidade',''],['neutral','Demandas ativas',activeDemands,activeDemands?'Em acompanhamento':'Nenhuma demanda','▤','demandas','']]; metrics.forEach(m=>{ %><button class="metric-card <%= m[0] %>" type="button" data-target="<%= m[5] %>" data-filter="<%= m[6] %>"><i><%= m[4] %></i><strong><%= m[2]||0 %></strong><span><%= m[1] %></span><small><%= m[3] %></small></button><% }) %></section>

<div class="op-layout"><main class="op-main">
<section class="op-card" id="os"><div class="card-heading"><div><h2>ORDENS DE SERVIÇO</h2><p>Visão rápida das atividades em manutenção</p></div><a href="/os?<%= qs %>">Ver todas as OS →</a></div>
 <div class="status-summary"><span>Abertas<strong><%= osCounts.abertas||0 %></strong></span><span>Em andamento<strong><%= osCounts.andamento||0 %></strong></span><span>Pausadas<strong><%= osCounts.pausadas||0 %></strong></span><span>Fechadas no período<strong><%= op.os.closedInPeriod??'—' %></strong></span></div>
 <div class="os-content"><div class="responsive-table"><table class="op-table"><thead><tr><th>OS</th><th>Equipamento</th><th>Responsáveis</th><th>Criticidade</th><th>Status</th><th>Abertura</th><th>Ação</th></tr></thead><tbody><% if(!op.os.items.length){ %><tr class="empty"><td colspan="7">Nenhuma OS ativa para os filtros selecionados.</td></tr><% } (op.os.items||[]).slice(0,5).forEach(o=>{const status=o.status_normalizado;%><tr data-status="<%= status %>" data-overdue="<%= o.atrasada %>" data-critical="<%= o.critica %>"><td data-label="OS"><b>#<%= o.id %></b></td><td data-label="Equipamento"><strong><%= o.equipamento||'-' %></strong></td><td data-label="Responsáveis"><%= o.responsavel_exibicao||'-' %></td><td data-label="Criticidade"><span class="tag <%= o.critica?'danger':'neutral' %>"><%= o.grau||o.criticidade||'-' %></span></td><td data-label="Status"><span class="tag status"><%= status.replaceAll('_',' ') %></span></td><td data-label="Abertura"><%= o.abertura||o.opened_at?fmtBR(o.abertura||o.opened_at):'-' %></td><td data-label="Ação"><% if(status==='ABERTA'){ %><form method="post" action="/os/<%= o.id %>/status"><input type="hidden" name="status" value="ANDAMENTO"><button class="table-action" type="submit">Iniciar</button></form><% }else{ %><a class="table-action" href="/os/<%= o.id %>"><%= ['ANDAMENTO','EM_ANDAMENTO'].includes(status)?'Continuar':'Ver' %></a><% } %></td></tr><% }) %></tbody></table></div>
  <div class="donut-panel"><h3>DISTRIBUIÇÃO DAS OS</h3><div class="donut" style="--donut:<%= donutStops||'#e8eeeb 0 100%' %>"><b><%= op.os.totalAtivas||0 %></b><small>ativas</small></div><div class="donut-legend"><% dist.forEach((d,i)=>{ %><button data-filter="<%= d.key %>"><i style="background:<%= distColors[i] %>"></i><span><%= d.key.replace('andamento','Em andamento') %></span><strong><%= d.value %> · <%= d.percent %>%</strong></button><% }) %></div></div></div><div class="active-filter" hidden>Filtro ativo: <strong></strong> <button type="button">Limpar</button></div>
</section>

<section class="op-card" id="criticidade"><div class="card-heading"><div><h2>CRITICIDADE DOS EQUIPAMENTOS</h2><p>Ranking de risco operacional</p></div><a href="/dashboard/criticidade?<%= qs %>">Abrir painel completo →</a></div><div class="critical-content"><div class="critical-list"><% if(!op.critical.length){%><p class="empty-state">Dados insuficientes no período selecionado.</p><%}(op.critical||[]).slice(0,5).forEach((i,index)=>{const score=scores[index], level=score>=maxScore*.7?'CRÍTICO':'ALTO';%><a href="<%= i.historico_url||'/dashboard/criticidade/equipamentos/'+i.equipamento_id %>"><b><%= index+1 %></b><span><strong><%= i.equipamento_nome||'-' %></strong><small><%= i.total_falhas||0 %> falhas · <%= i.reincidencias||0 %> reincidências · Média entre falhas: <%= i.frequencia_media||'—' %></small><i><u style="width:<%= Math.max(5,score/maxScore*100) %>%"></u></i></span><em class="risk <%= level==='CRÍTICO'?'critical':'' %>"><%= level %></em><strong class="score"><%= score %></strong></a><% }) %></div><div class="trend-panel"><h3>FALHAS — ÚLTIMOS 30 DIAS</h3><svg viewBox="0 0 360 150" role="img" aria-label="Tendência de falhas"><line x1="30" y1="25" x2="30" y2="125"/><line x1="30" y1="125" x2="345" y2="125"/><line x1="30" y1="92" x2="345" y2="92"/><line x1="30" y1="58" x2="345" y2="58"/></svg><p>Dados insuficientes para gerar a tendência.</p><div class="weeks"><span>Semana 1</span><span>Semana 2</span><span>Semana 3</span><span>Semana 4</span></div></div></div></section>

<% if(canPreventivas){%><section class="op-card" id="preventivas"><div class="card-heading"><div><h2>PREVENTIVAS PROGRAMADAS</h2><p>Programação de manutenção preventiva</p></div><a href="/preventivas?<%= qs %>">Ver todas as preventivas →</a></div><div class="status-summary"><span>Abertas<strong><%= prevCounts.abertas %></strong></span><span>Em andamento<strong><%= prevCounts.andamento %></strong></span><span>Concluídas<strong><%= prevCounts.concluidas %></strong></span><span>Vencendo nesta semana<strong><%= prev.deadlines.semana||0 %></strong></span></div><div class="crit-summary"><% [['BAIXA','#43b86b'],['MEDIA','#eab438'],['ALTA','#ee7c30'],['CRITICA','#dc3447']].forEach(c=>{ %><span style="--crit:<%= c[1] %>"><i></i><%= c[0] %><strong><%= prev.criticidade?.[c[0]]||0 %></strong></span><% }) %></div><div class="responsive-table"><table class="op-table"><thead><tr><th>Número</th><th>Equipamento</th><th>Responsáveis</th><th>Data prevista</th><th>Criticidade</th><th>Status</th><th>Ação</th></tr></thead><tbody><% if(!prev.items.length){%><tr class="empty"><td colspan="7">Nenhuma preventiva programada no período.</td></tr><%}(prev.items||[]).slice(0,6).forEach(p=>{%><tr><td data-label="Número"><b>#<%= p.id %></b></td><td data-label="Equipamento"><%= p.equipamento_nome||'-' %></td><td data-label="Responsáveis"><%= p.responsavel_exibicao||'-' %></td><td data-label="Data prevista"><%= p.data_prevista?fmtBR(p.data_prevista):'-' %></td><td data-label="Criticidade"><span class="tag"><%= p.criticidade||'-' %></span></td><td data-label="Status"><span class="tag <%= p.vencida?'danger':'' %>"><%= p.status||'-' %></span></td><td data-label="Ação"><%if(canOperatePreventivas&&statusNorm(p.status)==='PENDENTE'){%><form method="post" action="/dashboard/preventivas/<%= p.id %>/iniciar"><button class="table-action" type="submit">Iniciar</button></form><%}else{%><a class="table-action" href="/preventivas">Ver</a><%}%></td></tr><%})%></tbody></table></div></section><%}%>
<section class="op-card compact-card" id="demandas"><div class="card-heading"><h2>DEMANDAS</h2><a href="/demandas">Abrir demandas →</a></div><div class="demand-summary"><span>Novas<strong><%= demandas.novas||0 %></strong></span><span>Em andamento<strong><%= demandas.em_andamento||0 %></strong></span><span>Paradas<strong><%= demandas.paradas||0 %></strong></span></div><%if(!activeDemands){%><p class="empty-state">Nenhuma demanda em andamento.</p><%}%></section>
</main><aside class="op-side">
<section class="op-card"><div class="side-heading"><h2>ESCALA DA SEMANA</h2><small>Semana atual</small></div><% const day=escala?.diurno_mecanicos||[],night=escala?.noturno||[],weekend=escala?.final_semana_responsavel||night; [['Equipe do dia',day],['Equipe da noite',night],['Fim de semana',weekend]].forEach(g=>{%><div class="team-row"><span class="avatar"><%= g[1].map(p=>String(p.nome||'?')[0]).join('').slice(0,2)||'–' %></span><div><strong><%= g[0] %></strong><small><%= g[1].map(p=>p.nome).join(', ')||'Não informado' %></small></div></div><%})%><p class="absence"><strong>Folgas e atestados</strong><span><%= (escala?.folgas_afastamentos||[]).map(i=>i.nome).join(', ')||'Nenhum registro' %></span></p></section>
<section class="op-card"><h2>DESEMPENHO DA EQUIPE</h2><% const ranking=rankingMecanicos?.itemsMecanicos||rankingMecanicos?.items||[],maxRank=Math.max(1,...ranking.slice(0,5).map(i=>Number(i.score||i.pontos||0))); if(!ranking.length){%><p class="empty-state">Dados insuficientes para o ranking.</p><%}ranking.slice(0,5).forEach((i,index)=>{const score=Number(i.score||i.pontos||0);%><div class="rank-row"><b><%= index+1 %></b><span><strong><%= i.nome %></strong><small><%= i.os_finalizadas||i.os_total||0 %> OS finalizadas</small><i><u style="width:<%= score/maxRank*100 %>%"></u></i></span><em><%= score.toFixed(1) %></em></div><%})%><a class="download-link" href="/dashboard/ranking/relatorios/ultimo/pdf">⇩ Baixar PDF mensal</a></section>
<section class="op-card compact-card"><h2>AVISOS</h2><%if(!(avisos||[]).length){%><p class="empty-state">Nenhum aviso ativo no momento.</p><%}else (avisos||[]).slice(0,3).forEach(a=>{%><p class="notice"><strong><%= a.titulo||'Aviso' %></strong><small><%= a.mensagem||'-' %></small></p><%})%></section>
<section class="op-card compact-card"><h2>MOTORES</h2><div class="motor-grid"><span>Funcionando<strong><%= motoresResumo?.em_funcionamento||0 %></strong></span><span>Estoque<strong><%= motoresResumo?.em_estoque||0 %></strong></span><span>Em conserto<strong><%= motoresResumo?.em_conserto||0 %></strong></span></div></section>
</aside></div></div><script src="/js/operational-dashboard.js" defer></script>
