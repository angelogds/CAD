<% layout('layout') %>
<% var data = (typeof criticidadeOperacional !== 'undefined' && criticidadeOperacional) ? criticidadeOperacional : {}; var ranking = data.ranking || []; var osr = data.osResumo || {}; var interv = data.intervencoes || []; var f = data.filters || {}; var opts = data.options || {}; %>
<style>
.crit-card{background:#fff;border:1px solid #dbe7df;border-radius:16px;padding:14px;box-shadow:0 1px 3px rgba(21,128,61,.08);margin-bottom:14px}.crit-title{font-weight:900;color:#166534;text-transform:uppercase;letter-spacing:.04em;font-size:13px;margin-bottom:10px}.crit-filters{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:8px}.crit-filters label{font-size:12px;font-weight:800;color:#475569}.crit-filters input,.crit-filters select{width:100%;padding:8px;border:1px solid #cbd5e1;border-radius:10px}.crit-kpis{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:8px}.crit-kpi{display:block;text-decoration:none;color:inherit;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:10px}.crit-kpi strong{display:block;font-size:26px;color:#14532d}.bar-row{display:grid;grid-template-columns:minmax(150px,260px) 1fr;gap:10px;align-items:center;margin:10px 0}.bar-label{font-weight:900;color:#0f172a;overflow:hidden;text-overflow:ellipsis}.bar-track{background:#f1f5f9;border-radius:999px;overflow:hidden}.bar-fill{background:#dc2626;color:#fff;font-weight:900;padding:8px 10px;min-width:42px;text-align:right}.crit-meta{font-size:12px;color:#64748b;margin-top:4px}.crit-table{width:100%;border-collapse:collapse}.crit-table th,.crit-table td{padding:9px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.crit-badge{border-radius:999px;padding:3px 8px;font-size:11px;font-weight:900}.red{background:#fee2e2;color:#991b1b}.orange{background:#ffedd5;color:#9a3412}.green{background:#dcfce7;color:#166534}.gray{background:#f1f5f9;color:#475569}@media(max-width:800px){.crit-filters,.crit-kpis{grid-template-columns:1fr}.bar-row{grid-template-columns:1fr}.crit-table{min-width:860px}.crit-scroll{overflow:auto}}@media(min-width:1400px){.crit-card{font-size:1.1rem}.crit-kpi strong{font-size:36px}}
</style>
<div class="page-head"><div><h1>Painel operacional de criticidade</h1><p class="muted">Equipamentos com maior incidência de falhas reais no período selecionado. Preventivas e OS canceladas não entram como falha.</p></div><a class="btn btn-green" href="/dashboard">Voltar ao painel</a></div>
<form class="crit-card" method="GET" action="/dashboard/criticidade"><div class="crit-title">Filtros</div><div class="crit-filters"><label>Período<select name="periodo"><% [7,30,60,90,180].forEach(function(d){ %><option value="<%= d %>" <%= Number(f.days)===d?'selected':'' %>><%= d %> dias</option><% }) %></select></label><label>Início<input type="date" name="inicio" value="<%= f.start || '' %>"></label><label>Fim<input type="date" name="fim" value="<%= f.end || '' %>"></label><label>Setor<select name="setor"><option value="">Todos</option><% (opts.setores||[]).forEach(function(s){ %><option <%= f.setor===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Equipamento<select name="equipamento_id"><option value="">Todos</option><% (opts.equipamentos||[]).forEach(function(e){ %><option value="<%= e.id %>" <%= String(f.equipamento_id)===String(e.id)?'selected':'' %>><%= e.nome %></option><% }) %></select></label><label>Criticidade<select name="criticidade"><option value="">Todas</option><% ['BAIXA','MEDIA','ALTA','CRITICA','EMERGENCIAL'].forEach(function(c){ %><option <%= f.criticidade===c?'selected':'' %>><%= c %></option><% }) %></select></label><label>Tipo manutenção<input name="tipo" value="<%= f.tipo || '' %>" placeholder="CORRETIVA"></label><label>Situação OS<input name="status" value="<%= f.status || '' %>" placeholder="ABERTA"></label><label>Ativo<select name="ativo"><option value="">Todos</option><option value="1" <%= String(f.ativo)==='1'?'selected':'' %>>Ativo</option><option value="0" <%= String(f.ativo)==='0'?'selected':'' %>>Inativo</option></select></label></div><button class="btn btn-green" style="margin-top:10px">Aplicar filtros</button></form>
<section class="crit-card"><div class="crit-title">Top 5 equipamentos com mais falhas</div><% if (!ranking.length) { %><p class="muted">Nenhuma falha corretiva registrada no período.</p><% } %><% var max = Math.max.apply(null, ranking.map(function(i){return i.total_falhas;})); ranking.forEach(function(i){ var pct = max ? Math.max(8, Math.round(i.total_falhas/max*100)) : 0; var color = i.os_criticas>0?'red':(i.reincidencias>0?'orange':'green'); %><a class="bar-row" href="<%= i.historico_url || ('/dashboard/criticidade/equipamentos/'+i.equipamento_id) %>"><div><div class="bar-label"><%= i.equipamento_nome %></div><div class="crit-meta"><%= i.setor %> • Última falha: <%= i.ultima_falha ? fmtBR(i.ultima_falha) : '-' %> • <span class="crit-badge <%= color %>"><%= i.situacao_atual || '-' %></span></div></div><div><div class="bar-track"><div class="bar-fill" style="width:<%= pct %>%"><%= i.total_falhas %></div></div><div class="crit-meta">Críticas/emergenciais: <%= i.os_criticas %> • Reincidências: <%= i.reincidencias %> • Média entre falhas: <%= i.frequencia_media %> • Tendência: <%= i.intervalo.tendencia %></div></div></a><% }) %><div class="crit-meta">Legenda: vermelho = falhas críticas/emergenciais; laranja = observação/reincidência; verde = operando sem nova ocorrência corretiva; cinza = dados insuficientes.</div></section>
<section class="crit-card"><div class="crit-title">Situação das ordens de serviço</div><div class="crit-kpis"><a class="crit-kpi" href="/os?status=ABERTA"><span>OS abertas</span><strong><%= osr.abertas || 0 %></strong></a><a class="crit-kpi" href="/os?status=AGUARDANDO_EQUIPE"><span>Aguardando equipe</span><strong><%= osr.aguardando_equipe || 0 %></strong></a><a class="crit-kpi" href="/os?status=ANDAMENTO"><span>Em andamento</span><strong><%= osr.andamento || 0 %></strong></a><a class="crit-kpi" href="/os?status=PAUSADA"><span>Pausadas</span><strong><%= osr.pausadas || 0 %></strong></a><a class="crit-kpi" href="/os?criticidade=CRITICA"><span>Críticas/emergenciais</span><strong><%= osr.criticas_emergenciais || 0 %></strong></a><a class="crit-kpi" href="/os?status=CONCLUIDA"><span>Finalizadas no período</span><strong><%= osr.finalizadas_periodo || 0 %></strong></a><a class="crit-kpi" href="/os?vencidas=1"><span>Vencidas/antigas</span><strong><%= osr.vencidas || 0 %></strong></a><div class="crit-kpi"><span>Tempo médio fechamento</span><strong><%= osr.tempo_medio_fechamento_horas == null ? '-' : Number(osr.tempo_medio_fechamento_horas).toFixed(1)+'h' %></strong></div></div></section>
<section class="crit-card"><div class="crit-title">Reforma e parada programada</div><div class="crit-scroll"><table class="crit-table"><thead><tr><th>Classificação</th><th>Equipamento</th><th>Setor</th><th>Motivo</th><th>Falhas</th><th>Reinc.</th><th>Última falha</th><th>Criticidade</th><th>Situação</th><th>Prevista</th><th>Responsável</th></tr></thead><tbody><% if(!interv.length){ %><tr><td colspan="11">Nenhuma indicação ou sugestão no período.</td></tr><% } %><% interv.forEach(function(i){ %><tr><td><%= i.classificacao %></td><td><%= i.equipamento_nome %></td><td><%= i.setor %></td><td><%= i.motivo %></td><td><%= i.total_falhas %></td><td><%= i.reincidencias %></td><td><%= i.ultima_falha ? fmtBR(i.ultima_falha) : '-' %></td><td><span class="crit-badge <%= i.os_criticas>0?'red':'orange' %>"><%= i.criticidade || '-' %></span></td><td><%= i.situacao_solicitacao %></td><td>-</td><td><%= i.responsavel %></td></tr><% }) %></tbody></table></div></section>
