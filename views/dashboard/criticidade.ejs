<% layout('layout') %>
<link rel="stylesheet" href="/css/operational-dashboard.css?v=20261103-criticidade-v1">
<% var data = (typeof criticidadeOperacional !== 'undefined' && criticidadeOperacional) ? criticidadeOperacional : {}; var ranking=data.ranking||[]; var osr=data.osResumo||{}; var interv=data.intervencoes||[]; var f=data.filters||{}; var opts=data.options||{}; const summary=data.resumo||{};
const maxFalhas=Math.max(1,...ranking.map(i=>Number(i.total_falhas||0)));
const critBadge=i=>!i.corretivas_abertas?'ok':i.criticidade_atual==='CRITICA'?'danger':i.criticidade_atual==='ALTA'?'warning':'neutral';
const qs=new URLSearchParams({...(f.relative?{periodo:f.periodo||String(f.days||30)}:{inicio:f.start||'',fim:f.end||''}),setor:f.setor||'',ativo:f.ativo??'1',...(f.equipamento_id?{equipamento_id:f.equipamento_id}:{}),...(f.criticidade?{criticidade:f.criticidade}:{}),...(f.tipo?{tipo:f.tipo}:{}),...(f.status?{status:f.status}:{})}).toString();
const cards=[['Corretivas no período',summary.falhas||0,'Ocorrências registradas',''],['Equipamentos',summary.equipamentos||0,'Com corretivas no período',''],['Com corretiva aberta',summary.com_corretiva_aberta||0,'Situação atual','warning'],['Críticos / altos atuais',summary.criticos_atuais||0,'Corretivas ainda abertas','danger']];
%>
<div class="operational-dashboard criticality-page">
<header class="op-head criticality-hero"><div class="op-title"><span class="criticality-eyebrow">MANUTENÇÃO · CONFIABILIDADE</span><h1>Criticidade dos equipamentos</h1><p>Corretivas, reincidências e situação atual dos serviços.</p><small><%= f.start?f.start.split('-').reverse().join('/'):'' %> a <%= f.end?f.end.split('-').reverse().join('/'):'' %> · Preventivas não entram como falha.</small></div><div class="op-controls criticality-actions"><a class="op-button ghost" href="/dashboard">Voltar ao painel</a><a class="op-button" href="/tv?<%= qs %>" target="_blank" rel="noopener">Modo TV</a></div></header>
<form class="op-card criticality-filter-card" method="GET" action="/dashboard/criticidade">
<div class="criticality-filter-grid">
<label><span>Período</span><select name="periodo" onchange="this.form.elements.inicio.value='';this.form.elements.fim.value='';"><option value="personalizado" <%= !f.relative?'selected':'' %>>Personalizado</option><option value="hoje" <%= f.periodo==='hoje'?'selected':'' %>>Hoje</option><option value="mes" <%= f.periodo==='mes'?'selected':'' %>>Mês atual</option><% [7,30,60,90,180].forEach(d=>{ %><option value="<%= d %>" <%= f.relative&&f.periodo===String(d)?'selected':'' %>>Últimos <%= d %> dias</option><% }) %></select></label>
<label><span>Início</span><input type="date" name="inicio" value="<%= f.start||'' %>"></label><label><span>Fim</span><input type="date" name="fim" value="<%= f.end||'' %>"></label>
<label><span>Setor</span><select name="setor"><option value="">Todos</option><% (opts.setores||[]).forEach(s=>{ %><option <%= f.setor===s?'selected':'' %>><%= s %></option><% }) %></select></label>
<label><span>Equipamento</span><select name="equipamento_id"><option value="">Todos</option><% (opts.equipamentos||[]).forEach(e=>{ %><option value="<%= e.id %>" <%= String(f.equipamento_id)===String(e.id)?'selected':'' %>><%= e.nome %></option><% }) %></select></label>
</div>
<details class="criticality-more-filters"><summary>Mais filtros</summary><div class="criticality-filter-grid">
<label><span>Prioridade da corretiva</span><select name="criticidade"><option value="">Todas</option><% ['BAIXA','MEDIA','ALTA','CRITICA','EMERGENCIAL'].forEach(c=>{ %><option <%= f.criticidade===c?'selected':'' %>><%= c %></option><% }) %></select></label>
<label><span>Tipo corretivo</span><select name="tipo"><option value="">Todos os corretivos</option><% ['CORRETIVA','EMERGENCIAL','FALHA','QUEBRA','CRITICA'].forEach(t=>{ %><option <%= f.tipo===t?'selected':'' %>><%= t %></option><% }) %></select></label>
<label><span>Situação da OS no período</span><select name="status"><option value="">Todas</option><% ['ABERTA','AGUARDANDO_EQUIPE','ANDAMENTO','EM_ANDAMENTO','PAUSADA','CONCLUIDA','FECHADA','FINALIZADA'].forEach(s=>{ %><option <%= f.status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label>
<label><span>Cadastro do equipamento</span><select name="ativo"><option value="1" <%= String(f.ativo)==='1'?'selected':'' %>>Ativos</option><option value="0" <%= String(f.ativo)==='0'?'selected':'' %>>Inativos</option><option value="" <%= f.ativo===''?'selected':'' %>>Todos</option></select></label>
</div></details><div class="criticality-filter-actions"><button class="op-button" type="submit">Aplicar filtros</button><a class="op-button ghost" href="/dashboard/criticidade">Limpar</a></div>
</form>
<section class="metric-grid criticality-kpi-grid" aria-label="Corretivas e situação atual"><% cards.forEach(([label,value,meta,tone])=>{ %><div class="metric-card <%= tone %>"><strong><%= value %></strong><span><%= label %></span><small><%= meta %></small></div><% }) %></section>
<div class="criticality-main-grid"><section class="op-card criticality-ranking-card"><div class="card-heading"><div><h2>Corretivas por equipamento</h2><p>Top 5 do período. A situação considera as corretivas ainda abertas.</p></div></div>
<% if(!ranking.length){ %><p class="empty-state">Nenhuma falha corretiva registrada no período.</p><% } %><div class="criticality-ranking-list"><% ranking.forEach((i,index)=>{ %><a class="criticality-rank-row" href="<%= i.historico_url||'/dashboard/criticidade/equipamentos/'+i.equipamento_id %>"><b><%= index+1 %></b><div class="criticality-rank-info"><div class="criticality-rank-title"><strong><%= i.equipamento_nome %></strong><span class="tag <%= critBadge(i) %>"><%= i.corretivas_abertas?i.corretivas_abertas+' corretiva(s) aberta(s)':'Sem corretiva aberta' %></span></div><small><%= i.setor %> · Última corretiva: <%= i.ultima_falha?fmtBR(i.ultima_falha):'—' %></small><div class="criticality-bar"><i style="width:<%= Number(i.total_falhas||0)/maxFalhas*100 %>%"></i></div><small><%= i.total_falhas %> corretiva(s) · <%= i.reincidencias %> reincidência(s) · Média entre falhas: <%= i.frequencia_media %></small></div><strong class="criticality-rank-value"><%= i.total_falhas %></strong></a><% }) %></div></section>
<section class="op-card criticality-summary-card"><div class="card-heading"><h2>Leitura do período</h2></div><div class="criticality-summary-list"><div><span>Corretivas encerradas</span><strong><%= osr.finalizadas_periodo||0 %></strong></div><div><span>Reincidências em até 15 dias</span><strong><%= summary.reincidencias||0 %></strong></div><div><span>Equipamentos sem corretiva aberta</span><strong><%= summary.encerrados||0 %></strong></div><div><span>Média até o fechamento</span><strong><%= osr.tempo_medio_fechamento_horas==null?'—':Number(osr.tempo_medio_fechamento_horas).toFixed(1)+'h' %></strong></div></div><p class="criticality-note">Serviços encerrados continuam no histórico do período. Preventivas, lubrificações e OS canceladas não contam como falhas.</p></section></div>
<section class="op-card"><div class="card-heading"><div><h2>Avaliação do histórico corretivo</h2><p>Sugestões para análise da Manutenção/PCM, sem abrir serviços automaticamente.</p></div></div><div class="responsive-table"><table class="op-table criticality-table"><thead><tr><th>Equipamento</th><th>Corretivas</th><th>Reincidências</th><th>Situação atual</th><th>Avaliação</th><th>Ação</th></tr></thead><tbody>
<% if(!interv.length){ %><tr class="empty"><td colspan="6">Nenhuma indicação ou sugestão no período.</td></tr><% } %><% interv.forEach(i=>{ %><tr><td data-label="Equipamento"><div><strong><%= i.equipamento_nome %></strong><small><%= i.setor %></small></div></td><td data-label="Corretivas"><%= i.total_falhas %></td><td data-label="Reincidências"><%= i.reincidencias %></td><td data-label="Situação atual"><span class="tag <%= critBadge(i) %>"><%= i.corretivas_abertas?i.situacao_atual.replaceAll('_',' '):'Sem corretiva aberta' %></span></td><td data-label="Avaliação"><div><strong><%= i.classificacao %></strong><small><%= i.motivo %></small></div></td><td data-label="Ação"><a class="table-action" href="<%= i.historico_url %>">Ver corretivas</a></td></tr><% }) %></tbody></table></div></section>
</div>
<style>
.criticality-page{padding-bottom:8px}.criticality-actions{max-width:none}.criticality-filter-card{padding:14px 15px}.criticality-filter-grid{display:grid;grid-template-columns:repeat(5,minmax(140px,1fr));gap:10px}.criticality-filter-grid label{display:grid;gap:5px;color:#667085;font-size:10px;font-weight:800}.criticality-filter-grid select,.criticality-filter-grid input{height:36px;border:1px solid #d9e2de;border-radius:9px;background:#fff;padding:0 10px;color:#202a3b;font-weight:700;min-width:0}.criticality-filter-actions{display:flex;gap:8px;margin-top:12px}.criticality-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.criticality-kpi-grid .metric-card{text-decoration:none;text-align:left;min-height:104px}.criticality-kpi-grid .metric-card strong{margin-top:0}.criticality-main-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,.7fr);gap:14px}.criticality-count{font-size:10px;color:#687386;font-weight:800}.criticality-ranking-list{display:grid}.criticality-rank-row{display:grid;grid-template-columns:28px minmax(0,1fr) 44px;gap:10px;align-items:center;text-decoration:none;color:inherit;padding:11px 0;border-bottom:1px solid #e8ecea}.criticality-rank-row>b{width:26px;height:26px;border-radius:50%;background:#edf8f1;color:#118b4d;display:grid;place-items:center}.criticality-rank-info{display:grid;gap:5px;min-width:0}.criticality-rank-title{display:flex;align-items:center;gap:8px;justify-content:space-between}.criticality-rank-title strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.criticality-rank-info small{color:#687386;font-size:10px}.criticality-bar{height:7px;background:#edf0ef;border-radius:999px;overflow:hidden}.criticality-bar i{display:block;height:100%;background:linear-gradient(90deg,#f0aa26,#d93443);border-radius:999px}.criticality-rank-value{text-align:right;font-size:18px;color:#202a3b}.criticality-legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px;padding-top:10px;border-top:1px solid #e8ecea;color:#687386;font-size:9px}.criticality-legend span{display:flex;align-items:center;gap:5px}.criticality-legend i{width:8px;height:8px;border-radius:50%}.legend-danger{background:#d93243}.legend-warning{background:#ed941e}.legend-ok{background:#118b4d}.legend-neutral{background:#9aa3af}.criticality-summary-list{display:grid;grid-template-columns:1fr 1fr;gap:8px}.criticality-summary-list>div{background:#f7faf8;border-radius:10px;padding:11px}.criticality-summary-list span{display:block;color:#687386;font-size:10px}.criticality-summary-list strong{display:block;font-size:22px;margin-top:3px;color:#202a3b}.criticality-note{margin:10px 0 0;padding:10px;background:#fff8e8;border:1px solid #f5df9a;border-radius:9px;color:#7d6516;font-size:10px;line-height:1.4}.criticality-table td{max-width:260px}.tag.ok{color:#08783a;background:#edf8f1}.tag.warning{color:#a15c00;background:#fff5e9}.tag.danger{color:#be2332;background:#fff0f2}
@media(max-width:1180px){.criticality-filter-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.criticality-main-grid{grid-template-columns:1fr}.criticality-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:760px){.criticality-filter-grid{grid-template-columns:1fr 1fr}.criticality-filter-actions{display:grid;grid-template-columns:1fr 1fr}.criticality-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.criticality-summary-list{grid-template-columns:1fr 1fr}.criticality-rank-row{grid-template-columns:24px minmax(0,1fr) 34px}.criticality-rank-title{align-items:flex-start;flex-direction:column}.criticality-legend{display:grid;grid-template-columns:1fr 1fr}}
@media(max-width:430px){.criticality-filter-grid{grid-template-columns:1fr}.criticality-summary-list{grid-template-columns:1fr 1fr}.criticality-kpi-grid .metric-card{min-height:84px}.criticality-kpi-grid .metric-card strong{font-size:23px}}
</style>
