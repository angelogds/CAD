<% layout('layout') %>
<% var d = (typeof detalhe !== 'undefined' && detalhe) ? detalhe : {}; var rows = d.ocorrencias || []; %>
<div class="page-head"><div><h1>Histórico operacional do equipamento</h1><p class="muted">Ocorrências corretivas, falhas, quebras, críticas e emergenciais.</p></div><a class="btn" href="/dashboard/criticidade">Voltar</a></div>
<section class="dashboard-card"><div class="dashboard-title">Ordens de serviço relacionadas</div><div class="table-wrap"><table class="table compact"><thead><tr><th>#</th><th>Equipamento</th><th>Setor</th><th>Tipo</th><th>Status</th><th>Criticidade</th><th>Abertura</th><th>Descrição</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="8">Nenhuma ocorrência encontrada.</td></tr><% } %><% rows.forEach(function(o){ %><tr><td><a href="/os/<%= o.id %>">#<%= o.id %></a></td><td><%= o.equipamento_nome %></td><td><%= o.setor %></td><td><%= o.tipo %></td><td><%= o.status %></td><td><%= o.criticidade %></td><td><%= o.opened_at ? fmtBR(o.opened_at) : '-' %></td><td><%= o.descricao || '-' %></td></tr><% }) %></tbody></table></div></section>
