<% layout('layout') %>
<link rel="stylesheet" href="/css/operational-dashboard.css?v=20261103-criticidade-v1">
<% var d=(typeof detalhe!=='undefined'&&detalhe)?detalhe:{};var rows=d.ocorrencias||[];const f=d.filters||{};const qs=new URLSearchParams({inicio:f.start||'',fim:f.end||'',ativo:f.ativo??'1'}).toString(); %>
<div class="operational-dashboard criticality-page">
<header class="op-head criticality-hero"><div class="op-title"><span class="criticality-eyebrow">MANUTENÇÃO · HISTÓRICO CORRETIVO</span><h1><%= rows[0]?.equipamento_nome||'Corretivas do equipamento' %></h1><p>Somente corretivas do período. Preventivas não entram neste histórico.</p><small><%= rows.length %> ocorrência(s) · <%= f.start?f.start.split('-').reverse().join('/'):'' %> a <%= f.end?f.end.split('-').reverse().join('/'):'' %></small></div><a class="op-button ghost" href="/dashboard/criticidade?<%= qs %>">Voltar</a></header>
<section class="op-card"><div class="responsive-table"><table class="op-table"><thead><tr><th>OS</th><th>Tipo</th><th>Situação</th><th>Prioridade</th><th>Abertura</th><th>Fechamento</th><th>Serviço</th></tr></thead><tbody>
<% if(!rows.length){ %><tr class="empty"><td colspan="7">Nenhuma ocorrência corretiva encontrada neste período.</td></tr><% } %><% rows.forEach(o=>{ %><tr>
<td data-label="OS"><a class="table-action" href="/os/<%= o.id %>">#<%= o.id %></a></td><td data-label="Tipo"><%= o.tipo %></td><td data-label="Situação"><%= String(o.status).replaceAll('_',' ') %></td><td data-label="Prioridade"><%= o.criticidade %></td><td data-label="Abertura"><%= o.opened_at?fmtBR(o.opened_at):'—' %></td><td data-label="Fechamento"><%= o.closed_at?fmtBR(o.closed_at):'—' %></td><td data-label="Serviço"><%= o.descricao||'—' %></td>
</tr><% }) %></tbody></table></div></section>
</div>
