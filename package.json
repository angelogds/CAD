{
  "name": "manutencao-campo-do-gado-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Manutenção - Campo do Gado V2",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
